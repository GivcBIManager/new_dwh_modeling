/// Oasis staff and doctors with specialty; filtered to the user's branches and specialties.
table Staff

	column 'Staff Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: staff_key

	column 'Branch Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Staff ID'
		dataType: string
		summarizeBy: none
		sourceColumn: staff_id

	column 'Staff Name'
		dataType: string
		summarizeBy: none
		sourceColumn: staff_name

	column 'Staff Name AR'
		dataType: string
		summarizeBy: none
		sourceColumn: staff_name_ar

	column Gender
		dataType: string
		summarizeBy: none
		sourceColumn: gender

	column Nationality
		dataType: string
		summarizeBy: none
		sourceColumn: nationality

	column 'Is Saudi'
		dataType: string
		summarizeBy: none
		sourceColumn: is_saudi

	column 'Staff Grade'
		dataType: string
		summarizeBy: none
		sourceColumn: staff_grade

	column Classification
		dataType: string
		summarizeBy: none
		sourceColumn: classification

	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	column 'Med Nonmed'
		dataType: string
		summarizeBy: none
		sourceColumn: med_nonmed

	column 'Is Consultant'
		dataType: string
		summarizeBy: none
		sourceColumn: is_consultant

	column 'Position Name'
		dataType: string
		summarizeBy: none
		sourceColumn: position_name

	column Specialty
		dataType: string
		summarizeBy: none
		sourceColumn: specialty

	column 'Unified Specialty'
		dataType: string
		summarizeBy: none
		sourceColumn: unified_specialty

	column 'Is Non Admitting Specialty'
		dataType: string
		summarizeBy: none
		sourceColumn: is_non_admitting_specialty

	column 'Is High Value Specialty'
		dataType: string
		summarizeBy: none
		sourceColumn: is_high_value_specialty

	column 'Clinic Duration Hours'
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: clinic_duration_hours

	column 'Slots Per Hour'
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: slots_per_hour

	column 'SCFHS Licence No'
		dataType: string
		summarizeBy: none
		sourceColumn: scfhs_licence_no

	column 'Contract Status'
		dataType: string
		summarizeBy: none
		sourceColumn: contract_status

	column 'Termination Date'
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: termination_date

	column 'Termination Reason'
		dataType: string
		summarizeBy: none
		sourceColumn: termination_reason

	column 'Service Start Date'
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: service_start_date

	partition Staff = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_dim_staff")
				in
				    Source

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_staff
