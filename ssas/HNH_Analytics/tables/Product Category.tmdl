/// Product categories with unified and high-level departments.
table 'Product Category'

	column 'Product Category Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: product_category_key

	column 'Branch Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Category Code'
		dataType: string
		summarizeBy: none
		sourceColumn: category_code

	column 'Product Group'
		dataType: string
		summarizeBy: none
		sourceColumn: product_group

	column 'Unified Category'
		dataType: string
		summarizeBy: none
		sourceColumn: unified_category

	column 'Product Department'
		dataType: string
		summarizeBy: none
		sourceColumn: product_department

	column 'High Level Department'
		dataType: string
		summarizeBy: none
		sourceColumn: high_level_department

	column 'Is Medication Category'
		dataType: string
		summarizeBy: none
		sourceColumn: is_medication_category

	partition 'Product Category' = query
		source
			query = select * from gold.ssas_dim_product_category
			dataSource: HNH_Gold

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_product_category
