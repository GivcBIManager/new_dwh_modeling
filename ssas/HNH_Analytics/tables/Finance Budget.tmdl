/// Monthly budget per hospital and P&L line or balance-sheet caption, from the budget file and the BI manager's overrides.
table 'Finance Budget'

	column 'Branch Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Month Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: value
		summarizeBy: none
		sourceColumn: month_date_key

	column Statement
		dataType: string
		summarizeBy: none
		sourceColumn: statement

	column 'PL Line Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: pl_line_key

	column 'PL Line Code'
		dataType: string
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: pl_line_code

	column 'BS Caption'
		dataType: string
		summarizeBy: none
		sourceColumn: bs_caption

	column Amount
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: amount

	column Source
		dataType: string
		summarizeBy: none
		sourceColumn: source

	partition 'Finance Budget' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_fact_finance_budget_monthly")
				in
				    Source

	annotation hnh_kind = fact
	annotation hnh_view = ssas_fact_finance_budget_monthly
