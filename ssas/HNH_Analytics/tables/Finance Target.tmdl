/// Yearly finance KPI targets per hospital (branch 0 = all hospitals) with the watch band.
table 'Finance Target'

	column 'KPI Code'
		dataType: string
		summarizeBy: none
		sourceColumn: kpi_code

	column 'Branch ID'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: branch_id

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	column Target
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: target_value

	column 'Watch Pct'
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: watch_pct

	partition 'Finance Target' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_dim_finance_target")
				in
				    Source

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_finance_target
