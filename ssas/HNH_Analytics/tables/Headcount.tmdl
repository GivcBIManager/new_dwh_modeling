/// Month-end headcount snapshot per employee.
table Headcount

	/// Month-end headcount of the last closed month (is_closed_month) in the selection; the projected current month is excluded. Contingent workers excluded (Phase 4 spec section 7). Snapshot: never summed over months. The last period is taken per branch, so a multi-branch total keeps every branch.
	measure Headcount =
			SUMX (
				VALUES ( Branch[Branch Key] ),
				VAR LastMonth = CALCULATE ( MAX ( Headcount[Month Date Key] ), Headcount[Is Closed Month] = "Yes" )
				RETURN
					CALCULATE (
						SUM ( Headcount[Headcount Units] ),
						Headcount[Month Date Key] = LastMonth,
						Headcount[Is Closed Month] = "Yes",
						Headcount[Is Contingent] = "No"
					)
			)
		formatString: #,0
		displayFolder: Headcount

	column 'Branch Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Employee Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: employee_key

	column 'Staff Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: staff_key

	column 'HR Department Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: hr_department_key

	column 'Job Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: job_key

	column 'Grade Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: grade_key

	column 'Position Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: position_key

	column 'Location Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: location_key

	column 'Month Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: value
		summarizeBy: none
		sourceColumn: month_date_key

	column 'Is Closed Month'
		dataType: string
		summarizeBy: none
		sourceColumn: is_closed_month

	column 'Worker Type Code'
		dataType: string
		summarizeBy: none
		sourceColumn: worker_type_code

	column 'Is Contingent'
		dataType: string
		summarizeBy: none
		sourceColumn: is_contingent

	column 'Assignment Status'
		dataType: string
		summarizeBy: none
		sourceColumn: assignment_status

	column 'Is Saudi'
		dataType: string
		summarizeBy: none
		sourceColumn: is_saudi

	column Gender
		dataType: string
		summarizeBy: none
		sourceColumn: gender

	column 'Age Band'
		dataType: string
		summarizeBy: none
		sourceColumn: age_band

	column 'Tenure Band'
		dataType: string
		summarizeBy: none
		sourceColumn: tenure_band

	column 'Headcount Units'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: headcount

	column FTE
		dataType: double
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: fte

	column 'Is New Hire In Month'
		dataType: string
		summarizeBy: none
		sourceColumn: is_new_hire_in_month

	partition Headcount = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_fact_headcount_monthly")
				in
				    Source

	annotation hnh_kind = fact
	annotation hnh_view = ssas_fact_headcount_monthly
