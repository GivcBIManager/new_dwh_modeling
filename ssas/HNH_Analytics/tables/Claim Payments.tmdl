/// Payer remittance and advances from NPHIES.
table 'Claim Payments'

	column 'Branch Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Payment Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: value
		summarizeBy: none
		sourceColumn: payment_date_key

	column 'Statement End Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: value
		summarizeBy: none
		sourceColumn: statement_end_date_key

	column 'Patient Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: patient_key

	column 'Payer Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: payer_key

	column 'Detail Type'
		dataType: string
		summarizeBy: none
		sourceColumn: detail_type

	column 'Payment Reference'
		dataType: string
		summarizeBy: none
		sourceColumn: payment_reference

	column 'Period Start'
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: period_start

	column 'Period End'
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: period_end

	column 'Payment Amount'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: payment_amount

	column 'Payment Component'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: payment_component

	column 'Early Fee'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: early_fee

	column 'NPHIES Fee'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: nphies_fee

	column 'Days To Payment'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: days_to_payment

	partition 'Claim Payments' = query
		source
			query = select * from gold.ssas_fact_claim_payment
			dataSource: HNH_Gold

	annotation hnh_kind = fact
	annotation hnh_view = ssas_fact_claim_payment
