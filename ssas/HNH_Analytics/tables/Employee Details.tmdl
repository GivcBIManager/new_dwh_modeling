/// Employee names; visible only to users with pay access, for their branches.
table 'Employee Details'

	column 'Employee Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: employee_key

	column 'Branch Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Full Name'
		dataType: string
		summarizeBy: none
		sourceColumn: full_name

	partition 'Employee Details' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_dim_employee_pii")
				in
				    Source

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_employee_pii
