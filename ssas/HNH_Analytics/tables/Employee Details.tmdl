/// Employee names and personal details (birth date, marital status, email, phone, national ID); visible only to users with pay access, for their branches.
table 'Employee Details'

	column 'Employee Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: employee_key

	column 'Branch Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Full Name'
		dataType: string
		summarizeBy: none
		sourceColumn: full_name

	column 'Marital Status'
		dataType: string
		summarizeBy: none
		sourceColumn: marital_status

	column 'Email Address'
		dataType: string
		summarizeBy: none
		sourceColumn: email_address

	column 'Phone Number'
		dataType: string
		summarizeBy: none
		sourceColumn: phone_number

	column 'National ID'
		dataType: string
		summarizeBy: none
		sourceColumn: national_id

	column 'Birth Date Key'
		dataType: int64
		isHidden
		encodingHint: value
		summarizeBy: none
		sourceColumn: birth_date_key

	partition 'Employee Details' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_dim_employee_pii")
				in
				    Source

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_employee_pii
