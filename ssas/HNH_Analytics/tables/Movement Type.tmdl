/// Stock movement types with direction and consumption flag.
table 'Movement Type'

	column 'Movement Type Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: movement_type_key

	column 'Movement Type'
		dataType: string
		summarizeBy: none
		sortByColumn: 'Sort Order'
		sourceColumn: movement_type

	column Direction
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: direction

	column 'Is Consumption'
		dataType: string
		summarizeBy: none
		sourceColumn: is_consumption

	column 'Sort Order'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: sort_order

	partition 'Movement Type' = query
		source
			query = select * from gold.ssas_dim_movement_type
			dataSource: HNH_Gold

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_movement_type
