/// Outpatient, emergency, inpatient and other care types.
table 'Care Type'

	column 'Care Type Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: care_type_key

	column 'Care Type'
		dataType: string
		summarizeBy: none
		sourceColumn: care_type

	column 'Care Type Name'
		dataType: string
		summarizeBy: none
		sourceColumn: care_type_name

	partition 'Care Type' = query
		source
			query = select * from gold.ssas_dim_care_type
			dataSource: HNH_Gold

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_care_type
