/// Suppliers from Fusion and Oasis.
table Supplier

	column 'Supplier Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: supplier_key

	column 'Vendor ID'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: vendor_id

	column 'Vendor Site ID'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: vendor_site_id

	column 'Supplier Number'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: supplier_number

	column 'Supplier Name'
		dataType: string
		summarizeBy: none
		sourceColumn: supplier_name

	column 'Supplier Type'
		dataType: string
		summarizeBy: none
		sourceColumn: supplier_type

	column 'Supplier Status'
		dataType: string
		summarizeBy: none
		sourceColumn: supplier_status

	column 'Site Code'
		dataType: string
		summarizeBy: none
		sourceColumn: site_code

	column 'Business Unit ID'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: business_unit_id

	column Country
		dataType: string
		summarizeBy: none
		sourceColumn: country

	column 'Source System'
		dataType: string
		summarizeBy: none
		sourceColumn: source_system

	column 'Supplier Code'
		dataType: string
		summarizeBy: none
		sourceColumn: supplier_code

	partition Supplier = query
		source
			query = select * from gold.ssas_dim_supplier
			dataSource: HNH_Gold

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_supplier
