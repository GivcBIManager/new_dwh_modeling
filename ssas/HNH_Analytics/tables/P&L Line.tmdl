/// Lines of the Fusion profitability report with their section and kind.
table 'P&L Line'

	column 'PL Line Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: pl_line_key

	column 'PL Line Code'
		dataType: string
		summarizeBy: none
		sourceColumn: pl_line_code

	column 'PL Line Label'
		dataType: string
		summarizeBy: none
		sortByColumn: 'PL Line Key'
		sourceColumn: pl_line_label

	column 'Section Name'
		dataType: string
		summarizeBy: none
		sortByColumn: 'Section Key'
		sourceColumn: section_name

	column 'Section Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: section_key

	column 'Line Kind'
		dataType: string
		summarizeBy: none
		sourceColumn: line_kind

	column 'Is In Fusion Report'
		dataType: string
		summarizeBy: none
		sourceColumn: is_in_fusion_report

	partition 'P&L Line' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_dim_pl_report_line")
				in
				    Source

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_pl_report_line
