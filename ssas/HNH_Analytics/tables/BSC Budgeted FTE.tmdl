/// Budgeted FTE per hospital and year (job vacancy rate).
table 'BSC Budgeted FTE'

	column 'Branch Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Year Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: value
		summarizeBy: none
		sourceColumn: year_date_key

	column 'Budgeted FTE'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: budgeted_fte

	partition 'BSC Budgeted FTE' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_fact_bsc_budgeted_fte")
				in
				    Source

	annotation hnh_kind = fact
	annotation hnh_view = ssas_fact_bsc_budgeted_fte
