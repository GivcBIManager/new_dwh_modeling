	/// Bar colour of FR Chart IS vs Budget % (the income statement's hospital comparison): favourable bar #05A591 above zero, unfavourable #DC280A below (P&L sign, R9b), muted #4D5B6B at zero or without a figure.
	measure 'FR Chart IS vs Budget Colour' =
			VAR __Value = ( -- measure body
				CALCULATE (
					VAR Change = [FR Chart IS vs Budget %]
					RETURN
						IF ( ISBLANK ( Change ), "#4D5B6B", IF ( ROUND ( Change, 3 ) > 0, "#05A591", IF ( ROUND ( Change, 3 ) < 0, "#DC280A", "#4D5B6B" ) ) ),
					REMOVEFILTERS ( 'Finance Column' )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + P&L Report | Finance Column, P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Chart IS vs Budget Colour"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report

