				& IF ( ISFILTERED ( 'Discharge Outcome' ), ", ""Discharge Outcome""" )
				& IF ( ISFILTERED ( 'ER Priority' ), ", ""ER Priority""" )
				& IF ( ISFILTERED ( 'Eligibility Type' ), ", ""Eligibility Type""" )
				& IF ( ISFILTERED ( 'Encounters' ), ", ""Encounters""" )
				& IF ( ISFILTERED ( 'Episode Billing' ), ", ""Episode Billing""" )
				& IF ( ISFILTERED ( 'Episodes' ), ", ""Episodes""" )
				& IF ( ISFILTERED ( 'FS Line' ), ", ""FS Line""" )
				& IF ( ISFILTERED ( 'Finance Budget' ), ", ""Finance Budget""" )
				& IF ( ISFILTERED ( 'Finance Column' ), ", ""Finance Column""" )
				& IF ( ISFILTERED ( 'Finance KPI' ), ", ""Finance KPI""" )
				& IF ( ISFILTERED ( 'Finance Target' ), ", ""Finance Target""" )
				& IF ( ISFILTERED ( 'GL Account' ), ", ""GL Account""" )
				& IF ( ISFILTERED ( 'GL Balances' ), ", ""GL Balances""" )
				& IF ( ISFILTERED ( 'GL FS Monthly' ), ", ""GL FS Monthly""" )
				& IF ( ISFILTERED ( 'GL Journal Lines' ), ", ""GL Journal Lines""" )
				& IF ( ISFILTERED ( 'GL Period' ), ", ""GL Period""" )
				& IF ( ISFILTERED ( 'Goods Receipts' ), ", ""Goods Receipts""" )
				& IF ( ISFILTERED ( 'HR Data Issue Records' ), ", ""HR Data Issue Records""" )
				& IF ( ISFILTERED ( 'HR Data Issues' ), ", ""HR Data Issues""" )
				& IF ( ISFILTERED ( 'HR KPI' ), ", ""HR KPI""" )
				& IF ( ISFILTERED ( 'HR Targets' ), ", ""HR Targets""" )
				& IF ( ISFILTERED ( 'Headcount' ), ", ""Headcount""" )
				& IF ( ISFILTERED ( 'Income Statement' ), ", ""Income Statement""" )
				& IF ( ISFILTERED ( 'Invoices' ), ", ""Invoices""" )
				& IF ( ISFILTERED ( 'Item' ), ", ""Item""" )
				& IF ( ISFILTERED ( 'Leave Balances' ), ", ""Leave Balances""" )
				& IF ( ISFILTERED ( 'MRP 1' ), ", ""MRP 1""" )
				& IF ( ISFILTERED ( 'MRP 2' ), ", ""MRP 2""" )
				& IF ( ISFILTERED ( 'MRP 3' ), ", ""MRP 3""" )
				& IF ( ISFILTERED ( 'Movement Type' ), ", ""Movement Type""" )
				& IF ( ISFILTERED ( 'NPHIES Reason' ), ", ""NPHIES Reason""" )
				& IF ( ISFILTERED ( 'Order Lines' ), ", ""Order Lines""" )
				& IF ( ISFILTERED ( 'Ordering Doctor' ), ", ""Ordering Doctor""" )
				& IF ( ISFILTERED ( 'P&L Line' ), ", ""P&L Line""" )
				& IF ( ISFILTERED ( 'P&L Report' ), ", ""P&L Report""" )
				& IF ( ISFILTERED ( 'Patient' ), ", ""Patient""" )
				& IF ( ISFILTERED ( 'Patient Consumption' ), ", ""Patient Consumption""" )
				& IF ( ISFILTERED ( 'Patient Details' ), ", ""Patient Details""" )
				& IF ( ISFILTERED ( 'Pay Category' ), ", ""Pay Category""" )
				& IF ( ISFILTERED ( 'Payer' ), ", ""Payer""" )
				& IF ( ISFILTERED ( 'Payroll' ), ", ""Payroll""" )
				& IF ( ISFILTERED ( 'Policy' ), ", ""Policy""" )
				& IF ( ISFILTERED ( 'Pre-auth Lines' ), ", ""Pre-auth Lines""" )
				& IF ( ISFILTERED ( 'Pre-auth Outcome' ), ", ""Pre-auth Outcome""" )
				& IF ( ISFILTERED ( 'Procedure Type' ), ", ""Procedure Type""" )
				& IF ( ISFILTERED ( 'Product Category' ), ", ""Product Category""" )
				& IF ( ISFILTERED ( 'Purchase Lines' ), ", ""Purchase Lines""" )
				& IF ( ISFILTERED ( 'Requisitions' ), ", ""Requisitions""" )
				& IF ( ISFILTERED ( 'Revenue Adjustments' ), ", ""Revenue Adjustments""" )
				& IF ( ISFILTERED ( 'Service' ), ", ""Service""" )
				& IF ( ISFILTERED ( 'Service Department' ), ", ""Service Department""" )
				& IF ( ISFILTERED ( 'Staff Productivity' ), ", ""Staff Productivity""" )
				& IF ( ISFILTERED ( 'Stock Monthly' ), ", ""Stock Monthly""" )
				& IF ( ISFILTERED ( 'Stock Movements' ), ", ""Stock Movements""" )
				& IF ( ISFILTERED ( 'Store' ), ", ""Store""" )
				& IF ( ISFILTERED ( 'Supplier' ), ", ""Supplier""" )
				& IF ( ISFILTERED ( 'Surgeries' ), ", ""Surgeries""" )
				& IF ( ISFILTERED ( 'Survey Answers' ), ", ""Survey Answers""" )
				& IF ( ISFILTERED ( 'Survey Question' ), ", ""Survey Question""" )
				& IF ( ISFILTERED ( 'Survey Responses' ), ", ""Survey Responses""" )
				& IF ( ISFILTERED ( 'Survey Service' ), ", ""Survey Service""" )
				& IF ( ISFILTERED ( 'Targets' ), ", ""Targets""" )
				& IF ( ISFILTERED ( 'Time' ), ", ""Time""" )
				& IF ( ISFILTERED ( 'Workforce Monthly' ), ", ""Workforce Monthly""" )
			RETURN MID ( __Names, 3, 4000 )
		formatString: General
		isHidden
		displayFolder: Diagnostics\Guards

	/// Filtered tables that cannot filter Workforce Monthly, as a quoted list; generated by ssas/tools/measure_guards.py (SSAS spec P41).
	measure '_Guard Workforce Monthly' =
			VAR __Names =
				IF ( ISFILTERED ( 'AP Invoice Lines' ), ", ""AP Invoice Lines""" )
				& IF ( ISFILTERED ( 'AP Open Items' ), ", ""AP Open Items""" )
				& IF ( ISFILTERED ( 'AP Payments' ), ", ""AP Payments""" )
				& IF ( ISFILTERED ( 'Absence Days' ), ", ""Absence Days""" )
				& IF ( ISFILTERED ( 'Absence Type' ), ", ""Absence Type""" )
				& IF ( ISFILTERED ( 'Absences' ), ", ""Absences""" )
				& IF ( ISFILTERED ( 'Admission Source' ), ", ""Admission Source""" )
				& IF ( ISFILTERED ( 'Admission Treating Doctor' ), ", ""Admission Treating Doctor""" )
				& IF ( ISFILTERED ( 'Admissions' ), ", ""Admissions""" )
				& IF ( ISFILTERED ( 'Anaesthetist' ), ", ""Anaesthetist""" )
				& IF ( ISFILTERED ( 'Appointment Outcome' ), ", ""Appointment Outcome""" )
				& IF ( ISFILTERED ( 'BSC AR Collections' ), ", ""BSC AR Collections""" )
				& IF ( ISFILTERED ( 'BSC Budgeted FTE' ), ", ""BSC Budgeted FTE""" )
				& IF ( ISFILTERED ( 'BSC KPI' ), ", ""BSC KPI""" )
				& IF ( ISFILTERED ( 'BSC Licensed Beds' ), ", ""BSC Licensed Beds""" )
				& IF ( ISFILTERED ( 'BSC Manual Values' ), ", ""BSC Manual Values""" )
				& IF ( ISFILTERED ( 'BSC Parameters' ), ", ""BSC Parameters""" )
				& IF ( ISFILTERED ( 'BSC Targets' ), ", ""BSC Targets""" )
				& IF ( ISFILTERED ( 'BSC Weights' ), ", ""BSC Weights""" )
				& IF ( ISFILTERED ( 'Bed' ), ", ""Bed""" )
				& IF ( ISFILTERED ( 'Bed Occupancy' ), ", ""Bed Occupancy""" )
				& IF ( ISFILTERED ( 'Booked Doctor' ), ", ""Booked Doctor""" )
				& IF ( ISFILTERED ( 'Budget' ), ", ""Budget""" )
				& IF ( ISFILTERED ( 'Budget Line' ), ", ""Budget Line""" )
				& IF ( ISFILTERED ( 'Care Type' ), ", ""Care Type""" )
				& IF ( ISFILTERED ( 'Cash Receipts' ), ", ""Cash Receipts""" )
				& IF ( ISFILTERED ( 'Charge Lines' ), ", ""Charge Lines""" )
				& IF ( ISFILTERED ( 'Charged By' ), ", ""Charged By""" )
				& IF ( ISFILTERED ( 'Claim Lines' ), ", ""Claim Lines""" )
				& IF ( ISFILTERED ( 'Claim Payments' ), ", ""Claim Payments""" )
				& IF ( ISFILTERED ( 'Claim Status' ), ", ""Claim Status""" )
				& IF ( ISFILTERED ( 'Clinic Capacity' ), ", ""Clinic Capacity""" )
				& IF ( ISFILTERED ( 'Department' ), ", ""Department""" )
				& IF ( ISFILTERED ( 'Discharge Outcome' ), ", ""Discharge Outcome""" )
				& IF ( ISFILTERED ( 'ER Priority' ), ", ""ER Priority""" )
				& IF ( ISFILTERED ( 'Eligibility Type' ), ", ""Eligibility Type""" )
				& IF ( ISFILTERED ( 'Encounters' ), ", ""Encounters""" )
				& IF ( ISFILTERED ( 'Episode Billing' ), ", ""Episode Billing""" )
				& IF ( ISFILTERED ( 'Episodes' ), ", ""Episodes""" )
				& IF ( ISFILTERED ( 'FS Line' ), ", ""FS Line""" )
				& IF ( ISFILTERED ( 'Finance Budget' ), ", ""Finance Budget""" )
				& IF ( ISFILTERED ( 'Finance Column' ), ", ""Finance Column""" )
				& IF ( ISFILTERED ( 'Finance KPI' ), ", ""Finance KPI""" )
				& IF ( ISFILTERED ( 'Finance Target' ), ", ""Finance Target""" )
				& IF ( ISFILTERED ( 'From Branch' ), ", ""From Branch""" )
				& IF ( ISFILTERED ( 'GL Account' ), ", ""GL Account""" )
				& IF ( ISFILTERED ( 'GL Balances' ), ", ""GL Balances""" )
				& IF ( ISFILTERED ( 'GL FS Monthly' ), ", ""GL FS Monthly""" )
				& IF ( ISFILTERED ( 'GL Journal Lines' ), ", ""GL Journal Lines""" )
				& IF ( ISFILTERED ( 'GL Period' ), ", ""GL Period""" )
				& IF ( ISFILTERED ( 'Goods Receipts' ), ", ""Goods Receipts""" )
				& IF ( ISFILTERED ( 'HR Data Issue Records' ), ", ""HR Data Issue Records""" )
				& IF ( ISFILTERED ( 'HR Data Issues' ), ", ""HR Data Issues""" )
				& IF ( ISFILTERED ( 'HR KPI' ), ", ""HR KPI""" )
				& IF ( ISFILTERED ( 'HR Targets' ), ", ""HR Targets""" )
				& IF ( ISFILTERED ( 'Headcount' ), ", ""Headcount""" )
				& IF ( ISFILTERED ( 'Income Statement' ), ", ""Income Statement""" )
				& IF ( ISFILTERED ( 'Invoices' ), ", ""Invoices""" )
				& IF ( ISFILTERED ( 'Item' ), ", ""Item""" )
				& IF ( ISFILTERED ( 'Leave Balances' ), ", ""Leave Balances""" )
				& IF ( ISFILTERED ( 'MRP 1' ), ", ""MRP 1""" )
				& IF ( ISFILTERED ( 'MRP 2' ), ", ""MRP 2""" )
				& IF ( ISFILTERED ( 'MRP 3' ), ", ""MRP 3""" )
