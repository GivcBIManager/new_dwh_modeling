		formatString: #,0
		isHidden
		displayFolder: Finance\Building Blocks
	/// Expected credit loss in SAR, positive (P&L line GA_ECL, sign reversed), months up to the current one.
	measure 'Fin ECL' =
			VAR __Value = ( -- measure body
				VAR Total =
					CALCULATE (
						SUM ( 'P&L Report'[Amount] ),
						'P&L Line'[PL Line Code] = "GA_ECL",
						KEEPFILTERS ( 'Date'[Date] <= TODAY () )
					)
				RETURN
					IF ( NOT ISBLANK ( Total ), -Total )
			) -- end of measure body
			VAR __Wrong = [_Guard P&L Report]
			RETURN IF ( __Wrong = "", __Value, """Fin ECL"" can't be analysed by " & __Wrong )
		formatString: #,0
		isHidden
		displayFolder: Finance\Building Blocks
	/// Operating cost in SAR, positive: net revenue plus other income minus EBITDA (everything between net revenue and EBITDA); blank when all three are blank.
	measure 'Fin Opex' =
			VAR __Value = ( -- measure body
				IF (
					NOT ISBLANK ( [Fin Net Revenue] ) || NOT ISBLANK ( [Fin Other Income] ) || NOT ISBLANK ( [Fin EBITDA] ),
					[Fin Net Revenue] + [Fin Other Income] - [Fin EBITDA]
				)
			) -- end of measure body
			VAR __Wrong = [_Guard P&L Report]
			RETURN IF ( __Wrong = "", __Value, """Fin Opex"" can't be analysed by " & __Wrong )
		formatString: #,0
		isHidden
		displayFolder: Finance\Building Blocks
	/// Trade receivables, net in SAR (debit positive). Month-end balance of the last month with data in the selection (up to the current month), taken per branch and summed over branches. Snapshot.
	measure 'Fin Trade Receivables' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR B = Branch[Branch Key]
					VAR LastMonth =
						CALCULATE (
							MAX ( 'GL FS Monthly'[Month Date Key] ),
							REMOVEFILTERS ( 'GL FS Monthly' ),
							VALUES ( 'Date'[Date] ),
							Branch[Branch Key] = B,
							KEEPFILTERS ( 'Date'[Date] <= TODAY () )
						)
					RETURN
						CALCULATE (
							SUMX ( 'GL FS Monthly', 'GL FS Monthly'[Closing Balance] * 'GL FS Monthly'[Display Sign] ),
							'GL FS Monthly'[Month Date Key] = LastMonth,
							'GL FS Monthly'[FS Caption] = "trade receivables, net"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """Fin Trade Receivables"" can't be analysed by " & __Wrong )
		formatString: #,0
		isHidden
		displayFolder: Finance\Building Blocks

		annotation hnh_snapshot = 1
