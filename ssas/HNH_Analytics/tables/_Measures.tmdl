		annotation hnh_snapshot = 1
	/// Current assets in SAR (debit positive). Month-end balance of the last month with data in the selection (up to the current month), taken per branch and summed over branches. Snapshot.
	measure 'Fin Current Assets' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR B = Branch[Branch Key]
					VAR LastMonth =
						CALCULATE (
							MAX ( 'GL FS Monthly'[Month Date Key] ),
							REMOVEFILTERS ( 'GL FS Monthly' ),
							VALUES ( 'Date'[Date] ),
							Branch[Branch Key] = B,
							KEEPFILTERS ( 'Date'[Date] <= TODAY () )
						)
					RETURN
						CALCULATE (
							SUMX ( 'GL FS Monthly', 'GL FS Monthly'[Closing Balance] * 'GL FS Monthly'[Display Sign] ),
							'GL FS Monthly'[Month Date Key] = LastMonth,
							'GL FS Monthly'[FS Category] = "current assets"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """Fin Current Assets"" can't be analysed by " & __Wrong )
		formatString: #,0
		isHidden
		displayFolder: Finance\Building Blocks

		annotation hnh_snapshot = 1
	/// Current liabilities in SAR, credit positive. Month-end balance of the last month with data in the selection (up to the current month), taken per branch and summed over branches. Snapshot.
	measure 'Fin Current Liabilities' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR B = Branch[Branch Key]
					VAR LastMonth =
						CALCULATE (
							MAX ( 'GL FS Monthly'[Month Date Key] ),
							REMOVEFILTERS ( 'GL FS Monthly' ),
							VALUES ( 'Date'[Date] ),
							Branch[Branch Key] = B,
							KEEPFILTERS ( 'Date'[Date] <= TODAY () )
						)
					RETURN
						CALCULATE (
							SUMX ( 'GL FS Monthly', 'GL FS Monthly'[Closing Balance] * 'GL FS Monthly'[Display Sign] ),
							'GL FS Monthly'[Month Date Key] = LastMonth,
							'GL FS Monthly'[FS Category] = "current liabilities"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """Fin Current Liabilities"" can't be analysed by " & __Wrong )
		formatString: #,0
		isHidden
		displayFolder: Finance\Building Blocks

		annotation hnh_snapshot = 1
	/// Total assets in SAR (debit positive). Month-end balance of the last month with data in the selection (up to the current month), taken per branch and summed over branches. Snapshot.
	measure 'Fin Total Assets' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR B = Branch[Branch Key]
					VAR LastMonth =
						CALCULATE (
							MAX ( 'GL FS Monthly'[Month Date Key] ),
							REMOVEFILTERS ( 'GL FS Monthly' ),
							VALUES ( 'Date'[Date] ),
							Branch[Branch Key] = B,
							KEEPFILTERS ( 'Date'[Date] <= TODAY () )
						)
					RETURN
						CALCULATE (
							SUMX ( 'GL FS Monthly', 'GL FS Monthly'[Closing Balance] * 'GL FS Monthly'[Display Sign] ),
							'GL FS Monthly'[Month Date Key] = LastMonth,
							'GL FS Monthly'[FS Element] = "assets"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """Fin Total Assets"" can't be analysed by " & __Wrong )
		formatString: #,0
		isHidden
		displayFolder: Finance\Building Blocks

		annotation hnh_snapshot = 1
	/// Total liabilities in SAR, credit positive. Month-end balance of the last month with data in the selection (up to the current month), taken per branch and summed over branches. Snapshot.
	measure 'Fin Total Liabilities' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR B = Branch[Branch Key]
					VAR LastMonth =
						CALCULATE (
							MAX ( 'GL FS Monthly'[Month Date Key] ),
							REMOVEFILTERS ( 'GL FS Monthly' ),
							VALUES ( 'Date'[Date] ),
							Branch[Branch Key] = B,
							KEEPFILTERS ( 'Date'[Date] <= TODAY () )
						)
					RETURN
						CALCULATE (
							SUMX ( 'GL FS Monthly', 'GL FS Monthly'[Closing Balance] * 'GL FS Monthly'[Display Sign] ),
							'GL FS Monthly'[Month Date Key] = LastMonth,
							'GL FS Monthly'[FS Element] = "liabilities"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """Fin Total Liabilities"" can't be analysed by " & __Wrong )
		formatString: #,0
		isHidden
		displayFolder: Finance\Building Blocks

		annotation hnh_snapshot = 1
	/// Lease liability in SAR, credit positive. Month-end balance of the last month with data in the selection (up to the current month), taken per branch and summed over branches. Snapshot.
	measure 'Fin Lease Liability' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR B = Branch[Branch Key]
					VAR LastMonth =
						CALCULATE (
							MAX ( 'GL FS Monthly'[Month Date Key] ),
							REMOVEFILTERS ( 'GL FS Monthly' ),
							VALUES ( 'Date'[Date] ),
							Branch[Branch Key] = B,
							KEEPFILTERS ( 'Date'[Date] <= TODAY () )
						)
					RETURN
						CALCULATE (
							SUMX ( 'GL FS Monthly', 'GL FS Monthly'[Closing Balance] * 'GL FS Monthly'[Display Sign] ),
							'GL FS Monthly'[Month Date Key] = LastMonth,
							'GL FS Monthly'[FS Caption] = "lease liability"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """Fin Lease Liability"" can't be analysed by " & __Wrong )
		formatString: #,0
		isHidden
		displayFolder: Finance\Building Blocks

		annotation hnh_snapshot = 1
	/// Days of the selection up to today (actuals stop at today, so the rest of the current month is not counted); used for days ratios such as receivable days.
	measure 'Fin Period Days' =
			COUNTROWS ( CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) ) )
		formatString: #,0
		isHidden
		displayFolder: Finance\Building Blocks
	/// Factor that turns the selection's figure into a full year: 12 divided by the number of months in the selection up to the current month; blank when there is none.
	measure 'Fin Annualise' =
			DIVIDE ( 12, COUNTROWS ( CALCULATETABLE ( VALUES ( 'Date'[Start Of Month] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) ) ) )
		formatString: 0.00
		isHidden
		displayFolder: Finance\Building Blocks
	/// Budgeted net revenue in SAR (income-statement budget line NET_REVENUE). Months up to the current one, as the actuals; blank when the total is 0.
	measure 'Fin Budget Net Revenue' =
			VAR __Value = ( -- measure body
				VAR Total =
					CALCULATE (
						SUM ( 'Finance Budget'[Amount] ),
						'Finance Budget'[Statement] = "IS",
						'P&L Line'[PL Line Code] = "NET_REVENUE",
						KEEPFILTERS ( 'Date'[Date] <= TODAY () )
					)
				RETURN
					IF ( Total <> 0, Total )  -- a total of 0 means no budget is loaded: no target, not a target of 0
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget]
			RETURN IF ( __Wrong = "", __Value, """Fin Budget Net Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		isHidden
		displayFolder: Finance\Building Blocks
	/// Budgeted direct cost in SAR, positive (line DIRECT_COST, sign reversed). Months up to the current one, as the actuals; blank when the total is 0.
	measure 'Fin Budget Direct Cost' =
			VAR __Value = ( -- measure body
				VAR Total =
					CALCULATE (
						SUM ( 'Finance Budget'[Amount] ),
						'Finance Budget'[Statement] = "IS",
						'P&L Line'[PL Line Code] = "DIRECT_COST",
						KEEPFILTERS ( 'Date'[Date] <= TODAY () )
					)
				RETURN
					IF ( Total <> 0, -Total )  -- a total of 0 means no budget is loaded: no target, not a target of 0
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget]
			RETURN IF ( __Wrong = "", __Value, """Fin Budget Direct Cost"" can't be analysed by " & __Wrong )
		formatString: #,0
		isHidden
		displayFolder: Finance\Building Blocks
	/// Budgeted general and administrative cost in SAR, positive (line GA_TOTAL, sign reversed). Months up to the current one, as the actuals; blank when the total is 0.
	measure 'Fin Budget G&A' =
			VAR __Value = ( -- measure body
				VAR Total =
					CALCULATE (
						SUM ( 'Finance Budget'[Amount] ),
						'Finance Budget'[Statement] = "IS",
						'P&L Line'[PL Line Code] = "GA_TOTAL",
						KEEPFILTERS ( 'Date'[Date] <= TODAY () )
					)
				RETURN
					IF ( Total <> 0, -Total )  -- a total of 0 means no budget is loaded: no target, not a target of 0
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget]
			RETURN IF ( __Wrong = "", __Value, """Fin Budget G&A"" can't be analysed by " & __Wrong )
		formatString: #,0
		isHidden
		displayFolder: Finance\Building Blocks
	/// Budgeted selling and marketing cost in SAR, positive (line SM, sign reversed). Months up to the current one, as the actuals; blank when the total is 0.
	measure 'Fin Budget Marketing' =
			VAR __Value = ( -- measure body
				VAR Total =
					CALCULATE (
						SUM ( 'Finance Budget'[Amount] ),
						'Finance Budget'[Statement] = "IS",
						'P&L Line'[PL Line Code] = "SM",
						KEEPFILTERS ( 'Date'[Date] <= TODAY () )
					)
				RETURN
					IF ( Total <> 0, -Total )  -- a total of 0 means no budget is loaded: no target, not a target of 0
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget]
			RETURN IF ( __Wrong = "", __Value, """Fin Budget Marketing"" can't be analysed by " & __Wrong )
		formatString: #,0
		isHidden
		displayFolder: Finance\Building Blocks
	/// Budgeted EBITDA in SAR (line EBITDA). Months up to the current one, as the actuals; blank when the total is 0.
	measure 'Fin Budget EBITDA' =
			VAR __Value = ( -- measure body
				VAR Total =
					CALCULATE (
						SUM ( 'Finance Budget'[Amount] ),
						'Finance Budget'[Statement] = "IS",
						'P&L Line'[PL Line Code] = "EBITDA",
						KEEPFILTERS ( 'Date'[Date] <= TODAY () )
					)
				RETURN
					IF ( Total <> 0, Total )  -- a total of 0 means no budget is loaded: no target, not a target of 0
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget]
			RETURN IF ( __Wrong = "", __Value, """Fin Budget EBITDA"" can't be analysed by " & __Wrong )
		formatString: #,0
		isHidden
		displayFolder: Finance\Building Blocks
	/// Budgeted net profit in SAR (line NET_PROFIT). Months up to the current one, as the actuals; blank when the total is 0.
	measure 'Fin Budget Net Profit' =
			VAR __Value = ( -- measure body
				VAR Total =
					CALCULATE (
						SUM ( 'Finance Budget'[Amount] ),
						'Finance Budget'[Statement] = "IS",
						'P&L Line'[PL Line Code] = "NET_PROFIT",
						KEEPFILTERS ( 'Date'[Date] <= TODAY () )
					)
				RETURN
					IF ( Total <> 0, Total )  -- a total of 0 means no budget is loaded: no target, not a target of 0
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget]
			RETURN IF ( __Wrong = "", __Value, """Fin Budget Net Profit"" can't be analysed by " & __Wrong )
		formatString: #,0
		isHidden
		displayFolder: Finance\Building Blocks
	/// Budgeted consumables cost in SAR, positive (line DC_CONSUMABLES, sign reversed). Months up to the current one, as the actuals; blank when the total is 0.
	measure 'Fin Budget Consumables' =
			VAR __Value = ( -- measure body
				VAR Total =
					CALCULATE (
						SUM ( 'Finance Budget'[Amount] ),
						'Finance Budget'[Statement] = "IS",
						'P&L Line'[PL Line Code] = "DC_CONSUMABLES",
						KEEPFILTERS ( 'Date'[Date] <= TODAY () )
					)
				RETURN
					IF ( Total <> 0, -Total )  -- a total of 0 means no budget is loaded: no target, not a target of 0
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget]
			RETURN IF ( __Wrong = "", __Value, """Fin Budget Consumables"" can't be analysed by " & __Wrong )
		formatString: #,0
		isHidden
		displayFolder: Finance\Building Blocks
	/// Budgeted medicines cost in SAR, positive (line DC_MEDICINES, sign reversed). Months up to the current one, as the actuals; blank when the total is 0.
	measure 'Fin Budget Medicines' =
			VAR __Value = ( -- measure body
				VAR Total =
					CALCULATE (
						SUM ( 'Finance Budget'[Amount] ),
						'Finance Budget'[Statement] = "IS",
						'P&L Line'[PL Line Code] = "DC_MEDICINES",
						KEEPFILTERS ( 'Date'[Date] <= TODAY () )
					)
				RETURN
					IF ( Total <> 0, -Total )  -- a total of 0 means no budget is loaded: no target, not a target of 0
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget]
			RETURN IF ( __Wrong = "", __Value, """Fin Budget Medicines"" can't be analysed by " & __Wrong )
		formatString: #,0
		isHidden
		displayFolder: Finance\Building Blocks
	/// Budgeted operating cost in SAR, positive: budgeted NET_REVENUE plus OTHER_INCOME minus EBITDA. Months up to the current one, as the actuals; blank when the total is 0.
	measure 'Fin Budget Opex' =
			VAR __Value = ( -- measure body
				VAR Total =
					CALCULATE (
							SUM ( 'Finance Budget'[Amount] ),
							'Finance Budget'[Statement] = "IS",
							'P&L Line'[PL Line Code] = "NET_REVENUE",
							KEEPFILTERS ( 'Date'[Date] <= TODAY () )
						)
						+ CALCULATE (
							SUM ( 'Finance Budget'[Amount] ),
							'Finance Budget'[Statement] = "IS",
							'P&L Line'[PL Line Code] = "OTHER_INCOME",
							KEEPFILTERS ( 'Date'[Date] <= TODAY () )
						)
						- CALCULATE (
							SUM ( 'Finance Budget'[Amount] ),
							'Finance Budget'[Statement] = "IS",
							'P&L Line'[PL Line Code] = "EBITDA",
							KEEPFILTERS ( 'Date'[Date] <= TODAY () )
						)
				RETURN
					IF ( Total <> 0, Total )  -- a total of 0 means no budget is loaded: no target, not a target of 0
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget]
			RETURN IF ( __Wrong = "", __Value, """Fin Budget Opex"" can't be analysed by " & __Wrong )
		formatString: #,0
		isHidden
		displayFolder: Finance\Building Blocks
	/// Income statement actual in SAR of the P&L line(s) in context, in the P&L Report's sign (revenue and profit positive, costs negative); a subtotal line is its own P&L Report row; several lines (a section, the total) add their detail and not-mapped lines. Months up to the current one.
	measure 'FR Actual' =
			VAR __Value = ( -- measure body
				VAR OneLine = HASONEVALUE ( 'P&L Line'[PL Line Key] )
				RETURN
					IF (
						OneLine,
						CALCULATE (
							SUM ( 'P&L Report'[Amount] ),
							KEEPFILTERS ( 'Date'[Date] <= TODAY () )
						),
						-- several lines (a section, the grand total): their detail and not-mapped lines, as a subtotal adds them
						CALCULATE (
							SUM ( 'P&L Report'[Amount] ),
							KEEPFILTERS ( 'Date'[Date] <= TODAY () ),
							KEEPFILTERS ( 'P&L Line'[Line Kind] <> "subtotal" )
						)
					)
			) -- end of measure body
			VAR __Wrong = [_Guard P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Actual"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report
	/// FR Actual of the same months last year; in the current year only the months up to today are shifted, so a year to date compares with the same months last year. All hospitals in context.
	measure 'FR Last Year' =
			VAR __Value = ( -- measure body
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				RETURN
					CALCULATE ( [FR Actual], SAMEPERIODLASTYEAR ( Past ) )
			) -- end of measure body
			VAR __Wrong = [_Guard P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Last Year"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report
	/// The P&L line whose budget the FR budget measures compare: the line in context; with several lines of one section, that section's own subtotal line (Revenue: REV_TOTAL, Direct Cost: DIRECT_COST); blank for a section without a subtotal line or several sections (ruling R9e).
	measure 'FR Budget Line Key' =
			IF (
				HASONEVALUE ( 'P&L Line'[PL Line Key] ),
				VALUES ( 'P&L Line'[PL Line Key] ),
				-- several lines of one section: that section's own subtotal line; a section without one, or several sections: blank
				VAR Section = SELECTEDVALUE ( 'P&L Line'[Section Name] )
				RETURN
					IF (
						NOT ISBLANK ( Section ),
						CALCULATE (
							MAX ( 'P&L Line'[PL Line Key] ),
							REMOVEFILTERS ( 'P&L Line' ),
							'P&L Line'[Section Name] = Section,
							'P&L Line'[Line Kind] = "subtotal"
						)
					)
			)
		formatString: 0
		isHidden
		displayFolder: Finance\Report

	/// Budget in SAR (Finance Budget income-statement rows, P&L sign) of the line FR Budget Line Key names: the line in context, or the subtotal line of the one section in context; blank for several sections. Months up to the current one (ruling R2); only hospital-months with a budget row add up, so several hospitals give the budgeted ones (like-for-like). Blank below line level (caption, account).
	measure 'FR Budget' =
			VAR __Value = ( -- measure body
				VAR LineKey = [FR Budget Line Key]
				RETURN
					-- the budget has no caption or account grain
					IF (
						NOT ISBLANK ( LineKey ) && NOT ISFILTERED ( 'P&L Report' ),
						CALCULATE (
							SUM ( 'Finance Budget'[Amount] ),
							'Finance Budget'[Statement] = "IS",
							REMOVEFILTERS ( 'P&L Line' ),
							'P&L Line'[PL Line Key] = LineKey,
							KEEPFILTERS ( 'Date'[Date] <= TODAY () )
						)
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + P&L Report | P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Budget"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report

		annotation hnh_guard_allow = P&L Report
	/// FR Actual of the line FR Budget Line Key names over exactly the hospital-months that have a FR Budget row for it, so a hospital or month without a budget leaves both sides of the comparison (like-for-like). Blank below line level and for several sections.
	measure 'FR Actual (Budgeted)' =
			VAR __Value = ( -- measure body
				VAR LineKey = [FR Budget Line Key]
				VAR BudgetCells =
					CALCULATETABLE (
						SUMMARIZE ( 'Finance Budget', 'Finance Budget'[Branch Key], 'Finance Budget'[Month Date Key], 'Finance Budget'[PL Line Key] ),
						'Finance Budget'[Statement] = "IS",
						REMOVEFILTERS ( 'P&L Line' ),
						'P&L Line'[PL Line Key] = LineKey,
						KEEPFILTERS ( 'Date'[Date] <= TODAY () )
					)
				RETURN
					IF (
						NOT ISBLANK ( LineKey ) && NOT ISFILTERED ( 'P&L Report' ) && NOT ISEMPTY ( BudgetCells ),
						CALCULATE (
							[FR Actual],
							REMOVEFILTERS ( 'P&L Line' ),
							'P&L Line'[PL Line Key] = LineKey,
							TREATAS ( BudgetCells, 'P&L Report'[Branch Key], 'P&L Report'[Month Date Key], 'P&L Report'[PL Line Key] )
						)
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + P&L Report | P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Actual (Budgeted)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report

		annotation hnh_guard_allow = P&L Report
	/// FR Actual (Budgeted) minus FR Budget in SAR; in the P&L sign a positive variance is favourable on every line (more revenue, less cost). Blank without a budget.
	measure 'FR Budget Variance' =
			VAR __Value = ( -- measure body
				VAR BudgetAmount = [FR Budget]
				RETURN
					IF ( NOT ISBLANK ( BudgetAmount ), [FR Actual (Budgeted)] - BudgetAmount )
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + P&L Report | P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Budget Variance"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report

		annotation hnh_guard_allow = P&L Report
	/// FR Budget Variance divided by the absolute budget, so a positive figure is favourable on every line; blank without a budget or with a budget of 0.
	measure 'FR Budget Variance %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [FR Budget Variance], ABS ( [FR Budget] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + P&L Report | P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Budget Variance %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Finance\Report

		annotation hnh_guard_allow = P&L Report
	/// FR Actual (Budgeted) as a share of FR Budget (both in the P&L sign, so a cost line above 100 % is an overrun: read with FR Favourable); blank without a budget.
	measure 'FR Achievement %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [FR Actual (Budgeted)], [FR Budget] )
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + P&L Report | P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Achievement %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Finance\Report

		annotation hnh_guard_allow = P&L Report
	/// FR Actual against FR Last Year, divided by the absolute last-year figure, so a positive figure is favourable on every line; blank when either is blank. All hospitals in context.
	measure 'FR Growth %' =
			VAR __Value = ( -- measure body
				VAR Actual = [FR Actual]
				VAR LastYear = [FR Last Year]
				RETURN
					IF ( NOT ISBLANK ( Actual ) && NOT ISBLANK ( LastYear ), DIVIDE ( Actual - LastYear, ABS ( LastYear ) ) )
			) -- end of measure body
			VAR __Wrong = [_Guard P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Growth %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Finance\Report
	/// FR Actual as a share of net revenue (Fin Net Revenue) of the same hospitals and months, whatever the line, caption or account in context.
	measure 'FR % of Revenue' =
			VAR __Value = ( -- measure body
				VAR Revenue =
					CALCULATE (
						[Fin Net Revenue],
						REMOVEFILTERS ( 'P&L Line' ),
						REMOVEFILTERS ( 'P&L Report'[FS Category], 'P&L Report'[FS Caption], 'P&L Report'[FS Line], 'P&L Report'[Account Code], 'P&L Report'[Account Name], 'P&L Report'[FS Caption Name] )
					)
				RETURN
					DIVIDE ( [FR Actual], Revenue )
			) -- end of measure body
			VAR __Wrong = [_Guard P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR % of Revenue"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Finance\Report
	/// Placeholder text of a budget cell for the line FR Budget Line Key names: "Not budgeted" when it has no budget line (unlinked, or a subtotal of unlinked sections such as REV_TOTAL) and no budget row in context (no override entered), "No budget yet" when the budget is blank otherwise, else empty. Empty below line level and for several sections.
	measure 'FR Budget Label' =
			VAR __Value = ( -- measure body
				VAR LineKey = [FR Budget Line Key]
				VAR Kind = CALCULATE ( SELECTEDVALUE ( 'P&L Line'[Budget Kind] ), REMOVEFILTERS ( 'P&L Line' ), 'P&L Line'[PL Line Key] = LineKey )
				VAR LinkCode = CALCULATE ( SELECTEDVALUE ( 'P&L Line'[Budget Line Code] ), REMOVEFILTERS ( 'P&L Line' ), 'P&L Line'[PL Line Key] = LineKey )
				VAR Unlinked = Kind = "unlinked" || ( Kind = "subtotal" && LinkCode = "" )
				VAR BudgetRows =
					CALCULATE (
						COUNTROWS ( 'Finance Budget' ),
						'Finance Budget'[Statement] = "IS",
						REMOVEFILTERS ( 'P&L Line' ),
						'P&L Line'[PL Line Key] = LineKey,
						KEEPFILTERS ( 'Date'[Date] <= TODAY () )
					)
				RETURN
					SWITCH (
						TRUE (),
						ISBLANK ( LineKey ) || ISFILTERED ( 'P&L Report' ), "",
						Unlinked && ISBLANK ( BudgetRows ), "Not budgeted",
						ISBLANK ( [FR Budget] ), "No budget yet",
						""
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + P&L Report | P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Budget Label"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = P&L Report
	/// Wording of the budget comparison: "vs budget (budgeted hospitals)" when a hospital in context has actuals but no budget for the lines and months in context (and another has one), else "vs budget".
	measure 'FR Budget Basis Label' =
			VAR __Value = ( -- measure body
				VAR WithActual = CALCULATETABLE ( VALUES ( 'P&L Report'[Branch Key] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				VAR WithBudget = CALCULATETABLE ( VALUES ( 'Finance Budget'[Branch Key] ), 'Finance Budget'[Statement] = "IS", KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				RETURN
					IF (
						NOT ISEMPTY ( WithBudget ) && NOT ISEMPTY ( EXCEPT ( WithActual, WithBudget ) ),
						"vs budget (budgeted hospitals)",
						"vs budget"
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + P&L Report | P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Budget Basis Label"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = P&L Report
	/// Nature of the P&L line in context: 1 when a larger figure is better (revenue, other income, OCI, profit subtotals), -1 when a smaller one is (costs and discounts, shown negative, so an achievement above 100 % is an overrun), 0 for not-mapped lines or several lines. In the P&L sign a positive variance or growth is favourable on every line.
	measure 'FR Favourable' =
			VAR Code = SELECTEDVALUE ( 'P&L Line'[PL Line Code] )
			VAR Section = SELECTEDVALUE ( 'P&L Line'[Section Name] )
			RETURN
				SWITCH (
					TRUE (),
					ISBLANK ( Code ) || SELECTEDVALUE ( 'P&L Line'[Line Kind] ) = "not_mapped", 0,
					Section IN { "Revenue", "Net Revenue", "Gross Profit", "Other Income", "EBITDA", "Net Profit / (Loss)", "OCI", "Total Comprehensive Income" }, 1,
					-1
				)
		formatString: 0
		displayFolder: Finance\Report
	/// Trial balance opening balance in SAR (debit positive) of the first month in context, taken per hospital (its first month with GL rows, up to the current month) and summed.
	measure 'FR GL Opening' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR B = Branch[Branch Key]
					VAR FirstMonth =
						CALCULATE (
							MIN ( 'GL FS Monthly'[Month Date Key] ),
							REMOVEFILTERS ( 'GL FS Monthly' ),
							VALUES ( 'Date'[Date] ),
							Branch[Branch Key] = B,
							KEEPFILTERS ( 'Date'[Date] <= TODAY () )
						)
					RETURN
						CALCULATE ( SUM ( 'GL FS Monthly'[Opening Balance] ), 'GL FS Monthly'[Month Date Key] = FirstMonth )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR GL Opening"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report
	/// Opening-balance journals in SAR (debit positive) of the months in context up to the current one: Oasis January brought-forward entries and Fusion go-live loads.
	measure 'FR GL Opening Journals' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'GL FS Monthly'[Opening Journal Amount] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR GL Opening Journals"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report
	/// Debits in SAR of the months in context up to the current one, opening journals excluded.
	measure 'FR GL Debit' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'GL FS Monthly'[Debit] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR GL Debit"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report
	/// Credits in SAR (positive) of the months in context up to the current one, opening journals excluded; the trial balance shows them in brackets.
	measure 'FR GL Credit' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'GL FS Monthly'[Credit] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR GL Credit"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report
	/// Net movement in SAR (debits minus credits, debit positive, opening journals excluded) of the months in context up to the current one.
	measure 'FR GL Net Movement' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'GL FS Monthly'[Movement] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR GL Net Movement"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report
	/// Trial balance closing balance in SAR (debit positive) of the last month in context, taken per hospital (its last month with GL rows, up to the current month) and summed. Snapshot.
	measure 'FR GL Closing' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR B = Branch[Branch Key]
					VAR LastMonth =
						CALCULATE (
							MAX ( 'GL FS Monthly'[Month Date Key] ),
							REMOVEFILTERS ( 'GL FS Monthly' ),
							VALUES ( 'Date'[Date] ),
							Branch[Branch Key] = B,
							KEEPFILTERS ( 'Date'[Date] <= TODAY () )
						)
					RETURN
						CALCULATE ( SUM ( 'GL FS Monthly'[Closing Balance] ), 'GL FS Monthly'[Month Date Key] = LastMonth )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR GL Closing"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report

		annotation hnh_snapshot = 1
	/// Closing minus opening, opening journals and debits plus credits, in SAR: zero within one ledger; over a range that crosses a hospital's Oasis-to-Fusion cutover it shows the gap the two ledgers leave. Blank when below SAR 1.
	measure 'FR GL Cutover Difference' =
			VAR __Value = ( -- measure body
				VAR Gap = [FR GL Closing] - [FR GL Opening] - [FR GL Opening Journals] - [FR GL Debit] + [FR GL Credit]
				RETURN
					IF ( ABS ( Gap ) >= 1, Gap )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR GL Cutover Difference"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report
	/// FR GL Closing at the same point last year (the months in context shifted a year, those after today left out first), debit positive. Snapshot.
	measure 'FR GL Closing Last Year' =
			VAR __Value = ( -- measure body
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				RETURN
					CALCULATE ( [FR GL Closing], SAMEPERIODLASTYEAR ( Past ) )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR GL Closing Last Year"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report

		annotation hnh_snapshot = 1
	/// Balance sheet month-end balance in SAR in the display sign (assets debit positive, liabilities and equity credit positive) of the last month in context per hospital, summed. Current year profit is not the income statement accounts' GL balance but the year-to-date total comprehensive income of the P&L Report (line TOTAL_COMPREHENSIVE_INCOME, net profit plus OCI, January to that month), so it ties to the income statement and OCI closes into it (ruling R9f); its accounts show no balance. Snapshot.
	measure 'FR BS Balance' =
			VAR __Value = ( -- measure body
				VAR ShowProfit =
					-- the Current year profit caption is in context, above account level (its accounts are not shown by their GL balance)
					NOT ISFILTERED ( 'GL FS Monthly'[Account Name] ) && NOT ISFILTERED ( 'GL FS Monthly'[Account Code] )
						&& NOT ISFILTERED ( 'GL FS Monthly'[FS Line] ) && NOT ISFILTERED ( 'GL FS Monthly'[FS Caption] )
						&& NOT ISFILTERED ( 'GL FS Monthly'[FS Caption Name] ) && NOT ISFILTERED ( 'GL FS Monthly'[FS Category] )
						&& NOT ISFILTERED ( 'GL FS Monthly'[FS Category Name] ) && NOT ISFILTERED ( 'GL FS Monthly'[FS Element] )
						&& NOT ISFILTERED ( 'GL FS Monthly'[FS Element Name] )
						&& "Current year profit" IN CALCULATETABLE ( VALUES ( 'GL FS Monthly'[BS Caption] ), REMOVEFILTERS ( 'Date' ), REMOVEFILTERS ( Branch ) )
				RETURN
					SUMX (
						VALUES ( Branch[Branch Key] ),
						VAR B = Branch[Branch Key]
						VAR LastMonth =
							CALCULATE (
								MAX ( 'GL FS Monthly'[Month Date Key] ),
								REMOVEFILTERS ( 'GL FS Monthly' ),
								VALUES ( 'Date'[Date] ),
								Branch[Branch Key] = B,
								KEEPFILTERS ( 'Date'[Date] <= TODAY () )
							)
						VAR Balance =
							CALCULATE (
								SUMX ( 'GL FS Monthly', 'GL FS Monthly'[Closing Balance] * 'GL FS Monthly'[Display Sign] ),
								'GL FS Monthly'[Month Date Key] = LastMonth,
								KEEPFILTERS ( 'GL FS Monthly'[BS Caption] <> "Current year profit" )
							)
						VAR Profit =
							IF (
								ShowProfit && NOT ISBLANK ( LastMonth ),
								VAR MonthStart = DATE ( QUOTIENT ( LastMonth, 10000 ), MOD ( QUOTIENT ( LastMonth, 100 ), 100 ), 1 )
								RETURN
									CALCULATE (
										SUM ( 'P&L Report'[Amount] ),
										'P&L Line'[PL Line Code] = "TOTAL_COMPREHENSIVE_INCOME",
										KEEPFILTERS ( 'Date'[Date] <= TODAY () ),
										REMOVEFILTERS ( 'GL FS Monthly' ),
										Branch[Branch Key] = B,
										DATESBETWEEN ( 'Date'[Date], DATE ( YEAR ( MonthStart ), 1, 1 ), EOMONTH ( MonthStart, 0 ) )
									)
							)
						RETURN
							Balance + Profit
					)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly + P&L Report | GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR BS Balance"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report

		annotation hnh_snapshot = 1
		annotation hnh_guard_allow = GL FS Monthly
	/// What stops the balance sheet balancing, in SAR: assets minus liabilities and equity minus current year profit (the year-to-date total comprehensive income, as FR BS Balance) at the last month in context per hospital, whatever balance sheet row is in context. Not mapped balances and a cutover gap show here; blank when below SAR 1. Snapshot.
	measure 'FR BS Difference' =
			VAR __Value = ( -- measure body
				VAR Gap =
					SUMX (
						VALUES ( Branch[Branch Key] ),
						VAR B = Branch[Branch Key]
						VAR LastMonth =
							CALCULATE (
								MAX ( 'GL FS Monthly'[Month Date Key] ),
								REMOVEFILTERS ( 'GL FS Monthly' ),
								VALUES ( 'Date'[Date] ),
								Branch[Branch Key] = B,
								KEEPFILTERS ( 'Date'[Date] <= TODAY () )
							)
						-- debit-positive closing: assets minus credit-positive liabilities and equity is their plain sum
						VAR Sides =
							CALCULATE (
								SUM ( 'GL FS Monthly'[Closing Balance] ),
								REMOVEFILTERS ( 'GL FS Monthly' ),
								Branch[Branch Key] = B,
								'GL FS Monthly'[Month Date Key] = LastMonth,
								'GL FS Monthly'[BS Side] IN { "Assets", "Liabilities & equity" },
								'GL FS Monthly'[BS Caption] <> "Current year profit"
							)
						VAR Profit =
							IF (
								NOT ISBLANK ( LastMonth ),
								VAR MonthStart = DATE ( QUOTIENT ( LastMonth, 10000 ), MOD ( QUOTIENT ( LastMonth, 100 ), 100 ), 1 )
								RETURN
									CALCULATE (
										SUM ( 'P&L Report'[Amount] ),
										'P&L Line'[PL Line Code] = "TOTAL_COMPREHENSIVE_INCOME",
										KEEPFILTERS ( 'Date'[Date] <= TODAY () ),
										REMOVEFILTERS ( 'GL FS Monthly' ),
										Branch[Branch Key] = B,
										DATESBETWEEN ( 'Date'[Date], DATE ( YEAR ( MonthStart ), 1, 1 ), EOMONTH ( MonthStart, 0 ) )
									)
							)
						RETURN
							Sides - Profit
					)
				RETURN
					IF ( ABS ( Gap ) >= 1, Gap )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly + P&L Report | GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR BS Difference"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report

		annotation hnh_snapshot = 1
		annotation hnh_guard_allow = GL FS Monthly
	/// Balance sheet budget in SAR (display sign) at the month FR BS Balance shows per hospital: Finance Budget BS rows of the FS captions in context, summed over captions, categories and sides; Current year profit takes the year-to-date budgeted total comprehensive income (each month the TOTAL_COMPREHENSIVE_INCOME budget when it comes from the budget or an override, else the NET_PROFIT budget). Blank at account level and when no budget is entered. Snapshot.
	measure 'FR BS Budget' =
			VAR __Value = ( -- measure body
				VAR AccountLevel = ISFILTERED ( 'GL FS Monthly'[Account Name] ) || ISFILTERED ( 'GL FS Monthly'[Account Code] )
				VAR Captions = CALCULATETABLE ( VALUES ( 'GL FS Monthly'[FS Caption] ), KEEPFILTERS ( 'GL FS Monthly'[BS Caption] <> "Current year profit" ) )
				VAR ShowProfit =
					-- the Current year profit caption is in context, above account level (its accounts are not shown by their GL balance)
					NOT ISFILTERED ( 'GL FS Monthly'[Account Name] ) && NOT ISFILTERED ( 'GL FS Monthly'[Account Code] )
						&& NOT ISFILTERED ( 'GL FS Monthly'[FS Line] ) && NOT ISFILTERED ( 'GL FS Monthly'[FS Caption] )
						&& NOT ISFILTERED ( 'GL FS Monthly'[FS Caption Name] ) && NOT ISFILTERED ( 'GL FS Monthly'[FS Category] )
						&& NOT ISFILTERED ( 'GL FS Monthly'[FS Category Name] ) && NOT ISFILTERED ( 'GL FS Monthly'[FS Element] )
						&& NOT ISFILTERED ( 'GL FS Monthly'[FS Element Name] )
						&& "Current year profit" IN CALCULATETABLE ( VALUES ( 'GL FS Monthly'[BS Caption] ), REMOVEFILTERS ( 'Date' ), REMOVEFILTERS ( Branch ) )
				RETURN
					IF (
						NOT AccountLevel,
						SUMX (
							VALUES ( Branch[Branch Key] ),
							VAR B = Branch[Branch Key]
							VAR LastMonth =
								CALCULATE (
									MAX ( 'GL FS Monthly'[Month Date Key] ),
									REMOVEFILTERS ( 'GL FS Monthly' ),
									VALUES ( 'Date'[Date] ),
									Branch[Branch Key] = B,
									KEEPFILTERS ( 'Date'[Date] <= TODAY () )
								)
							VAR Lines =
								CALCULATE (
									SUM ( 'Finance Budget'[Amount] ),
									'Finance Budget'[Statement] = "BS",
									'Finance Budget'[Month Date Key] = LastMonth,
									TREATAS ( Captions, 'Finance Budget'[BS Caption] )
								)
							VAR Profit =
								IF (
									ShowProfit && NOT ISBLANK ( LastMonth ),
									VAR MonthStart = DATE ( QUOTIENT ( LastMonth, 10000 ), MOD ( QUOTIENT ( LastMonth, 100 ), 100 ), 1 )
									RETURN
										CALCULATE (
											SUMX (
												VALUES ( 'Date'[Start Of Month] ),
												VAR Tci =
													CALCULATE (
														SUM ( 'Finance Budget'[Amount] ),
														'Finance Budget'[Statement] = "IS",
														'P&L Line'[PL Line Code] = "TOTAL_COMPREHENSIVE_INCOME",
														'Finance Budget'[Source] <> "rollup"
													)
												RETURN
													-- a rolled-up TCI misses the budget held on linked subtotals (revenue): take the net profit budget instead
													IF (
														NOT ISBLANK ( Tci ),
														Tci,
														CALCULATE ( SUM ( 'Finance Budget'[Amount] ), 'Finance Budget'[Statement] = "IS", 'P&L Line'[PL Line Code] = "NET_PROFIT" )
													)
											),
											KEEPFILTERS ( 'Date'[Date] <= TODAY () ),
											REMOVEFILTERS ( 'GL FS Monthly' ),
											Branch[Branch Key] = B,
											DATESBETWEEN ( 'Date'[Date], DATE ( YEAR ( MonthStart ), 1, 1 ), EOMONTH ( MonthStart, 0 ) )
										)
								)
							RETURN
								Lines + Profit
						)
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + GL FS Monthly | GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR BS Budget"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report

		annotation hnh_snapshot = 1
		annotation hnh_guard_allow = GL FS Monthly
	/// Placeholder text of a balance sheet budget cell: "No budget yet" when FR BS Budget is blank, else empty; empty at account level (the budget is by caption).
	measure 'FR BS Budget Label' =
			VAR __Value = ( -- measure body
				IF (
					ISFILTERED ( 'GL FS Monthly'[Account Name] ) || ISFILTERED ( 'GL FS Monthly'[Account Code] ),
					"",
					IF ( ISBLANK ( [FR BS Budget] ), "No budget yet", "" )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + GL FS Monthly | GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR BS Budget Label"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = GL FS Monthly
	/// FR BS Balance as a share of total assets (Fin Total Assets) of the same hospitals and month, whatever balance sheet row is in context. Snapshot.
	measure 'FR % of Assets' =
			VAR __Value = ( -- measure body
				VAR Assets =
					CALCULATE ( [Fin Total Assets], REMOVEFILTERS ( 'GL FS Monthly' ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ) )
				RETURN
					DIVIDE ( [FR BS Balance], Assets )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly + P&L Report | GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR % of Assets"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Finance\Report

		annotation hnh_snapshot = 1
		annotation hnh_guard_allow = GL FS Monthly
	/// FR BS Balance at the same point last year (display sign): the months in context shifted a year, those after today left out first, then each hospital's last month; Current year profit is last year's total comprehensive income January to that month. Snapshot.
	measure 'FR BS Last Year' =
			VAR __Value = ( -- measure body
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				RETURN
					CALCULATE ( [FR BS Balance], SAMEPERIODLASTYEAR ( Past ) )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly + P&L Report | GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR BS Last Year"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report

		annotation hnh_snapshot = 1
		annotation hnh_guard_allow = GL FS Monthly
	/// Like-for-like twin of FR BS Budget: FR BS Balance (display sign, each hospital's last month in context) added up only over the hospital and balance sheet caption pairs that have a FR BS Budget, so with FR BS Budget it gives the balance sheet vs-budget figures. Blank at account level and while no budget is entered. Snapshot.
	measure 'FR BS Balance (Budgeted)' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					SUMX (
						CALCULATETABLE ( VALUES ( 'GL FS Monthly'[BS Caption] ) ),
						CALCULATE ( IF ( NOT ISBLANK ( [FR BS Budget] ), [FR BS Balance] ) )
					)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + GL FS Monthly + P&L Report | GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR BS Balance (Budgeted)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report

		annotation hnh_snapshot = 1
		annotation hnh_guard_allow = GL FS Monthly
	/// Debits in SAR of the whole ledger of the hospitals and months in context, up to the current one, opening journals excluded; a trial balance row in context does not narrow it (tile).
	measure 'FR Period Debits' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'GL FS Monthly'[Debit] ),
					REMOVEFILTERS ( 'GL FS Monthly' ),
					VALUES ( 'Date'[Date] ),
					VALUES ( Branch[Branch Key] ),
					KEEPFILTERS ( 'Date'[Date] <= TODAY () )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR Period Debits"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report
	/// Credits in SAR (positive) of the whole ledger of the hospitals and months in context, up to the current one, opening journals excluded; a trial balance row in context does not narrow it (tile).
	measure 'FR Period Credits' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'GL FS Monthly'[Credit] ),
					REMOVEFILTERS ( 'GL FS Monthly' ),
					VALUES ( 'Date'[Date] ),
					VALUES ( Branch[Branch Key] ),
					KEEPFILTERS ( 'Date'[Date] <= TODAY () )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR Period Credits"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report
	/// FR Period Debits minus FR Period Credits in SAR: 0 when the ledger of the selection balances (tile).
	measure 'FR Out of Balance' =
			VAR __Value = ( -- measure body
				VAR Debits = [FR Period Debits]
				VAR Credits = [FR Period Credits]
				RETURN
					IF ( NOT ISBLANK ( Debits ) || NOT ISBLANK ( Credits ), Debits - Credits )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR Out of Balance"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report
	/// Current assets minus current liabilities in SAR (Fin Current Assets - Fin Current Liabilities) at the last month in context per hospital. Snapshot.
	measure 'FR Net Working Capital' =
			VAR __Value = ( -- measure body
				VAR Assets = [Fin Current Assets]
				VAR Liabilities = [Fin Current Liabilities]
				RETURN
					IF ( NOT ISBLANK ( Assets ) || NOT ISBLANK ( Liabilities ), Assets - Liabilities )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR Net Working Capital"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report

		annotation hnh_snapshot = 1
	/// Balance sheet budget (FR BS Budget, display sign) of the trial balance rows in debit-positive sign: assets as they are, liabilities and equity negated, added up over the balance sheet sides in context; trial balance accounts that are not on the balance sheet have none. Blank when no budget is entered. Snapshot.
	measure 'FR TB Budget' =
			VAR __Value = ( -- measure body
				SUMX (
					FILTER ( VALUES ( 'GL FS Monthly'[BS Side] ), 'GL FS Monthly'[BS Side] IN { "Assets", "Liabilities & equity" } ),
					IF ( 'GL FS Monthly'[BS Side] = "Assets", 1, -1 ) * CALCULATE ( [FR BS Budget] )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + GL FS Monthly | GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR TB Budget"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report

		annotation hnh_snapshot = 1
		annotation hnh_guard_allow = GL FS Monthly
	/// FR BS Balance (Budgeted) in the trial balance's debit-positive sign, over the balance sheet sides in context: the closing balance of the hospital and caption pairs that have a FR TB Budget, so with FR TB Budget it gives the trial balance vs-budget figures. Snapshot.
	measure 'FR TB Balance (Budgeted)' =
			VAR __Value = ( -- measure body
				SUMX (
					FILTER ( VALUES ( 'GL FS Monthly'[BS Side] ), 'GL FS Monthly'[BS Side] IN { "Assets", "Liabilities & equity" } ),
					IF ( 'GL FS Monthly'[BS Side] = "Assets", 1, -1 ) * CALCULATE ( [FR BS Balance (Budgeted)] )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + GL FS Monthly + P&L Report | GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR TB Balance (Budgeted)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report

		annotation hnh_snapshot = 1
		annotation hnh_guard_allow = GL FS Monthly
	/// Income statement matrix cell, text in SAR thousands (or a percentage), for the column of 'Finance Column' in context: a month column shows that month's FR Actual and is blank when the month is not among those picked or lies after today; budget, variance, variance %, last year, growth, % of revenue and achievement come from the FR measures; a budget cell without a budget reads the FR Budget Label placeholder ('Not budgeted' / 'No budget yet') on a row that has figures. Blank when every component is blank, so empty rows drop.
	measure 'FR IS Cell' =
			VAR __Value = ( -- measure body
				VAR Kind = SELECTEDVALUE ( 'Finance Column'[Kind] )
				VAR MonthNum = SELECTEDVALUE ( 'Finance Column'[Month Num] )
				RETURN
					-- the figures below are read without the Finance Column filter, which only chooses the figure
					CALCULATE (
						VAR Amount =
							SWITCH (
								Kind,
								"month", IF ( MonthNum IN VALUES ( 'Date'[Month] ), CALCULATE ( [FR Actual], 'Date'[Month] = MonthNum ) ),
								"actual", [FR Actual],
								"budget", [FR Budget],
								"variance", [FR Budget Variance],
								"ly", [FR Last Year]
							)
						VAR Arrow = SWITCH ( Kind, "var_pct", [FR Budget Variance %], "growth", [FR Growth %] )
						VAR Plain = SWITCH ( Kind, "pct_rev", [FR % of Revenue], "ach", [FR Achievement %] )
						VAR Label =
							IF (
								Kind IN { "budget", "variance", "var_pct", "ach" } && ISBLANK ( Amount ) && ISBLANK ( Arrow ) && ISBLANK ( Plain )
									&& ( NOT ISBLANK ( [FR Actual] ) || NOT ISBLANK ( [FR Last Year] ) ),
								[FR Budget Label]
							)
						RETURN
							SWITCH (
								TRUE (),
								Kind IN { "month", "actual", "budget", "variance", "ly" }, IF ( ISBLANK ( Amount ), IF ( Label <> "", Label ), IF ( ISBLANK ( Amount ), BLANK (), FORMAT ( Amount / 1000, "#,0;(#,0);–" ) ) ),
								Kind IN { "var_pct", "growth" }, IF ( ISBLANK ( Arrow ), IF ( Label <> "", Label ), IF ( ISBLANK ( Arrow ), BLANK (), IF ( ABS ( Arrow ) > 9.99, "n/m", IF ( ABS ( Arrow ) < 0.0005, "0.0%", FORMAT ( Arrow, "▲ 0.0%;▼ 0.0%" ) ) ) ) ),
								Kind IN { "pct_rev", "ach" }, IF ( ISBLANK ( Plain ), IF ( Label <> "", Label ), IF ( ISBLANK ( Plain ), BLANK (), IF ( ABS ( Plain ) > 9.99, "n/m", FORMAT ( Plain, "0.0%" ) ) ) )
							),
						REMOVEFILTERS ( 'Finance Column' )
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + P&L Report | Finance Column, P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR IS Cell"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = Finance Column, P&L Report
	/// Trial balance matrix cell, text in SAR thousands (credits in brackets) or a percentage, for the column of 'Finance Column' in context: opening, opening journals, debit, credit, closing, cutover difference, net movement of a month column (blank when the month is not picked or lies after today), last year, growth, budget, vs budget and achievement (closing against budget); empty opening journals and cutover columns are blank; blank when every component is blank, so empty rows drop.
	measure 'FR TB Cell' =
			VAR __Value = ( -- measure body
				VAR Kind = SELECTEDVALUE ( 'Finance Column'[Kind] )
				VAR MonthNum = SELECTEDVALUE ( 'Finance Column'[Month Num] )
				RETURN
					CALCULATE (
						VAR Closing = [FR GL Closing]
						VAR Credit = [FR GL Credit]
						VAR Journals = [FR GL Opening Journals]
						VAR Amount =
							SWITCH (
								Kind,
								"opening", [FR GL Opening],
								"opening_journal", IF ( Journals <> 0, Journals ),
								"debit", [FR GL Debit],
								"credit", IF ( NOT ISBLANK ( Credit ), -Credit ),
								"closing", Closing,
								"cutover", [FR GL Cutover Difference],
								"month", IF ( MonthNum IN VALUES ( 'Date'[Month] ), CALCULATE ( [FR GL Net Movement], 'Date'[Month] = MonthNum ) ),
								"ly", [FR GL Closing Last Year],
								"budget", [FR TB Budget]
							)
						VAR LastYear = IF ( Kind = "growth", [FR GL Closing Last Year] )
						VAR BudgetFig = IF ( Kind IN { "vs_bud", "ach" }, [FR TB Budget] )
						VAR Budgeted = IF ( Kind IN { "vs_bud", "ach" }, [FR TB Balance (Budgeted)] )
						VAR Growth = IF ( NOT ISBLANK ( Closing ) && NOT ISBLANK ( LastYear ), DIVIDE ( Closing - LastYear, ABS ( LastYear ) ) )
						VAR VsBudget = IF ( NOT ISBLANK ( BudgetFig ), DIVIDE ( Budgeted - BudgetFig, ABS ( BudgetFig ) ) )
						VAR Achievement = IF ( NOT ISBLANK ( BudgetFig ), DIVIDE ( Budgeted, BudgetFig ) )
						VAR Label =
							IF (
								Kind IN { "budget", "vs_bud", "ach" } && ISBLANK ( Amount ) && ISBLANK ( VsBudget ) && ISBLANK ( Achievement )
									&& NOT ISBLANK ( Closing ) && NOT ISFILTERED ( 'GL FS Monthly'[Account Name] ) && NOT ISFILTERED ( 'GL FS Monthly'[Account Code] ),
								"No budget yet"
							)
						RETURN
							SWITCH (
								TRUE (),
								Kind IN { "opening", "opening_journal", "debit", "credit", "closing", "cutover", "month", "ly", "budget" },
									IF ( ISBLANK ( Amount ), IF ( Label <> "", Label ), IF ( ISBLANK ( Amount ), BLANK (), FORMAT ( Amount / 1000, "#,0;(#,0);–" ) ) ),
								Kind = "growth", IF ( ISBLANK ( Growth ), BLANK (), IF ( ABS ( Growth ) > 9.99, "n/m", IF ( ABS ( Growth ) < 0.0005, "0.0%", FORMAT ( Growth, "▲ 0.0%;▼ 0.0%" ) ) ) ),
								Kind = "vs_bud", IF ( ISBLANK ( VsBudget ), IF ( Label <> "", Label ), IF ( ISBLANK ( VsBudget ), BLANK (), IF ( ABS ( VsBudget ) > 9.99, "n/m", IF ( ABS ( VsBudget ) < 0.0005, "0.0%", FORMAT ( VsBudget, "▲ 0.0%;▼ 0.0%" ) ) ) ) ),
								Kind = "ach", IF ( ISBLANK ( Achievement ), IF ( Label <> "", Label ), IF ( ISBLANK ( Achievement ), BLANK (), IF ( ABS ( Achievement ) > 9.99, "n/m", FORMAT ( Achievement, "0.0%" ) ) ) )
							),
						REMOVEFILTERS ( 'Finance Column' )
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + GL FS Monthly + P&L Report | Finance Column, GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR TB Cell"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = Finance Column, GL FS Monthly
	/// Balance sheet matrix cell, text in SAR thousands or a percentage, for the column of 'Finance Column' in context: a month column shows that month's month-end balance (blank when the month is not picked or lies after today), closing, last year, growth, budget, vs budget, achievement (balance against budget) and % of assets; a budget cell without a budget reads 'No budget yet' on a row that has a balance; blank when every component is blank, so empty rows drop.
	measure 'FR BS Cell' =
			VAR __Value = ( -- measure body
				VAR Kind = SELECTEDVALUE ( 'Finance Column'[Kind] )
				VAR MonthNum = SELECTEDVALUE ( 'Finance Column'[Month Num] )
				RETURN
					CALCULATE (
						VAR Balance = [FR BS Balance]
						VAR Amount =
							SWITCH (
								Kind,
								"month", IF ( MonthNum IN VALUES ( 'Date'[Month] ), CALCULATE ( [FR BS Balance], 'Date'[Month] = MonthNum ) ),
								"closing", Balance,
								"ly", [FR BS Last Year],
								"budget", [FR BS Budget]
							)
						VAR LastYear = IF ( Kind = "growth", [FR BS Last Year] )
						VAR BudgetFig = IF ( Kind IN { "vs_bud", "ach" }, [FR BS Budget] )
						VAR Budgeted = IF ( Kind IN { "vs_bud", "ach" }, [FR BS Balance (Budgeted)] )
						VAR Growth = IF ( NOT ISBLANK ( Balance ) && NOT ISBLANK ( LastYear ), DIVIDE ( Balance - LastYear, ABS ( LastYear ) ) )
						VAR VsBudget = IF ( NOT ISBLANK ( BudgetFig ), DIVIDE ( Budgeted - BudgetFig, ABS ( BudgetFig ) ) )
						VAR Achievement = IF ( NOT ISBLANK ( BudgetFig ), DIVIDE ( Budgeted, BudgetFig ) )
						VAR OfAssets = IF ( Kind = "pct_assets", [FR % of Assets] )
						VAR Label =
							IF (
								Kind IN { "budget", "vs_bud", "ach" } && ISBLANK ( Amount ) && ISBLANK ( VsBudget ) && ISBLANK ( Achievement )
									&& NOT ISBLANK ( Balance ),
								[FR BS Budget Label]
							)
						RETURN
							SWITCH (
								TRUE (),
								Kind IN { "month", "closing", "ly", "budget" }, IF ( ISBLANK ( Amount ), IF ( Label <> "", Label ), IF ( ISBLANK ( Amount ), BLANK (), FORMAT ( Amount / 1000, "#,0;(#,0);–" ) ) ),
								Kind = "growth", IF ( ISBLANK ( Growth ), BLANK (), IF ( ABS ( Growth ) > 9.99, "n/m", IF ( ABS ( Growth ) < 0.0005, "0.0%", FORMAT ( Growth, "▲ 0.0%;▼ 0.0%" ) ) ) ),
								Kind = "vs_bud", IF ( ISBLANK ( VsBudget ), IF ( Label <> "", Label ), IF ( ISBLANK ( VsBudget ), BLANK (), IF ( ABS ( VsBudget ) > 9.99, "n/m", IF ( ABS ( VsBudget ) < 0.0005, "0.0%", FORMAT ( VsBudget, "▲ 0.0%;▼ 0.0%" ) ) ) ) ),
								Kind = "ach", IF ( ISBLANK ( Achievement ), IF ( Label <> "", Label ), IF ( ISBLANK ( Achievement ), BLANK (), IF ( ABS ( Achievement ) > 9.99, "n/m", FORMAT ( Achievement, "0.0%" ) ) ) ),
								Kind = "pct_assets", IF ( ISBLANK ( OfAssets ), BLANK (), IF ( ABS ( OfAssets ) > 9.99, "n/m", FORMAT ( OfAssets, "0.0%" ) ) )
							),
						REMOVEFILTERS ( 'Finance Column' )
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + GL FS Monthly + P&L Report | Finance Column, GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR BS Cell"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = Finance Column, GL FS Monthly
	/// Font colour (hex) of a matrix cell for the column of 'Finance Column' in context: placeholder grey #9AA7B5 where the budget is missing, favourable #04705F / unfavourable #C2230A on income statement variance and growth (P&L sign: positive is favourable), muted #4D5B6B on trial balance and balance sheet growth and vs budget, else ink #0A1E32.
	measure 'FR Cell Colour' =
			VAR __Value = ( -- measure body
				VAR Page = SELECTEDVALUE ( 'Finance Column'[Page] )
				VAR Kind = SELECTEDVALUE ( 'Finance Column'[Kind] )
				RETURN
					CALCULATE (
						VAR NoBudget =
							Kind IN { "budget", "variance", "var_pct", "vs_bud", "ach" }
								&& ISBLANK ( SWITCH ( Page, "is", [FR Budget], "tb", [FR TB Budget], "bs", [FR BS Budget] ) )
						-- income statement figures are in the P&L sign: a positive variance or growth is favourable on every line (ruling R9b)
						VAR Signed =
							ROUND (
								SWITCH (
									TRUE (),
									Page = "is" && Kind IN { "variance", "var_pct" }, [FR Budget Variance],
									Page = "is" && Kind = "growth", [FR Growth %]
								),
								3
							)
						RETURN
							SWITCH (
								TRUE (),
								NoBudget, "#9AA7B5",
								Page IN { "tb", "bs" } && Kind IN { "growth", "vs_bud" }, "#4D5B6B",
								Signed > 0, "#04705F",
								Signed < 0, "#C2230A",
								"#0A1E32"
							),
						REMOVEFILTERS ( 'Finance Column' )
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + GL FS Monthly + P&L Report | Finance Column, GL FS Monthly, P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Cell Colour"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = Finance Column, GL FS Monthly, P&L Report
	/// Period of the selection up to today as text for the report header: 'Oct 2026' for one month, 'Jan to Oct 2026' for a range in one year, 'Nov 2025 to Mar 2026' across years. Blank when no day up to today is selected.
	measure 'FR Period Text' =
			VAR Dates = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
			VAR StartDay = MINX ( Dates, 'Date'[Date] )
			VAR EndDay = MAXX ( Dates, 'Date'[Date] )
			VAR FirstMonth = LOOKUPVALUE ( 'Date'[Month Short], 'Date'[Date], StartDay )
			VAR LastMonth = LOOKUPVALUE ( 'Date'[Month Short], 'Date'[Date], EndDay )
			RETURN
				IF (
					NOT ISEMPTY ( Dates ),
					SWITCH (
						TRUE (),
						YEAR ( StartDay ) <> YEAR ( EndDay ), FirstMonth & " " & YEAR ( StartDay ) & " to " & LastMonth & " " & YEAR ( EndDay ),
						FirstMonth = LastMonth, LastMonth & " " & YEAR ( EndDay ),
						FirstMonth & " to " & LastMonth & " " & YEAR ( EndDay )
					)
				)
		formatString: General
		displayFolder: Finance\Report
	/// Net revenue in SAR for the report's tiles: Fin Net Revenue (P&L report line NET_REVENUE), months up to today.
	measure 'FR Net Revenue' =
			VAR __Value = ( -- measure body
				[Fin Net Revenue]
			) -- end of measure body
			VAR __Wrong = [_Guard P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Net Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report
	/// EBITDA in SAR for the report's tiles: Fin EBITDA (P&L report line EBITDA), months up to today.
	measure 'FR EBITDA' =
			VAR __Value = ( -- measure body
				[Fin EBITDA]
			) -- end of measure body
			VAR __Wrong = [_Guard P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR EBITDA"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report
	/// Net profit in SAR for the report's tiles: Fin Net Profit (P&L report line NET_PROFIT), months up to today.
	measure 'FR Net Profit' =
			VAR __Value = ( -- measure body
				[Fin Net Profit]
			) -- end of measure body
			VAR __Wrong = [_Guard P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Net Profit"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report
	/// Total assets in SAR for the report's tiles: Fin Total Assets, each hospital's closing at its last month with GL rows up to today, summed. Snapshot.
	measure 'FR Total Assets' =
			VAR __Value = ( -- measure body
				[Fin Total Assets]
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR Total Assets"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report

		annotation hnh_snapshot = 1
	/// Result of net revenue against budget as text, e.g. '▲ 3.2% vs budget (budgeted hospitals)': FR Actual (Budgeted) against FR Budget of line NET_REVENUE, with the FR Budget Basis Label wording; 'No budget yet' without a budget; blank when the budget is 0.
	measure 'FR Tile Net Revenue vs Budget' =
			VAR __Value = ( -- measure body
				VAR BudgetFig = CALCULATE ( [FR Budget], 'P&L Line'[PL Line Code] = "NET_REVENUE" )
				VAR Actual = CALCULATE ( [FR Actual (Budgeted)], 'P&L Line'[PL Line Code] = "NET_REVENUE" )
				VAR Change = IF ( NOT ISBLANK ( Actual ) && NOT ISBLANK ( BudgetFig ), DIVIDE ( Actual - BudgetFig, ABS ( BudgetFig ) ) )
				RETURN
					IF ( ISBLANK ( BudgetFig ), "No budget yet", IF ( NOT ISBLANK ( Change ), IF ( ISBLANK ( Change ), BLANK (), IF ( ABS ( Change ) > 9.99, "n/m", IF ( ABS ( Change ) < 0.0005, "0.0%", FORMAT ( Change, "▲ 0.0%;▼ 0.0%" ) ) ) ) & " " & [FR Budget Basis Label] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Tile Net Revenue vs Budget"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report
	/// Colour of FR Tile Net Revenue vs Budget: favourable #04705F / unfavourable #C2230A, muted #4D5B6B on a neutral or balance sheet line, placeholder grey #9AA7B5 without a budget.
	measure 'FR Tile Net Revenue vs Budget Colour' =
			VAR __Value = ( -- measure body
				VAR BudgetFig = CALCULATE ( [FR Budget], 'P&L Line'[PL Line Code] = "NET_REVENUE" )
				VAR Actual = CALCULATE ( [FR Actual (Budgeted)], 'P&L Line'[PL Line Code] = "NET_REVENUE" )
				VAR Change = IF ( NOT ISBLANK ( Actual ) && NOT ISBLANK ( BudgetFig ), DIVIDE ( Actual - BudgetFig, ABS ( BudgetFig ) ) )
				RETURN
					IF ( ISBLANK ( BudgetFig ), "#9AA7B5", IF ( ISBLANK ( Change ), "#4D5B6B", IF ( ROUND ( Change, 3 ) > 0, "#04705F", IF ( ROUND ( Change, 3 ) < 0, "#C2230A", "#4D5B6B" ) ) ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Tile Net Revenue vs Budget Colour"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report
	/// Growth of net revenue on the same months last year as text, e.g. '▲ 3.2% vs last year' (FR Growth % of line NET_REVENUE); blank without a last-year figure.
	measure 'FR Tile Net Revenue vs LY' =
			VAR __Value = ( -- measure body
				VAR Growth = CALCULATE ( [FR Growth %], 'P&L Line'[PL Line Code] = "NET_REVENUE" )
				RETURN
					IF ( NOT ISBLANK ( Growth ), IF ( ISBLANK ( Growth ), BLANK (), IF ( ABS ( Growth ) > 9.99, "n/m", IF ( ABS ( Growth ) < 0.0005, "0.0%", FORMAT ( Growth, "▲ 0.0%;▼ 0.0%" ) ) ) ) & " vs last year" )
			) -- end of measure body
			VAR __Wrong = [_Guard P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Tile Net Revenue vs LY"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report
	/// Colour of FR Tile Net Revenue vs LY: favourable #04705F / unfavourable #C2230A, muted #4D5B6B on a neutral or balance sheet line.
	measure 'FR Tile Net Revenue vs LY Colour' =
			VAR __Value = ( -- measure body
				VAR Growth = CALCULATE ( [FR Growth %], 'P&L Line'[PL Line Code] = "NET_REVENUE" )
				RETURN
					IF ( ISBLANK ( Growth ), "#4D5B6B", IF ( ROUND ( Growth, 3 ) > 0, "#04705F", IF ( ROUND ( Growth, 3 ) < 0, "#C2230A", "#4D5B6B" ) ) )
			) -- end of measure body
			VAR __Wrong = [_Guard P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Tile Net Revenue vs LY Colour"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report
	/// Result of EBITDA against budget as text, e.g. '▲ 3.2% vs budget (budgeted hospitals)': FR Actual (Budgeted) against FR Budget of line EBITDA, with the FR Budget Basis Label wording; 'No budget yet' without a budget; blank when the budget is 0.
	measure 'FR Tile EBITDA vs Budget' =
			VAR __Value = ( -- measure body
				VAR BudgetFig = CALCULATE ( [FR Budget], 'P&L Line'[PL Line Code] = "EBITDA" )
				VAR Actual = CALCULATE ( [FR Actual (Budgeted)], 'P&L Line'[PL Line Code] = "EBITDA" )
				VAR Change = IF ( NOT ISBLANK ( Actual ) && NOT ISBLANK ( BudgetFig ), DIVIDE ( Actual - BudgetFig, ABS ( BudgetFig ) ) )
				RETURN
					IF ( ISBLANK ( BudgetFig ), "No budget yet", IF ( NOT ISBLANK ( Change ), IF ( ISBLANK ( Change ), BLANK (), IF ( ABS ( Change ) > 9.99, "n/m", IF ( ABS ( Change ) < 0.0005, "0.0%", FORMAT ( Change, "▲ 0.0%;▼ 0.0%" ) ) ) ) & " " & [FR Budget Basis Label] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Tile EBITDA vs Budget"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report
	/// Colour of FR Tile EBITDA vs Budget: favourable #04705F / unfavourable #C2230A, muted #4D5B6B on a neutral or balance sheet line, placeholder grey #9AA7B5 without a budget.
	measure 'FR Tile EBITDA vs Budget Colour' =
			VAR __Value = ( -- measure body
				VAR BudgetFig = CALCULATE ( [FR Budget], 'P&L Line'[PL Line Code] = "EBITDA" )
				VAR Actual = CALCULATE ( [FR Actual (Budgeted)], 'P&L Line'[PL Line Code] = "EBITDA" )
				VAR Change = IF ( NOT ISBLANK ( Actual ) && NOT ISBLANK ( BudgetFig ), DIVIDE ( Actual - BudgetFig, ABS ( BudgetFig ) ) )
				RETURN
					IF ( ISBLANK ( BudgetFig ), "#9AA7B5", IF ( ISBLANK ( Change ), "#4D5B6B", IF ( ROUND ( Change, 3 ) > 0, "#04705F", IF ( ROUND ( Change, 3 ) < 0, "#C2230A", "#4D5B6B" ) ) ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Tile EBITDA vs Budget Colour"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report
	/// Growth of EBITDA on the same months last year as text, e.g. '▲ 3.2% vs last year' (FR Growth % of line EBITDA); blank without a last-year figure.
	measure 'FR Tile EBITDA vs LY' =
			VAR __Value = ( -- measure body
				VAR Growth = CALCULATE ( [FR Growth %], 'P&L Line'[PL Line Code] = "EBITDA" )
				RETURN
					IF ( NOT ISBLANK ( Growth ), IF ( ISBLANK ( Growth ), BLANK (), IF ( ABS ( Growth ) > 9.99, "n/m", IF ( ABS ( Growth ) < 0.0005, "0.0%", FORMAT ( Growth, "▲ 0.0%;▼ 0.0%" ) ) ) ) & " vs last year" )
			) -- end of measure body
			VAR __Wrong = [_Guard P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Tile EBITDA vs LY"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report
	/// Colour of FR Tile EBITDA vs LY: favourable #04705F / unfavourable #C2230A, muted #4D5B6B on a neutral or balance sheet line.
	measure 'FR Tile EBITDA vs LY Colour' =
			VAR __Value = ( -- measure body
				VAR Growth = CALCULATE ( [FR Growth %], 'P&L Line'[PL Line Code] = "EBITDA" )
				RETURN
					IF ( ISBLANK ( Growth ), "#4D5B6B", IF ( ROUND ( Growth, 3 ) > 0, "#04705F", IF ( ROUND ( Growth, 3 ) < 0, "#C2230A", "#4D5B6B" ) ) )
			) -- end of measure body
			VAR __Wrong = [_Guard P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Tile EBITDA vs LY Colour"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report
	/// Result of net profit against budget as text, e.g. '▲ 3.2% vs budget (budgeted hospitals)': FR Actual (Budgeted) against FR Budget of line NET_PROFIT, with the FR Budget Basis Label wording; 'No budget yet' without a budget; blank when the budget is 0.
	measure 'FR Tile Net Profit vs Budget' =
			VAR __Value = ( -- measure body
				VAR BudgetFig = CALCULATE ( [FR Budget], 'P&L Line'[PL Line Code] = "NET_PROFIT" )
				VAR Actual = CALCULATE ( [FR Actual (Budgeted)], 'P&L Line'[PL Line Code] = "NET_PROFIT" )
				VAR Change = IF ( NOT ISBLANK ( Actual ) && NOT ISBLANK ( BudgetFig ), DIVIDE ( Actual - BudgetFig, ABS ( BudgetFig ) ) )
				RETURN
					IF ( ISBLANK ( BudgetFig ), "No budget yet", IF ( NOT ISBLANK ( Change ), IF ( ISBLANK ( Change ), BLANK (), IF ( ABS ( Change ) > 9.99, "n/m", IF ( ABS ( Change ) < 0.0005, "0.0%", FORMAT ( Change, "▲ 0.0%;▼ 0.0%" ) ) ) ) & " " & [FR Budget Basis Label] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Tile Net Profit vs Budget"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report
	/// Colour of FR Tile Net Profit vs Budget: favourable #04705F / unfavourable #C2230A, muted #4D5B6B on a neutral or balance sheet line, placeholder grey #9AA7B5 without a budget.
	measure 'FR Tile Net Profit vs Budget Colour' =
			VAR __Value = ( -- measure body
				VAR BudgetFig = CALCULATE ( [FR Budget], 'P&L Line'[PL Line Code] = "NET_PROFIT" )
				VAR Actual = CALCULATE ( [FR Actual (Budgeted)], 'P&L Line'[PL Line Code] = "NET_PROFIT" )
				VAR Change = IF ( NOT ISBLANK ( Actual ) && NOT ISBLANK ( BudgetFig ), DIVIDE ( Actual - BudgetFig, ABS ( BudgetFig ) ) )
				RETURN
					IF ( ISBLANK ( BudgetFig ), "#9AA7B5", IF ( ISBLANK ( Change ), "#4D5B6B", IF ( ROUND ( Change, 3 ) > 0, "#04705F", IF ( ROUND ( Change, 3 ) < 0, "#C2230A", "#4D5B6B" ) ) ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Tile Net Profit vs Budget Colour"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report
	/// Growth of net profit on the same months last year as text, e.g. '▲ 3.2% vs last year' (FR Growth % of line NET_PROFIT); blank without a last-year figure.
	measure 'FR Tile Net Profit vs LY' =
			VAR __Value = ( -- measure body
				VAR Growth = CALCULATE ( [FR Growth %], 'P&L Line'[PL Line Code] = "NET_PROFIT" )
				RETURN
					IF ( NOT ISBLANK ( Growth ), IF ( ISBLANK ( Growth ), BLANK (), IF ( ABS ( Growth ) > 9.99, "n/m", IF ( ABS ( Growth ) < 0.0005, "0.0%", FORMAT ( Growth, "▲ 0.0%;▼ 0.0%" ) ) ) ) & " vs last year" )
			) -- end of measure body
			VAR __Wrong = [_Guard P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Tile Net Profit vs LY"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report
	/// Colour of FR Tile Net Profit vs LY: favourable #04705F / unfavourable #C2230A, muted #4D5B6B on a neutral or balance sheet line.
	measure 'FR Tile Net Profit vs LY Colour' =
			VAR __Value = ( -- measure body
				VAR Growth = CALCULATE ( [FR Growth %], 'P&L Line'[PL Line Code] = "NET_PROFIT" )
				RETURN
					IF ( ISBLANK ( Growth ), "#4D5B6B", IF ( ROUND ( Growth, 3 ) > 0, "#04705F", IF ( ROUND ( Growth, 3 ) < 0, "#C2230A", "#4D5B6B" ) ) )
			) -- end of measure body
			VAR __Wrong = [_Guard P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Tile Net Profit vs LY Colour"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report
	/// Change of the EBITDA margin (EBITDA / net revenue) against the budget margin in percentage points, e.g. '+1.4 pt vs budget (budgeted hospitals)'; actual over the budgeted hospital-months; 'No budget yet' without a budget.
	measure 'FR Tile EBITDA Margin vs Budget' =
			VAR __Value = ( -- measure body
				VAR BudgetMargin =
					DIVIDE (
						CALCULATE ( [FR Budget], 'P&L Line'[PL Line Code] = "EBITDA" ),
						CALCULATE ( [FR Budget], 'P&L Line'[PL Line Code] = "NET_REVENUE" )
					)
				VAR ActualMargin =
					DIVIDE (
						CALCULATE ( [FR Actual (Budgeted)], 'P&L Line'[PL Line Code] = "EBITDA" ),
						CALCULATE ( [FR Actual (Budgeted)], 'P&L Line'[PL Line Code] = "NET_REVENUE" )
					)
				VAR Change = IF ( NOT ISBLANK ( ActualMargin ) && NOT ISBLANK ( BudgetMargin ), ( ActualMargin - BudgetMargin ) * 100 )
				RETURN
					IF ( ISBLANK ( BudgetMargin ), "No budget yet", IF ( NOT ISBLANK ( Change ), FORMAT ( Change, "+0.0 ""pt"";-0.0 ""pt"";0.0 ""pt""" ) & " " & [FR Budget Basis Label] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Tile EBITDA Margin vs Budget"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report
	/// Colour of FR Tile EBITDA Margin vs Budget: favourable #04705F / unfavourable #C2230A, muted #4D5B6B on a neutral or balance sheet line, placeholder grey #9AA7B5 without a budget.
	measure 'FR Tile EBITDA Margin vs Budget Colour' =
			VAR __Value = ( -- measure body
				VAR BudgetMargin =
					DIVIDE (
						CALCULATE ( [FR Budget], 'P&L Line'[PL Line Code] = "EBITDA" ),
						CALCULATE ( [FR Budget], 'P&L Line'[PL Line Code] = "NET_REVENUE" )
					)
				VAR ActualMargin =
					DIVIDE (
						CALCULATE ( [FR Actual (Budgeted)], 'P&L Line'[PL Line Code] = "EBITDA" ),
						CALCULATE ( [FR Actual (Budgeted)], 'P&L Line'[PL Line Code] = "NET_REVENUE" )
					)
				VAR Change = IF ( NOT ISBLANK ( ActualMargin ) && NOT ISBLANK ( BudgetMargin ), ( ActualMargin - BudgetMargin ) * 100 )
				RETURN
					IF ( ISBLANK ( BudgetMargin ), "#9AA7B5", IF ( ISBLANK ( Change ), "#4D5B6B", IF ( ROUND ( Change, 3 ) > 0, "#04705F", IF ( ROUND ( Change, 3 ) < 0, "#C2230A", "#4D5B6B" ) ) ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Tile EBITDA Margin vs Budget Colour"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report
	/// Change of the EBITDA margin on the same months last year in percentage points, e.g. '+1.4 pt vs last year'.
	measure 'FR Tile EBITDA Margin vs LY' =
			VAR __Value = ( -- measure body
				VAR ActualMargin =
					DIVIDE ( CALCULATE ( [FR Actual], 'P&L Line'[PL Line Code] = "EBITDA" ), CALCULATE ( [FR Actual], 'P&L Line'[PL Line Code] = "NET_REVENUE" ) )
				VAR LastYearMargin =
					DIVIDE ( CALCULATE ( [FR Last Year], 'P&L Line'[PL Line Code] = "EBITDA" ), CALCULATE ( [FR Last Year], 'P&L Line'[PL Line Code] = "NET_REVENUE" ) )
				VAR Change = IF ( NOT ISBLANK ( ActualMargin ) && NOT ISBLANK ( LastYearMargin ), ( ActualMargin - LastYearMargin ) * 100 )
				RETURN
					IF ( NOT ISBLANK ( Change ), FORMAT ( Change, "+0.0 ""pt"";-0.0 ""pt"";0.0 ""pt""" ) & " vs last year" )
			) -- end of measure body
			VAR __Wrong = [_Guard P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Tile EBITDA Margin vs LY"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report
	/// Colour of FR Tile EBITDA Margin vs LY: favourable #04705F / unfavourable #C2230A, muted #4D5B6B on a neutral or balance sheet line.
	measure 'FR Tile EBITDA Margin vs LY Colour' =
			VAR __Value = ( -- measure body
				VAR ActualMargin =
					DIVIDE ( CALCULATE ( [FR Actual], 'P&L Line'[PL Line Code] = "EBITDA" ), CALCULATE ( [FR Actual], 'P&L Line'[PL Line Code] = "NET_REVENUE" ) )
				VAR LastYearMargin =
					DIVIDE ( CALCULATE ( [FR Last Year], 'P&L Line'[PL Line Code] = "EBITDA" ), CALCULATE ( [FR Last Year], 'P&L Line'[PL Line Code] = "NET_REVENUE" ) )
				VAR Change = IF ( NOT ISBLANK ( ActualMargin ) && NOT ISBLANK ( LastYearMargin ), ( ActualMargin - LastYearMargin ) * 100 )
				RETURN
					IF ( ISBLANK ( Change ), "#4D5B6B", IF ( ROUND ( Change, 3 ) > 0, "#04705F", IF ( ROUND ( Change, 3 ) < 0, "#C2230A", "#4D5B6B" ) ) )
			) -- end of measure body
			VAR __Wrong = [_Guard P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Tile EBITDA Margin vs LY Colour"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report
	/// Total assets against the assets budget as text, e.g. '▲ 3.2% vs budget (budgeted hospitals)': FR BS Balance (Budgeted) against FR BS Budget of the Assets side; 'No budget yet' without a budget. Balance sheet comparisons are muted, not favourable or unfavourable.
	measure 'FR Tile Total Assets vs Budget' =
			VAR __Value = ( -- measure body
				VAR BudgetFig = CALCULATE ( [FR BS Budget], 'GL FS Monthly'[BS Side] = "Assets" )
				VAR Actual = CALCULATE ( [FR BS Balance (Budgeted)], 'GL FS Monthly'[BS Side] = "Assets" )
				VAR Whole = CALCULATE ( [FR BS Balance], 'GL FS Monthly'[BS Side] = "Assets" )
				VAR Change = IF ( NOT ISBLANK ( Actual ) && NOT ISBLANK ( BudgetFig ), DIVIDE ( Actual - BudgetFig, ABS ( BudgetFig ) ) )
				RETURN
					IF (
						ISBLANK ( BudgetFig ),
						"No budget yet",
						IF (
							NOT ISBLANK ( Change ),
							IF ( ISBLANK ( Change ), BLANK (), IF ( ABS ( Change ) > 9.99, "n/m", IF ( ABS ( Change ) < 0.0005, "0.0%", FORMAT ( Change, "▲ 0.0%;▼ 0.0%" ) ) ) ) & IF ( ROUND ( Whole - Actual, 0 ) <> 0, " vs budget (budgeted hospitals)", " vs budget" )
						)
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + GL FS Monthly + P&L Report | GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR Tile Total Assets vs Budget"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = GL FS Monthly
	/// Colour of FR Tile Total Assets vs Budget: the muted #4D5B6B (a balance sheet line has no favourable or unfavourable reading), placeholder grey #9AA7B5 without a budget.
	measure 'FR Tile Total Assets vs Budget Colour' =
			VAR __Value = ( -- measure body
				VAR BudgetFig = CALCULATE ( [FR BS Budget], 'GL FS Monthly'[BS Side] = "Assets" )
				RETURN
					IF ( ISBLANK ( BudgetFig ), "#9AA7B5", "#4D5B6B" )
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + GL FS Monthly | GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR Tile Total Assets vs Budget Colour"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = GL FS Monthly
	/// Total assets against the same point last year as text, e.g. '▲ 3.2% vs last year' (FR BS Last Year of the Assets side).
	measure 'FR Tile Total Assets vs LY' =
			VAR __Value = ( -- measure body
				VAR Balance = CALCULATE ( [FR BS Balance], 'GL FS Monthly'[BS Side] = "Assets" )
				VAR LastYear = CALCULATE ( [FR BS Last Year], 'GL FS Monthly'[BS Side] = "Assets" )
				VAR Growth = IF ( NOT ISBLANK ( Balance ) && NOT ISBLANK ( LastYear ), DIVIDE ( Balance - LastYear, ABS ( LastYear ) ) )
				RETURN
					IF ( NOT ISBLANK ( Growth ), IF ( ISBLANK ( Growth ), BLANK (), IF ( ABS ( Growth ) > 9.99, "n/m", IF ( ABS ( Growth ) < 0.0005, "0.0%", FORMAT ( Growth, "▲ 0.0%;▼ 0.0%" ) ) ) ) & " vs last year" )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly + P&L Report | GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """FR Tile Total Assets vs LY"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = GL FS Monthly
	/// Colour of FR Tile Total Assets vs LY: always the muted #4D5B6B (the balance sheet tile has no favourable or unfavourable reading against last year).
	measure 'FR Tile Total Assets vs LY Colour' =
			"#4D5B6B"
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = GL FS Monthly
	/// Placeholder of the net working capital against budget: the balance sheet budget has no line for it, so 'No budget yet'.
	measure 'FR Tile Net Working Capital vs Budget' =
			"No budget yet"
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = GL FS Monthly, P&L Report
	/// Colour of FR Tile Net Working Capital vs Budget: always the placeholder grey #9AA7B5 (the balance sheet budget has no line for it).
	measure 'FR Tile Net Working Capital vs Budget Colour' =
			"#9AA7B5"
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = GL FS Monthly, P&L Report
	/// Change of the net working capital on the same point last year as text, e.g. '+120k vs last year'; blank without a last-year figure.
	measure 'FR Tile Net Working Capital vs LY' =
			VAR __Value = ( -- measure body
				VAR ThisPeriod = [FR Net Working Capital] / 1000
				VAR LastYear = CALCULATE ( [FR Net Working Capital] / 1000, SAMEPERIODLASTYEAR ( CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) ) ) )
				VAR Change = IF ( NOT ISBLANK ( ThisPeriod ) && NOT ISBLANK ( LastYear ), ThisPeriod - LastYear )
				RETURN
					IF ( NOT ISBLANK ( Change ), FORMAT ( Change, "+#,0;-#,0;0" ) & "k vs last year" )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly | GL FS Monthly, P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Tile Net Working Capital vs LY"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = GL FS Monthly, P&L Report
	/// Colour of FR Tile Net Working Capital vs LY: always the muted #4D5B6B (the balance sheet tile has no favourable or unfavourable reading against last year).
	measure 'FR Tile Net Working Capital vs LY Colour' =
			"#4D5B6B"
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = GL FS Monthly, P&L Report
	/// Placeholder of the current ratio (current assets / current liabilities) against budget: the balance sheet budget has no line for it, so 'No budget yet'.
	measure 'FR Tile Current Ratio vs Budget' =
			"No budget yet"
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = GL FS Monthly, P&L Report
	/// Colour of FR Tile Current Ratio vs Budget: always the placeholder grey #9AA7B5 (the balance sheet budget has no line for it).
	measure 'FR Tile Current Ratio vs Budget Colour' =
			"#9AA7B5"
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = GL FS Monthly, P&L Report
	/// Change of the current ratio (current assets / current liabilities) on the same point last year as text, e.g. '+0.12 x vs last year'; blank without a last-year figure.
	measure 'FR Tile Current Ratio vs LY' =
			VAR __Value = ( -- measure body
				VAR ThisPeriod = DIVIDE ( [Fin Current Assets], [Fin Current Liabilities] )
				VAR LastYear = CALCULATE ( DIVIDE ( [Fin Current Assets], [Fin Current Liabilities] ), SAMEPERIODLASTYEAR ( CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) ) ) )
				VAR Change = IF ( NOT ISBLANK ( ThisPeriod ) && NOT ISBLANK ( LastYear ), ThisPeriod - LastYear )
				RETURN
					IF ( NOT ISBLANK ( Change ), FORMAT ( Change, "+0.00;-0.00;0.00" ) & " x vs last year" )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly | GL FS Monthly, P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Tile Current Ratio vs LY"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = GL FS Monthly, P&L Report
	/// Colour of FR Tile Current Ratio vs LY: always the muted #4D5B6B (the balance sheet tile has no favourable or unfavourable reading against last year).
	measure 'FR Tile Current Ratio vs LY Colour' =
			"#4D5B6B"
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = GL FS Monthly, P&L Report
	/// Placeholder of the receivable days (trade receivables / net revenue x days in the period) against budget: the balance sheet budget has no line for it, so 'No budget yet'.
	measure 'FR Tile Receivable Days vs Budget' =
			"No budget yet"
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = GL FS Monthly, P&L Report
	/// Colour of FR Tile Receivable Days vs Budget: always the placeholder grey #9AA7B5 (the balance sheet budget has no line for it).
	measure 'FR Tile Receivable Days vs Budget Colour' =
			"#9AA7B5"
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = GL FS Monthly, P&L Report
	/// Change of the receivable days (trade receivables / net revenue x days in the period) on the same point last year as text, e.g. '+3 days vs last year'; blank without a last-year figure.
	measure 'FR Tile Receivable Days vs LY' =
			VAR __Value = ( -- measure body
				VAR ThisPeriod = DIVIDE ( [Fin Trade Receivables], [Fin Net Revenue] ) * [Fin Period Days]
				VAR LastYear = CALCULATE ( DIVIDE ( [Fin Trade Receivables], [Fin Net Revenue] ) * [Fin Period Days], SAMEPERIODLASTYEAR ( CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) ) ) )
				VAR Change = IF ( NOT ISBLANK ( ThisPeriod ) && NOT ISBLANK ( LastYear ), ThisPeriod - LastYear )
				RETURN
					IF ( NOT ISBLANK ( Change ), FORMAT ( Change, "+0;-0;0" ) & " days vs last year" )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly + P&L Report | GL FS Monthly, P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Tile Receivable Days vs LY"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = GL FS Monthly, P&L Report
	/// Colour of FR Tile Receivable Days vs LY: always the muted #4D5B6B (the balance sheet tile has no favourable or unfavourable reading against last year).
	measure 'FR Tile Receivable Days vs LY Colour' =
			"#4D5B6B"
		formatString: General
		displayFolder: Finance\Report

		annotation hnh_guard_allow = GL FS Monthly, P&L Report
	/// Chart series: trial balance month-end closing (debit positive) actual. The matrix row in context drives it; with no row selected it shows the default line (trade receivables, net).
	measure 'FR Chart TB Actual' =
			VAR __Value = ( -- measure body
				CALCULATE (
					IF (
						ISFILTERED ( 'GL FS Monthly'[FS Type Name] ) || ISFILTERED ( 'GL FS Monthly'[FS Element Name] ) || ISFILTERED ( 'GL FS Monthly'[FS Category Name] ) || ISFILTERED ( 'GL FS Monthly'[FS Caption Name] ) || ISFILTERED ( 'GL FS Monthly'[Account Name] ),
						[FR GL Closing],
						CALCULATE ( [FR GL Closing], 'GL FS Monthly'[FS Caption] = "trade receivables, net" )
					),
					REMOVEFILTERS ( 'Finance Column' )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly | Finance Column, GL FS Monthly, P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Chart TB Actual"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report

		annotation hnh_snapshot = 1
		annotation hnh_guard_allow = Finance Column, GL FS Monthly, P&L Report
	/// Chart series: trial balance month-end closing (debit positive) budget. The matrix row in context drives it; with no row selected it shows the default line (trade receivables, net).
	measure 'FR Chart TB Budget' =
			VAR __Value = ( -- measure body
				CALCULATE (
					IF (
						ISFILTERED ( 'GL FS Monthly'[FS Type Name] ) || ISFILTERED ( 'GL FS Monthly'[FS Element Name] ) || ISFILTERED ( 'GL FS Monthly'[FS Category Name] ) || ISFILTERED ( 'GL FS Monthly'[FS Caption Name] ) || ISFILTERED ( 'GL FS Monthly'[Account Name] ),
						[FR TB Budget],
						CALCULATE ( [FR TB Budget], 'GL FS Monthly'[FS Caption] = "trade receivables, net" )
					),
					REMOVEFILTERS ( 'Finance Column' )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + GL FS Monthly | Finance Column, GL FS Monthly, P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Chart TB Budget"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report

		annotation hnh_snapshot = 1
		annotation hnh_guard_allow = Finance Column, GL FS Monthly, P&L Report
	/// Chart series: trial balance month-end closing (debit positive) last year. The matrix row in context drives it; with no row selected it shows the default line (trade receivables, net).
	measure 'FR Chart TB Last Year' =
			VAR __Value = ( -- measure body
				CALCULATE (
					IF (
						ISFILTERED ( 'GL FS Monthly'[FS Type Name] ) || ISFILTERED ( 'GL FS Monthly'[FS Element Name] ) || ISFILTERED ( 'GL FS Monthly'[FS Category Name] ) || ISFILTERED ( 'GL FS Monthly'[FS Caption Name] ) || ISFILTERED ( 'GL FS Monthly'[Account Name] ),
						[FR GL Closing Last Year],
						CALCULATE ( [FR GL Closing Last Year], 'GL FS Monthly'[FS Caption] = "trade receivables, net" )
					),
					REMOVEFILTERS ( 'Finance Column' )
				)
