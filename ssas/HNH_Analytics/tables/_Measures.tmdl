/// Every measure of the model, in display folders by domain (<domain>\<topic>). Each perspective shows the measures of its domain (decision P26).
table _Measures

	/// Admissions by admit date, old warehouse rule (vw_inpatients, 2026-10-13): a last bed in a ward that is not excluded, an outcome that is not wrong admission, and more than one hour (to now for open stays).
	measure Admissions =
			VAR __Value = ( -- measure body
				CALCULATE ( COUNTROWS ( Admissions ), Admissions[Is Countable] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions]
			RETURN IF ( __Wrong = "", __Value, """Admissions"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Admissions
	/// Occupied ÷ available bed-days on inpatient wards that are not excluded (gold spec section 8; receiving notes).
	measure 'Bed Occupancy %' =
			VAR __Value = ( -- measure body
				CALCULATE (
					DIVIDE ( SUM ( 'Bed Occupancy'[Is Occupied] ), SUM ( 'Bed Occupancy'[Is Available] ) ),
					'Bed Occupancy'[Is Inpatient Ward] = "Yes",
					'Bed Occupancy'[Is Excluded Ward] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Bed Occupancy]
			RETURN IF ( __Wrong = "", __Value, """Bed Occupancy %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Flow\Occupancy
	/// Outpatient visits: arrived, not cancelled OP encounters (gold spec section 8).
	measure 'OP Visits' =
			VAR __Value = ( -- measure body
				CALCULATE (
					COUNTROWS ( Encounters ),
					KEEPFILTERS ( Encounters[Encounter Type] = "OP" ),
					Encounters[Is Arrived] = "Yes",
					Encounters[Is Cancelled] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """OP Visits"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Visits
	/// Billed amount in SAR: Σ net_amount of invoices (Phase 2 spec section 8).
	measure 'Billed Amount' =
			VAR __Value = ( -- measure body
				SUM ( Invoices[Net Amount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Invoices]
			RETURN IF ( __Wrong = "", __Value, """Billed Amount"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Billing
	/// Patient collections in SAR: Σ receipt_amount over receipts and cancellations; refunds are excluded (receiving note: refunds = Σ over Refund).
	measure 'Patient Collections' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Cash Receipts'[Receipt Amount] ), 'Cash Receipts'[Receipt Kind] IN { "Receipt", "Cancellation" } )
			) -- end of measure body
			VAR __Wrong = [_Guard Cash Receipts]
			RETURN IF ( __Wrong = "", __Value, """Patient Collections"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Collections
	/// Recognised revenue in SAR: Σ revenue_amount (Phase 2 spec section 8, "Revenue").
	measure Revenue =
			VAR __Value = ( -- measure body
				SUM ( 'Charge Lines'[Revenue Amount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Claimed amount in SAR of the latest, not cancelled submission (Phase 2B spec section 7; receiving notes).
	measure 'Claimed Amount' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Claim Lines'[Line Claimed Amount] ),
					'Claim Lines'[Is Latest Submission] = "Yes",
					'Claim Lines'[Is Cancelled Claim] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Lines]
			RETURN IF ( __Wrong = "", __Value, """Claimed Amount"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Claims
	/// Posted closing balance in SAR at the last period of the selection (an adjustment period wins over its month), signed for display (Phase 3 spec section 8). Snapshot. The last period is taken per branch, so a multi-branch total keeps every branch.
	measure 'GL Closing Balance' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastPeriod = CALCULATE ( MAX ( 'GL Balances'[Period Key] ), REMOVEFILTERS ( 'GL Balances' ), VALUES ( 'Date'[Date] ), VALUES ( 'GL Period'[Period Key] ), VALUES ( Branch[Branch Key] ) )
					RETURN
						CALCULATE (
							SUMX ( 'GL Balances', 'GL Balances'[Closing Balance] * RELATED ( 'FS Line'[Display Sign] ) ),
							'GL Balances'[Period Key] = LastPeriod,
							'GL Balances'[Balance View] = "posted"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """GL Closing Balance"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Balances

		annotation hnh_snapshot = 1
	/// Month-end headcount of the last closed month (is_closed_month) in the selection; the projected current month is excluded. Contingent workers excluded (Phase 4 spec section 7). Snapshot: never summed over months. The last period is taken per branch, so a multi-branch total keeps every branch.
	measure Headcount =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastMonth = CALCULATE ( MAX ( Headcount[Month Date Key] ), REMOVEFILTERS ( Headcount ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ), Headcount[Is Closed Month] = "Yes" )
					RETURN
						CALCULATE (
							SUM ( Headcount[Headcount Units] ),
							Headcount[Month Date Key] = LastMonth,
							Headcount[Is Closed Month] = "Yes",
							Headcount[Is Contingent] = "No"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Headcount]
			RETURN IF ( __Wrong = "", __Value, """Headcount"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Headcount

		annotation hnh_snapshot = 1
	/// Payroll cost in SAR: Σ cost_amount; parallel-run rows are already excluded (Phase 4 spec section 7).
	measure 'Payroll Cost' =
			VAR __Value = ( -- measure body
				SUM ( Payroll[Cost Amount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Payroll]
			RETURN IF ( __Wrong = "", __Value, """Payroll Cost"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Payroll
	/// Consumption cost in SAR: Σ consumption_cost of consumption movements (Phase 5 spec section 7).
	measure 'Consumption Cost' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Stock Movements'[Consumption Cost Amount] ), 'Stock Movements'[Is Consumption] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Movements]
			RETURN IF ( __Wrong = "", __Value, """Consumption Cost"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Consumption
	/// Stock value in SAR at the last month-end of the selection, expiry stores excluded (Phase 5 spec section 7). Snapshot. The last period is taken per branch, so a multi-branch total keeps every branch.
	measure 'Stock Value' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastMonth = CALCULATE ( MAX ( 'Stock Monthly'[Month Date Key] ), REMOVEFILTERS ( 'Stock Monthly' ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ) )
					RETURN
						CALCULATE (
							SUM ( 'Stock Monthly'[Stock Value Amount] ),
							'Stock Monthly'[Month Date Key] = LastMonth,
							'Stock Monthly'[Is Expiry Store] = "No"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Monthly]
			RETURN IF ( __Wrong = "", __Value, """Stock Value"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Stock

		annotation hnh_snapshot = 1
	/// Hospital NPS on the 5-point "recommend" question: (promoters − detractors) ÷ answers × 100; under 30 answers shows "insufficient sample" (Phase 6 spec section 7).
	measure 'Hospital NPS (5-point)' =
			VAR __Value = ( -- measure body
				VAR Answers = CALCULATE ( COUNTROWS ( 'Survey Answers' ), 'Survey Answers'[NPS Role] = "Hospital NPS" )
				VAR Net =
					CALCULATE (
						SUM ( 'Survey Answers'[Is Promoter] ) - SUM ( 'Survey Answers'[Is Detractor] ),
						'Survey Answers'[NPS Role] = "Hospital NPS"
					)
				RETURN IF ( Answers > 0, DIVIDE ( Net, Answers ) * 100 )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Hospital NPS (5-point)"" can't be analysed by " & __Wrong )
		displayFolder: Patient Experience\NPS
	
		formatStringDefinition =
				VAR Answers = CALCULATE ( COUNTROWS ( 'Survey Answers' ), 'Survey Answers'[NPS Role] = "Hospital NPS" )
				RETURN IF ( Answers < 30, """insufficient sample""", "0.0" )
	/// Primary survey invitations (Phase 6 spec section 7.1).
	measure Invitations =
			VAR __Value = ( -- measure body
				CALCULATE ( COUNTROWS ( 'Survey Responses' ), 'Survey Responses'[Is Primary For Encounter] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Invitations"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Survey Quality
	/// Responded ÷ primary invitations (Phase 6 spec 7.1 as amended in the receiving notes: not ÷ SMS sent, because a third of submitted surveys have no SMS date).
	measure 'Response Rate %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Surveys Responded], [Invitations] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Response Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Survey Quality
	/// The login SSAS sees for this connection; use it to check row-level security from a report.
	measure 'Current User' = USERPRINCIPALNAME ()
		formatString: General
		displayFolder: Diagnostics

	/// Emergency visits: ER encounters that are not cancelled (gold spec section 8).
	measure 'ER Visits' =
			VAR __Value = ( -- measure body
				CALCULATE (
					COUNTROWS ( Encounters ),
					KEEPFILTERS ( Encounters[Encounter Type] = "ER" ),
					Encounters[Is Cancelled] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """ER Visits"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Visits
	/// Census: OP visits plus ER visits (gold spec section 8).
	measure Census =
			VAR __Value = ( -- measure body
				[OP Visits] + [ER Visits]
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """Census"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Visits
	/// Distinct patients with an arrived, not cancelled OP or ER encounter (gold spec section 8; IP rows are admissions).
	measure 'Unique Patients' =
			VAR __Value = ( -- measure body
				CALCULATE (
					DISTINCTCOUNT ( Encounters[Patient Key] ),
					KEEPFILTERS ( Encounters[Encounter Type] IN { "OP", "ER" } ),
					Encounters[Is Arrived] = "Yes",
					Encounters[Is Cancelled] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """Unique Patients"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Patients
	/// Arrived OP and ER encounters with visit type New patient (gold spec section 8).
	measure 'New Patients' =
			VAR __Value = ( -- measure body
				CALCULATE (
					COUNTROWS ( Encounters ),
					KEEPFILTERS ( Encounters[Encounter Type] IN { "OP", "ER" } ),
					KEEPFILTERS ( Encounters[Visit Type] = "New patient" ),
					Encounters[Is Arrived] = "Yes"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """New Patients"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Patients
	/// Distinct returning patients (is_returning) among arrived, not cancelled OP and ER encounters (gold spec section 8).
	measure 'Returning Patients' =
			VAR __Value = ( -- measure body
				CALCULATE (
					DISTINCTCOUNT ( Encounters[Patient Key] ),
					KEEPFILTERS ( Encounters[Encounter Type] IN { "OP", "ER" } ),
					Encounters[Is Arrived] = "Yes",
					Encounters[Is Cancelled] = "No",
					Encounters[Is Returning] = "Yes"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """Returning Patients"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Patients
	/// Average waiting minutes of arrived, not cancelled OP and ER encounters; ER wait is arrival to treatment start (gold spec section 8; receiving notes).
	measure 'Average Wait (min)' =
			VAR __Value = ( -- measure body
				CALCULATE (
					AVERAGE ( Encounters[Wait Minutes] ),
					KEEPFILTERS ( Encounters[Encounter Type] IN { "OP", "ER" } ),
					Encounters[Is Arrived] = "Yes",
					Encounters[Is Cancelled] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """Average Wait (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Patient Flow\Waiting
	/// Median waiting minutes of arrived, not cancelled OP and ER encounters (gold spec section 8).
	measure 'Median Wait (min)' =
			VAR __Value = ( -- measure body
				CALCULATE (
					MEDIAN ( Encounters[Wait Minutes] ),
					KEEPFILTERS ( Encounters[Encounter Type] IN { "OP", "ER" } ),
					Encounters[Is Arrived] = "Yes",
					Encounters[Is Cancelled] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """Median Wait (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Patient Flow\Waiting
	/// Sum of waiting minutes, the figure the old reports published; use the average or median for comparisons (gold spec section 8 corrections).
	measure 'Total Wait (min)' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( Encounters[Wait Minutes] ),
					KEEPFILTERS ( Encounters[Encounter Type] IN { "OP", "ER" } ),
					Encounters[Is Arrived] = "Yes",
					Encounters[Is Cancelled] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """Total Wait (min)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Waiting
	/// Average ER length of stay in minutes, arrival to completion, of arrived, not cancelled ER encounters (receiving notes).
	measure 'Average ER LOS (min)' =
			VAR __Value = ( -- measure body
				CALCULATE (
					AVERAGE ( Encounters[ER LOS Minutes] ),
					KEEPFILTERS ( Encounters[Encounter Type] = "ER" ),
					Encounters[Is Arrived] = "Yes",
					Encounters[Is Cancelled] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """Average ER LOS (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Patient Flow\Waiting
	/// No-shows ÷ booked appointments that are not walk-ins and not cancelled (gold spec section 8).
	measure 'No-show Rate %' =
			VAR __Value = ( -- measure body
				VAR Booked =
					CALCULATE (
						COUNTROWS ( Encounters ),
						KEEPFILTERS ( Encounters[Encounter Type] IN { "OP", "ER" } ),
						Encounters[Is Walk In] = "No",
						Encounters[Is Cancelled] = "No"
					)
				VAR NoShows =
					CALCULATE (
						COUNTROWS ( Encounters ),
						KEEPFILTERS ( Encounters[Encounter Type] IN { "OP", "ER" } ),
						Encounters[Is Walk In] = "No",
						Encounters[Is Cancelled] = "No",
						Encounters[Is No Show] = "Yes"
					)
				RETURN DIVIDE ( NoShows, Booked )
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """No-show Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Flow\Appointments
	/// Cancelled ÷ booked appointments (not walk-ins), cancelled ones included in the denominator (gold spec section 8).
	measure 'Cancellation Rate %' =
			VAR __Value = ( -- measure body
				VAR Booked =
					CALCULATE (
						COUNTROWS ( Encounters ),
						KEEPFILTERS ( Encounters[Encounter Type] IN { "OP", "ER" } ),
						Encounters[Is Walk In] = "No"
					)
				VAR Cancelled =
					CALCULATE (
						COUNTROWS ( Encounters ),
						KEEPFILTERS ( Encounters[Encounter Type] IN { "OP", "ER" } ),
						Encounters[Is Walk In] = "No",
						Encounters[Is Cancelled] = "Yes"
					)
				RETURN DIVIDE ( Cancelled, Booked )
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """Cancellation Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Flow\Appointments
	/// Episodes with an arrived encounter that is not a follow-up, by episode start date (gold spec section 8).
	measure Episodes =
			VAR __Value = ( -- measure body
				CALCULATE ( COUNTROWS ( Episodes ), Episodes[Has Arrived Non Follow Up Encounter] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Episodes]
			RETURN IF ( __Wrong = "", __Value, """Episodes"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Episodes
	/// Admissions counted by the old warehouse rule (see Admissions), by physical discharge date.
	measure Discharges =
			VAR __Value = ( -- measure body
				CALCULATE (
					COUNTROWS ( Admissions ),
					Admissions[Is Countable] = "Yes",
					USERELATIONSHIP ( Admissions[Physical Discharge Date Key], 'Date'[Date Key] )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions]
			RETURN IF ( __Wrong = "", __Value, """Discharges"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Admissions
	/// Average length of stay in days of the period's discharges (old warehouse rule, see Admissions); slice by Is LTC for the LTC split (old rule: more than 30 days to discharge or to now, or referred as LTC).
	measure 'ALOS (days)' =
			VAR __Value = ( -- measure body
				CALCULATE (
					AVERAGE ( Admissions[LOS Days] ),
					Admissions[Is Countable] = "Yes",
					USERELATIONSHIP ( Admissions[Physical Discharge Date Key], 'Date'[Date Key] )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions]
			RETURN IF ( __Wrong = "", __Value, """ALOS (days)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Patient Flow\Admissions
	/// 30-day readmissions ÷ admissions, by admit date, old warehouse rule: 30 days or less from the patient's previous admission (admit to admit).
	measure 'Readmission Rate 30d %' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Admissions], Admissions[Is Readmission 30d] = "Yes" ), [Admissions] )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions]
			RETURN IF ( __Wrong = "", __Value, """Readmission Rate 30d %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Flow\Admissions
	/// Admissions within 2 calendar days of the patient's previous admission whose last ward is named ICU or CCU (old warehouse rule).
	measure 'ICU Readmissions 48h' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Admissions], Admissions[Is ICU Readmission 48h] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions]
			RETURN IF ( __Wrong = "", __Value, """ICU Readmissions 48h"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Admissions
	/// Countable admissions from OP or ER ÷ OP and ER episodes whose consultant's specialty admits (gold spec section 8; episodes as in the Episodes measure).
	measure 'Conversion Rate %' =
			VAR __Value = ( -- measure body
				VAR Converted =
					CALCULATE (
						[Admissions],
						REMOVEFILTERS ( 'Care Type' ),
						KEEPFILTERS ( 'Admission Source'[Admission Source] IN { "OP", "ER" } ),
						KEEPFILTERS ( TREATAS ( VALUES ( 'Care Type'[Care Type] ), 'Admission Source'[Admission Source] ) )
					)
				VAR Eligible =
					CALCULATE (
						[Episodes],
						KEEPFILTERS ( 'Care Type'[Care Type] IN { "OP", "ER" } ),
						KEEPFILTERS ( TREATAS ( VALUES ( 'Admission Source'[Admission Source] ), 'Care Type'[Care Type] ) ),
						REMOVEFILTERS ( 'Admission Source' ),
						Staff[Is Non Admitting Specialty] = "No"
					)
				RETURN DIVIDE ( Converted, Eligible )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Episodes | Admission Source]
			RETURN IF ( __Wrong = "", __Value, """Conversion Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Flow\Admissions

		annotation hnh_guard_allow = Admission Source
	/// Discharges ÷ average available beds of inpatient, not excluded wards over the days in the period (gold spec section 8).
	measure 'Bed Turnover' =
			VAR __Value = ( -- measure body
				VAR BedDays =
					CALCULATE (
						SUM ( 'Bed Occupancy'[Is Available] ),
						'Bed Occupancy'[Is Inpatient Ward] = "Yes",
						'Bed Occupancy'[Is Excluded Ward] = "No"
					)
				VAR Days =
					CALCULATE (
						DISTINCTCOUNT ( 'Bed Occupancy'[Date Key] ),
						'Bed Occupancy'[Is Inpatient Ward] = "Yes",
						'Bed Occupancy'[Is Excluded Ward] = "No"
					)
				RETURN DIVIDE ( [Discharges], DIVIDE ( BedDays, Days ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Bed Occupancy]
			RETURN IF ( __Wrong = "", __Value, """Bed Turnover"" can't be analysed by " & __Wrong )
		formatString: #,0.00
		displayFolder: Patient Flow\Occupancy
	/// Attended ÷ scheduled clinic slots (gold spec section 8).
	measure 'Clinic Utilisation %' =
			VAR __Value = ( -- measure body
				DIVIDE ( SUM ( 'Clinic Capacity'[Slots Attended] ), SUM ( 'Clinic Capacity'[Slots Total] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Clinic Capacity]
			RETURN IF ( __Wrong = "", __Value, """Clinic Utilisation %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Flow\Clinics
	/// Operations that are not cancelled, by operation date (gold spec section 8).
	measure 'Theatre Volume' =
			VAR __Value = ( -- measure body
				CALCULATE ( COUNTROWS ( Surgeries ), Surgeries[Is Cancelled] = "No" )
			) -- end of measure body
			VAR __Wrong = [_Guard Surgeries]
			RETURN IF ( __Wrong = "", __Value, """Theatre Volume"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Theatre
	/// Target census of the most likely scenario unless a scenario is selected (gold spec 7.7).
	measure 'Target Census' =
			VAR __Value = ( -- measure body
				VAR Scenario =
					FILTER (
						ALL ( Targets[Scenario] ),
						IF ( ISFILTERED ( Targets[Scenario] ), Targets[Scenario] IN VALUES ( Targets[Scenario] ), Targets[Scenario] = "most_likely" )
					)
				RETURN CALCULATE ( SUM ( Targets[Target Census] ), Scenario )
			) -- end of measure body
			VAR __Wrong = [_Guard Targets]
			RETURN IF ( __Wrong = "", __Value, """Target Census"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Targets
	/// Target episodes of the most likely scenario unless a scenario is selected (gold spec 7.7).
	measure 'Target Episodes' =
			VAR __Value = ( -- measure body
				VAR Scenario =
					FILTER (
						ALL ( Targets[Scenario] ),
						IF ( ISFILTERED ( Targets[Scenario] ), Targets[Scenario] IN VALUES ( Targets[Scenario] ), Targets[Scenario] = "most_likely" )
					)
				RETURN CALCULATE ( SUM ( Targets[Target Episodes] ), Scenario )
			) -- end of measure body
			VAR __Wrong = [_Guard Targets]
			RETURN IF ( __Wrong = "", __Value, """Target Episodes"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Targets
	/// Target revenue in SAR of the most likely scenario unless a scenario is selected (gold spec 7.7).
	measure 'Target Revenue' =
			VAR __Value = ( -- measure body
				VAR Scenario =
					FILTER (
						ALL ( Targets[Scenario] ),
						IF ( ISFILTERED ( Targets[Scenario] ), Targets[Scenario] IN VALUES ( Targets[Scenario] ), Targets[Scenario] = "most_likely" )
					)
				RETURN CALCULATE ( SUM ( Targets[Target Revenue] ), Scenario )
			) -- end of measure body
			VAR __Wrong = [_Guard Targets]
			RETURN IF ( __Wrong = "", __Value, """Target Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Targets
	/// Target cost per episode in SAR = Σ target_cost_total ÷ Σ target_episodes, never a sum of the per-row value (receiving notes).
	measure 'Target Cost per Episode' =
			VAR __Value = ( -- measure body
				VAR Scenario =
					FILTER (
						ALL ( Targets[Scenario] ),
						IF ( ISFILTERED ( Targets[Scenario] ), Targets[Scenario] IN VALUES ( Targets[Scenario] ), Targets[Scenario] = "most_likely" )
					)
				RETURN CALCULATE ( DIVIDE ( SUM ( Targets[Target Cost Total] ), SUM ( Targets[Target Episodes] ) ), Scenario )
			) -- end of measure body
			VAR __Wrong = [_Guard Targets]
			RETURN IF ( __Wrong = "", __Value, """Target Cost per Episode"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Targets
	/// Target ALOS in days of inpatient stay types = Σ target patient days ÷ Σ target episodes (the episode-weighted target_alos; receiving notes).
	measure 'Target ALOS (days)' =
			VAR __Value = ( -- measure body
				VAR Scenario =
					FILTER (
						ALL ( Targets[Scenario] ),
						IF ( ISFILTERED ( Targets[Scenario] ), Targets[Scenario] IN VALUES ( Targets[Scenario] ), Targets[Scenario] = "most_likely" )
					)
				RETURN
					CALCULATE (
						DIVIDE ( SUM ( Targets[Target Patient Days] ), SUM ( Targets[Target Episodes] ) ),
						Scenario,
						KEEPFILTERS ( Targets[Stay Type] IN { "Non-LTC", "LTC" } )
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Targets]
			RETURN IF ( __Wrong = "", __Value, """Target ALOS (days)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Patient Flow\Targets
	/// Gross charges in SAR of recognised revenue lines (Phase 2 spec section 9).
	measure 'Gross Charges' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Charge Lines'[Gross Amount] ), 'Charge Lines'[Is Recognised Revenue] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """Gross Charges"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Line discount in SAR of recognised revenue lines (Phase 2 spec section 9).
	measure 'Line Discount' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Charge Lines'[Line Discount Amount] ), 'Charge Lines'[Is Recognised Revenue] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """Line Discount"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// VAT in SAR of recognised revenue lines (Phase 2 spec section 9).
	measure VAT =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Charge Lines'[VAT Amount] ), 'Charge Lines'[Is Recognised Revenue] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """VAT"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Claimable revenue in SAR: Σ claimable_amount (Phase 2 spec section 9).
	measure 'Claimable Revenue' =
			VAR __Value = ( -- measure body
				SUM ( 'Charge Lines'[Claimable Amount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """Claimable Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Revenue in SAR of patient-share (deductible and co-pay) lines (Phase 2 spec section 9).
	measure 'Patient Share Revenue' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Revenue], KEEPFILTERS ( 'Charge Lines'[Is Patient Share] = "Yes" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """Patient Share Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Revenue in SAR of cash-billed lines (Phase 2 spec section 9).
	measure 'Cash Revenue' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Revenue], KEEPFILTERS ( 'Charge Lines'[Is Cash Billed] = "Yes" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """Cash Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Revenue in SAR of medication lines (Phase 2 spec section 9).
	measure 'Medication Revenue' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Revenue], KEEPFILTERS ( 'Charge Lines'[Is Medication] = "Yes" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """Medication Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Revenue in SAR by the episode's payer, so a payer's patients include their co-pay; Revenue slices by the billed payer (Phase 2 spec section 9).
	measure 'Revenue by Episode Payer' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Revenue], USERELATIONSHIP ( 'Charge Lines'[Episode Payer Key], Payer[Payer Key] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """Revenue by Episode Payer"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Package content value in SAR: Σ package_content_amount (Phase 2 spec section 9).
	measure 'Package Content Value' =
			VAR __Value = ( -- measure body
				SUM ( 'Charge Lines'[Package Content Amount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """Package Content Value"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Net amount in SAR of cancelled charge lines (Phase 2 spec section 9).
	measure 'Cancelled Charges' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Charge Lines'[Net Amount] ), KEEPFILTERS ( 'Charge Lines'[Charge Status] = "Cancelled" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """Cancelled Charges"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Post-invoice discount in SAR: Σ adjustment_amount of the credit documents (Phase 2 spec section 9).
	measure 'Post-invoice Discount' =
			VAR __Value = ( -- measure body
				SUM ( 'Revenue Adjustments'[Adjustment Amount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Revenue Adjustments]
			RETURN IF ( __Wrong = "", __Value, """Post-invoice Discount"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Revenue plus post-invoice discount in SAR (Phase 2 spec section 9).
	measure 'Net Revenue After Adjustments' =
			VAR __Value = ( -- measure body
				[Revenue] + [Post-invoice Discount]
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines + Revenue Adjustments]
			RETURN IF ( __Wrong = "", __Value, """Net Revenue After Adjustments"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Billed amount in SAR of verified invoices (Phase 2 spec section 9).
	measure 'Verified Billed Amount' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Billed Amount], KEEPFILTERS ( Invoices[Is Verified] = "Yes" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Invoices]
			RETURN IF ( __Wrong = "", __Value, """Verified Billed Amount"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Billing
	/// Billed statements in SAR: Σ invoice net amount (INVOICE_NET_AMOUNT); slice by the Claim Status hierarchy (claim status spec R1, 6.2).
	measure 'Billed Statements' =
			VAR __Value = ( -- measure body
				SUM ( Invoices[Net Amount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Invoices]
			RETURN IF ( __Wrong = "", __Value, """Billed Statements"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Billing
	/// Billed statements in SAR submitted through NPHIES: every claim status except New, Valid and Invalid (claim status spec R3, 6.2).
	measure 'Billed Submitted to NPHIES' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Billed Statements], KEEPFILTERS ( 'Claim Status'[Submission Channel] = "NPHIES" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Invoices]
			RETURN IF ( __Wrong = "", __Value, """Billed Submitted to NPHIES"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Billing
	/// Billed statements in SAR submitted manually: status New on a purchaser flagged manual submission (claim status spec R4, 6.2).
	measure 'Billed Manual' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Billed Statements], KEEPFILTERS ( 'Claim Status'[Submission Channel] = "Manual" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Invoices]
			RETURN IF ( __Wrong = "", __Value, """Billed Manual"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Billing
	/// Billed statements in SAR not submitted: New on a purchaser not flagged manual, Valid (Under Processing) or Invalid (claim status spec 4.1, 6.2).
	measure 'Billed Not Submitted' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Billed Statements], KEEPFILTERS ( 'Claim Status'[Submission Channel] = "Not submitted" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Invoices]
			RETURN IF ( __Wrong = "", __Value, """Billed Not Submitted"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Billing
	/// Unbilled amount in SAR of episodes, by the episode's last delivery date (Phase 2 spec section 9).
	measure 'Unbilled Amount' =
			VAR __Value = ( -- measure body
				SUM ( 'Episode Billing'[Unbilled Amount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Episode Billing]
			RETURN IF ( __Wrong = "", __Value, """Unbilled Amount"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Billing
	/// Refunds paid back to patients in SAR: Σ receipt_amount of Refund rows (receiving notes).
	measure 'Patient Refunds' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Cash Receipts'[Receipt Amount] ), 'Cash Receipts'[Receipt Kind] = "Refund" )
			) -- end of measure body
			VAR __Wrong = [_Guard Cash Receipts]
			RETURN IF ( __Wrong = "", __Value, """Patient Refunds"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Collections
	/// Outpatient order lines in leak scope; inpatient lines only when Is Inpatient is selected (order fulfilment spec section 8; receiving notes).
	measure 'Order Lines' =
			VAR __Value = ( -- measure body
				VAR Inpatient =
					FILTER (
						ALL ( 'Order Lines'[Is Inpatient] ),
						IF ( ISFILTERED ( 'Order Lines'[Is Inpatient] ) || ISFILTERED ( 'Care Type' ), 'Order Lines'[Is Inpatient] IN VALUES ( 'Order Lines'[Is Inpatient] ), 'Order Lines'[Is Inpatient] = "No" )
					)
				RETURN CALCULATE ( COUNTROWS ( 'Order Lines' ), Inpatient, 'Order Lines'[Is In Leak Scope] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Order Lines]
			RETURN IF ( __Wrong = "", __Value, """Order Lines"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Order Fulfilment
	/// Lost order lines in leak scope, outpatient by default (order fulfilment spec section 8).
	measure 'Lost Lines' =
			VAR __Value = ( -- measure body
				VAR Inpatient =
					FILTER (
						ALL ( 'Order Lines'[Is Inpatient] ),
						IF ( ISFILTERED ( 'Order Lines'[Is Inpatient] ) || ISFILTERED ( 'Care Type' ), 'Order Lines'[Is Inpatient] IN VALUES ( 'Order Lines'[Is Inpatient] ), 'Order Lines'[Is Inpatient] = "No" )
					)
				RETURN
					CALCULATE (
						COUNTROWS ( 'Order Lines' ),
						Inpatient,
						'Order Lines'[Is In Leak Scope] = "Yes",
						'Order Lines'[Is Lost] = "Yes"
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Order Lines]
			RETURN IF ( __Wrong = "", __Value, """Lost Lines"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Order Fulfilment
	/// Lost lines ÷ order lines (order fulfilment spec section 8).
	measure 'Leak Rate %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Lost Lines], [Order Lines] )
			) -- end of measure body
			VAR __Wrong = [_Guard Order Lines]
			RETURN IF ( __Wrong = "", __Value, """Leak Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Revenue Cycle\Order Fulfilment
	/// Ordered value in SAR of lost lines, unit outliers excluded (order fulfilment spec section 8).
	measure 'Lost Value' =
			VAR __Value = ( -- measure body
				VAR Inpatient =
					FILTER (
						ALL ( 'Order Lines'[Is Inpatient] ),
						IF ( ISFILTERED ( 'Order Lines'[Is Inpatient] ) || ISFILTERED ( 'Care Type' ), 'Order Lines'[Is Inpatient] IN VALUES ( 'Order Lines'[Is Inpatient] ), 'Order Lines'[Is Inpatient] = "No" )
					)
				RETURN
					CALCULATE (
						SUM ( 'Order Lines'[Ordered Value] ),
						Inpatient,
						'Order Lines'[Is In Leak Scope] = "Yes",
						'Order Lines'[Is Lost] = "Yes",
						'Order Lines'[Is Unit Outlier] = "No"
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Order Lines]
			RETURN IF ( __Wrong = "", __Value, """Lost Value"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Order Fulfilment
	/// Average of the per-line unit fulfilment ratio (capped at 1) over lines in leak scope; outliers kept (order fulfilment spec section 8).
	measure 'Unit Fulfilment Rate %' =
			VAR __Value = ( -- measure body
				VAR Inpatient =
					FILTER (
						ALL ( 'Order Lines'[Is Inpatient] ),
						IF ( ISFILTERED ( 'Order Lines'[Is Inpatient] ) || ISFILTERED ( 'Care Type' ), 'Order Lines'[Is Inpatient] IN VALUES ( 'Order Lines'[Is Inpatient] ), 'Order Lines'[Is Inpatient] = "No" )
					)
				RETURN CALCULATE ( AVERAGE ( 'Order Lines'[Unit Fulfilment Ratio] ), Inpatient, 'Order Lines'[Is In Leak Scope] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Order Lines]
			RETURN IF ( __Wrong = "", __Value, """Unit Fulfilment Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Revenue Cycle\Order Fulfilment
	/// Partially delivered lines in leak scope, unit outliers excluded (order fulfilment spec section 8; receiving notes).
	measure 'Partially Delivered Lines' =
			VAR __Value = ( -- measure body
				VAR Inpatient =
					FILTER (
						ALL ( 'Order Lines'[Is Inpatient] ),
						IF ( ISFILTERED ( 'Order Lines'[Is Inpatient] ) || ISFILTERED ( 'Care Type' ), 'Order Lines'[Is Inpatient] IN VALUES ( 'Order Lines'[Is Inpatient] ), 'Order Lines'[Is Inpatient] = "No" )
					)
				RETURN
					CALCULATE (
						COUNTROWS ( 'Order Lines' ),
						Inpatient,
						'Order Lines'[Is In Leak Scope] = "Yes",
						'Order Lines'[Is Partially Delivered] = "Yes",
						'Order Lines'[Is Unit Outlier] = "No"
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Order Lines]
			RETURN IF ( __Wrong = "", __Value, """Partially Delivered Lines"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Order Fulfilment
	/// Lost lines in context ÷ lost lines with every filter except the ordering doctor's specialty (order fulfilment spec section 8).
	measure 'Share of Total Lost %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Lost Lines], CALCULATE ( [Lost Lines], REMOVEFILTERS ( Staff[Unified Specialty], Staff[Specialty] ) ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Order Lines]
			RETURN IF ( __Wrong = "", __Value, """Share of Total Lost %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Revenue Cycle\Order Fulfilment
	/// Median minutes from order to first delivery of delivered lines; Consultation and Package are left out (charged at order time) (order fulfilment spec section 8).
	measure 'Order to Delivery Median (min)' =
			VAR __Value = ( -- measure body
				VAR Inpatient =
					FILTER (
						ALL ( 'Order Lines'[Is Inpatient] ),
						IF ( ISFILTERED ( 'Order Lines'[Is Inpatient] ) || ISFILTERED ( 'Care Type' ), 'Order Lines'[Is Inpatient] IN VALUES ( 'Order Lines'[Is Inpatient] ), 'Order Lines'[Is Inpatient] = "No" )
					)
				RETURN
					CALCULATE (
						MEDIAN ( 'Order Lines'[Order To Delivery Minutes] ),
						Inpatient,
						'Order Lines'[Line Status] = "Delivered",
						KEEPFILTERS ( NOT ( 'Order Lines'[Order Category] IN { "Consultation", "Package" } ) )
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Order Lines]
			RETURN IF ( __Wrong = "", __Value, """Order to Delivery Median (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Revenue Cycle\Order Fulfilment
	/// Cancelled lines ÷ all lines (cancelled lines are out of leak scope, so no scope filter), outpatient by default (order fulfilment spec section 8).
	measure 'Order Cancellation Rate %' =
			VAR __Value = ( -- measure body
				VAR Inpatient =
					FILTER (
						ALL ( 'Order Lines'[Is Inpatient] ),
						IF ( ISFILTERED ( 'Order Lines'[Is Inpatient] ) || ISFILTERED ( 'Care Type' ), 'Order Lines'[Is Inpatient] IN VALUES ( 'Order Lines'[Is Inpatient] ), 'Order Lines'[Is Inpatient] = "No" )
					)
				VAR AllLines = CALCULATE ( COUNTROWS ( 'Order Lines' ), Inpatient )
				VAR Cancelled = CALCULATE ( COUNTROWS ( 'Order Lines' ), Inpatient, 'Order Lines'[Line Status] = "Cancelled" )
				RETURN DIVIDE ( Cancelled, AllLines )
			) -- end of measure body
			VAR __Wrong = [_Guard Order Lines]
			RETURN IF ( __Wrong = "", __Value, """Order Cancellation Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Revenue Cycle\Order Fulfilment
	/// Claimed amount in SAR of sent lines of the latest, not cancelled submission (Phase 2B spec section 8).
	measure 'Claims Submitted' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Claim Lines'[Line Claimed Amount] ),
					'Claim Lines'[Is Sent] = "Yes",
					'Claim Lines'[Is Latest Submission] = "Yes",
					'Claim Lines'[Is Cancelled Claim] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Lines]
			RETURN IF ( __Wrong = "", __Value, """Claims Submitted"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Claims
	/// Approved amount in SAR of the latest, not cancelled submission: net amount of approved lines, the NPHIES benefit of partially approved lines, by the line's response outcome (claim status spec 4.2).
	measure 'Claims Approved' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Claim Lines'[Approved Amount] ),
					'Claim Lines'[Is Latest Submission] = "Yes",
					'Claim Lines'[Is Cancelled Claim] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Lines]
			RETURN IF ( __Wrong = "", __Value, """Claims Approved"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Claims
	/// Rejected amount in SAR of the latest, not cancelled submission: net amount of rejected lines, net minus benefit (not below 0) of partially approved lines (claim status spec 4.2); slice by NPHIES Reason for rejections by reason.
	measure 'Claims Rejected' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Claim Lines'[Rejected Amount] ),
					'Claim Lines'[Is Latest Submission] = "Yes",
					'Claim Lines'[Is Cancelled Claim] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Lines]
			RETURN IF ( __Wrong = "", __Value, """Claims Rejected"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Claims
	/// Rejected ÷ (approved + rejected) amount of adjudicated lines of the latest, not cancelled submission (claim status spec 6.2).
	measure 'Claim Rejection Rate %' =
			VAR __Value = ( -- measure body
				VAR Rejected = CALCULATE ( [Claims Rejected], 'Claim Lines'[Adjudication Status] = "Adjudicated" )
				VAR Approved = CALCULATE ( [Claims Approved], 'Claim Lines'[Adjudication Status] = "Adjudicated" )
				RETURN DIVIDE ( Rejected, Approved + Rejected )
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Lines]
			RETURN IF ( __Wrong = "", __Value, """Claim Rejection Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Claims & Pre-auth\Claims
	/// Rejected ÷ (approved + rejected) of first submissions (submission 1 as sent, cancelled claims included: the one exception to the cancelled rule) (claim status spec 6.2).
	measure 'First-pass Rejection Rate %' =
			VAR __Value = ( -- measure body
				VAR Rejected =
					CALCULATE (
						SUM ( 'Claim Lines'[Rejected Amount] ),
						'Claim Lines'[Submission Number] = 1,
						'Claim Lines'[Adjudication Status] = "Adjudicated"
					)
				VAR Approved =
					CALCULATE (
						SUM ( 'Claim Lines'[Approved Amount] ),
						'Claim Lines'[Submission Number] = 1,
						'Claim Lines'[Adjudication Status] = "Adjudicated"
					)
				RETURN DIVIDE ( Rejected, Approved + Rejected )
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Lines]
			RETURN IF ( __Wrong = "", __Value, """First-pass Rejection Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Claims & Pre-auth\Claims
	/// Approved amount in SAR of latest, not cancelled resubmissions (submission number above 1) (Phase 2B spec section 8).
	measure 'Resubmission Recovery' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Claim Lines'[Approved Amount] ),
					'Claim Lines'[Is Latest Submission] = "Yes",
					'Claim Lines'[Is Cancelled Claim] = "No",
					'Claim Lines'[Submission Number] > 1
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Lines]
			RETURN IF ( __Wrong = "", __Value, """Resubmission Recovery"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Claims
	/// Claimed amount in SAR of sent, latest, not cancelled lines with no response or pended (Phase 2B spec section 8).
	measure 'Pending Adjudication' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Claim Lines'[Line Claimed Amount] ),
					'Claim Lines'[Is Sent] = "Yes",
					'Claim Lines'[Is Latest Submission] = "Yes",
					'Claim Lines'[Is Cancelled Claim] = "No",
					KEEPFILTERS ( 'Claim Lines'[Adjudication Status] IN { "No response", "Pended" } )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Lines]
			RETURN IF ( __Wrong = "", __Value, """Pending Adjudication"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Claims
	/// Claim remittance in SAR from NPHIES payment lines; advances are in Payer Advances; not insurer AR (Phase 2B spec section 8; receiving notes).
	measure Remitted =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Claim Payments'[Payment Amount] ), 'Claim Payments'[Detail Type] = "payment" )
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Payments]
			RETURN IF ( __Wrong = "", __Value, """Remitted"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Payments
	/// Money paid by payers as advances in SAR (detail type advance); not claim remittance (receiving notes).
	measure 'Payer Advances' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Claim Payments'[Payment Amount] ), 'Claim Payments'[Detail Type] = "advance" )
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Payments]
			RETURN IF ( __Wrong = "", __Value, """Payer Advances"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Payments
	/// Early fee in SAR as signed by the payer; reported beside the NPHIES fee, never netted (Phase 2B spec section 8).
	measure 'Early Fee' =
			VAR __Value = ( -- measure body
				SUM ( 'Claim Payments'[Early Fee] )
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Payments]
			RETURN IF ( __Wrong = "", __Value, """Early Fee"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Payments
	/// NPHIES fee in SAR as signed by the payer (Phase 2B spec section 8).
	measure 'NPHIES Fee' =
			VAR __Value = ( -- measure body
				SUM ( 'Claim Payments'[NPHIES Fee] )
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Payments]
			RETURN IF ( __Wrong = "", __Value, """NPHIES Fee"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Payments
	/// Median days from statement to payment of payment lines, for one payment month only (blank over longer periods: bulk back-settlements skew them) (Phase 2B spec section 8; receiving notes).
	measure 'Median Days to Payment' =
			VAR __Value = ( -- measure body
				IF (
					HASONEVALUE ( 'Date'[Year Month] ),
					CALCULATE ( MEDIAN ( 'Claim Payments'[Days To Payment] ), 'Claim Payments'[Detail Type] = "payment" )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Payments]
			RETURN IF ( __Wrong = "", __Value, """Median Days to Payment"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Claims & Pre-auth\Payments
	/// Pre-auth service lines, payer advance authorisations excluded (Phase 2 spec section 9; receiving notes).
	measure 'Pre-auth Services' =
			VAR __Value = ( -- measure body
				CALCULATE ( COUNTROWS ( 'Pre-auth Lines' ), KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Pre-auth Services"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Distinct pre-auth requests per branch, added over branches; payer advances excluded (Phase 2 spec section 9).
	measure 'Pre-auth Requests' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					CALCULATE (
						DISTINCTCOUNTNOBLANK ( 'Pre-auth Lines'[Request No] ),
						KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" )
					)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Pre-auth Requests"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Approved lines with a final response ÷ lines with a final response (Phase 2 spec section 9; receiving notes).
	measure 'Pre-auth Approval Rate %' =
			VAR __Value = ( -- measure body
				VAR Final = CALCULATE ( [Pre-auth Services], 'Pre-auth Lines'[Has Final Response] = "Yes" )
				VAR Approved =
					CALCULATE ( [Pre-auth Services], 'Pre-auth Lines'[Has Final Response] = "Yes", 'Pre-auth Lines'[Is Approved] = "Yes" )
				RETURN DIVIDE ( Approved, Final )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Pre-auth Approval Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Rejected lines with a final response ÷ lines with a final response (Phase 2 spec section 9; receiving notes).
	measure 'Pre-auth Rejection Rate %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Pre-auth Rejected Lines], CALCULATE ( [Pre-auth Services], 'Pre-auth Lines'[Has Final Response] = "Yes" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Pre-auth Rejection Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Lines approved at the first response ÷ approved lines with a final response (Phase 2 spec section 9).
	measure 'Approved First Time %' =
			VAR __Value = ( -- measure body
				VAR Approved =
					CALCULATE ( [Pre-auth Services], 'Pre-auth Lines'[Has Final Response] = "Yes", 'Pre-auth Lines'[Is Approved] = "Yes" )
				VAR FirstTime =
					CALCULATE (
						[Pre-auth Services],
						'Pre-auth Lines'[Has Final Response] = "Yes",
						'Pre-auth Lines'[Is Approved] = "Yes",
						'Pre-auth Lines'[Is First Response Approved] = "Yes"
					)
				RETURN DIVIDE ( FirstTime, Approved )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Approved First Time %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Requests with a resubmitted line ÷ requests (Phase 2 spec section 9).
	measure 'Pre-auth Resubmission Rate %' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Pre-auth Requests], 'Pre-auth Lines'[Is Resubmitted] = "Yes" ), [Pre-auth Requests] )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Pre-auth Resubmission Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Transfer lines ÷ lines (Phase 2 spec section 9).
	measure 'Pre-auth Transfer Rate %' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Pre-auth Services], 'Pre-auth Lines'[Is Transfer] = "Yes" ), [Pre-auth Services] )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Pre-auth Transfer Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Average minutes from request to first send (Phase 2 spec section 9).
	measure 'Request to Sent Avg (min)' =
			VAR __Value = ( -- measure body
				CALCULATE ( AVERAGE ( 'Pre-auth Lines'[Request To Sent Minutes] ), KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Request to Sent Avg (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Claims & Pre-auth\Pre-auth Turnaround
	/// Median minutes from request to first send (Phase 2 spec section 9).
	measure 'Request to Sent Median (min)' =
			VAR __Value = ( -- measure body
				CALCULATE ( MEDIAN ( 'Pre-auth Lines'[Request To Sent Minutes] ), KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Request to Sent Median (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Claims & Pre-auth\Pre-auth Turnaround
	/// Average minutes from send to the final response (Phase 2 spec section 9).
	measure 'Sent to Response Avg (min)' =
			VAR __Value = ( -- measure body
				CALCULATE ( AVERAGE ( 'Pre-auth Lines'[Sent To Response Minutes] ), KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Sent to Response Avg (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Claims & Pre-auth\Pre-auth Turnaround
	/// Median minutes from send to the final response (Phase 2 spec section 9).
	measure 'Sent to Response Median (min)' =
			VAR __Value = ( -- measure body
				CALCULATE ( MEDIAN ( 'Pre-auth Lines'[Sent To Response Minutes] ), KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Sent to Response Median (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Claims & Pre-auth\Pre-auth Turnaround
	/// Average minutes from request to the final response (Phase 2 spec section 9).
	measure 'Total Turnaround Avg (min)' =
			VAR __Value = ( -- measure body
				CALCULATE ( AVERAGE ( 'Pre-auth Lines'[Total Turnaround Minutes] ), KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Total Turnaround Avg (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Claims & Pre-auth\Pre-auth Turnaround
	/// Median minutes from request to the final response (Phase 2 spec section 9).
	measure 'Total Turnaround Median (min)' =
			VAR __Value = ( -- measure body
				CALCULATE ( MEDIAN ( 'Pre-auth Lines'[Total Turnaround Minutes] ), KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Total Turnaround Median (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Claims & Pre-auth\Pre-auth Turnaround
	/// Approved lines that were never delivered (Phase 2 spec section 9).
	measure 'Unutilised Approvals' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Pre-auth Services], 'Pre-auth Lines'[Is Approved Not Delivered] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Unutilised Approvals"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Unutilised approvals ÷ lines (Phase 2 spec section 9).
	measure 'Unutilised Approval Rate %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Unutilised Approvals], [Pre-auth Services] )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Unutilised Approval Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Approved estimated amount in SAR of approved, undelivered lines on the latest request for the service (Phase 2 spec section 9).
	measure 'Pre-auth Lost Revenue' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Pre-auth Lines'[Approved Estimated Amount] ),
					KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ),
					'Pre-auth Lines'[Is Approved Not Delivered] = "Yes",
					'Pre-auth Lines'[Is Latest Request For Service] = "Yes"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Pre-auth Lost Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Estimated amount in SAR of rejected lines on the latest request for the service (Phase 2 spec section 9).
	measure 'Pre-auth Rejected Revenue' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Pre-auth Lines'[Estimated Amount] ),
					KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ),
					'Pre-auth Lines'[Preauth Outcome] = "Rejected",
					'Pre-auth Lines'[Is Latest Request For Service] = "Yes"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Pre-auth Rejected Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Lines delivered without an approval (Phase 2 spec section 9).
	measure 'Delivered Without Approval' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Pre-auth Services], 'Pre-auth Lines'[Is Delivered Not Approved] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Delivered Without Approval"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Estimated amount in SAR of lines delivered without an approval (Phase 2 spec section 9).
	measure 'Delivered Without Approval Amount' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Pre-auth Lines'[Estimated Amount] ),
					KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ),
					'Pre-auth Lines'[Is Delivered Not Approved] = "Yes"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Delivered Without Approval Amount"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Rejected pre-auth lines with a final response; slice by NPHIES Reason for rejections by reason (Phase 2B spec section 8).
	measure 'Pre-auth Rejected Lines' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Pre-auth Services], 'Pre-auth Lines'[Preauth Outcome] = "Rejected", 'Pre-auth Lines'[Has Final Response] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Pre-auth Rejected Lines"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Payer-initiated advance authorisations, by the payer's creation date (receiving notes).
	measure 'Advance Authorisations' =
			VAR __Value = ( -- measure body
				CALCULATE ( COUNTROWS ( 'Pre-auth Lines' ), KEEPFILTERS ( 'Pre-auth Lines'[Line Source] = "Payer advance" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Advance Authorisations"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Advance Authorisations
	/// Payer approved amount in SAR of advance authorisations, placeholders of 0 and 1 SAR included as sent (receiving notes).
	measure 'Advance Approved Amount' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Pre-auth Lines'[Payer Approved Amount] ), KEEPFILTERS ( 'Pre-auth Lines'[Line Source] = "Payer advance" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Advance Approved Amount"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Advance Authorisations
	/// Closing balance in SAR including unposted journals, at the last period of the selection per branch, signed for display (Phase 3 spec section 8; receiving notes). Snapshot.
	measure 'GL Closing Balance (incl. Unposted)' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastPeriod = CALCULATE ( MAX ( 'GL Balances'[Period Key] ), REMOVEFILTERS ( 'GL Balances' ), VALUES ( 'Date'[Date] ), VALUES ( 'GL Period'[Period Key] ), VALUES ( Branch[Branch Key] ) )
					RETURN
						CALCULATE (
							SUMX ( 'GL Balances', 'GL Balances'[Closing Balance] * RELATED ( 'FS Line'[Display Sign] ) ),
							'GL Balances'[Period Key] = LastPeriod,
							'GL Balances'[Balance View] = "including_unposted"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """GL Closing Balance (incl. Unposted)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Balances

		annotation hnh_snapshot = 1
	/// Posted period movement in SAR, signed for display; use it for balances and year to date (Phase 3 spec section 8).
	measure 'GL Movement' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUMX ( 'GL Balances', 'GL Balances'[Period Movement] * RELATED ( 'FS Line'[Display Sign] ) ),
					'GL Balances'[Balance View] = "posted"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """GL Movement"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Balances
	/// Period movement in SAR including unposted journals, signed for display (Phase 3 spec section 8).
	measure 'GL Movement (incl. Unposted)' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUMX ( 'GL Balances', 'GL Balances'[Period Movement] * RELATED ( 'FS Line'[Display Sign] ) ),
					'GL Balances'[Balance View] = "including_unposted"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """GL Movement (incl. Unposted)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Balances
	/// Posted movement in SAR without the go-live opening-balance journals, for monthly trends (Phase 3 spec section 8; receiving notes).
	measure 'GL Movement Trend' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUMX ( 'GL Balances', 'GL Balances'[Period Movement Excl Opening] * RELATED ( 'FS Line'[Display Sign] ) ),
					'GL Balances'[Balance View] = "posted"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """GL Movement Trend"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Balances
	/// Movement in SAR including unposted journals, without opening-balance journals, for monthly trends (Phase 3 spec section 8).
	measure 'GL Movement Trend (incl. Unposted)' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUMX ( 'GL Balances', 'GL Balances'[Period Movement Excl Opening] * RELATED ( 'FS Line'[Display Sign] ) ),
					'GL Balances'[Balance View] = "including_unposted"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """GL Movement Trend (incl. Unposted)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Balances
	/// Equity line Profit for the year in SAR = −Σ posted closing balance of income-statement accounts at the last period per branch, so assets = liabilities + equity (receiving notes). Snapshot.
	measure 'Profit for the Year' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastPeriod = CALCULATE ( MAX ( 'GL Balances'[Period Key] ), REMOVEFILTERS ( 'GL Balances' ), VALUES ( 'Date'[Date] ), VALUES ( 'GL Period'[Period Key] ), VALUES ( Branch[Branch Key] ) )
					RETURN
						- CALCULATE (
							SUM ( 'GL Balances'[Closing Balance] ),
							'GL Balances'[Period Key] = LastPeriod,
							'GL Balances'[Balance View] = "posted",
							'GL Account'[Balance Side] = "IS"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """Profit for the Year"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Balances

		annotation hnh_snapshot = 1
	/// Profit for the year in SAR including unposted journals (receiving notes). Snapshot.
	measure 'Profit for the Year (incl. Unposted)' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastPeriod = CALCULATE ( MAX ( 'GL Balances'[Period Key] ), REMOVEFILTERS ( 'GL Balances' ), VALUES ( 'Date'[Date] ), VALUES ( 'GL Period'[Period Key] ), VALUES ( Branch[Branch Key] ) )
					RETURN
						- CALCULATE (
							SUM ( 'GL Balances'[Closing Balance] ),
							'GL Balances'[Period Key] = LastPeriod,
							'GL Balances'[Balance View] = "including_unposted",
							'GL Account'[Balance Side] = "IS"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """Profit for the Year (incl. Unposted)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Balances

		annotation hnh_snapshot = 1
	/// Posted actual in SAR of one budget code, on the code's natural side; blank across several codes, whose sum is meaningless (Phase 3 spec section 8; receiving notes).
	measure 'IS Actual' =
			VAR __Value = ( -- measure body
				IF ( HASONEVALUE ( 'Budget Line'[Budget Line Code] ), SUM ( 'Income Statement'[Actual Posted] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """IS Actual"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Statement
	/// Actual in SAR including unposted journals, of one budget code (Phase 3 spec section 8).
	measure 'IS Actual (incl. Unposted)' =
			VAR __Value = ( -- measure body
				IF ( HASONEVALUE ( 'Budget Line'[Budget Line Code] ), SUM ( 'Income Statement'[Actual Including Unposted] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """IS Actual (incl. Unposted)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Statement
	/// Actual in SAR without opening-balance journals, of one budget code, for monthly trends (Phase 3 spec 6.3).
	measure 'IS Actual (excl. Opening)' =
			VAR __Value = ( -- measure body
				IF ( HASONEVALUE ( 'Budget Line'[Budget Line Code] ), SUM ( 'Income Statement'[Actual Excl Opening] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """IS Actual (excl. Opening)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Statement
	/// Most likely budget in SAR of one budget code (Phase 3 spec section 8; budget covers branches 1-6).
	measure 'IS Budget' =
			VAR __Value = ( -- measure body
				IF ( HASONEVALUE ( 'Budget Line'[Budget Line Code] ), SUM ( 'Income Statement'[Budget Most Likely] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """IS Budget"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Budget
	/// Budget to compare with the actual: IS Budget, except DC_MEDICINES, which compares with the DC_MEDICINES + DC_CONSUMABLES budget (receiving notes, O-P3-8).
	measure 'IS Budget (Comparable)' =
			VAR __Value = ( -- measure body
				IF (
					HASONEVALUE ( 'Budget Line'[Budget Line Code] ),
					IF (
						SELECTEDVALUE ( 'Budget Line'[Budget Line Code] ) = "DC_MEDICINES",
						CALCULATE (
							SUM ( 'Income Statement'[Budget Most Likely] ),
							REMOVEFILTERS ( 'Budget Line' ),
							'Budget Line'[Budget Line Code] IN { "DC_MEDICINES", "DC_CONSUMABLES" }
						),
						[IS Budget]
					)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """IS Budget (Comparable)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Budget
	/// Actual − comparable budget in SAR of one budget code (Phase 3 spec section 8).
	measure 'Budget Variance' =
			VAR __Value = ( -- measure body
				[IS Actual] - [IS Budget (Comparable)]
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """Budget Variance"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Budget
	/// Budget variance ÷ the absolute comparable budget (Phase 3 spec section 8).
	measure 'Budget Variance %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Budget Variance], ABS ( [IS Budget (Comparable)] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """Budget Variance %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Finance\Budget
	/// EBITDA in SAR: the EBITDA subtotal of the income statement, posted (Phase 3 spec section 8; never re-derived in DAX).
	measure EBITDA =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Income Statement'[Actual Posted] ), 'Budget Line'[Budget Line Code] = "EBITDA" )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """EBITDA"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Statement
	/// Gross profit in SAR: the GROSS_PROFIT subtotal, posted (Phase 3 spec section 8).
	measure 'Gross Profit' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Income Statement'[Actual Posted] ), 'Budget Line'[Budget Line Code] = "GROSS_PROFIT" )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """Gross Profit"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Statement
	/// Net profit in SAR: the NET_PROFIT subtotal, posted (Phase 3 spec section 8).
	measure 'Net Profit' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Income Statement'[Actual Posted] ), 'Budget Line'[Budget Line Code] = "NET_PROFIT" )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """Net Profit"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Statement
	/// EBITDA ÷ net revenue (REV_NET) (Phase 3 spec section 8).
	measure 'EBITDA Margin %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [EBITDA], CALCULATE ( SUM ( 'Income Statement'[Actual Posted] ), 'Budget Line'[Budget Line Code] = "REV_NET" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """EBITDA Margin %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Finance\Statement
	/// Supplier spend in SAR: Σ spend_amount of AP invoice lines by accounting date (Phase 3 spec section 8).
	measure 'Supplier Spend' =
			VAR __Value = ( -- measure body
				SUM ( 'AP Invoice Lines'[Spend Amount] )
			) -- end of measure body
			VAR __Wrong = [_Guard AP Invoice Lines]
			RETURN IF ( __Wrong = "", __Value, """Supplier Spend"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Payables
	/// Open payables in SAR at the last refresh, by invoice date; credit memos reduce it; filter Invoice Type for invoices only (Phase 3 spec section 8; receiving notes). Snapshot.
	measure 'Open Payables' =
			VAR __Value = ( -- measure body
				SUM ( 'AP Open Items'[Amount Remaining] )
			) -- end of measure body
			VAR __Wrong = [_Guard AP Open Items]
			RETURN IF ( __Wrong = "", __Value, """Open Payables"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Payables

		annotation hnh_snapshot = 1
	/// Open payables in SAR past their due date (days overdue above 0) at the last refresh (Phase 3 spec section 8). Snapshot.
	measure 'Overdue Payables' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'AP Open Items'[Amount Remaining] ), 'AP Open Items'[Days Overdue] > 0 )
			) -- end of measure body
			VAR __Wrong = [_Guard AP Open Items]
			RETURN IF ( __Wrong = "", __Value, """Overdue Payables"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Payables

		annotation hnh_snapshot = 1
	/// Median days from invoice to payment of payments that are not voided (Phase 3 spec section 8).
	measure 'Median Days to Pay' =
			VAR __Value = ( -- measure body
				CALCULATE ( MEDIAN ( 'AP Payments'[Days Invoice To Payment] ), 'AP Payments'[Is Voided] = "No" )
			) -- end of measure body
			VAR __Wrong = [_Guard AP Payments]
			RETURN IF ( __Wrong = "", __Value, """Median Days to Pay"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Finance\Payables
	/// Payments made on or before the due date ÷ payments, voided payments excluded (Phase 3 spec section 8).
	measure 'On-time Payment Rate %' =
			VAR __Value = ( -- measure body
				VAR Payments = CALCULATE ( COUNTROWS ( 'AP Payments' ), 'AP Payments'[Is Voided] = "No" )
				VAR OnTime =
					CALCULATE (
						COUNTROWS ( 'AP Payments' ),
						'AP Payments'[Is Voided] = "No",
						'AP Payments'[Days After Due] <= 0 && NOT ISBLANK ( 'AP Payments'[Days After Due] )
					)
				RETURN DIVIDE ( OnTime, Payments )
			) -- end of measure body
			VAR __Wrong = [_Guard AP Payments]
			RETURN IF ( __Wrong = "", __Value, """On-time Payment Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Finance\Payables
	/// Month-end FTE of the last closed month in the selection per branch, contingent workers excluded (Phase 4 spec section 7). Snapshot.
	measure FTE =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastMonth = CALCULATE ( MAX ( Headcount[Month Date Key] ), REMOVEFILTERS ( Headcount ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ), Headcount[Is Closed Month] = "Yes" )
					RETURN
						CALCULATE (
							SUM ( Headcount[FTE] ),
							Headcount[Month Date Key] = LastMonth,
							Headcount[Is Closed Month] = "Yes",
							Headcount[Is Contingent] = "No"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Headcount]
			RETURN IF ( __Wrong = "", __Value, """FTE"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Workforce\Headcount

		annotation hnh_snapshot = 1
	/// Saudi heads / heads without part-time doctors at the last closed month, by the scorecard rules (bsc ssas spec, Appendix B, KPI 46). Snapshot.
	measure 'Saudisation Rate %' =
			VAR __Value = ( -- measure body
				VAR Saudi =
					SUMX (
						VALUES ( Branch[Branch Key] ),
						VAR LastMonth = [BSC Last Workforce Month]
						RETURN IF ( NOT ISBLANK ( LastMonth ), CALCULATE ( SUM ( 'Workforce Monthly'[Headcount] ), REMOVEFILTERS ( 'Date' ), 'Workforce Monthly'[Month Date Key] = LastMonth, 'Workforce Monthly'[Row Type] = "head", 'Workforce Monthly'[Is Saudi] = 1 ) )
					)
				VAR Heads =
					SUMX (
						VALUES ( Branch[Branch Key] ),
						VAR LastMonth = [BSC Last Workforce Month]
						RETURN IF ( NOT ISBLANK ( LastMonth ), CALCULATE ( SUM ( 'Workforce Monthly'[Headcount] ), REMOVEFILTERS ( 'Date' ), 'Workforce Monthly'[Month Date Key] = LastMonth, 'Workforce Monthly'[Row Type] = "head" ) )
					)
				RETURN DIVIDE ( Saudi, Heads )
			) -- end of measure body
			VAR __Wrong = [_Guard Workforce Monthly]
			RETURN IF ( __Wrong = "", __Value, """Saudisation Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Workforce\Headcount

		annotation hnh_snapshot = 1
	/// Average month-end headcount over the closed months of the selection, from 2026 (Phase 4 spec section 7; receiving notes).
	measure 'Average Headcount' =
			VAR __Value = ( -- measure body
				AVERAGEX ( VALUES ( 'Date'[Year Month] ), [Headcount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Headcount]
			RETURN IF ( __Wrong = "", __Value, """Average Headcount"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Workforce\Headcount
	/// Hire movements in the period (Phase 4 spec section 7).
	measure Hires =
			VAR __Value = ( -- measure body
				CALCULATE ( COUNTROWS ( 'Worker Movements' ), 'Worker Movements'[Is Hire] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Worker Movements]
			RETURN IF ( __Wrong = "", __Value, """Hires"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Movements
	/// Leaver movements in the period (Phase 4 spec section 7).
	measure Leavers =
			VAR __Value = ( -- measure body
				CALCULATE ( COUNTROWS ( 'Worker Movements' ), 'Worker Movements'[Is Leaver] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Worker Movements]
			RETURN IF ( __Wrong = "", __Value, """Leavers"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Movements
	/// Voluntary leaver movements in the period (Phase 4 spec section 7).
	measure 'Voluntary Leavers' =
			VAR __Value = ( -- measure body
				CALCULATE ( COUNTROWS ( 'Worker Movements' ), 'Worker Movements'[Is Voluntary Leaver] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Worker Movements]
			RETURN IF ( __Wrong = "", __Value, """Voluntary Leavers"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Movements
	/// Resignations / average headcount by the scorecard rules: Oasis resignations for branches 1-5, Fusion voluntary leavers for 6-8, part-time doctors in headcount (bsc ssas spec, Appendix B, KPI 43).
	measure 'Turnover Rate %' =
			VAR __Value = ( -- measure body
				DIVIDE ( SUM ( 'Workforce Monthly'[Resignations] ), [BSC Average Headcount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Workforce Monthly]
			RETURN IF ( __Wrong = "", __Value, """Turnover Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Workforce\Movements
	/// Voluntary leavers ÷ average month-end headcount of the period, from 2026 (Phase 4 spec section 7).
	measure 'Voluntary Turnover Rate %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Voluntary Leavers], [Average Headcount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Headcount + Worker Movements]
			RETURN IF ( __Wrong = "", __Value, """Voluntary Turnover Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Workforce\Movements
	/// Gross pay in SAR: Σ gross_pay, parallel-run rows already excluded; open Oasis payroll included (Phase 4 spec section 7; receiving notes).
	measure 'Gross Pay' =
			VAR __Value = ( -- measure body
				SUM ( Payroll[Gross Pay] )
			) -- end of measure body
			VAR __Wrong = [_Guard Payroll]
			RETURN IF ( __Wrong = "", __Value, """Gross Pay"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Payroll
	/// Gross pay in SAR of payroll the branch has not closed yet; it changes until the month is closed (receiving notes).
	measure 'Gross Pay (Open Payroll)' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Gross Pay], KEEPFILTERS ( Payroll[Is Closed Payroll] = "No" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Payroll]
			RETURN IF ( __Wrong = "", __Value, """Gross Pay (Open Payroll)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Payroll
	/// Overtime gross pay ÷ gross pay (Phase 4 spec section 7).
	measure 'Overtime Share %' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Gross Pay], KEEPFILTERS ( 'Pay Category'[Pay Category] = "Overtime" ) ), [Gross Pay] )
			) -- end of measure body
			VAR __Wrong = [_Guard Payroll]
			RETURN IF ( __Wrong = "", __Value, """Overtime Share %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Workforce\Payroll
	/// Average month-end FTE over the closed months of the selection (Phase 4 spec section 7).
	measure 'Average FTE' =
			VAR __Value = ( -- measure body
				AVERAGEX ( VALUES ( 'Date'[Year Month] ), [FTE] )
			) -- end of measure body
			VAR __Wrong = [_Guard Headcount]
			RETURN IF ( __Wrong = "", __Value, """Average FTE"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Workforce\Headcount
	/// Payroll cost in SAR ÷ average FTE of the period (Phase 4 spec section 7).
	measure 'Payroll Cost per FTE' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Payroll Cost], [Average FTE] )
			) -- end of measure body
			VAR __Wrong = [_Guard Headcount + Payroll]
			RETURN IF ( __Wrong = "", __Value, """Payroll Cost per FTE"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Payroll
	/// Counted sick-leave days up to today (receiving notes: planned absence runs into 2027).
	measure 'Sick Days' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Absence Days'[Absence Days] ),
					KEEPFILTERS ( 'Absence Type'[Absence Category] = "Sick" ),
					'Date'[Is Past] = "Yes"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Absence Days]
			RETURN IF ( __Wrong = "", __Value, """Sick Days"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Absence
	/// Sick days ÷ (month-end FTE × past calendar days), over months with a closed headcount (Phase 4 spec section 7).
	measure 'Sick Leave Rate %' =
			VAR __Value = ( -- measure body
				VAR Months =
					FILTER (
						ADDCOLUMNS (
							VALUES ( 'Date'[Year Month] ),
							"@Fte", [FTE],
							"@Days", CALCULATE ( COUNTROWS ( 'Date' ), 'Date'[Is Past] = "Yes" ),
							"@Sick", [Sick Days]
						),
						NOT ISBLANK ( [@Fte] )
					)
				RETURN DIVIDE ( SUMX ( Months, [@Sick] ), SUMX ( Months, [@Fte] * [@Days] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Absence Days + Headcount]
			RETURN IF ( __Wrong = "", __Value, """Sick Leave Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Workforce\Absence
	/// Leave balance in days at the last closed accrual month of the selection per branch: the latest period of each employee and plan in that month (receiving notes). Snapshot.
	measure 'Leave Balance (days)' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastDay =
						CALCULATE (
							MAX ( 'Leave Balances'[Accrual Period Date Key] ),
							REMOVEFILTERS ( 'Leave Balances' ),
							VALUES ( 'Date'[Date] ),
							VALUES ( Branch[Branch Key] ),
							'Leave Balances'[Is Latest In Month] = "Yes",
							'Leave Balances'[Is Closed Period] = "Yes",
							'Date'[Is Past] = "Yes"
						)
					RETURN
						CALCULATE (
							SUM ( 'Leave Balances'[End Balance] ),
							'Leave Balances'[Is Latest In Month] = "Yes",
							'Leave Balances'[Is Closed Period] = "Yes",
							'Date'[Year Month] = INT ( LastDay / 100 )
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Leave Balances]
			RETURN IF ( __Wrong = "", __Value, """Leave Balance (days)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Workforce\Leave

		annotation hnh_snapshot = 1
	/// Leave liability in SAR at the last closed accrual month of the selection per branch (receiving notes). Snapshot.
	measure 'Leave Liability' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastDay =
						CALCULATE (
							MAX ( 'Leave Balances'[Accrual Period Date Key] ),
							REMOVEFILTERS ( 'Leave Balances' ),
							VALUES ( 'Date'[Date] ),
							VALUES ( Branch[Branch Key] ),
							'Leave Balances'[Is Latest In Month] = "Yes",
							'Leave Balances'[Is Closed Period] = "Yes",
							'Date'[Is Past] = "Yes"
						)
					RETURN
						CALCULATE (
							SUM ( 'Leave Balances'[Leave Liability Amount] ),
							'Leave Balances'[Is Latest In Month] = "Yes",
							'Leave Balances'[Is Closed Period] = "Yes",
							'Date'[Year Month] = INT ( LastDay / 100 )
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Leave Balances]
			RETURN IF ( __Wrong = "", __Value, """Leave Liability"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Leave

		annotation hnh_snapshot = 1
	/// Leave balance in days at the latest closed accrual period, whatever dates are selected (receiving notes: latest-position KPI).
	measure 'Current Leave Balance (days)' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Leave Balances'[End Balance] ), 'Leave Balances'[Is Current Balance] = "Yes", REMOVEFILTERS ( 'Date' ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Leave Balances]
			RETURN IF ( __Wrong = "", __Value, """Current Leave Balance (days)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Workforce\Leave
	/// Leave liability in SAR at the latest closed accrual period, whatever dates are selected (receiving notes).
	measure 'Current Leave Liability' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Leave Balances'[Leave Liability Amount] ), 'Leave Balances'[Is Current Balance] = "Yes", REMOVEFILTERS ( 'Date' ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Leave Balances]
			RETURN IF ( __Wrong = "", __Value, """Current Leave Liability"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Leave
	/// Revenue ÷ payroll cost of linked doctors and nurses, a ratio of sums (Phase 4 spec section 7; receiving notes).
	measure 'Revenue per Payroll SAR' =
			VAR __Value = ( -- measure body
				DIVIDE ( SUM ( 'Staff Productivity'[Revenue Amount] ), SUM ( 'Staff Productivity'[Payroll Cost] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Staff Productivity]
			RETURN IF ( __Wrong = "", __Value, """Revenue per Payroll SAR"" can't be analysed by " & __Wrong )
		formatString: #,0.00
		displayFolder: Workforce\Productivity
	/// Encounters seen ÷ FTE-months of linked doctors and nurses (Phase 4 spec section 7).
	measure 'Visits per FTE' =
			VAR __Value = ( -- measure body
				DIVIDE ( SUM ( 'Staff Productivity'[Encounters Seen] ), SUM ( 'Staff Productivity'[FTE] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Staff Productivity]
			RETURN IF ( __Wrong = "", __Value, """Visits per FTE"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Workforce\Productivity
	/// Payroll cost in SAR ÷ encounters seen of linked doctors and nurses (Phase 4 spec section 7).
	measure 'Payroll Cost per Visit' =
			VAR __Value = ( -- measure body
				DIVIDE ( SUM ( 'Staff Productivity'[Payroll Cost] ), SUM ( 'Staff Productivity'[Encounters Seen] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Staff Productivity]
			RETURN IF ( __Wrong = "", __Value, """Payroll Cost per Visit"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Productivity
	/// Consumption quantity in primary units of consumption movements (patient sales − returns + department issues) (Phase 5 spec section 7).
	measure 'Consumption Quantity' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Stock Movements'[Consumption Quantity] ), 'Stock Movements'[Is Consumption] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Movements]
			RETURN IF ( __Wrong = "", __Value, """Consumption Quantity"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Consumption
	/// Consumption cost in SAR at pharmacy stores, plus medication issued from wards (Phase 5 spec section 7).
	measure 'Pharmacy Consumption Cost' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Consumption Cost], KEEPFILTERS ( Store[Store Type] = "Pharmacy" ) )
					+ CALCULATE ( [Consumption Cost], KEEPFILTERS ( Store[Store Type] = "Ward" ), KEEPFILTERS ( 'Item'[Item Group] = "Medication" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Movements]
			RETURN IF ( __Wrong = "", __Value, """Pharmacy Consumption Cost"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Consumption
	/// Recorded cost in SAR of patient consumption lines (Phase 5 spec section 7).
	measure 'Patient Consumption Cost' =
			VAR __Value = ( -- measure body
				SUM ( 'Patient Consumption'[Cost Amount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Patient Consumption]
			RETURN IF ( __Wrong = "", __Value, """Patient Consumption Cost"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Consumption
	/// Revenue − consumption cost in SAR of patient consumption lines whose revenue basis is a charge (receiving notes; package components are separate).
	measure 'Drug and Supply Margin' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Patient Consumption'[Revenue Amount] ) - SUM ( 'Patient Consumption'[Consumption Cost] ),
					'Patient Consumption'[Revenue Basis] = "charge"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Patient Consumption]
			RETURN IF ( __Wrong = "", __Value, """Drug and Supply Margin"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Margin
	/// Margin ÷ revenue of charge-based patient consumption, a ratio of sums (Phase 5 spec section 7).
	measure 'Drug and Supply Margin %' =
			VAR __Value = ( -- measure body
				DIVIDE (
					[Drug and Supply Margin],
					CALCULATE ( SUM ( 'Patient Consumption'[Revenue Amount] ), 'Patient Consumption'[Revenue Basis] = "charge" )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Patient Consumption]
			RETURN IF ( __Wrong = "", __Value, """Drug and Supply Margin %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Supply Chain\Margin
	/// Consumption cost in SAR of package-component dispenses, whose revenue is on the package header (receiving notes).
	measure 'Package Component Cost' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Patient Consumption'[Consumption Cost] ), 'Patient Consumption'[Revenue Basis] = "package_component" )
			) -- end of measure body
			VAR __Wrong = [_Guard Patient Consumption]
			RETURN IF ( __Wrong = "", __Value, """Package Component Cost"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Margin
	/// Stock value at the last closed month-end ÷ (that month's consumption cost ÷ days in the month), per branch, then summed (Phase 5 spec section 7). Snapshot.
	measure 'Days of Stock' =
			VAR __Value = ( -- measure body
				VAR DailyUse =
					SUMX (
						VALUES ( Branch[Branch Key] ),
						VAR LastMonth = CALCULATE ( MAX ( 'Stock Monthly'[Month Date Key] ), REMOVEFILTERS ( 'Stock Monthly' ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ), 'Stock Monthly'[Is Closed Month] = "Yes" )
						RETURN DIVIDE ( CALCULATE ( [Consumption Cost], 'Date'[Year Month] = INT ( LastMonth / 100 ) ), MOD ( LastMonth, 100 ) )
					)
				VAR StockValue =
					SUMX (
						VALUES ( Branch[Branch Key] ),
						VAR LastMonth = CALCULATE ( MAX ( 'Stock Monthly'[Month Date Key] ), REMOVEFILTERS ( 'Stock Monthly' ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ), 'Stock Monthly'[Is Closed Month] = "Yes" )
						RETURN CALCULATE ( SUM ( 'Stock Monthly'[Stock Value Amount] ), 'Stock Monthly'[Month Date Key] = LastMonth, 'Stock Monthly'[Is Expiry Store] = "No" )
					)
				RETURN DIVIDE ( StockValue, DailyUse )
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Monthly + Stock Movements]
			RETURN IF ( __Wrong = "", __Value, """Days of Stock"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Supply Chain\Stock

		annotation hnh_snapshot = 1
	/// Consumption cost of the 12 months to the last closed month-end ÷ average month-end stock value of those months, per branch, then summed (Phase 5 spec section 7). Snapshot.
	measure 'Inventory Turnover' =
			VAR __Value = ( -- measure body
				VAR Consumption12 =
					SUMX (
						VALUES ( Branch[Branch Key] ),
						VAR LastMonth = CALCULATE ( MAX ( 'Stock Monthly'[Month Date Key] ), REMOVEFILTERS ( 'Stock Monthly' ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ), 'Stock Monthly'[Is Closed Month] = "Yes" )
						VAR LastDay = DATE ( INT ( LastMonth / 10000 ), MOD ( INT ( LastMonth / 100 ), 100 ), MOD ( LastMonth, 100 ) )
						RETURN IF ( NOT ISBLANK ( LastMonth ), CALCULATE ( [Consumption Cost], DATESINPERIOD ( 'Date'[Date], LastDay, -12, MONTH ) ) )
					)
				VAR AverageStock =
					SUMX (
						VALUES ( Branch[Branch Key] ),
						VAR LastMonth = CALCULATE ( MAX ( 'Stock Monthly'[Month Date Key] ), REMOVEFILTERS ( 'Stock Monthly' ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ), 'Stock Monthly'[Is Closed Month] = "Yes" )
						VAR LastDay = DATE ( INT ( LastMonth / 10000 ), MOD ( INT ( LastMonth / 100 ), 100 ), MOD ( LastMonth, 100 ) )
						RETURN
							IF (
								NOT ISBLANK ( LastMonth ),
								CALCULATE ( AVERAGEX ( VALUES ( 'Date'[Year Month] ), [Stock Value] ), DATESINPERIOD ( 'Date'[Date], LastDay, -12, MONTH ) )
							)
					)
				RETURN DIVIDE ( Consumption12, AverageStock )
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Monthly + Stock Movements]
			RETURN IF ( __Wrong = "", __Value, """Inventory Turnover"" can't be analysed by " & __Wrong )
		formatString: #,0.00
		displayFolder: Supply Chain\Stock

		annotation hnh_snapshot = 1
	/// Items with stock at the last closed month-end and no consumption in the 90 days to it, per branch (Phase 5 spec section 7). Snapshot.
	measure 'Slow-Moving Items' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastMonth = CALCULATE ( MAX ( 'Stock Monthly'[Month Date Key] ), REMOVEFILTERS ( 'Stock Monthly' ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ), 'Stock Monthly'[Is Closed Month] = "Yes" )
					VAR LastDay = DATE ( INT ( LastMonth / 10000 ), MOD ( INT ( LastMonth / 100 ), 100 ), MOD ( LastMonth, 100 ) )
					VAR InStock =
						CALCULATETABLE (
							VALUES ( 'Stock Monthly'[Item Key] ),
							'Stock Monthly'[Month Date Key] = LastMonth,
							'Stock Monthly'[Is Expiry Store] = "No",
							'Stock Monthly'[Quantity] > 0
						)
					VAR Consumed =
						CALCULATETABLE (
							VALUES ( 'Stock Movements'[Item Key] ),
							'Stock Movements'[Is Consumption] = "Yes",
							DATESINPERIOD ( 'Date'[Date], LastDay, -90, DAY )
						)
					RETURN IF ( NOT ISBLANK ( LastMonth ), COUNTROWS ( EXCEPT ( InStock, Consumed ) ) )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Monthly + Stock Movements]
			RETURN IF ( __Wrong = "", __Value, """Slow-Moving Items"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Stock

		annotation hnh_snapshot = 1
	/// Stock value in SAR at the last closed month-end of items with no consumption in the 90 days to it (Phase 5 spec section 7). Snapshot.
	measure 'Slow-Moving Stock Value' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastMonth = CALCULATE ( MAX ( 'Stock Monthly'[Month Date Key] ), REMOVEFILTERS ( 'Stock Monthly' ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ), 'Stock Monthly'[Is Closed Month] = "Yes" )
					VAR LastDay = DATE ( INT ( LastMonth / 10000 ), MOD ( INT ( LastMonth / 100 ), 100 ), MOD ( LastMonth, 100 ) )
					VAR InStock =
						CALCULATETABLE (
							VALUES ( 'Stock Monthly'[Item Key] ),
							'Stock Monthly'[Month Date Key] = LastMonth,
							'Stock Monthly'[Is Expiry Store] = "No",
							'Stock Monthly'[Quantity] > 0
						)
					VAR Consumed =
						CALCULATETABLE (
							VALUES ( 'Stock Movements'[Item Key] ),
							'Stock Movements'[Is Consumption] = "Yes",
							DATESINPERIOD ( 'Date'[Date], LastDay, -90, DAY )
						)
					RETURN
						IF (
							NOT ISBLANK ( LastMonth ),
							CALCULATE (
								SUM ( 'Stock Monthly'[Stock Value Amount] ),
								'Stock Monthly'[Month Date Key] = LastMonth,
								'Stock Monthly'[Is Expiry Store] = "No",
								'Stock Monthly'[Quantity] > 0,
								EXCEPT ( InStock, Consumed )
							)
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Monthly + Stock Movements]
			RETURN IF ( __Wrong = "", __Value, """Slow-Moving Stock Value"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Stock

		annotation hnh_snapshot = 1
	/// Items with stock at the last closed month-end and no consumption in the 180 days to it, per branch (Phase 5 spec section 7). Snapshot.
	measure 'Dead Stock Items' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastMonth = CALCULATE ( MAX ( 'Stock Monthly'[Month Date Key] ), REMOVEFILTERS ( 'Stock Monthly' ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ), 'Stock Monthly'[Is Closed Month] = "Yes" )
					VAR LastDay = DATE ( INT ( LastMonth / 10000 ), MOD ( INT ( LastMonth / 100 ), 100 ), MOD ( LastMonth, 100 ) )
					VAR InStock =
						CALCULATETABLE (
							VALUES ( 'Stock Monthly'[Item Key] ),
							'Stock Monthly'[Month Date Key] = LastMonth,
							'Stock Monthly'[Is Expiry Store] = "No",
							'Stock Monthly'[Quantity] > 0
						)
					VAR Consumed =
						CALCULATETABLE (
							VALUES ( 'Stock Movements'[Item Key] ),
							'Stock Movements'[Is Consumption] = "Yes",
							DATESINPERIOD ( 'Date'[Date], LastDay, -180, DAY )
						)
					RETURN IF ( NOT ISBLANK ( LastMonth ), COUNTROWS ( EXCEPT ( InStock, Consumed ) ) )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Monthly + Stock Movements]
			RETURN IF ( __Wrong = "", __Value, """Dead Stock Items"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Stock

		annotation hnh_snapshot = 1
	/// Stock value in SAR at the last closed month-end of items with no consumption in the 180 days to it (Phase 5 spec section 7). Snapshot.
	measure 'Dead Stock Value' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastMonth = CALCULATE ( MAX ( 'Stock Monthly'[Month Date Key] ), REMOVEFILTERS ( 'Stock Monthly' ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ), 'Stock Monthly'[Is Closed Month] = "Yes" )
					VAR LastDay = DATE ( INT ( LastMonth / 10000 ), MOD ( INT ( LastMonth / 100 ), 100 ), MOD ( LastMonth, 100 ) )
					VAR InStock =
						CALCULATETABLE (
							VALUES ( 'Stock Monthly'[Item Key] ),
							'Stock Monthly'[Month Date Key] = LastMonth,
							'Stock Monthly'[Is Expiry Store] = "No",
							'Stock Monthly'[Quantity] > 0
						)
					VAR Consumed =
						CALCULATETABLE (
							VALUES ( 'Stock Movements'[Item Key] ),
							'Stock Movements'[Is Consumption] = "Yes",
							DATESINPERIOD ( 'Date'[Date], LastDay, -180, DAY )
						)
					RETURN
						IF (
							NOT ISBLANK ( LastMonth ),
							CALCULATE (
								SUM ( 'Stock Monthly'[Stock Value Amount] ),
								'Stock Monthly'[Month Date Key] = LastMonth,
								'Stock Monthly'[Is Expiry Store] = "No",
								'Stock Monthly'[Quantity] > 0,
								EXCEPT ( InStock, Consumed )
							)
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Monthly + Stock Movements]
			RETURN IF ( __Wrong = "", __Value, """Dead Stock Value"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Stock

		annotation hnh_snapshot = 1
	/// Median days from PO to first receipt of approved POs; prefer it to the average (Oasis outliers above 365 days) (Phase 5 spec section 7; receiving notes).
	measure 'PO Lead Time Median (days)' =
			VAR __Value = ( -- measure body
				CALCULATE ( MEDIAN ( 'Purchase Lines'[Lead Time Days] ), 'Purchase Lines'[Is Approved PO] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Purchase Lines]
			RETURN IF ( __Wrong = "", __Value, """PO Lead Time Median (days)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Supply Chain\Purchasing
	/// Average days from PO to first receipt of approved POs (Phase 5 spec section 7).
	measure 'PO Lead Time Average (days)' =
			VAR __Value = ( -- measure body
				CALCULATE ( AVERAGE ( 'Purchase Lines'[Lead Time Days] ), 'Purchase Lines'[Is Approved PO] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Purchase Lines]
			RETURN IF ( __Wrong = "", __Value, """PO Lead Time Average (days)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Supply Chain\Purchasing
	/// Quantity received ÷ (quantity ordered − quantity cancelled) of approved POs, in the ordering unit (Phase 5 spec section 7).
	measure 'PO Fill Rate %' =
			VAR __Value = ( -- measure body
				CALCULATE (
					DIVIDE (
						SUM ( 'Purchase Lines'[Quantity Received] ),
						SUM ( 'Purchase Lines'[Quantity Ordered] ) - SUM ( 'Purchase Lines'[Quantity Cancelled] )
					),
					'Purchase Lines'[Is Approved PO] = "Yes"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Purchase Lines]
			RETURN IF ( __Wrong = "", __Value, """PO Fill Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Supply Chain\Purchasing
	/// Unit price of the latest approved PO line for one item and one supplier (the highest price if several lines share that date); blank otherwise (Phase 5 spec section 7).
	measure 'Last PO Unit Price' =
			VAR __Value = ( -- measure body
				IF (
					HASONEVALUE ( 'Item'[Item Key] ) && HASONEVALUE ( Supplier[Supplier Key] ),
					VAR LastPo = CALCULATE ( MAX ( 'Purchase Lines'[PO Date Key] ), 'Purchase Lines'[Is Approved PO] = "Yes" )
					RETURN
						CALCULATE (
							MAX ( 'Purchase Lines'[Unit Price] ),
							'Purchase Lines'[PO Date Key] = LastPo,
							'Purchase Lines'[Is Approved PO] = "Yes"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Purchase Lines]
			RETURN IF ( __Wrong = "", __Value, """Last PO Unit Price"" can't be analysed by " & __Wrong )
		formatString: #,0.00
		displayFolder: Supply Chain\Purchasing
	/// Latest ÷ previous approved PO unit price − 1, for one item and one supplier (Phase 5 spec section 7).
	measure 'PO Price Change %' =
			VAR __Value = ( -- measure body
				IF (
					HASONEVALUE ( 'Item'[Item Key] ) && HASONEVALUE ( Supplier[Supplier Key] ),
					VAR LastPo = CALCULATE ( MAX ( 'Purchase Lines'[PO Date Key] ), 'Purchase Lines'[Is Approved PO] = "Yes" )
					VAR PreviousPo =
						CALCULATE (
							MAX ( 'Purchase Lines'[PO Date Key] ),
							'Purchase Lines'[Is Approved PO] = "Yes",
							'Purchase Lines'[PO Date Key] < LastPo
						)
					VAR PreviousPrice =
						CALCULATE (
							MAX ( 'Purchase Lines'[Unit Price] ),
							'Purchase Lines'[PO Date Key] = PreviousPo,
							'Purchase Lines'[Is Approved PO] = "Yes"
						)
					VAR Ratio = DIVIDE ( [Last PO Unit Price], PreviousPrice )
					RETURN IF ( NOT ISBLANK ( PreviousPo ) && NOT ISBLANK ( Ratio ), Ratio - 1 )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Purchase Lines]
			RETURN IF ( __Wrong = "", __Value, """PO Price Change %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Supply Chain\Purchasing
	/// AP spend matched to POs ÷ total AP spend (Phase 5 spec section 7, with Phase 3's AP invoice lines).
	measure 'PO-Matched Spend Share %' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Supplier Spend], KEEPFILTERS ( 'AP Invoice Lines'[Is PO Matched] = "Yes" ) ), [Supplier Spend] )
			) -- end of measure body
			VAR __Wrong = [_Guard AP Invoice Lines]
			RETURN IF ( __Wrong = "", __Value, """PO-Matched Spend Share %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Supply Chain\Purchasing
	/// Oasis lines Fusion has not received ÷ Oasis lines from go-live (in Fusion or a gap), as rec_stock_interface_daily (Phase 5 spec section 7).
	measure 'Fusion Interface Gap %' =
			VAR __Value = ( -- measure body
				VAR Gap =
					CALCULATE ( COUNTROWS ( 'Stock Movements' ), 'Stock Movements'[Is Fusion Gap] = "Yes", 'Stock Movements'[Is In Oasis] = "Yes" )
				VAR InFusion =
					CALCULATE ( COUNTROWS ( 'Stock Movements' ), 'Stock Movements'[Source System] = "fusion", 'Stock Movements'[Is In Oasis] = "Yes" )
				RETURN DIVIDE ( Gap, Gap + InFusion )
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Movements]
			RETURN IF ( __Wrong = "", __Value, """Fusion Interface Gap %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Supply Chain\Interface
	/// Every survey invitation, primary or repeat (Phase 6 spec 7.1, secondary measure).
	measure 'All Invitations' =
			VAR __Value = ( -- measure body
				COUNTROWS ( 'Survey Responses' )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """All Invitations"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Survey Quality
	/// Primary invitations with an SMS sent ÷ primary invitations (Phase 6 spec 7.1).
	measure 'SMS Reach %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Invitations (SMS)], [Invitations] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """SMS Reach %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Survey Quality
	/// Submitted ÷ responded primary invitations (Phase 6 spec 7.1).
	measure 'Completion Rate %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Surveys Submitted], [Surveys Responded] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Completion Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Survey Quality
	/// Scored questions answered ÷ offered, over responded primary invitations (Phase 6 spec 7.1).
	measure 'Answer Completeness %' =
			VAR __Value = ( -- measure body
				CALCULATE (
					DIVIDE ( SUM ( 'Survey Responses'[Scored Questions Answered] ), SUM ( 'Survey Responses'[Scored Questions Offered] ) ),
					'Survey Responses'[Is Primary For Encounter] = "Yes",
					'Survey Responses'[Is Responded] = "Yes"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Answer Completeness %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Survey Quality
	/// Median days from visit to answer of responded primary invitations; only submitted surveys have it (Phase 6 spec 7.1; receiving notes).
	measure 'Median Days Visit to Answer' =
			VAR __Value = ( -- measure body
				CALCULATE (
					MEDIAN ( 'Survey Responses'[Days Visit To Answer] ),
					'Survey Responses'[Is Primary For Encounter] = "Yes",
					'Survey Responses'[Is Responded] = "Yes"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Median Days Visit to Answer"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Patient Experience\Survey Quality
	/// Primary invitations linked to an encounter ÷ primary invitations (Phase 6 spec 7.1).
	measure 'Encounter Link %' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Invitations], KEEPFILTERS ( 'Survey Responses'[Link Status] = "Linked" ) ), [Invitations] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Encounter Link %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Survey Quality
	/// Responded primary invitations with a known doctor ÷ responded primary invitations (Phase 6 spec 7.1; receiving notes: staff_key <> -1).
	measure 'Doctor Attribution %' =
			VAR __Value = ( -- measure body
				VAR Responded = CALCULATE ( [Invitations], 'Survey Responses'[Is Responded] = "Yes" )
				VAR Attributed =
					CALCULATE ( [Invitations], 'Survey Responses'[Is Responded] = "Yes", 'Survey Responses'[Staff Key] <> -1 )
				RETURN DIVIDE ( Attributed, Responded )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Doctor Attribution %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Survey Quality
	/// Repeat (non-primary) invitations ÷ all invitations (Phase 6 spec 7.1).
	measure 'Repeat Invitation Rate %' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [All Invitations], 'Survey Responses'[Is Primary For Encounter] = "No" ), [All Invitations] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Repeat Invitation Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Survey Quality
	/// Physician NPS on the 5-point question: (promoters − detractors) ÷ answers × 100; under 30 answers shows "insufficient sample" (Phase 6 spec 7.2).
	measure 'Physician NPS (5-point)' =
			VAR __Value = ( -- measure body
				VAR Answers = CALCULATE ( COUNTROWS ( 'Survey Answers' ), 'Survey Answers'[NPS Role] = "Physician NPS" )
				VAR Net =
					CALCULATE (
						SUM ( 'Survey Answers'[Is Promoter] ) - SUM ( 'Survey Answers'[Is Detractor] ),
						'Survey Answers'[NPS Role] = "Physician NPS"
					)
				RETURN IF ( Answers > 0, DIVIDE ( Net, Answers ) * 100 )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Physician NPS (5-point)"" can't be analysed by " & __Wrong )
		displayFolder: Patient Experience\NPS
	
		formatStringDefinition =
				VAR Answers = CALCULATE ( COUNTROWS ( 'Survey Answers' ), 'Survey Answers'[NPS Role] = "Physician NPS" )
				RETURN IF ( Answers < 30, """insufficient sample""", "0.0" )
	/// NPS of any selection (domain, question, doctor, specialty) over scored answers; under 30 answers shows "insufficient sample" (Phase 6 spec 7.2).
	measure 'NPS (5-point)' =
			VAR __Value = ( -- measure body
				VAR Answers = [_Unguarded NPS Answers]
				VAR Net =
					CALCULATE (
						SUM ( 'Survey Answers'[Is Promoter] ) - SUM ( 'Survey Answers'[Is Detractor] ),
						'Survey Answers'[Is Scored] = "Yes"
					)
				RETURN IF ( Answers > 0, DIVIDE ( Net, Answers ) * 100 )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """NPS (5-point)"" can't be analysed by " & __Wrong )
		displayFolder: Patient Experience\NPS
	
		formatStringDefinition =
				IF ( [NPS Answers] < 30, """insufficient sample""", "0.0" )
	/// Scored answers (n), shown next to every NPS (Phase 6 spec 7.2).
	measure 'NPS Answers' =
			VAR __Value = ( -- measure body
				CALCULATE ( COUNTROWS ( 'Survey Answers' ), 'Survey Answers'[Is Scored] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """NPS Answers"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\NPS
	/// Promoter answers ÷ scored answers (Phase 6 spec 7.2).
	measure '% Promoters' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( SUM ( 'Survey Answers'[Is Promoter] ), 'Survey Answers'[Is Scored] = "Yes" ), [_Unguarded NPS Answers] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """% Promoters"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\NPS
	/// Passive answers ÷ scored answers (Phase 6 spec 7.2).
	measure '% Passives' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( SUM ( 'Survey Answers'[Is Passive] ), 'Survey Answers'[Is Scored] = "Yes" ), [_Unguarded NPS Answers] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """% Passives"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\NPS
	/// Detractor answers ÷ scored answers (Phase 6 spec 7.2).
	measure '% Detractors' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( SUM ( 'Survey Answers'[Is Detractor] ), 'Survey Answers'[Is Scored] = "Yes" ), [_Unguarded NPS Answers] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """% Detractors"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\NPS
	/// Primary invitations with at least one answer, submitted or partial (Phase 6 spec 7.1).
	measure 'Surveys Responded' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Invitations], 'Survey Responses'[Is Responded] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Surveys Responded"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Survey Quality
	/// Primary invitations whose survey was completed and submitted (Phase 6 spec 7.1).
	measure 'Surveys Submitted' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Invitations], 'Survey Responses'[Is Submitted] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Surveys Submitted"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Survey Quality
	/// Primary invitations answered in part and not submitted (response status Partial).
	measure 'Surveys Partial' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Invitations], 'Survey Responses'[Response Status] = "Partial" )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Surveys Partial"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Survey Quality
	/// Primary invitations without any answer (response status Not started).
	measure 'Surveys Not Started' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Invitations], 'Survey Responses'[Response Status] = "Not started" )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Surveys Not Started"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Survey Quality
	/// Distinct known patients behind the primary invitations; an unlinked survey has no patient and is left out.
	measure 'Patients Invited' =
			VAR __Value = ( -- measure body
				CALCULATE (
					DISTINCTCOUNT ( 'Survey Responses'[Patient Key] ),
					'Survey Responses'[Is Primary For Encounter] = "Yes",
					'Survey Responses'[Patient Key] <> -1
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Patients Invited"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Survey Quality
	/// Distinct known patients who answered at least one question on a primary invitation.
	measure 'Patients Responded' =
			VAR __Value = ( -- measure body
				CALCULATE (
					DISTINCTCOUNT ( 'Survey Responses'[Patient Key] ),
					'Survey Responses'[Is Primary For Encounter] = "Yes",
					'Survey Responses'[Is Responded] = "Yes",
					'Survey Responses'[Patient Key] <> -1
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Patients Responded"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Survey Quality
	/// Primary invitations whose survey SMS was sent (SMS channel).
	measure 'Invitations (SMS)' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Invitations], 'Survey Responses'[Is SMS Sent] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Invitations (SMS)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Survey Channel
	/// Primary invitations without an SMS: surveys conducted by a call-centre agent.
	measure 'Invitations (Agent Call)' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Invitations], 'Survey Responses'[Is SMS Sent] = "No" )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Invitations (Agent Call)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Survey Channel
	/// Responded primary invitations of the SMS channel.
	measure 'Responded (SMS)' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Surveys Responded], 'Survey Responses'[Is SMS Sent] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Responded (SMS)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Survey Channel
	/// Responded primary invitations of the call-centre agent channel (no SMS sent).
	measure 'Responded (Agent Call)' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Surveys Responded], 'Survey Responses'[Is SMS Sent] = "No" )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Responded (Agent Call)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Survey Channel
	/// Responded ÷ invited, SMS channel.
	measure 'Response Rate % (SMS)' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Responded (SMS)], [Invitations (SMS)] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Response Rate % (SMS)"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Survey Channel
	/// Responded ÷ invited, call-centre agent channel.
	measure 'Response Rate % (Agent Call)' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Responded (Agent Call)], [Invitations (Agent Call)] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Response Rate % (Agent Call)"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Survey Channel
	/// Submitted ÷ responded, SMS channel.
	measure 'Completion Rate % (SMS)' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Completion Rate %], 'Survey Responses'[Is SMS Sent] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Completion Rate % (SMS)"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Survey Channel
	/// Submitted ÷ responded, call-centre agent channel.
	measure 'Completion Rate % (Agent Call)' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Completion Rate %], 'Survey Responses'[Is SMS Sent] = "No" )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Completion Rate % (Agent Call)"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Survey Channel
	/// Agent-call responses ÷ all responses.
	measure 'Agent Call Share of Responses %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Responded (Agent Call)], [Surveys Responded] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Agent Call Share of Responses %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Survey Channel
	/// Partial responses ÷ responded primary invitations.
	measure 'Partial Rate %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Surveys Partial], [Surveys Responded] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Partial Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Data Quality
	/// Primary invitations whose patient has no recorded gender (or no patient) ÷ primary invitations.
	measure 'Unknown Gender %' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Invitations], Patient[Gender] = "Unknown" ), [Invitations] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Unknown Gender %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Data Quality
	/// 1 for a visit month with 1,000 or more primary invitations network-wide over the whole month, whatever else is selected; the months that count for the sample-vs-visits comparison, so a month whose surveys are still arriving is left out.
	measure 'Month Has 1000+ Invitations' =
			VAR __Value = ( -- measure body
				CALCULATE (
					IF ( [Invitations] >= 1000, 1 ),
					REMOVEFILTERS ( Branch ),
					REMOVEFILTERS ( Patient ),
					REMOVEFILTERS ( Payer ),
					REMOVEFILTERS ( Staff ),
					REMOVEFILTERS ( Department ),
					REMOVEFILTERS ( 'Survey Service' ),
					REMOVEFILTERS ( 'Care Type' ),
					-- the fact's expanded table includes Date: remove its own columns' filters, then keep the month
					REMOVEFILTERS ( 'Survey Responses' ),
					VALUES ( 'Date'[Start Of Month] )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Month Has 1000+ Invitations"" can't be analysed by " & __Wrong )
		formatString: 0
		displayFolder: Patient Experience\Sample Size
	/// Visits of the population the linked surveys in context come from: ER Visits, OP Visits and Admissions for the care types (ER, OP, IP) of the linked primary invitations, in the months with 1,000+ invitations. The survey's care type is the linked encounter's, so a care-setting selection maps itself.
	measure 'Actual Visits' =
			VAR __Value = ( -- measure body
				VAR Months = FILTER ( VALUES ( 'Date'[Start Of Month] ), [Month Has 1000+ Invitations] = 1 )
				VAR Pools =
					CALCULATETABLE (
						DISTINCT ( 'Survey Responses'[Care Type Key] ),
						'Survey Responses'[Is Primary For Encounter] = "Yes",
						'Survey Responses'[Link Status] = "Linked"
					)
				VAR Codes =
					CALCULATETABLE ( FILTER ( VALUES ( 'Care Type'[Care Type] ), 'Care Type'[Care Type] IN { "OP", "ER", "IP" } ), TREATAS ( Pools, 'Care Type'[Care Type Key] ) )
				VAR Visits =
					SUMX (
						Codes,
						VAR Code = 'Care Type'[Care Type]
						RETURN
							CALCULATE (
								SWITCH ( Code, "OP", [_Unguarded OP Visits], "ER", [_Unguarded ER Visits], "IP", [_Unguarded Admissions] ),
								REMOVEFILTERS ( 'Care Type' ),
								KEEPFILTERS ( Months )
							)
					)
				RETURN IF ( Visits > 0, Visits )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """Actual Visits"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Sample Size

		annotation hnh_guard_allow = Survey Service
	/// Visit-matched invitations ÷ actual visits: the share of visits that got a survey.
	measure 'Survey Coverage %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Invitations (Visit-Matched)], [Actual Visits] )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """Survey Coverage %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Sample Size

		annotation hnh_guard_allow = Survey Service
	/// Visit-matched respondents ÷ actual visits: responses per visit.
	measure 'Response Coverage %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Respondents (Visit-Matched)], [Actual Visits] )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """Response Coverage %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Sample Size

		annotation hnh_guard_allow = Survey Service
	/// Responses needed for a ±5% margin at 95% confidence (385), reduced for a small population with the finite-population correction on the actual visits; blank without visit-matched invitations.
	measure 'Required Sample (±5%)' =
			VAR __Value = ( -- measure body
				VAR Base = 1.96 ^ 2 * 0.25 / 0.05 ^ 2
				VAR Visits = [Actual Visits]
				RETURN
					IF (
						NOT ISBLANK ( [Invitations (Visit-Matched)] ),
						IF ( ISBLANK ( Visits ), CEILING ( Base, 1 ), CEILING ( Base / ( 1 + ( Base - 1 ) / Visits ), 1 ) )
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """Required Sample (±5%)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Sample Size

		annotation hnh_guard_allow = Survey Service
	/// Responses still needed to reach the required sample (0 when reached).
	measure 'Sample Gap' =
			VAR __Value = ( -- measure body
				IF ( NOT ISBLANK ( [Required Sample (±5%)] ), MAX ( 0, [Required Sample (±5%)] - [Respondents (Visit-Matched)] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """Sample Gap"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Sample Size

		annotation hnh_guard_allow = Survey Service
	/// Margin of error of a proportion at 95% confidence, 0.98 ÷ √respondents, with the finite-population correction on the actual visits.
	measure 'Margin of Error (±)' =
			VAR __Value = ( -- measure body
				VAR Resp = [Respondents (Visit-Matched)]
				VAR Visits = [Actual Visits]
				VAR Moe = DIVIDE ( 0.98, SQRT ( Resp ) )
				RETURN IF ( Resp > 0, IF ( ISBLANK ( Visits ) || Visits <= Resp, Moe, Moe * SQRT ( ( Visits - Resp ) / ( Visits - 1 ) ) ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """Margin of Error (±)"" can't be analysed by " & __Wrong )
		formatString: ±0.0%
		displayFolder: Patient Experience\Sample Size

		annotation hnh_guard_allow = Survey Service
	/// Primary invitations linked to an ER, OP or IP visit in the months with 1,000+ invitations: the invitations that can be compared with actual visits.
	measure 'Invitations (Visit-Matched)' =
			VAR __Value = ( -- measure body
				VAR Months = FILTER ( VALUES ( 'Date'[Start Of Month] ), [Month Has 1000+ Invitations] = 1 )
				RETURN
					CALCULATE ( [Invitations], 'Survey Responses'[Link Status] = "Linked", KEEPFILTERS ( TREATAS ( { "OP", "ER", "IP" }, 'Care Type'[Care Type] ) ), KEEPFILTERS ( Months ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Invitations (Visit-Matched)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Representativeness
	/// Responded primary invitations linked to an ER, OP or IP visit in the months with 1,000+ invitations.
	measure 'Respondents (Visit-Matched)' =
			VAR __Value = ( -- measure body
				VAR Months = FILTER ( VALUES ( 'Date'[Start Of Month] ), [Month Has 1000+ Invitations] = 1 )
				RETURN
					CALCULATE ( [Surveys Responded], 'Survey Responses'[Link Status] = "Linked", KEEPFILTERS ( TREATAS ( { "OP", "ER", "IP" }, 'Care Type'[Care Type] ) ), KEEPFILTERS ( Months ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Respondents (Visit-Matched)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Representativeness
	/// Visit-matched respondents ÷ visit-matched invitations.
	measure 'Response Rate % (Visit-Matched)' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Respondents (Visit-Matched)], [Invitations (Visit-Matched)] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Response Rate % (Visit-Matched)"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Representativeness
	/// Share of the selection's visit-matched respondents in this group. By care type the share is raw; for any other group the responses are first re-weighted to each care type's share of visits, so inpatient over-sampling does not distort it.
	measure 'Response Share %' =
			VAR __Value = ( -- measure body
				VAR R = CALCULATE ( [Respondents (Visit-Matched)], ALLSELECTED () )
				VAR V = CALCULATE ( [Actual Visits], ALLSELECTED () )
				VAR W =
					CALCULATETABLE (
						ADDCOLUMNS (
							FILTER ( VALUES ( 'Care Type'[Care Type] ), 'Care Type'[Care Type] IN { "OP", "ER", "IP" } ),
							"@w", DIVIDE ( DIVIDE ( [Actual Visits], V ), DIVIDE ( [Respondents (Visit-Matched)], R ) )
						),
						ALLSELECTED ()
					)
				RETURN
					IF (
						ISINSCOPE ( 'Care Type'[Care Type Name] ) || ISINSCOPE ( 'Care Type'[Care Type] ),
						DIVIDE ( [Respondents (Visit-Matched)], R ),
						DIVIDE ( SUMX ( W, [Respondents (Visit-Matched)] * [@w] ), R )
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """Response Share %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Representativeness

		annotation hnh_guard_allow = Survey Service
	/// Share of the selection's actual visits in this group.
	measure 'Visit Share %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Actual Visits], CALCULATE ( [Actual Visits], ALLSELECTED () ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """Visit Share %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Representativeness

		annotation hnh_guard_allow = Survey Service
	/// Response share ÷ visit share: 1.00 is a fair share, under 0.80 under-represented, over 1.25 over-represented.
	measure 'Representation Index' =
			VAR __Value = ( -- measure body
				VAR V = [Visit Share %]
				RETURN IF ( V > 0, DIVIDE ( [Response Share %] + 0, V ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """Representation Index"" can't be analysed by " & __Wrong )
		formatString: 0.00
		displayFolder: Patient Experience\Representativeness

		annotation hnh_guard_allow = Survey Service
	/// Fair share (index 0.80–1.25), Under, Over, or No visit data when there are respondents but no visits.
	measure 'Representation Status' =
			VAR __Value = ( -- measure body
				VAR I = [Representation Index]
				RETURN
					SWITCH (
						TRUE (),
						ISBLANK ( I ), IF ( [Respondents (Visit-Matched)] > 0, "No visit data" ),
						I < 0.8, "Under",
						I > 1.25, "Over",
						"Fair share"
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """Representation Status"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Patient Experience\Representativeness

		annotation hnh_guard_allow = Survey Service
	/// ½ Σ |response share − visit share| over branches, responses re-weighted to the care-type mix of visits: the share of responses that would have to move for the branch mix to match the visits.
	measure 'Mismatch (Branch)' =
			VAR __Value = ( -- measure body
				VAR R = [Respondents (Visit-Matched)]
				VAR V = [Actual Visits]
				VAR W =
					ADDCOLUMNS (
						FILTER ( VALUES ( 'Care Type'[Care Type] ), 'Care Type'[Care Type] IN { "OP", "ER", "IP" } ),
						"@w", DIVIDE ( DIVIDE ( [Actual Visits], V ), DIVIDE ( [Respondents (Visit-Matched)], R ) )
					)
				RETURN
					IF (
						R > 0 && V > 0,
						0.5
							* SUMX (
								VALUES ( Branch[Branch Name] ),
								ABS ( DIVIDE ( SUMX ( W, [Respondents (Visit-Matched)] * [@w] ), R ) - DIVIDE ( [Actual Visits], V ) )
							)
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """Mismatch (Branch)"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Representativeness

		annotation hnh_guard_allow = Survey Service
	/// ½ Σ |response share − visit share| over the care types ER, OP and IP.
	measure 'Mismatch (Care Type)' =
			VAR __Value = ( -- measure body
				VAR R = [Respondents (Visit-Matched)]
				VAR V = [Actual Visits]
				RETURN
					IF (
						R > 0 && V > 0,
						0.5 * SUMX ( VALUES ( 'Care Type'[Care Type] ), ABS ( DIVIDE ( [Respondents (Visit-Matched)], R ) - DIVIDE ( [Actual Visits], V ) ) )
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """Mismatch (Care Type)"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Representativeness

		annotation hnh_guard_allow = Survey Service
	/// ½ Σ |response share − visit share| over patient gender, responses re-weighted to the care-type mix of visits.
	measure 'Mismatch (Gender)' =
			VAR __Value = ( -- measure body
				VAR R = [Respondents (Visit-Matched)]
				VAR V = [Actual Visits]
				VAR W =
					ADDCOLUMNS (
						FILTER ( VALUES ( 'Care Type'[Care Type] ), 'Care Type'[Care Type] IN { "OP", "ER", "IP" } ),
						"@w", DIVIDE ( DIVIDE ( [Actual Visits], V ), DIVIDE ( [Respondents (Visit-Matched)], R ) )
					)
				RETURN
					IF (
						R > 0 && V > 0,
						0.5
							* SUMX (
								VALUES ( Patient[Gender] ),
								ABS ( DIVIDE ( SUMX ( W, [Respondents (Visit-Matched)] * [@w] ), R ) - DIVIDE ( [Actual Visits], V ) )
							)
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """Mismatch (Gender)"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Representativeness

		annotation hnh_guard_allow = Survey Service
	/// ½ Σ |response share − visit share| over Saudi / non-Saudi patients, responses re-weighted to the care-type mix of visits.
	measure 'Mismatch (Nationality)' =
			VAR __Value = ( -- measure body
				VAR R = [Respondents (Visit-Matched)]
				VAR V = [Actual Visits]
				VAR W =
					ADDCOLUMNS (
						FILTER ( VALUES ( 'Care Type'[Care Type] ), 'Care Type'[Care Type] IN { "OP", "ER", "IP" } ),
						"@w", DIVIDE ( DIVIDE ( [Actual Visits], V ), DIVIDE ( [Respondents (Visit-Matched)], R ) )
					)
				RETURN
					IF (
						R > 0 && V > 0,
						0.5
							* SUMX (
								VALUES ( Patient[Is Saudi] ),
								ABS ( DIVIDE ( SUMX ( W, [Respondents (Visit-Matched)] * [@w] ), R ) - DIVIDE ( [Actual Visits], V ) )
							)
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """Mismatch (Nationality)"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Representativeness

		annotation hnh_guard_allow = Survey Service
	/// ½ Σ |response share − visit share| over payer categories, responses re-weighted to the care-type mix of visits.
	measure 'Mismatch (Payer)' =
			VAR __Value = ( -- measure body
				VAR R = [Respondents (Visit-Matched)]
				VAR V = [Actual Visits]
				VAR W =
					ADDCOLUMNS (
						FILTER ( VALUES ( 'Care Type'[Care Type] ), 'Care Type'[Care Type] IN { "OP", "ER", "IP" } ),
						"@w", DIVIDE ( DIVIDE ( [Actual Visits], V ), DIVIDE ( [Respondents (Visit-Matched)], R ) )
					)
				RETURN
					IF (
						R > 0 && V > 0,
						0.5
							* SUMX (
								VALUES ( Payer[Category] ),
								ABS ( DIVIDE ( SUMX ( W, [Respondents (Visit-Matched)] * [@w] ), R ) - DIVIDE ( [Actual Visits], V ) )
							)
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """Mismatch (Payer)"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Representativeness

		annotation hnh_guard_allow = Survey Service
	/// Verdict on the worst of the five mismatches: Representative up to 5%, Acceptable up to 10%, else "Skewed by <profile>".
	measure 'Sample Representativeness' =
			VAR __Value = ( -- measure body
				VAR T =
					UNION (
						ROW ( "@who", "branch", "@m", [Mismatch (Branch)] ),
						ROW ( "@who", "care type", "@m", [Mismatch (Care Type)] ),
						ROW ( "@who", "gender", "@m", [Mismatch (Gender)] ),
						ROW ( "@who", "nationality", "@m", [Mismatch (Nationality)] ),
						ROW ( "@who", "payer", "@m", [Mismatch (Payer)] )
					)
				VAR Worst = MAXX ( T, [@m] )
				VAR Who = MAXX ( FILTER ( T, [@m] = Worst ), [@who] )
				RETURN
					SWITCH ( TRUE (), ISBLANK ( Worst ), BLANK (), Worst <= 0.05, "Representative", Worst <= 0.1, "Acceptable", "Skewed by " & Who )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """Sample Representativeness"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Patient Experience\Representativeness

		annotation hnh_guard_allow = Survey Service
	/// Sample Representativeness in one word: Representative, Acceptable or Skewed.
	measure 'Sample Mix' =
			VAR __Value = ( -- measure body
				VAR Verdict = [Sample Representativeness]
				RETURN IF ( LEFT ( Verdict, 6 ) = "Skewed", "Skewed", Verdict )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """Sample Mix"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Patient Experience\Representativeness

		annotation hnh_guard_allow = Survey Service
	/// NPS (5-point) of the answers linked to an ER, OP or IP visit: the NPS as surveyed, on the population the weighted NPS re-weights.
	measure 'NPS (Visit-Matched)' =
			VAR __Value = ( -- measure body
				CALCULATE ( [NPS (5-point)], 'Survey Answers'[Link Status] = "Linked", KEEPFILTERS ( TREATAS ( { "OP", "ER", "IP" }, 'Care Type'[Care Type] ) ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """NPS (Visit-Matched)"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Representativeness
	/// NPS (Visit-Matched) of each branch × care type weighted by its actual visits: what the NPS would be if the sample had the visit mix.
	measure 'Weighted NPS' =
			VAR __Value = ( -- measure body
				VAR Strata = CROSSJOIN ( VALUES ( Branch[Branch Name] ), FILTER ( VALUES ( 'Care Type'[Care Type] ), 'Care Type'[Care Type] IN { "OP", "ER", "IP" } ) )
				VAR T =
					FILTER (
						ADDCOLUMNS ( Strata, "@nps", [NPS (Visit-Matched)], "@v", [Actual Visits] ),
						NOT ISBLANK ( [@nps] ) && [@v] > 0
					)
				RETURN DIVIDE ( SUMX ( T, [@nps] * [@v] ), SUMX ( T, [@v] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Answers + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """Weighted NPS"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Representativeness

		annotation hnh_guard_allow = Survey Service
	/// Weighted NPS − NPS (Visit-Matched), in points.
	measure 'NPS Weighting Effect' =
			VAR __Value = ( -- measure body
				VAR W = [Weighted NPS]
				VAR S = [NPS (Visit-Matched)]
				RETURN IF ( NOT ISBLANK ( W ) && NOT ISBLANK ( S ), W - S )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Answers + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """NPS Weighting Effect"" can't be analysed by " & __Wrong )
		formatString: +0.0;-0.0;0.0
		displayFolder: Patient Experience\Representativeness

		annotation hnh_guard_allow = Survey Service
	/// Distinct survey responses with at least one scored answer.
	measure Respondents =
			VAR __Value = ( -- measure body
				CALCULATE ( DISTINCTCOUNT ( 'Survey Answers'[Survey Response Key] ), 'Survey Answers'[Is Scored] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Respondents"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\NPS
	/// Average of the NPS (5-point) of each question with answers, so every question counts the same whatever its volume.
	measure 'Avg NPS by Question' =
			VAR __Value = ( -- measure body
				AVERAGEX ( FILTER ( VALUES ( 'Survey Question'[Question Key] ), [NPS Answers] > 0 ), [NPS (5-point)] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Avg NPS by Question"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\NPS
	/// NPS (5-point) with 30 or more scored answers, else blank: the ranking version of the score.
	measure 'NPS (n>=30)' =
			VAR __Value = ( -- measure body
				IF ( [NPS Answers] >= 30, [NPS (5-point)] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """NPS (n>=30)"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\NPS
	/// Physician NPS (5-point) with 10 or more physician-question answers, else blank.
	measure 'Physician NPS (n>=10)' =
			VAR __Value = ( -- measure body
				IF ( CALCULATE ( COUNTROWS ( 'Survey Answers' ), 'Survey Answers'[NPS Role] = "Physician NPS" ) >= 10, [Physician NPS (5-point)] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Physician NPS (n>=10)"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\NPS
	/// Average scored answer rescaled to 0–100: 1–5 scales (score − 1) ÷ 4, the 1–4 scale (score − 1) ÷ 3, the 0–10 scale score ÷ 10, each × 100.
	measure 'Overall Satisfaction (0-100)' =
			VAR __Value = ( -- measure body
				VAR Groups =
					CALCULATETABLE (
						ADDCOLUMNS (
							SUMMARIZE ( 'Survey Answers', 'Survey Answers'[Scale Type], 'Survey Answers'[Answer Score] ),
							"@n", CALCULATE ( COUNTROWS ( 'Survey Answers' ) )
						),
						'Survey Answers'[Is Scored] = "Yes",
						NOT ISBLANK ( 'Survey Answers'[Answer Score] )
					)
				VAR Num =
					SUMX (
						Groups,
						[@n]
							* SWITCH (
								'Survey Answers'[Scale Type],
								"likelihood_0_10", 'Survey Answers'[Answer Score] * 10,
								"definitely_1_4", ( 'Survey Answers'[Answer Score] - 1 ) / 3 * 100,
								( 'Survey Answers'[Answer Score] - 1 ) / 4 * 100
							)
					)
				RETURN DIVIDE ( Num, SUMX ( Groups, [@n] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Overall Satisfaction (0-100)"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Satisfaction
	/// Answers at the top of their scale (5 of 5, 4 of 4, 9–10 of 10) ÷ scored answers.
	measure 'Top Box %' =
			VAR __Value = ( -- measure body
				DIVIDE (
					CALCULATE (
						COUNTROWS ( 'Survey Answers' ),
						'Survey Answers'[Is Scored] = "Yes",
						KEEPFILTERS (
							FILTER (
								ALL ( 'Survey Answers'[Scale Type], 'Survey Answers'[Answer Score] ),
								SWITCH (
									'Survey Answers'[Scale Type],
									"likelihood_0_10", 'Survey Answers'[Answer Score] >= 9,
									"definitely_1_4", 'Survey Answers'[Answer Score] = 4,
									'Survey Answers'[Answer Score] = 5
								)
							)
						)
					),
					[NPS Answers]
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Top Box %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Satisfaction
	/// NPS (5-point) of all branches together, shown only when a branch is in view so the comparison means something.
	measure 'Network NPS' =
			VAR __Value = ( -- measure body
				IF ( [NPS Answers] > 0 && ISFILTERED ( Branch ), CALCULATE ( [NPS (5-point)], REMOVEFILTERS ( Branch ) ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Network NPS"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Benchmark
	/// NPS (5-point) − Network NPS, in points.
	measure 'NPS vs Network' =
			VAR __Value = ( -- measure body
				VAR Net = [Network NPS]
				RETURN IF ( NOT ISBLANK ( Net ) && NOT ISBLANK ( [NPS (5-point)] ), [NPS (5-point)] - Net )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """NPS vs Network"" can't be analysed by " & __Wrong )
		formatString: +0.0;-0.0;0.0
		displayFolder: Patient Experience\Benchmark
	/// Overall Satisfaction (0-100) of all branches together, when a branch is in view.
	measure 'Network Overall Satisfaction (0-100)' =
			VAR __Value = ( -- measure body
				IF ( [NPS Answers] > 0 && ISFILTERED ( Branch ), CALCULATE ( [Overall Satisfaction (0-100)], REMOVEFILTERS ( Branch ) ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Network Overall Satisfaction (0-100)"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Benchmark
	/// Response Rate % of all branches together, when there are invitations in context.
	measure 'Network Response Rate %' =
			VAR __Value = ( -- measure body
				IF ( NOT ISBLANK ( [Invitations] ), CALCULATE ( [Response Rate %], REMOVEFILTERS ( Branch ) ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Network Response Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Benchmark
	/// NPS (5-point) of the whole specialty of the doctor(s) in context, across every branch and doctor.
	measure 'Specialty NPS' =
			VAR __Value = ( -- measure body
				IF ( [NPS Answers] > 0, CALCULATE ( [NPS (5-point)], REMOVEFILTERS ( Staff ), VALUES ( Staff[Specialty] ) ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Specialty NPS"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Benchmark
	/// How far the true NPS could be from the measured one at 95% confidence, in points: 1.96 × √((P + D − (P − D)²) ÷ respondents) × 100, with P and D the promoter and detractor shares of scored answers.
	measure 'NPS Margin of Error' =
			VAR __Value = ( -- measure body
				VAR P = [% Promoters]
				VAR D = [% Detractors]
				VAR N = [Respondents]
				RETURN IF ( N > 0, 1.96 * SQRT ( ( P + D - ( P - D ) ^ 2 ) / N ) * 100 )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """NPS Margin of Error"" can't be analysed by " & __Wrong )
		formatString: ±0.0
		displayFolder: Patient Experience\Reliability
	/// High at a margin of ±3 or better, Moderate up to ±7, else Low; No answers without a margin.
	measure Reliability =
			VAR __Value = ( -- measure body
				VAR M = [NPS Margin of Error]
				RETURN SWITCH ( TRUE (), ISBLANK ( M ), "No answers", M <= 3, "High", M <= 7, "Moderate", "Low" )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Reliability"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Patient Experience\Reliability
	/// NPS (5-point) by response attribute. When a Survey Responses attribute (who completed the survey, first visit…) is filtered, the answers are restricted to those responses, since the two facts have no relationship.
	measure 'NPS (Response Attr)' =
			VAR __Value = ( -- measure body
				IF (
					ISFILTERED ( 'Survey Responses' ),
					CALCULATE (
						[_Unguarded NPS (5-point)],
						TREATAS ( VALUES ( 'Survey Responses'[Survey Response Key] ), 'Survey Answers'[Survey Response Key] )
					),
					[_Unguarded NPS (5-point)]
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers + Survey Responses | Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """NPS (Response Attr)"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Patient Profile

		annotation hnh_guard_allow = Survey Responses
	/// Overall Satisfaction (0-100) by response attribute. When a Survey Responses attribute (who completed the survey, first visit…) is filtered, the answers are restricted to those responses, since the two facts have no relationship.
	measure 'Overall Satisfaction (Response Attr)' =
			VAR __Value = ( -- measure body
				IF (
					ISFILTERED ( 'Survey Responses' ),
					CALCULATE (
						[_Unguarded Overall Satisfaction (0-100)],
						TREATAS ( VALUES ( 'Survey Responses'[Survey Response Key] ), 'Survey Answers'[Survey Response Key] )
					),
					[_Unguarded Overall Satisfaction (0-100)]
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers + Survey Responses | Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Overall Satisfaction (Response Attr)"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Patient Profile

		annotation hnh_guard_allow = Survey Responses
	/// % Promoters by response attribute. When a Survey Responses attribute (who completed the survey, first visit…) is filtered, the answers are restricted to those responses, since the two facts have no relationship.
	measure '% Promoters (Response Attr)' =
			VAR __Value = ( -- measure body
				IF (
					ISFILTERED ( 'Survey Responses' ),
					CALCULATE (
						[_Unguarded % Promoters],
						TREATAS ( VALUES ( 'Survey Responses'[Survey Response Key] ), 'Survey Answers'[Survey Response Key] )
					),
					[_Unguarded % Promoters]
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers + Survey Responses | Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """% Promoters (Response Attr)"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Patient Profile

		annotation hnh_guard_allow = Survey Responses
	/// % Detractors by response attribute. When a Survey Responses attribute (who completed the survey, first visit…) is filtered, the answers are restricted to those responses, since the two facts have no relationship.
	measure '% Detractors (Response Attr)' =
			VAR __Value = ( -- measure body
				IF (
					ISFILTERED ( 'Survey Responses' ),
					CALCULATE (
						[_Unguarded % Detractors],
						TREATAS ( VALUES ( 'Survey Responses'[Survey Response Key] ), 'Survey Answers'[Survey Response Key] )
					),
					[_Unguarded % Detractors]
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers + Survey Responses | Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """% Detractors (Response Attr)"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Patient Profile

		annotation hnh_guard_allow = Survey Responses
	/// Respondents by response attribute. When a Survey Responses attribute (who completed the survey, first visit…) is filtered, the answers are restricted to those responses, since the two facts have no relationship.
	measure 'Respondents (Response Attr)' =
			VAR __Value = ( -- measure body
				IF (
					ISFILTERED ( 'Survey Responses' ),
					CALCULATE (
						[_Unguarded Respondents],
						TREATAS ( VALUES ( 'Survey Responses'[Survey Response Key] ), 'Survey Answers'[Survey Response Key] )
					),
					[_Unguarded Respondents]
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers + Survey Responses | Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Respondents (Response Attr)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Patient Profile

		annotation hnh_guard_allow = Survey Responses
	/// NPS Margin of Error on the bridged (Response Attr) shares and respondents.
	measure 'NPS Margin of Error (Response Attr)' =
			VAR __Value = ( -- measure body
				VAR P = [% Promoters (Response Attr)]
				VAR D = [% Detractors (Response Attr)]
				VAR N = [Respondents (Response Attr)]
				RETURN IF ( N > 0, 1.96 * SQRT ( ( P + D - ( P - D ) ^ 2 ) / N ) * 100 )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers + Survey Responses | Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """NPS Margin of Error (Response Attr)"" can't be analysed by " & __Wrong )
		formatString: ±0.0
		displayFolder: Patient Experience\Reliability

		annotation hnh_guard_allow = Survey Responses
	/// Reliability on the bridged (Response Attr) margin of error.
	measure 'Reliability (Response Attr)' =
			VAR __Value = ( -- measure body
				VAR M = [NPS Margin of Error (Response Attr)]
				RETURN SWITCH ( TRUE (), ISBLANK ( M ), "No answers", M <= 3, "High", M <= 7, "Moderate", "Low" )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers + Survey Responses | Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Reliability (Response Attr)"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Patient Experience\Reliability

		annotation hnh_guard_allow = Survey Responses
	/// Minimum scored answers for a question group to be ranked: 30 for the network, 10 for a specialty, 5 for a doctor.
	measure 'Min Answers (Drivers)' =
			SWITCH ( TRUE (), ISFILTERED ( Staff[Staff Name] ), 5, ISFILTERED ( Staff[Specialty] ), 10, 30 )
		formatString: 0
		displayFolder: Patient Experience\Ranking
	/// NPS (5-point) when the group has at least Min Answers (Drivers) scored answers, else blank.
	measure 'NPS (Drivers)' =
			VAR __Value = ( -- measure body
				IF ( [NPS Answers] >= [Min Answers (Drivers)], [NPS (5-point)] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """NPS (Drivers)"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Ranking
	/// Minimum scored answers for a single question to be ranked: 30 for the network, 10 for a specialty, 2 for a doctor.
	measure 'Min Answers (Questions)' =
			SWITCH ( TRUE (), ISFILTERED ( Staff[Staff Name] ), 2, ISFILTERED ( Staff[Specialty] ), 10, 30 )
		formatString: 0
		displayFolder: Patient Experience\Ranking
	/// NPS (5-point) when the question has at least Min Answers (Questions) scored answers, else blank.
	measure 'NPS (Questions)' =
			VAR __Value = ( -- measure body
				IF ( [NPS Answers] >= [Min Answers (Questions)], [NPS (5-point)] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """NPS (Questions)"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Ranking
	/// NPS (Drivers) of the 8 lowest-scoring question groups in the selection (ties alphabetical); every question when drilled down to questions.
	measure 'Group NPS (Bottom 8)' =
			VAR __Value = ( -- measure body
				IF (
					ISINSCOPE ( 'Survey Question'[Question En] ),
					[NPS (Drivers)],
					VAR T =
						TOPN (
							8,
							FILTER ( ALLSELECTED ( 'Survey Question'[Domain En] ), NOT ISBLANK ( [NPS (Drivers)] ) ),
							[NPS (Drivers)], ASC,
							'Survey Question'[Domain En], ASC
						)
					RETURN IF ( SELECTEDVALUE ( 'Survey Question'[Domain En] ) IN T, [NPS (Drivers)] )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Group NPS (Bottom 8)"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Ranking
	/// NPS (Drivers) of the 8 highest-scoring question groups in the selection (ties alphabetical); every question when drilled down to questions.
	measure 'Group NPS (Top 8)' =
			VAR __Value = ( -- measure body
				IF (
					ISINSCOPE ( 'Survey Question'[Question En] ),
					[NPS (Drivers)],
					VAR T =
						TOPN (
							8,
							FILTER ( ALLSELECTED ( 'Survey Question'[Domain En] ), NOT ISBLANK ( [NPS (Drivers)] ) ),
							[NPS (Drivers)], DESC,
							'Survey Question'[Domain En], ASC
						)
					RETURN IF ( SELECTEDVALUE ( 'Survey Question'[Domain En] ) IN T, [NPS (Drivers)] )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Group NPS (Top 8)"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Ranking
	/// 1 when the question in scope is among the 8 lowest-scoring questions (NPS (Questions), ties alphabetical).
	measure 'Is Weak Question' =
			VAR __Value = ( -- measure body
				IF (
					ISINSCOPE ( 'Survey Question'[Question En] ),
					VAR T =
						TOPN (
							8,
							FILTER ( ALLSELECTED ( 'Survey Question'[Domain En], 'Survey Question'[Question En] ), NOT ISBLANK ( [NPS (Questions)] ) ),
							[NPS (Questions)], ASC,
							'Survey Question'[Domain En], ASC,
							'Survey Question'[Question En], ASC
						)
					RETURN IF ( ( SELECTEDVALUE ( 'Survey Question'[Domain En] ), SELECTEDVALUE ( 'Survey Question'[Question En] ) ) IN T, 1 )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Is Weak Question"" can't be analysed by " & __Wrong )
		formatString: 0
		displayFolder: Patient Experience\Ranking
	/// NPS (Questions) of the 8 lowest-scoring questions.
	measure 'Q NPS (Bottom 8)' =
			VAR __Value = ( -- measure body
				IF ( [Is Weak Question] = 1, [NPS (Questions)] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Q NPS (Bottom 8)"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Ranking
	/// % Promoters of the 8 lowest-scoring questions.
	measure 'Q % Promoters (Bottom 8)' =
			VAR __Value = ( -- measure body
				IF ( [Is Weak Question] = 1, [% Promoters] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Q % Promoters (Bottom 8)"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Ranking
	/// % Detractors of the 8 lowest-scoring questions.
	measure 'Q % Detractors (Bottom 8)' =
			VAR __Value = ( -- measure body
				IF ( [Is Weak Question] = 1, [% Detractors] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Q % Detractors (Bottom 8)"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Ranking
	/// NPS Answers of the 8 lowest-scoring questions.
	measure 'Q Answers (Bottom 8)' =
			VAR __Value = ( -- measure body
				IF ( [Is Weak Question] = 1, [NPS Answers] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Q Answers (Bottom 8)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Ranking
	/// Rank of the question group by its network-wide NPS (n>=30), lowest first, among the groups with a network score.
	measure 'Group Network Rank (Low)' =
			VAR __Value = ( -- measure body
				VAR Net = CALCULATE ( [NPS (n>=30)], REMOVEFILTERS ( Branch ) )
				RETURN
					IF (
						NOT ISBLANK ( Net ) && ISINSCOPE ( 'Survey Question'[Domain En] ),
						RANKX (
							FILTER ( ALLSELECTED ( 'Survey Question'[Domain En] ), NOT ISBLANK ( CALCULATE ( [NPS (n>=30)], REMOVEFILTERS ( Branch ) ) ) ),
							CALCULATE ( [NPS (n>=30)], REMOVEFILTERS ( Branch ) ),
							Net, ASC, SKIP
						)
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Group Network Rank (Low)"" can't be analysed by " & __Wrong )
		formatString: 0
		displayFolder: Patient Experience\Ranking
	/// NPS (5-point) of the 5 question groups with the lowest network NPS, by branch; the total when no group is in scope.
	measure 'Weak Group NPS (Bottom 5)' =
			VAR __Value = ( -- measure body
				IF (
					NOT ISINSCOPE ( 'Survey Question'[Domain En] ),
					[NPS (5-point)],
					IF ( NOT ISBLANK ( [Group Network Rank (Low)] ) && [Group Network Rank (Low)] <= 5, [NPS (5-point)] )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Weak Group NPS (Bottom 5)"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Ranking
	/// Rank of the specialty by scored answers across every branch and doctor, most surveyed first; 1 when no specialty is in scope.
	measure 'Specialty Volume Rank' =
			VAR __Value = ( -- measure body
				IF (
					ISINSCOPE ( Staff[Specialty] ),
					RANKX (
						ALLSELECTED ( Staff[Specialty] ),
						CALCULATE ( [NPS Answers], REMOVEFILTERS ( Branch ), REMOVEFILTERS ( Staff[Staff Name] ) ),
						, DESC, SKIP
					),
					1
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Specialty Volume Rank"" can't be analysed by " & __Wrong )
		formatString: 0
		displayFolder: Patient Experience\Ranking
	/// NPS (5-point) of the 15 most-surveyed specialties (and their doctors).
	measure 'Specialty NPS (Top 15 by Volume)' =
			VAR __Value = ( -- measure body
				IF ( NOT ISBLANK ( [Specialty Volume Rank] ) && [Specialty Volume Rank] <= 15, [NPS (5-point)] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Specialty NPS (Top 15 by Volume)"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Ranking
	/// NPS (5-point) of a doctor with 30+ scored answers, with the answer count as a tie-break (÷ 10,000,000); the ranking key of the top and bottom doctor lists.
	measure 'Doctor Score' =
			VAR __Value = ( -- measure body
				IF ( [NPS Answers] >= 30, [NPS (5-point)] + [NPS Answers] / 10000000 )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Doctor Score"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Ranking
	/// 1 when the doctor in scope is among the 8 highest Doctor Scores in the selection.
	measure 'Is Top Doctor' =
			VAR __Value = ( -- measure body
				IF (
					ISINSCOPE ( Staff[Staff Name] )
						&& SELECTEDVALUE ( Staff[Staff Name] )
							IN TOPN ( 8, FILTER ( ALLSELECTED ( Staff[Staff Name] ), NOT ISBLANK ( [Doctor Score] ) ), [Doctor Score], DESC, Staff[Staff Name], ASC ),
					1
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Is Top Doctor"" can't be analysed by " & __Wrong )
		formatString: 0
		displayFolder: Patient Experience\Ranking
	/// 1 when the doctor in scope is among the 8 lowest Doctor Scores in the selection.
	measure 'Is Bottom Doctor' =
			VAR __Value = ( -- measure body
				IF (
					ISINSCOPE ( Staff[Staff Name] )
						&& SELECTEDVALUE ( Staff[Staff Name] )
							IN TOPN ( 8, FILTER ( ALLSELECTED ( Staff[Staff Name] ), NOT ISBLANK ( [Doctor Score] ) ), [Doctor Score], ASC, Staff[Staff Name], ASC ),
					1
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Is Bottom Doctor"" can't be analysed by " & __Wrong )
		formatString: 0
		displayFolder: Patient Experience\Ranking
	/// NPS (n>=30) of the 8 top doctors.
	measure 'Top Doctor NPS' =
			VAR __Value = ( -- measure body
				IF ( [Is Top Doctor] = 1, [NPS (n>=30)] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Top Doctor NPS"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Ranking
	/// Specialty NPS of the 8 top doctors.
	measure 'Top Doctor Specialty NPS' =
			VAR __Value = ( -- measure body
				IF ( [Is Top Doctor] = 1, [Specialty NPS] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Top Doctor Specialty NPS"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Ranking
	/// Physician NPS (n>=10) of the 8 top doctors.
	measure 'Top Doctor Physician NPS' =
			VAR __Value = ( -- measure body
				IF ( [Is Top Doctor] = 1, [Physician NPS (n>=10)] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Top Doctor Physician NPS"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Ranking
	/// NPS Answers of the 8 top doctors.
	measure 'Top Doctor Answers' =
			VAR __Value = ( -- measure body
				IF ( [Is Top Doctor] = 1, [NPS Answers] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Top Doctor Answers"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Ranking
	/// NPS (n>=30) of the 8 bottom doctors.
	measure 'Bottom Doctor NPS' =
			VAR __Value = ( -- measure body
				IF ( [Is Bottom Doctor] = 1, [NPS (n>=30)] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Bottom Doctor NPS"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Ranking
	/// Specialty NPS of the 8 bottom doctors.
	measure 'Bottom Doctor Specialty NPS' =
			VAR __Value = ( -- measure body
				IF ( [Is Bottom Doctor] = 1, [Specialty NPS] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Bottom Doctor Specialty NPS"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Ranking
	/// Physician NPS (n>=10) of the 8 bottom doctors.
	measure 'Bottom Doctor Physician NPS' =
			VAR __Value = ( -- measure body
				IF ( [Is Bottom Doctor] = 1, [Physician NPS (n>=10)] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Bottom Doctor Physician NPS"" can't be analysed by " & __Wrong )
		formatString: 0.0
		displayFolder: Patient Experience\Ranking
	/// NPS Answers of the 8 bottom doctors.
	measure 'Bottom Doctor Answers' =
			VAR __Value = ( -- measure body
				IF ( [Is Bottom Doctor] = 1, [NPS Answers] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Bottom Doctor Answers"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Ranking
	/// Brand colour of the NPS band: green (#05A591) at 70 and above, yellow (#FFB900) from 50, red (#DC280A) below.
	measure 'NPS Color' =
			VAR __Value = ( -- measure body
				VAR V = [NPS (5-point)]
				RETURN SWITCH ( TRUE (), ISBLANK ( V ), BLANK (), V >= 70, "#05A591", V >= 50, "#FFB900", "#DC280A" )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """NPS Color"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Patient Experience\Formatting
	/// Green (#05A591) when NPS vs Network is zero or positive, red (#DC280A) when negative.
	measure 'Gap Color' =
			VAR __Value = ( -- measure body
				VAR G = [NPS vs Network]
				RETURN IF ( ISBLANK ( G ), BLANK (), IF ( G >= 0, "#05A591", "#DC280A" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Gap Color"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Patient Experience\Formatting
	/// Green (#05A591) for a fair share (index 0.80–1.25), orange (#E08A00) between 0.5 and 2, red (#DC280A) beyond.
	measure 'Representation Color' =
			VAR __Value = ( -- measure body
				VAR I = [Representation Index]
				RETURN SWITCH ( TRUE (), ISBLANK ( I ), BLANK (), I >= 0.8 && I <= 1.25, "#05A591", I >= 0.5 && I <= 2, "#E08A00", "#DC280A" )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """Representation Color"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Patient Experience\Formatting

		annotation hnh_guard_allow = Survey Service
	/// The selected branch (or All branches) and the first and last visit date with surveys in the selection.
	measure 'Report Title Context' =
			VAR __Value = ( -- measure body
				VAR B =
					IF ( ISFILTERED ( Branch[Branch Name] ) && HASONEVALUE ( Branch[Branch Name] ), VALUES ( Branch[Branch Name] ), "All branches" )
				RETURN
					B & "  |  " & FORMAT ( CALCULATE ( MIN ( 'Date'[Date] ), 'Survey Responses' ), "dd MMM yyyy" ) & " - "
						& FORMAT ( CALCULATE ( MAX ( 'Date'[Date] ), 'Survey Responses' ), "dd MMM yyyy" )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Report Title Context"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Patient Experience\Formatting
	/// One sentence: response rate, responded of invited, completion rate.
	measure 'Insight Participation' =
			VAR __Value = ( -- measure body
				"Response rate " & FORMAT ( [Response Rate %], "0.0%" ) & ": " & FORMAT ( [Surveys Responded], "#,0" ) & " of "
					& FORMAT ( [Invitations], "#,0" ) & " invited patients answered, and " & FORMAT ( [Completion Rate %], "0%" )
					& " of them finished the survey."
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Insight Participation"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Patient Experience\Story
	/// One sentence: NPS, promoter and detractor shares, overall satisfaction.
	measure 'Insight NPS' =
			VAR __Value = ( -- measure body
				"NPS " & FORMAT ( [NPS (5-point)], "0.0" ) & ": " & FORMAT ( [% Promoters], "0%" ) & " of answers are promoters and "
					& FORMAT ( [% Detractors], "0%" ) & " detractors. Overall satisfaction " & FORMAT ( [Overall Satisfaction (0-100)], "0.0" )
					& " / 100."
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Insight NPS"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Patient Experience\Story
	/// One sentence: highest and lowest branch NPS (100+ answers) and the spread, or the selected branch's NPS.
	measure 'Insight Branches' =
			VAR __Value = ( -- measure body
				VAR T = ADDCOLUMNS ( FILTER ( VALUES ( Branch[Branch Name] ), [NPS Answers] >= 100 ), "@n", [NPS (5-point)] )
				VAR Best = TOPN ( 1, T, [@n], DESC )
				VAR Worst = TOPN ( 1, T, [@n], ASC )
				RETURN
					IF (
						COUNTROWS ( T ) > 1,
						"Highest branch: " & MAXX ( Best, Branch[Branch Name] ) & " (" & FORMAT ( MAXX ( Best, [@n] ), "0.0" ) & "); lowest: "
							& MAXX ( Worst, Branch[Branch Name] ) & " (" & FORMAT ( MAXX ( Worst, [@n] ), "0.0" ) & "), a "
							& FORMAT ( MAXX ( Best, [@n] ) - MAXX ( Worst, [@n] ), "0" ) & "-point spread.",
						"Selected branch NPS: " & FORMAT ( [NPS (5-point)], "0.0" ) & "."
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Insight Branches"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Patient Experience\Story
	/// One sentence: the two lowest and the highest question groups by NPS (Drivers).
	measure 'Insight Drivers' =
			VAR __Value = ( -- measure body
				VAR T = ADDCOLUMNS ( FILTER ( VALUES ( 'Survey Question'[Domain En] ), [NPS Answers] >= [Min Answers (Drivers)] ), "@n", [NPS (5-point)] )
				VAR Worst = TOPN ( 2, T, [@n], ASC )
				VAR Best = TOPN ( 1, T, [@n], DESC )
				RETURN
					"Biggest drags: "
						& CONCATENATEX ( Worst, 'Survey Question'[Domain En] & " (" & FORMAT ( [@n], "0.0" ) & ")", " and ", [@n], ASC )
						& ". Strongest: " & MAXX ( Best, 'Survey Question'[Domain En] ) & " (" & FORMAT ( MAXX ( Best, [@n] ), "0.0" ) & ")."
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Insight Drivers"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Patient Experience\Story
	/// Key takeaway of the Participation page: response rate by channel, the lowest branch (500+ invitations), NPS reliability and the sample-vs-visits verdict.
	measure 'Story Participation' =
			VAR __Value = ( -- measure body
				VAR T = ADDCOLUMNS ( FILTER ( VALUES ( Branch[Branch Name] ), [Invitations] >= 500 ), "@r", [Response Rate %] )
				VAR Worst = TOPN ( 1, T, [@r], ASC, Branch[Branch Name], ASC )
				VAR Channels =
					IF (
						NOT ISBLANK ( [Response Rate % (Agent Call)] ) && NOT ISBLANK ( [Response Rate % (SMS)] ),
						" (agent calls " & FORMAT ( [Response Rate % (Agent Call)], "0.0%" ) & ", SMS " & FORMAT ( [Response Rate % (SMS)], "0.0%" ) & ")",
						""
					)
				VAR Rep = [Sample Representativeness]
				RETURN
					FORMAT ( [Response Rate %], "0.0%" ) & " responded" & Channels
						& IF (
							COUNTROWS ( T ) > 1,
							"; lowest branch " & MAXX ( Worst, Branch[Branch Name] ) & " (" & FORMAT ( MAXX ( Worst, [@r] ), "0.0%" ) & ").",
							"."
						)
						& " Reliability " & LOWER ( [Reliability] ) & " (±" & FORMAT ( [NPS Margin of Error], "0.0" ) & ")."
						& IF (
							NOT ISBLANK ( Rep ),
							" Sample " & LOWER ( Rep )
								& IF (
									NOT ISBLANK ( [Weighted NPS] ),
									"; weighted NPS " & FORMAT ( [Weighted NPS], "0.0" ) & " vs " & FORMAT ( [NPS (Visit-Matched)], "0.0" )
								) & ".",
							""
						)
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Answers + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """Story Participation"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Patient Experience\Story

		annotation hnh_guard_allow = Survey Service
	/// Key takeaway of the Satisfaction page: NPS with its margin and reliability, promoters, satisfaction, weakest and strongest care setting (100+ answers).
	measure 'Story Satisfaction' =
			VAR __Value = ( -- measure body
				VAR T = ADDCOLUMNS ( FILTER ( VALUES ( 'Survey Service'[Care Setting] ), [NPS Answers] >= 100 ), "@n", [NPS (5-point)] )
				VAR Worst = TOPN ( 1, T, [@n], ASC )
				VAR Best = TOPN ( 1, T, [@n], DESC )
				RETURN
					"NPS " & FORMAT ( [NPS (5-point)], "0.0" ) & " (±" & FORMAT ( [NPS Margin of Error], "0.0" ) & ", " & LOWER ( [Reliability] )
						& " reliability), " & FORMAT ( [% Promoters], "0%" ) & " promoters, satisfaction "
						& FORMAT ( [Overall Satisfaction (0-100)], "0.0" ) & "/100."
						& IF (
							COUNTROWS ( T ) > 1,
							" Weakest setting " & MAXX ( Worst, 'Survey Service'[Care Setting] ) & " (" & FORMAT ( MAXX ( Worst, [@n] ), "0.0" )
								& "), strongest " & MAXX ( Best, 'Survey Service'[Care Setting] ) & " (" & FORMAT ( MAXX ( Best, [@n] ), "0.0" ) & ").",
							""
						)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Story Satisfaction"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Patient Experience\Story
	/// Key takeaway of the Drivers page: the three lowest question groups (or no weak spots), with reliability when a doctor or specialty is in context.
	measure 'Story Drivers' =
			VAR __Value = ( -- measure body
				VAR Rel =
					IF (
						ISFILTERED ( Staff[Staff Name] ) || ISFILTERED ( Staff[Specialty] ),
						" Reliability: " & [Reliability] & " (±" & FORMAT ( [NPS Margin of Error], "0.0" ) & ").",
						""
					)
				VAR Who =
					IF (
						ISFILTERED ( Staff[Staff Name] ) && HASONEVALUE ( Staff[Staff Name] ),
						VALUES ( Staff[Staff Name] ) & ": ",
						IF ( ISFILTERED ( Staff[Specialty] ) && HASONEVALUE ( Staff[Specialty] ), VALUES ( Staff[Specialty] ) & ": ", "" )
					)
				VAR T = ADDCOLUMNS ( FILTER ( VALUES ( 'Survey Question'[Domain En] ), [NPS Answers] >= [Min Answers (Drivers)] ), "@n", [NPS (5-point)] )
				VAR Worst = TOPN ( 3, T, [@n], ASC, 'Survey Question'[Domain En], ASC )
				VAR Lowest = MINX ( T, [@n] )
				RETURN
					SWITCH (
						TRUE (),
						COUNTROWS ( T ) = 0, Who & "not enough answers yet to rank question groups.",
						Lowest >= 90, Who & "no weak spots: even the lowest-rated question group scores " & FORMAT ( Lowest, "0.0" ) & "." & Rel,
						Who & "Biggest drags: "
							& CONCATENATEX ( Worst, 'Survey Question'[Domain En] & " (" & FORMAT ( [@n], "0.0" ) & ")", ", ", [@n], ASC )
							& ". Click a bar for its weakest questions." & Rel
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Story Drivers"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Patient Experience\Story
	/// Key takeaway of the Branch Benchmark page: the branch leading and the branch trailing the network (100+ answers), and how many branches are below it.
	measure 'Story Branches' =
			VAR __Value = ( -- measure body
				VAR T =
					ADDCOLUMNS (
						FILTER ( VALUES ( Branch[Branch Name] ), [NPS Answers] >= 100 ),
						"@g", [NPS (5-point)] - CALCULATE ( [NPS (5-point)], REMOVEFILTERS ( Branch ) )
					)
				VAR Best = TOPN ( 1, T, [@g], DESC )
				VAR Worst = TOPN ( 1, T, [@g], ASC )
				RETURN
					MAXX ( Best, Branch[Branch Name] ) & " leads the network by " & FORMAT ( MAXX ( Best, [@g] ), "+0.0;-0.0" ) & " points; "
						& MAXX ( Worst, Branch[Branch Name] ) & " trails by " & FORMAT ( MAXX ( Worst, [@g] ), "+0.0;-0.0" ) & ". "
						& COUNTROWS ( FILTER ( T, [@g] < 0 ) ) & " of " & COUNTROWS ( T ) & " branches are below the network."
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Story Branches"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Patient Experience\Story
	/// Key takeaway of the Specialties & Doctors page: doctors (30+ answers) under 50 NPS and the lowest busy specialty (200+ answers).
	measure 'Story Doctors' =
			VAR __Value = ( -- measure body
				VAR D = FILTER ( ADDCOLUMNS ( VALUES ( Staff[Staff Name] ), "@d", [NPS (n>=30)] ), NOT ISBLANK ( [@d] ) )
				VAR S = ADDCOLUMNS ( FILTER ( VALUES ( Staff[Specialty] ), [NPS Answers] >= 200 ), "@n", [NPS (5-point)] )
				VAR Worst = TOPN ( 1, S, [@n], ASC )
				RETURN
					COUNTROWS ( FILTER ( D, [@d] < 50 ) ) & " of " & COUNTROWS ( D ) & " doctors (30+ answers) score below 50 NPS; lowest busy specialty "
						& MAXX ( Worst, Staff[Specialty] ) & " (" & FORMAT ( MAXX ( Worst, [@n] ), "0.0" )
						& "). Right-click a doctor or specialty for its drivers."
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Story Doctors"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Patient Experience\Story
	/// Key takeaway of the Patient Profile page: NPS range by who completed the survey (100+ responses) and female vs male NPS.
	measure 'Story Profile' =
			VAR __Value = ( -- measure body
				VAR T =
					ADDCOLUMNS (
						FILTER (
							VALUES ( 'Survey Responses'[Respondent Type] ),
							[Surveys Responded] >= 100 && 'Survey Responses'[Respondent Type] <> "Not answered"
						),
						"@n", [NPS (Response Attr)]
					)
				VAR Best = TOPN ( 1, T, [@n], DESC )
				VAR Worst = TOPN ( 1, T, [@n], ASC )
				RETURN
					"NPS by who completed the survey: " & FORMAT ( MAXX ( Worst, [@n] ), "0.0" ) & " (" & MAXX ( Worst, 'Survey Responses'[Respondent Type] )
						& ") to " & FORMAT ( MAXX ( Best, [@n] ), "0.0" ) & " (" & MAXX ( Best, 'Survey Responses'[Respondent Type] ) & "). Female "
						& FORMAT ( CALCULATE ( [NPS (5-point)], Patient[Gender] = "Female" ), "0.0" ) & " vs male "
						& FORMAT ( CALCULATE ( [NPS (5-point)], Patient[Gender] = "Male" ), "0.0" ) & "."
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers + Survey Responses | Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Story Profile"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Patient Experience\Story

		annotation hnh_guard_allow = Survey Responses
	/// Verdict of the sample-vs-visits section: the sample mix and whether weighting by visits moves the NPS beyond its margin.
	measure 'Story Representativeness' =
			VAR __Value = ( -- measure body
				VAR Rep = [Sample Representativeness]
				VAR E = [NPS Weighting Effect]
				VAR Moe = [NPS Margin of Error]
				RETURN
					IF (
						NOT ISBLANK ( Rep ),
						"Sample mix: " & LOWER ( Rep ) & "."
							& IF (
								NOT ISBLANK ( E ),
								" Weighted by actual visits NPS moves " & FORMAT ( E, "+0.0;-0.0;0.0" )
									& IF (
										ABS ( E ) <= Moe,
										", within the ±" & FORMAT ( Moe, "0.0" ) & " margin: the headline NPS holds.",
										", beyond the ±" & FORMAT ( Moe, "0.0" ) & " margin: read care types separately or use the weighted NPS."
									),
								""
							)
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters + Survey Answers + Survey Responses | Survey Service]
			RETURN IF ( __Wrong = "", __Value, """Story Representativeness"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Patient Experience\Story

		annotation hnh_guard_allow = Survey Service
	/// Trial balance opening balance in SAR (natural sign: debit +, credit −) at the first period of the selection per branch; under YTD the opening of the year. Posted unless a Balance View is selected (Phase 3 spec section 1, F4).
	measure 'TB Opening Balance' =
			VAR __Value = ( -- measure body
				VAR View =
					FILTER (
						ALL ( 'GL Balances'[Balance View] ),
						IF ( ISFILTERED ( 'GL Balances'[Balance View] ), 'GL Balances'[Balance View] IN VALUES ( 'GL Balances'[Balance View] ), 'GL Balances'[Balance View] = "posted" )
					)
				RETURN
					SUMX (
						VALUES ( Branch[Branch Key] ),
						VAR FirstPeriod = CALCULATE ( MIN ( 'GL Balances'[Period Key] ), REMOVEFILTERS ( 'GL Balances' ), VALUES ( 'Date'[Date] ), VALUES ( 'GL Period'[Period Key] ), VALUES ( Branch[Branch Key] ) )
						RETURN CALCULATE ( SUM ( 'GL Balances'[Opening Balance] ), 'GL Balances'[Period Key] = FirstPeriod, View )
					)
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """TB Opening Balance"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Trial Balance
	/// Trial balance debits in SAR of the periods in the selection; posted unless a Balance View is selected (Phase 3 spec F4).
	measure 'TB Debit' =
			VAR __Value = ( -- measure body
				VAR View =
					FILTER (
						ALL ( 'GL Balances'[Balance View] ),
						IF ( ISFILTERED ( 'GL Balances'[Balance View] ), 'GL Balances'[Balance View] IN VALUES ( 'GL Balances'[Balance View] ), 'GL Balances'[Balance View] = "posted" )
					)
				RETURN CALCULATE ( SUM ( 'GL Balances'[Period Debit] ), View )
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """TB Debit"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Trial Balance
	/// Trial balance credits in SAR of the periods in the selection; posted unless a Balance View is selected (Phase 3 spec F4).
	measure 'TB Credit' =
			VAR __Value = ( -- measure body
				VAR View =
					FILTER (
						ALL ( 'GL Balances'[Balance View] ),
						IF ( ISFILTERED ( 'GL Balances'[Balance View] ), 'GL Balances'[Balance View] IN VALUES ( 'GL Balances'[Balance View] ), 'GL Balances'[Balance View] = "posted" )
					)
				RETURN CALCULATE ( SUM ( 'GL Balances'[Period Credit] ), View )
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """TB Credit"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Trial Balance
	/// Trial balance net movement in SAR (debit − credit, natural sign) of the periods in the selection; posted unless a Balance View is selected (Phase 3 spec F4).
	measure 'TB Net Movement' =
			VAR __Value = ( -- measure body
				VAR View =
					FILTER (
						ALL ( 'GL Balances'[Balance View] ),
						IF ( ISFILTERED ( 'GL Balances'[Balance View] ), 'GL Balances'[Balance View] IN VALUES ( 'GL Balances'[Balance View] ), 'GL Balances'[Balance View] = "posted" )
					)
				RETURN CALCULATE ( SUM ( 'GL Balances'[Period Movement] ), View )
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """TB Net Movement"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Trial Balance
	/// Trial balance closing balance in SAR (natural sign) at the last period of the selection per branch (an adjustment period wins over its month); all accounts net to 0. Posted unless a Balance View is selected (Phase 3 spec section 8, F4). Snapshot.
	measure 'TB Closing Balance' =
			VAR __Value = ( -- measure body
				VAR View =
					FILTER (
						ALL ( 'GL Balances'[Balance View] ),
						IF ( ISFILTERED ( 'GL Balances'[Balance View] ), 'GL Balances'[Balance View] IN VALUES ( 'GL Balances'[Balance View] ), 'GL Balances'[Balance View] = "posted" )
					)
				RETURN
					SUMX (
						VALUES ( Branch[Branch Key] ),
						VAR LastPeriod = CALCULATE ( MAX ( 'GL Balances'[Period Key] ), REMOVEFILTERS ( 'GL Balances' ), VALUES ( 'Date'[Date] ), VALUES ( 'GL Period'[Period Key] ), VALUES ( Branch[Branch Key] ) )
						RETURN CALCULATE ( SUM ( 'GL Balances'[Closing Balance] ), 'GL Balances'[Period Key] = LastPeriod, View )
					)
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """TB Closing Balance"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Trial Balance

		annotation hnh_snapshot = 1
	/// GL net revenue in SAR, combined Oasis + Fusion GL (bsc vw_financial): minus the movement of FS element revenue, months up to the current one.
	measure 'BSC GL Net Revenue' =
			VAR __Value = ( -- measure body
				- CALCULATE (
					SUM ( 'GL FS Monthly'[Movement] ),
					'GL FS Monthly'[FS Element] = "revenue",
					KEEPFILTERS ( 'Date'[Date] <= TODAY () )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC GL Net Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// GL operating expenses in SAR (bsc vw_financial): FS element expenses without finance cost, zakat, depreciation and amortisation.
	measure 'BSC GL Opex' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'GL FS Monthly'[Movement] ),
					'GL FS Monthly'[FS Element] = "expenses",
					NOT 'GL FS Monthly'[FS Category] IN { "finance cost", "zakat", "depreciation and amortization" },
					NOT 'GL FS Monthly'[FS Caption] IN { "depreciation", "depreciation on rou", "amortization of intangible assets", "depreciation expense", "amortization expense" },
					KEEPFILTERS ( 'Date'[Date] <= TODAY () )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC GL Opex"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// GL EBITDA in SAR: GL net revenue minus GL operating expenses (bsc vw_financial).
	measure 'BSC GL EBITDA' =
			VAR __Value = ( -- measure body
				[BSC GL Net Revenue] - [BSC GL Opex]
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC GL EBITDA"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// GL general and administrative expenses in SAR (FS category general and administrative expenses).
	measure 'BSC GL G&A' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'GL FS Monthly'[Movement] ),
					'GL FS Monthly'[FS Category] = "general and administrative expenses",
					KEEPFILTERS ( 'Date'[Date] <= TODAY () )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC GL G&A"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// GL medical consumables in SAR (FS caption medical consumables; Fusion has no such caption yet).
	measure 'BSC GL Consumables' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'GL FS Monthly'[Movement] ),
					'GL FS Monthly'[FS Caption] = "medical consumables",
					KEEPFILTERS ( 'Date'[Date] <= TODAY () )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC GL Consumables"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// GL net income in SAR: minus the movement of every income-statement account (FS type is).
	measure 'BSC GL Income' =
			VAR __Value = ( -- measure body
				- CALCULATE (
					SUM ( 'GL FS Monthly'[Movement] ),
					'GL FS Monthly'[FS Type] = "is",
					KEEPFILTERS ( 'Date'[Date] <= TODAY () )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC GL Income"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// GL marketing expense in SAR (FS category selling and marketing expenses).
	measure 'BSC GL Marketing' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'GL FS Monthly'[Movement] ),
					'GL FS Monthly'[FS Category] = "selling and marketing expenses",
					KEEPFILTERS ( 'Date'[Date] <= TODAY () )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC GL Marketing"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// GL cost of medicines and consumables in SAR: captions cost of goods sold and medical consumables, and the line cost of medicines.
	measure 'BSC GL COGS' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'GL FS Monthly'[Movement] ),
					FILTER ( ALL ( 'GL FS Monthly'[FS Caption], 'GL FS Monthly'[FS Line] ), 'GL FS Monthly'[FS Caption] IN { "cost of goods sold", "medical consumables" } || 'GL FS Monthly'[FS Line] = "cost of medicines" ),
					KEEPFILTERS ( 'Date'[Date] <= TODAY () )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC GL COGS"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// Average trade receivables in SAR: per hospital, the mean over months up to the current one of (opening + closing) / 2, added over hospitals.
	measure 'BSC GL AR Average' =
			VAR __Value = ( -- measure body
				VAR Months = CALCULATETABLE ( VALUES ( 'Date'[Year Month] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				RETURN
					SUMX (
						VALUES ( Branch[Branch Key] ),
						AVERAGEX (
							Months,
							CALCULATE (
								DIVIDE ( SUM ( 'GL FS Monthly'[Opening Balance] ) + SUM ( 'GL FS Monthly'[Opening Journal Amount] ) + SUM ( 'GL FS Monthly'[Closing Balance] ), 2 ),
								'GL FS Monthly'[FS Caption] = "trade receivables, net"
							)
						)
					)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC GL AR Average"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// Average inventory in SAR: per hospital, the mean over months up to the current one of (opening + closing) / 2 of caption inventories, net.
	measure 'BSC GL Inventory Average' =
			VAR __Value = ( -- measure body
				VAR Months = CALCULATETABLE ( VALUES ( 'Date'[Year Month] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				RETURN
					SUMX (
						VALUES ( Branch[Branch Key] ),
						AVERAGEX (
							Months,
							CALCULATE (
								DIVIDE ( SUM ( 'GL FS Monthly'[Opening Balance] ) + SUM ( 'GL FS Monthly'[Opening Journal Amount] ) + SUM ( 'GL FS Monthly'[Closing Balance] ), 2 ),
								'GL FS Monthly'[FS Caption] = "inventories, net"
							)
						)
					)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC GL Inventory Average"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// Total assets in SAR at the start of the first month in context (opening balance plus go-live journals), added over hospitals.
	measure 'BSC GL Assets Opening' =
			VAR __Value = ( -- measure body
				VAR FirstMonth = CALCULATE ( MIN ( 'Date'[Year Month] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				RETURN
					SUMX (
						VALUES ( Branch[Branch Key] ),
						CALCULATE (
							SUM ( 'GL FS Monthly'[Opening Balance] ) + SUM ( 'GL FS Monthly'[Opening Journal Amount] ),
							'GL FS Monthly'[FS Element] = "assets",
							'Date'[Year Month] = FirstMonth
						)
					)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC GL Assets Opening"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// Days in the selected period up to today (Days in AR and inventory days).
	measure 'BSC Days in Period' =
			COUNTROWS ( CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) ) )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// Budgeted net revenue in SAR (budget line REV_NET, most likely).
	measure 'BSC Budget Net Revenue' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Income Statement'[Budget Most Likely] ), 'Budget Line'[Budget Line Code] = "REV_NET" )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """BSC Budget Net Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// Budgeted EBITDA in SAR (budget line EBITDA, most likely).
	measure 'BSC Budget EBITDA' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Income Statement'[Budget Most Likely] ), 'Budget Line'[Budget Line Code] = "EBITDA" )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """BSC Budget EBITDA"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// Budgeted operating cost in SAR (budget lines TOTAL_DC + TOTAL_GA, most likely).
	measure 'BSC Budget Opex' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Income Statement'[Budget Most Likely] ), 'Budget Line'[Budget Line Code] IN { "TOTAL_DC", "TOTAL_GA" } )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """BSC Budget Opex"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// Budgeted G&A in SAR without marketing (TOTAL_GA minus GA_MARKETING, most likely), as bsc vw_financial.
	measure 'BSC Budget G&A' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Income Statement'[Budget Most Likely] ), 'Budget Line'[Budget Line Code] = "TOTAL_GA" )
					- CALCULATE ( SUM ( 'Income Statement'[Budget Most Likely] ), 'Budget Line'[Budget Line Code] = "GA_MARKETING" )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """BSC Budget G&A"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// Budgeted medical consumables in SAR (budget line DC_CONSUMABLES, most likely).
	measure 'BSC Budget Consumables' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Income Statement'[Budget Most Likely] ), 'Budget Line'[Budget Line Code] = "DC_CONSUMABLES" )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """BSC Budget Consumables"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// Budgeted cost of medicines in SAR (budget line DC_MEDICINES, most likely).
	measure 'BSC Budget Medicines' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Income Statement'[Budget Most Likely] ), 'Budget Line'[Budget Line Code] = "DC_MEDICINES" )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """BSC Budget Medicines"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// Average available inpatient beds: per hospital, the mean over months of available bed-days / days with a bed row, added over hospitals (bsc beds view).
	measure 'BSC Available Beds' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					AVERAGEX (
						VALUES ( 'Date'[Year Month] ),
						CALCULATE (
							DIVIDE ( SUM ( 'Bed Occupancy'[Is Available] ), DISTINCTCOUNT ( 'Bed Occupancy'[Date Key] ) ),
							'Bed Occupancy'[Is Inpatient Ward] = "Yes",
							'Bed Occupancy'[Is Excluded Ward] = "No"
						)
					)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Bed Occupancy]
			RETURN IF ( __Wrong = "", __Value, """BSC Available Beds"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Balanced Scorecard\Building Blocks
	/// Licensed beds from the BI manager's table, per year (averaged over the years in context), added over hospitals.
	measure 'BSC Licensed Beds' =
			VAR __Value = ( -- measure body
				AVERAGEX (
					VALUES ( 'Date'[Year] ),
					VAR SelectedYear = 'Date'[Year]
					RETURN CALCULATE ( SUM ( 'BSC Licensed Beds'[Licensed Beds] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = SelectedYear )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard BSC Licensed Beds]
			RETURN IF ( __Wrong = "", __Value, """BSC Licensed Beds"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// Clinic capacity in visits: clinics x clinic hours per day x patients per hour x working days without Fridays up to today (Outpatient Dashboard rule).
	measure 'BSC Clinic Capacity' =
			VAR WorkingDays = COUNTROWS ( CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ), KEEPFILTERS ( 'Date'[Day Of Week] <> 5 ) ) )
			VAR PerClinicDay = MAX ( 'BSC Parameters'[Clinic Hours Per Day] ) * MAX ( 'BSC Parameters'[Clinic Patients Per Hour] )
			RETURN SUM ( Branch[Clinics Count] ) * PerClinicDay * WorkingDays
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// Month Date Key of the latest Workforce Monthly month up to the end of the period, whatever the date filters; blank for a period that starts after today.
	measure 'BSC Last Workforce Month' =
			VAR __Value = ( -- measure body
				VAR PeriodEnd = MAX ( 'Date'[Date] )
				VAR EndKey = YEAR ( PeriodEnd ) * 10000 + MONTH ( PeriodEnd ) * 100 + DAY ( PeriodEnd )
				RETURN IF ( MIN ( 'Date'[Date] ) <= TODAY (), CALCULATE ( MAX ( 'Workforce Monthly'[Month Date Key] ), REMOVEFILTERS ( 'Date' ), 'Workforce Monthly'[Month Date Key] <= EndKey ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Workforce Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Last Workforce Month"" can't be analysed by " & __Wrong )
		formatString: 0
		displayFolder: Balanced Scorecard\Building Blocks
	/// Average monthly headcount by the scorecard rules (part-time doctors included): per hospital, the mean over months (the last closed month when none has data yet), added over hospitals.
	measure 'BSC Average Headcount' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR InContext = AVERAGEX ( VALUES ( 'Date'[Year Month] ), CALCULATE ( SUM ( 'Workforce Monthly'[Headcount] ) ) )
					VAR LastMonth = [BSC Last Workforce Month]
					RETURN
						IF (
							ISBLANK ( InContext ) && NOT ISBLANK ( LastMonth ),
							CALCULATE ( SUM ( 'Workforce Monthly'[Headcount] ), REMOVEFILTERS ( 'Date' ), 'Workforce Monthly'[Month Date Key] = LastMonth ),
							InContext
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Workforce Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Average Headcount"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// Average monthly FTE by the scorecard rules (part-time doctors at 0.5): per hospital, the mean over months (the last closed month when none has data yet), added over hospitals.
	measure 'BSC Average FTE' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR InContext = AVERAGEX ( VALUES ( 'Date'[Year Month] ), CALCULATE ( SUM ( 'Workforce Monthly'[FTE] ) ) )
					VAR LastMonth = [BSC Last Workforce Month]
					RETURN
						IF (
							ISBLANK ( InContext ) && NOT ISBLANK ( LastMonth ),
							CALCULATE ( SUM ( 'Workforce Monthly'[FTE] ), REMOVEFILTERS ( 'Date' ), 'Workforce Monthly'[Month Date Key] = LastMonth ),
							InContext
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Workforce Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Average FTE"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Balanced Scorecard\Building Blocks
	/// Average monthly doctors by the scorecard rules (part-time doctors included), with the same last-closed-month fallback.
	measure 'BSC Average Doctors' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR InContext = AVERAGEX ( VALUES ( 'Date'[Year Month] ), CALCULATE ( SUM ( 'Workforce Monthly'[Headcount] ), 'Workforce Monthly'[Is Doctor] = 1 ) )
					VAR LastMonth = [BSC Last Workforce Month]
					RETURN
						IF (
							ISBLANK ( InContext ) && NOT ISBLANK ( LastMonth ),
							CALCULATE ( SUM ( 'Workforce Monthly'[Headcount] ), REMOVEFILTERS ( 'Date' ), 'Workforce Monthly'[Month Date Key] = LastMonth, 'Workforce Monthly'[Is Doctor] = 1 ),
							InContext
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Workforce Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Average Doctors"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// Average monthly nurses and doctors by the scorecard rules (part-time doctors included), with the same last-closed-month fallback.
	measure 'BSC Average Medical' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR InContext = AVERAGEX ( VALUES ( 'Date'[Year Month] ), CALCULATE ( SUM ( 'Workforce Monthly'[Headcount] ), 'Workforce Monthly'[Is Medical] = 1 ) )
					VAR LastMonth = [BSC Last Workforce Month]
					RETURN
						IF (
							ISBLANK ( InContext ) && NOT ISBLANK ( LastMonth ),
							CALCULATE ( SUM ( 'Workforce Monthly'[Headcount] ), REMOVEFILTERS ( 'Date' ), 'Workforce Monthly'[Month Date Key] = LastMonth, 'Workforce Monthly'[Is Medical] = 1 ),
							InContext
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Workforce Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Average Medical"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Building Blocks
	/// KPI 1 and 2 (net revenue achievement, growth vs last year): GL net revenue in SAR, combined Oasis + Fusion GL.
	measure 'BSC Net Revenue' =
			VAR __Value = ( -- measure body
				[BSC GL Net Revenue]
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Net Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Financial
	/// KPI 4: GL EBITDA / GL net revenue, pooled over hospitals and months.
	measure 'BSC EBITDA Margin' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC GL EBITDA], [BSC GL Net Revenue] )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC EBITDA Margin"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Financial
	/// KPI 5: operating cost (net revenue minus EBITDA) / net revenue, from the GL.
	measure 'BSC Cost to Revenue' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC GL Net Revenue] - [BSC GL EBITDA], [BSC GL Net Revenue] )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Cost to Revenue"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Financial
	/// KPI 63: GL medical consumables / GL net revenue (Fusion months are 0 until finance posts consumption).
	measure 'BSC Consumables Ratio' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC GL Consumables], [BSC GL Net Revenue] )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Consumables Ratio"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Financial
	/// KPI 6: average trade receivables x days in the period / GL net revenue.
	measure 'BSC Days in AR (days)' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC GL AR Average] * [BSC Days in Period], [BSC GL Net Revenue] )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Days in AR (days)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Balanced Scorecard\Financial
	/// KPI 64: average GL inventory x days in the period / GL cost of goods sold, medical consumables and cost of medicines.
	measure 'BSC Days Inventory (days)' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC GL Inventory Average] * [BSC Days in Period], [BSC GL COGS] )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Days Inventory (days)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Balanced Scorecard\Financial
	/// KPI 8: GL net revenue / average available inpatient beds.
	measure 'BSC Revenue per Bed' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC GL Net Revenue], [BSC Available Beds] )
			) -- end of measure body
			VAR __Wrong = [_Guard Bed Occupancy + GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Revenue per Bed"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Financial
	/// KPI 9: GL income of the period / total assets at the start of the period (not annualised, as the handover).
	measure 'BSC Return on Assets' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC GL Income], [BSC GL Assets Opening] )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Return on Assets"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Financial
	/// KPI 10: GL EBITDA / average available inpatient beds.
	measure 'BSC EBITDA per Bed' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC GL EBITDA], [BSC Available Beds] )
			) -- end of measure body
			VAR __Wrong = [_Guard Bed Occupancy + GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC EBITDA per Bed"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Financial
	/// KPI 55: GL net revenue / average doctors (part-time doctors included).
	measure 'BSC Revenue per Doctor' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC GL Net Revenue], [BSC Average Doctors] )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly + Workforce Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Revenue per Doctor"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Financial
	/// KPI 56: GL EBITDA / average doctors (part-time doctors included).
	measure 'BSC EBITDA per Doctor' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC GL EBITDA], [BSC Average Doctors] )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly + Workforce Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC EBITDA per Doctor"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Financial
	/// KPI 11: outpatient revenue plus non-LTC inpatient revenue (charge lines) / GL net revenue.
	measure 'BSC Multi-Specialty Revenue Share' =
			VAR __Value = ( -- measure body
				DIVIDE (
					CALCULATE ( [Revenue], 'Care Type'[Care Type] = "OP" )
						+ CALCULATE ( [Revenue], 'Care Type'[Care Type] = "IP", 'Charge Lines'[Is LTC] = "No" ),
					[BSC GL Net Revenue]
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines + GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Multi-Specialty Revenue Share"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Customer
	/// KPI 12: revenue of insurance payers (episode payer) / GL net revenue.
	measure 'BSC Payer Mix' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Revenue by Episode Payer], Payer[Category] = "Insurance" ), [BSC GL Net Revenue] )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines + GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Payer Mix"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Customer
	/// KPI 13: NPS over the pooled answers of the Hospital NPS and Physician NPS questions: (promoters - detractors) / answers x 100.
	measure 'BSC Patient Satisfaction' =
			VAR __Value = ( -- measure body
				VAR Answers = CALCULATE ( COUNTROWS ( 'Survey Answers' ), 'Survey Answers'[NPS Role] IN { "Hospital NPS", "Physician NPS" } )
				VAR Net = CALCULATE ( SUM ( 'Survey Answers'[Is Promoter] ) - SUM ( 'Survey Answers'[Is Detractor] ), 'Survey Answers'[NPS Role] IN { "Hospital NPS", "Physician NPS" } )
				RETURN IF ( Answers > 0, DIVIDE ( Net, Answers ) * 100 )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """BSC Patient Satisfaction"" can't be analysed by " & __Wrong )
		displayFolder: Balanced Scorecard\Customer

		formatStringDefinition =
				VAR Answers = CALCULATE ( COUNTROWS ( 'Survey Answers' ), 'Survey Answers'[NPS Role] IN { "Hospital NPS", "Physician NPS" } )
				RETURN IF ( Answers < 30, """insufficient sample""", "0.0" )
	/// KPI 14: distinct returning outpatients / distinct outpatients (arrived, not cancelled; ER excluded).
	measure 'BSC Patient Retention' =
			VAR __Value = ( -- measure body
				VAR Patients = CALCULATE ( DISTINCTCOUNT ( Encounters[Patient Key] ), KEEPFILTERS ( Encounters[Encounter Type] = "OP" ), Encounters[Is Arrived] = "Yes", Encounters[Is Cancelled] = "No" )
				VAR Returning = CALCULATE ( DISTINCTCOUNT ( Encounters[Patient Key] ), KEEPFILTERS ( Encounters[Encounter Type] = "OP" ), Encounters[Is Arrived] = "Yes", Encounters[Is Cancelled] = "No", Encounters[Is Returning] = "Yes" )
				RETURN DIVIDE ( Returning, Patients )
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """BSC Patient Retention"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Customer
	/// KPI 15: arrived outpatient visits of new patients / arrived outpatient visits.
	measure 'BSC New Patient Acquisition' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( COUNTROWS ( Encounters ), KEEPFILTERS ( Encounters[Encounter Type] = "OP" ), Encounters[Is Arrived] = "Yes", KEEPFILTERS ( Encounters[Visit Type] = "New patient" ) ), [OP Visits] )
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """BSC New Patient Acquisition"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Customer
	/// KPI 67: average waiting minutes of arrived, not cancelled outpatient visits that have a recorded wait.
	measure 'BSC OP Waiting Time (min)' =
			VAR __Value = ( -- measure body
				CALCULATE ( AVERAGE ( Encounters[Wait Minutes] ), KEEPFILTERS ( Encounters[Encounter Type] = "OP" ), Encounters[Is Arrived] = "Yes", Encounters[Is Cancelled] = "No" )
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """BSC OP Waiting Time (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Balanced Scorecard\Customer
	/// KPI 18: revenue of non-MoH payers (episode payer) / GL net revenue.
	measure 'BSC Non-MoH Revenue Share' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Revenue by Episode Payer], Payer[Is MOH] = "No" ), [BSC GL Net Revenue] )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines + GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Non-MoH Revenue Share"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Customer
	/// KPI 20: outpatient and ER visits of insurance patients.
	measure 'BSC Payer Volume' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Census], Payer[Category] = "Insurance" )
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """BSC Payer Volume"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Customer
	/// KPI 62: GL marketing expense / distinct new outpatients.
	measure 'BSC Patient Acquisition Cost' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC GL Marketing], CALCULATE ( DISTINCTCOUNT ( Encounters[Patient Key] ), KEEPFILTERS ( Encounters[Encounter Type] = "OP" ), Encounters[Is Arrived] = "Yes", KEEPFILTERS ( Encounters[Visit Type] = "New patient" ) ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters + GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Patient Acquisition Cost"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Customer
	/// KPI 21: occupied / available bed-days in inpatient wards (the model's Bed Occupancy %).
	measure 'BSC Bed Occupancy' =
			VAR __Value = ( -- measure body
				[Bed Occupancy %]
			) -- end of measure body
			VAR __Wrong = [_Guard Bed Occupancy]
			RETURN IF ( __Wrong = "", __Value, """BSC Bed Occupancy"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Internal Process
	/// KPI 22: arrived outpatient visits / clinic capacity (clinics x hours x patients per hour x working days).
	measure 'BSC Clinic Utilization' =
			VAR __Value = ( -- measure body
				DIVIDE ( [OP Visits], [BSC Clinic Capacity] )
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """BSC Clinic Utilization"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Internal Process
	/// KPI 23: average length of stay of countable non-LTC discharges, by discharge date.
	measure 'BSC ALOS (days)' =
			VAR __Value = ( -- measure body
				CALCULATE (
					AVERAGE ( Admissions[LOS Days] ),
					Admissions[Is Countable] = "Yes",
					Admissions[Is LTC] = "No",
					USERELATIONSHIP ( Admissions[Physical Discharge Date Key], 'Date'[Date Key] )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions]
			RETURN IF ( __Wrong = "", __Value, """BSC ALOS (days)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Balanced Scorecard\Internal Process
	/// KPI 24: countable admissions / arrived outpatient visits.
	measure 'BSC OP to IP Conversion' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Admissions], [OP Visits] )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters]
			RETURN IF ( __Wrong = "", __Value, """BSC OP to IP Conversion"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Internal Process
	/// KPI 42: outpatient visits + ER visits + admissions.
	measure 'BSC Patient Volume' =
			VAR __Value = ( -- measure body
				[OP Visits] + [ER Visits] + [Admissions]
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters]
			RETURN IF ( __Wrong = "", __Value, """BSC Patient Volume"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Internal Process
	/// KPI 57: ER visits / ER visits of the same days last year - 1 (days up to today).
	measure 'BSC ER Growth' =
			VAR __Value = ( -- measure body
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				VAR PriorYear = CALCULATE ( [ER Visits], SAMEPERIODLASTYEAR ( Past ) )
				RETURN IF ( NOT ISBLANK ( PriorYear ), DIVIDE ( [ER Visits], PriorYear ) - 1 )
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """BSC ER Growth"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Internal Process
	/// KPI 58: arrived outpatient visits / clinic capacity slots (legacy capacity rule).
	measure 'BSC OP Doctor Utilization' =
			VAR __Value = ( -- measure body
				DIVIDE ( [OP Visits], SUM ( 'Clinic Capacity'[BSC Capacity Slots] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Clinic Capacity + Encounters]
			RETURN IF ( __Wrong = "", __Value, """BSC OP Doctor Utilization"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Internal Process
	/// KPI 60: average available beds / licensed beds (the BI manager's licensed beds).
	measure 'BSC Activated Beds' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC Available Beds], [BSC Licensed Beds] )
			) -- end of measure body
			VAR __Wrong = [_Guard BSC Licensed Beds + Bed Occupancy]
			RETURN IF ( __Wrong = "", __Value, """BSC Activated Beds"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Internal Process
	/// KPI 25: revenue of high-value specialty doctors / GL net revenue.
	measure 'BSC High-Value Revenue Share' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Revenue], Staff[Is High Value Specialty] = "Yes" ), [BSC GL Net Revenue] )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines + GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC High-Value Revenue Share"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Internal Process
	/// KPI 26: (visits booked with a high-value specialty doctor + countable admissions under one) / visits.
	measure 'BSC High-Value Census' =
			VAR __Value = ( -- measure body
				DIVIDE (
					CALCULATE ( [Census], 'Booked Doctor'[Is High Value Specialty] = "Yes" )
						+ CALCULATE ( [Admissions], Staff[Is High Value Specialty] = "Yes" ),
					[Census]
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters]
			RETURN IF ( __Wrong = "", __Value, """BSC High-Value Census"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Internal Process
	/// KPI 27: outpatient revenue / outpatient episodes.
	measure 'BSC OP Revenue per Episode' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Revenue], 'Care Type'[Care Type] = "OP" ), CALCULATE ( [Episodes], 'Care Type'[Care Type] = "OP" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines + Episodes]
			RETURN IF ( __Wrong = "", __Value, """BSC OP Revenue per Episode"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Internal Process
	/// KPI 28: outpatient revenue of ancillary product categories / outpatient revenue.
	measure 'BSC Ancillary Utilization' =
			VAR __Value = ( -- measure body
				DIVIDE (
					CALCULATE ( [Revenue], 'Care Type'[Care Type] = "OP", 'Product Category'[Is BSC Ancillary] = "Yes" ),
					CALCULATE ( [Revenue], 'Care Type'[Care Type] = "OP" )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """BSC Ancillary Utilization"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Internal Process
	/// KPI 29: net amount of invoices not submitted / net amount of invoices, by invoice date, non-manual submissions of insurance and government payers.
	measure 'BSC Revenue Leakage' =
			VAR __Value = ( -- measure body
				VAR Base = CALCULATE ( SUM ( Invoices[Net Amount] ), Payer[Category] IN { "Insurance", "Government" }, 'Claim Status'[Submission Channel] <> "Manual" )
				VAR NotSubmitted = CALCULATE ( SUM ( Invoices[Net Amount] ), Payer[Category] IN { "Insurance", "Government" }, 'Claim Status'[Submission Channel] <> "Manual", 'Claim Status'[Is Submitted] = "No" )
				RETURN DIVIDE ( NotSubmitted, Base )
			) -- end of measure body
			VAR __Wrong = [_Guard Invoices]
			RETURN IF ( __Wrong = "", __Value, """BSC Revenue Leakage"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Internal Process
	/// KPI 30: rejected / submitted amount, latest submission, by statement month.
	measure 'BSC Claim Initial Rejection' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Claims Rejected], [Claims Submitted] )
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Lines]
			RETURN IF ( __Wrong = "", __Value, """BSC Claim Initial Rejection"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Internal Process
	/// KPI 31: approved pre-authorised services not delivered / services (the model's Unutilised Approval Rate %).
	measure 'BSC Order Not Done' =
			VAR __Value = ( -- measure body
				[Unutilised Approval Rate %]
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """BSC Order Not Done"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Internal Process
	/// KPI 32: average minutes from sending a pre-authorisation line to the payer's response.
	measure 'BSC Approval TAT (min)' =
			VAR __Value = ( -- measure body
				[Sent to Response Avg (min)]
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """BSC Approval TAT (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Balanced Scorecard\Internal Process
	/// KPI 34: (GL operating expenses - budgeted operating cost) / budgeted operating cost.
	measure 'BSC Cost Budget Variance' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC GL Opex] - [BSC Budget Opex], [BSC Budget Opex] )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly + Income Statement]
			RETURN IF ( __Wrong = "", __Value, """BSC Cost Budget Variance"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Internal Process
	/// KPI 35: GL general and administrative expenses / GL net revenue.
	measure 'BSC G&A Ratio' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC GL G&A], [BSC GL Net Revenue] )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC G&A Ratio"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Internal Process
	/// KPI 36: countable readmissions within 30 days (admit date) / discharges.
	measure 'BSC Readmission 30d' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Admissions], Admissions[Is Readmission 30d] = "Yes" ), [Discharges] )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions]
			RETURN IF ( __Wrong = "", __Value, """BSC Readmission 30d"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Internal Process
	/// KPI 37: readmissions to a critical bed within 48 hours / discharges from a critical bed.
	measure 'BSC Readmission 48h Critical' =
			VAR __Value = ( -- measure body
				DIVIDE ( [ICU Readmissions 48h], CALCULATE ( [Discharges], Bed[Is Critical] = "Yes" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions]
			RETURN IF ( __Wrong = "", __Value, """BSC Readmission 48h Critical"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Internal Process
	/// KPI 41: visits and countable admissions under a referral policy.
	measure 'BSC External Referrals' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Census], Encounters[Is Referral Policy] = "Yes" ) + CALCULATE ( [Admissions], Admissions[Is Referral Policy] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Encounters]
			RETURN IF ( __Wrong = "", __Value, """BSC External Referrals"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Internal Process
	/// KPI 43: resignations (Oasis for branches 1-5, Fusion voluntary leavers for 6-8) / average headcount, scorecard rules.
	measure 'BSC Turnover' =
			VAR __Value = ( -- measure body
				DIVIDE ( SUM ( 'Workforce Monthly'[Resignations] ), [BSC Average Headcount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Workforce Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Turnover"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Learning & Growth
	/// KPI 44: GL net revenue / average FTE (part-time doctors at 0.5).
	measure 'BSC Revenue per FTE' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC GL Net Revenue], [BSC Average FTE] )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly + Workforce Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Revenue per FTE"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Learning & Growth
	/// KPI 45: average FTE / average available inpatient beds.
	measure 'BSC Staff to Bed' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC Average FTE], [BSC Available Beds] )
			) -- end of measure body
			VAR __Wrong = [_Guard Bed Occupancy + Workforce Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Staff to Bed"" can't be analysed by " & __Wrong )
		formatString: #,0.00
		displayFolder: Balanced Scorecard\Learning & Growth
	/// KPI 46: Saudi heads / heads without part-time doctors at the last closed month of the period, added over hospitals. Snapshot.
	measure 'BSC Saudization' =
			VAR __Value = ( -- measure body
				VAR Saudi =
					SUMX (
						VALUES ( Branch[Branch Key] ),
						VAR LastMonth = [BSC Last Workforce Month]
						RETURN IF ( NOT ISBLANK ( LastMonth ), CALCULATE ( SUM ( 'Workforce Monthly'[Headcount] ), REMOVEFILTERS ( 'Date' ), 'Workforce Monthly'[Month Date Key] = LastMonth, 'Workforce Monthly'[Row Type] = "head", 'Workforce Monthly'[Is Saudi] = 1 ) )
					)
				VAR Heads =
					SUMX (
						VALUES ( Branch[Branch Key] ),
						VAR LastMonth = [BSC Last Workforce Month]
						RETURN IF ( NOT ISBLANK ( LastMonth ), CALCULATE ( SUM ( 'Workforce Monthly'[Headcount] ), REMOVEFILTERS ( 'Date' ), 'Workforce Monthly'[Month Date Key] = LastMonth, 'Workforce Monthly'[Row Type] = "head" ) )
					)
				RETURN DIVIDE ( Saudi, Heads )
			) -- end of measure body
			VAR __Wrong = [_Guard Workforce Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Saudization"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Learning & Growth

		annotation hnh_snapshot = 1
	/// KPI 47: requisition openings still open at the end of the period / the BI manager's budgeted FTE of that year. Snapshot.
	measure 'BSC Vacancy Rate' =
			VAR __Value = ( -- measure body
				VAR PeriodEnd = CALCULATE ( MAX ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				VAR LastKey = YEAR ( PeriodEnd ) * 10000 + MONTH ( PeriodEnd ) * 100 + DAY ( PeriodEnd )
				VAR Openings =
					CALCULATE (
						SUM ( Requisitions[Number To Hire] ),
						REMOVEFILTERS ( 'Date' ),
						Requisitions[Approved Date Key] <= LastKey,
						FILTER ( ALL ( Requisitions[Filled Date Key] ), ISBLANK ( Requisitions[Filled Date Key] ) || Requisitions[Filled Date Key] > LastKey )
					)
				VAR Budgeted = CALCULATE ( SUM ( 'BSC Budgeted FTE'[Budgeted FTE] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = YEAR ( PeriodEnd ) )
				RETURN IF ( NOT ISBLANK ( PeriodEnd ), DIVIDE ( Openings, Budgeted ) )
			) -- end of measure body
			VAR __Wrong = [_Guard BSC Budgeted FTE + Requisitions]
			RETURN IF ( __Wrong = "", __Value, """BSC Vacancy Rate"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Learning & Growth

		annotation hnh_snapshot = 1
	/// KPI 48: average days from approval to fill of the requisitions filled in the period.
	measure 'BSC Time to Fill (days)' =
			VAR __Value = ( -- measure body
				AVERAGE ( Requisitions[Days To Fill] )
			) -- end of measure body
			VAR __Wrong = [_Guard Requisitions]
			RETURN IF ( __Wrong = "", __Value, """BSC Time to Fill (days)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Balanced Scorecard\Learning & Growth
	/// KPI 68: average nurses and doctors / average doctors (part-time doctors included).
	measure 'BSC Clinical to Doctor' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC Average Medical], [BSC Average Doctors] )
			) -- end of measure body
			VAR __Wrong = [_Guard Workforce Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Clinical to Doctor"" can't be analysed by " & __Wrong )
		formatString: #,0.00
		displayFolder: Balanced Scorecard\Learning & Growth
	/// Manual KPIs: numerator / denominator entered by the BI manager for the KPI in context; a denominator of 0 divides by outpatient and ER visits (complaints).
	measure 'BSC Manual Value' =
			VAR __Value = ( -- measure body
				VAR Num = SUM ( 'BSC Manual Values'[Numerator] )
				VAR Den = SUM ( 'BSC Manual Values'[Denominator] )
				RETURN IF ( Den = 0 && NOT ISBLANK ( Num ), DIVIDE ( Num, CALCULATE ( [Census], REMOVEFILTERS ( 'BSC KPI' ) ) ), DIVIDE ( Num, Den ) )
			) -- end of measure body
			VAR __Wrong = [_Guard BSC Manual Values + Encounters | BSC KPI]
			RETURN IF ( __Wrong = "", __Value, """BSC Manual Value"" can't be analysed by " & __Wrong )
		formatString: #,0.00
		displayFolder: Balanced Scorecard\Building Blocks

		annotation hnh_guard_allow = BSC KPI
	/// Target of KPI 1: budgeted net revenue.
	measure 'BSC Target Net Revenue' =
			VAR __Value = ( -- measure body
				[BSC Budget Net Revenue]
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """BSC Target Net Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Targets
	/// Target of KPI 4: budgeted EBITDA / budgeted net revenue.
	measure 'BSC Target EBITDA Margin' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC Budget EBITDA], [BSC Budget Net Revenue] )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """BSC Target EBITDA Margin"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Targets
	/// Target of KPI 5: (budgeted net revenue - budgeted EBITDA) / budgeted net revenue.
	measure 'BSC Target Cost to Revenue' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC Budget Net Revenue] - [BSC Budget EBITDA], [BSC Budget Net Revenue] )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """BSC Target Cost to Revenue"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Targets
	/// Target of KPI 63: budgeted consumables / budgeted net revenue.
	measure 'BSC Target Consumables Ratio' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC Budget Consumables], [BSC Budget Net Revenue] )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """BSC Target Consumables Ratio"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Targets
	/// Target of KPI 64: average GL inventory x days / budgeted consumables and medicines.
	measure 'BSC Target Days Inventory (days)' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC GL Inventory Average] * [BSC Days in Period], [BSC Budget Consumables] + [BSC Budget Medicines] )
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly + Income Statement]
			RETURN IF ( __Wrong = "", __Value, """BSC Target Days Inventory (days)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Balanced Scorecard\Targets
	/// Target of KPI 8: budgeted net revenue / average available beds.
	measure 'BSC Target Revenue per Bed' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC Budget Net Revenue], [BSC Available Beds] )
			) -- end of measure body
			VAR __Wrong = [_Guard Bed Occupancy + Income Statement]
			RETURN IF ( __Wrong = "", __Value, """BSC Target Revenue per Bed"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Targets
	/// Target of KPI 10: budgeted EBITDA / average available beds.
	measure 'BSC Target EBITDA per Bed' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC Budget EBITDA], [BSC Available Beds] )
			) -- end of measure body
			VAR __Wrong = [_Guard Bed Occupancy + Income Statement]
			RETURN IF ( __Wrong = "", __Value, """BSC Target EBITDA per Bed"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Targets
	/// Target of KPI 55: budgeted net revenue / average doctors.
	measure 'BSC Target Revenue per Doctor' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC Budget Net Revenue], [BSC Average Doctors] )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement + Workforce Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Target Revenue per Doctor"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Targets
	/// Target of KPI 56: budgeted EBITDA / average doctors.
	measure 'BSC Target EBITDA per Doctor' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC Budget EBITDA], [BSC Average Doctors] )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement + Workforce Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Target EBITDA per Doctor"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Targets
	/// Target of KPI 11: target revenue of OP and non-LTC IP / budgeted net revenue.
	measure 'BSC Target Multi-Specialty Share' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Target Revenue], 'Care Type'[Care Type] = "OP" ) + CALCULATE ( [Target Revenue], 'Care Type'[Care Type] = "IP", Targets[Stay Type] <> "LTC" ), [BSC Budget Net Revenue] )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement + Targets]
			RETURN IF ( __Wrong = "", __Value, """BSC Target Multi-Specialty Share"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Targets
	/// Target of KPI 12: target revenue of insurance / budgeted net revenue.
	measure 'BSC Target Payer Mix' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Target Revenue], Targets[Creditor] = "Insurance" ), [BSC Budget Net Revenue] )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement + Targets]
			RETURN IF ( __Wrong = "", __Value, """BSC Target Payer Mix"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Targets
	/// Target of KPI 18: target revenue of non-government creditors / budgeted net revenue.
	measure 'BSC Target Non-MoH Share' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Target Revenue], Targets[Creditor] <> "Government" ), [BSC Budget Net Revenue] )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement + Targets]
			RETURN IF ( __Wrong = "", __Value, """BSC Target Non-MoH Share"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Targets
	/// Target of KPI 20: target census of insurance.
	measure 'BSC Target Payer Volume' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Target Census], Targets[Creditor] = "Insurance" )
			) -- end of measure body
			VAR __Wrong = [_Guard Targets]
			RETURN IF ( __Wrong = "", __Value, """BSC Target Payer Volume"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Targets
	/// Target of KPI 22: target OP census / clinic capacity.
	measure 'BSC Target Clinic Utilization' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Target Census], 'Care Type'[Care Type] = "OP" ), [BSC Clinic Capacity] )
			) -- end of measure body
			VAR __Wrong = [_Guard Targets]
			RETURN IF ( __Wrong = "", __Value, """BSC Target Clinic Utilization"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Targets
	/// Target of KPI 24: target IP census / target OP census.
	measure 'BSC Target OP to IP' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Target Census], 'Care Type'[Care Type] = "IP" ), CALCULATE ( [Target Census], 'Care Type'[Care Type] = "OP" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Targets]
			RETURN IF ( __Wrong = "", __Value, """BSC Target OP to IP"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Targets
	/// Target of KPI 42: target census of OP, ER and IP.
	measure 'BSC Target Patient Volume' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Target Census], 'Care Type'[Care Type] IN { "OP", "ER", "IP" } )
			) -- end of measure body
			VAR __Wrong = [_Guard Targets]
			RETURN IF ( __Wrong = "", __Value, """BSC Target Patient Volume"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Targets
	/// Target of KPI 57: target ER census / ER visits of the same days last year - 1 (days up to today).
	measure 'BSC Target ER Growth' =
			VAR __Value = ( -- measure body
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				VAR PriorYear = CALCULATE ( [ER Visits], SAMEPERIODLASTYEAR ( Past ) )
				RETURN IF ( NOT ISBLANK ( PriorYear ), DIVIDE ( CALCULATE ( [Target Census], 'Care Type'[Care Type] = "ER" ), PriorYear ) - 1 )
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters + Targets]
			RETURN IF ( __Wrong = "", __Value, """BSC Target ER Growth"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Targets
	/// Target of KPI 27: target OP revenue / target OP episodes.
	measure 'BSC Target OP Revenue per Episode' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Target Revenue], 'Care Type'[Care Type] = "OP" ), CALCULATE ( [Target Episodes], 'Care Type'[Care Type] = "OP" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Targets]
			RETURN IF ( __Wrong = "", __Value, """BSC Target OP Revenue per Episode"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Targets
	/// Target of KPI 28: the ancillary target share (BSC Parameters), where an OP revenue target exists.
	measure 'BSC Target Ancillary Utilization' =
			VAR __Value = ( -- measure body
				IF ( NOT ISBLANK ( CALCULATE ( [Target Revenue], 'Care Type'[Care Type] = "OP" ) ), MAX ( 'BSC Parameters'[Ancillary Target Share] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Targets]
			RETURN IF ( __Wrong = "", __Value, """BSC Target Ancillary Utilization"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Targets
	/// Target of KPI 35: budgeted G&A without marketing / budgeted net revenue.
	measure 'BSC Target G&A Ratio' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC Budget G&A], [BSC Budget Net Revenue] )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """BSC Target G&A Ratio"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Targets
	/// Target of KPI 44: budgeted net revenue / average FTE.
	measure 'BSC Target Revenue per FTE' =
			VAR __Value = ( -- measure body
				DIVIDE ( [BSC Budget Net Revenue], [BSC Average FTE] )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement + Workforce Monthly]
			RETURN IF ( __Wrong = "", __Value, """BSC Target Revenue per FTE"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Targets
	/// Fixed KPI target from the BI manager's table: average of the selected hospitals' monthly targets; an annual target with scale_with_months is pro-rated by the months in context.
	measure 'BSC Fixed Target' =
			VAR __Value = ( -- measure body
				VAR TargetValue = AVERAGE ( 'BSC Targets'[Target Value] )
				VAR Months = DISTINCTCOUNT ( 'BSC Targets'[Month Date Key] )
				RETURN IF ( MAX ( 'BSC Targets'[Scale With Months] ) = 1, TargetValue * Months / 12, TargetValue )
			) -- end of measure body
			VAR __Wrong = [_Guard BSC Targets]
			RETURN IF ( __Wrong = "", __Value, """BSC Fixed Target"" can't be analysed by " & __Wrong )
		formatString: #,0.00
		displayFolder: Balanced Scorecard\Targets
	/// Scorecard actual of the KPI in context: its measure (or the BI manager's manual value), for hospitals only and the days up to today; blank for a parked KPI.
	measure 'BSC Actual' =
			VAR __Value = ( -- measure body
				VAR Code = SELECTEDVALUE ( 'BSC KPI'[KPI Code] )
				VAR KpiState = SELECTEDVALUE ( 'BSC KPI'[Status] )
				VAR Source = SELECTEDVALUE ( 'BSC KPI'[Value Source] )
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				-- every KPI measure in one row: one table for all KPI rows, not a SWITCH of measures rebuilt per row
				VAR Measured =
					CALCULATETABLE (
						ROW (
							"@FIN_NET_REVENUE", [BSC Net Revenue],
							"@FIN_REVENUE_GROWTH", [BSC Net Revenue],
							"@FIN_EBITDA_MARGIN", [BSC EBITDA Margin],
							"@FIN_COST_TO_REVENUE", [BSC Cost to Revenue],
							"@FIN_CONSUMABLES_RATIO", [BSC Consumables Ratio],
							"@FIN_DAYS_IN_AR", [BSC Days in AR (days)],
							"@FIN_DAYS_INVENTORY", [BSC Days Inventory (days)],
							"@FIN_REVENUE_PER_BED", [BSC Revenue per Bed],
							"@FIN_RETURN_ON_ASSETS", [BSC Return on Assets],
							"@FIN_EBITDA_PER_BED", [BSC EBITDA per Bed],
							"@FIN_REVENUE_PER_DOCTOR", [BSC Revenue per Doctor],
							"@FIN_EBITDA_PER_DOCTOR", [BSC EBITDA per Doctor],
							"@CUS_MULTI_SPECIALTY_SHARE", [BSC Multi-Specialty Revenue Share],
							"@CUS_PAYER_MIX", [BSC Payer Mix],
							"@CUS_PATIENT_SATISFACTION", [BSC Patient Satisfaction],
							"@CUS_PATIENT_RETENTION", [BSC Patient Retention],
							"@CUS_NEW_PATIENTS", [BSC New Patient Acquisition],
							"@CUS_OP_WAIT", [BSC OP Waiting Time (min)],
							"@CUS_NON_MOH_SHARE", [BSC Non-MoH Revenue Share],
							"@CUS_PAYER_VOLUME", [BSC Payer Volume],
							"@CUS_ACQUISITION_COST", [BSC Patient Acquisition Cost],
							"@INT_BED_OCCUPANCY", [BSC Bed Occupancy],
							"@INT_OP_UTILIZATION", [BSC Clinic Utilization],
							"@INT_ALOS", [BSC ALOS (days)],
							"@INT_OP_TO_IP", [BSC OP to IP Conversion],
							"@INT_PATIENT_VOLUME", [BSC Patient Volume],
							"@INT_ER_GROWTH", [BSC ER Growth],
							"@INT_DOCTOR_UTILIZATION", [BSC OP Doctor Utilization],
							"@INT_ACTIVATED_BEDS", [BSC Activated Beds],
							"@INT_HIGH_VALUE_REVENUE", [BSC High-Value Revenue Share],
							"@INT_HIGH_VALUE_CENSUS", [BSC High-Value Census],
							"@INT_OP_REVENUE_PER_EPISODE", [BSC OP Revenue per Episode],
							"@INT_ANCILLARY_UTILIZATION", [BSC Ancillary Utilization],
							"@INT_REVENUE_LEAKAGE", [BSC Revenue Leakage],
							"@INT_CLAIM_INITIAL_REJECTION", [BSC Claim Initial Rejection],
							"@INT_ORDER_NOT_DONE", [BSC Order Not Done],
							"@INT_APPROVAL_TAT", [BSC Approval TAT (min)],
							"@INT_COST_BUDGET_VARIANCE", [BSC Cost Budget Variance],
							"@INT_GA_RATIO", [BSC G&A Ratio],
							"@INT_READMISSION_30D", [BSC Readmission 30d],
							"@INT_READMISSION_48H_CRITICAL", [BSC Readmission 48h Critical],
							"@INT_EXTERNAL_REFERRALS", [BSC External Referrals],
							"@LRN_TURNOVER", [BSC Turnover],
							"@LRN_REVENUE_PER_FTE", [BSC Revenue per FTE],
							"@LRN_STAFF_TO_BED", [BSC Staff to Bed],
							"@LRN_SAUDIZATION", [BSC Saudization],
							"@LRN_VACANCY_RATE", [BSC Vacancy Rate],
							"@LRN_TIME_TO_FILL", [BSC Time to Fill (days)],
							"@LRN_CLINICAL_TO_DOCTOR", [BSC Clinical to Doctor]
						),
						Past,
						REMOVEFILTERS ( 'BSC KPI' ),
						KEEPFILTERS ( Branch[Is Hospital] = "Yes" )
					)
				RETURN
					SWITCH (
						TRUE (),
						ISBLANK ( Code ) || KpiState = "parked", BLANK (),
						Source = "manual", CALCULATE ( [BSC Manual Value], Past, KEEPFILTERS ( Branch[Is Hospital] = "Yes" ) ),
						SWITCH (
							Code,
							"FIN_NET_REVENUE", MAXX ( Measured, [@FIN_NET_REVENUE] ),
							"FIN_REVENUE_GROWTH", MAXX ( Measured, [@FIN_REVENUE_GROWTH] ),
							"FIN_EBITDA_MARGIN", MAXX ( Measured, [@FIN_EBITDA_MARGIN] ),
							"FIN_COST_TO_REVENUE", MAXX ( Measured, [@FIN_COST_TO_REVENUE] ),
							"FIN_CONSUMABLES_RATIO", MAXX ( Measured, [@FIN_CONSUMABLES_RATIO] ),
							"FIN_DAYS_IN_AR", MAXX ( Measured, [@FIN_DAYS_IN_AR] ),
							"FIN_DAYS_INVENTORY", MAXX ( Measured, [@FIN_DAYS_INVENTORY] ),
							"FIN_REVENUE_PER_BED", MAXX ( Measured, [@FIN_REVENUE_PER_BED] ),
							"FIN_RETURN_ON_ASSETS", MAXX ( Measured, [@FIN_RETURN_ON_ASSETS] ),
							"FIN_EBITDA_PER_BED", MAXX ( Measured, [@FIN_EBITDA_PER_BED] ),
							"FIN_REVENUE_PER_DOCTOR", MAXX ( Measured, [@FIN_REVENUE_PER_DOCTOR] ),
							"FIN_EBITDA_PER_DOCTOR", MAXX ( Measured, [@FIN_EBITDA_PER_DOCTOR] ),
							"CUS_MULTI_SPECIALTY_SHARE", MAXX ( Measured, [@CUS_MULTI_SPECIALTY_SHARE] ),
							"CUS_PAYER_MIX", MAXX ( Measured, [@CUS_PAYER_MIX] ),
							"CUS_PATIENT_SATISFACTION", MAXX ( Measured, [@CUS_PATIENT_SATISFACTION] ),
							"CUS_PATIENT_RETENTION", MAXX ( Measured, [@CUS_PATIENT_RETENTION] ),
							"CUS_NEW_PATIENTS", MAXX ( Measured, [@CUS_NEW_PATIENTS] ),
							"CUS_OP_WAIT", MAXX ( Measured, [@CUS_OP_WAIT] ),
							"CUS_NON_MOH_SHARE", MAXX ( Measured, [@CUS_NON_MOH_SHARE] ),
							"CUS_PAYER_VOLUME", MAXX ( Measured, [@CUS_PAYER_VOLUME] ),
							"CUS_ACQUISITION_COST", MAXX ( Measured, [@CUS_ACQUISITION_COST] ),
							"INT_BED_OCCUPANCY", MAXX ( Measured, [@INT_BED_OCCUPANCY] ),
							"INT_OP_UTILIZATION", MAXX ( Measured, [@INT_OP_UTILIZATION] ),
							"INT_ALOS", MAXX ( Measured, [@INT_ALOS] ),
							"INT_OP_TO_IP", MAXX ( Measured, [@INT_OP_TO_IP] ),
							"INT_PATIENT_VOLUME", MAXX ( Measured, [@INT_PATIENT_VOLUME] ),
							"INT_ER_GROWTH", MAXX ( Measured, [@INT_ER_GROWTH] ),
							"INT_DOCTOR_UTILIZATION", MAXX ( Measured, [@INT_DOCTOR_UTILIZATION] ),
							"INT_ACTIVATED_BEDS", MAXX ( Measured, [@INT_ACTIVATED_BEDS] ),
							"INT_HIGH_VALUE_REVENUE", MAXX ( Measured, [@INT_HIGH_VALUE_REVENUE] ),
							"INT_HIGH_VALUE_CENSUS", MAXX ( Measured, [@INT_HIGH_VALUE_CENSUS] ),
							"INT_OP_REVENUE_PER_EPISODE", MAXX ( Measured, [@INT_OP_REVENUE_PER_EPISODE] ),
							"INT_ANCILLARY_UTILIZATION", MAXX ( Measured, [@INT_ANCILLARY_UTILIZATION] ),
							"INT_REVENUE_LEAKAGE", MAXX ( Measured, [@INT_REVENUE_LEAKAGE] ),
							"INT_CLAIM_INITIAL_REJECTION", MAXX ( Measured, [@INT_CLAIM_INITIAL_REJECTION] ),
							"INT_ORDER_NOT_DONE", MAXX ( Measured, [@INT_ORDER_NOT_DONE] ),
							"INT_APPROVAL_TAT", MAXX ( Measured, [@INT_APPROVAL_TAT] ),
							"INT_COST_BUDGET_VARIANCE", MAXX ( Measured, [@INT_COST_BUDGET_VARIANCE] ),
							"INT_GA_RATIO", MAXX ( Measured, [@INT_GA_RATIO] ),
							"INT_READMISSION_30D", MAXX ( Measured, [@INT_READMISSION_30D] ),
							"INT_READMISSION_48H_CRITICAL", MAXX ( Measured, [@INT_READMISSION_48H_CRITICAL] ),
							"INT_EXTERNAL_REFERRALS", MAXX ( Measured, [@INT_EXTERNAL_REFERRALS] ),
							"LRN_TURNOVER", MAXX ( Measured, [@LRN_TURNOVER] ),
							"LRN_REVENUE_PER_FTE", MAXX ( Measured, [@LRN_REVENUE_PER_FTE] ),
							"LRN_STAFF_TO_BED", MAXX ( Measured, [@LRN_STAFF_TO_BED] ),
							"LRN_SAUDIZATION", MAXX ( Measured, [@LRN_SAUDIZATION] ),
							"LRN_VACANCY_RATE", MAXX ( Measured, [@LRN_VACANCY_RATE] ),
							"LRN_TIME_TO_FILL", MAXX ( Measured, [@LRN_TIME_TO_FILL] ),
							"LRN_CLINICAL_TO_DOCTOR", MAXX ( Measured, [@LRN_CLINICAL_TO_DOCTOR] ),
							BLANK ()
						)
					)
			) -- end of measure body
			VAR __Wrong = [_Guard 17 facts #3ba24bc3]
			RETURN IF ( __Wrong = "", __Value, """BSC Actual"" can't be analysed by " & __Wrong )
		displayFolder: Balanced Scorecard\Scoring

		formatStringDefinition =
				SWITCH (
					SELECTEDVALUE ( 'BSC KPI'[Value Format] ),
					"sar", "#,0",
					"pct", "0.0%",
					"days", "#,0.0",
					"mins", "#,0.0",
					"#,0.00"
				)

		annotation hnh_guard_allow = BSC KPI
	/// Numerator of the actual of the KPI in context, in BSC Actual's filter context (days up to today, hospitals): BSC Actual is numerator ÷ denominator, numerator ÷ denominator − 1 for a growth KPI, or the numerator alone. Manual KPIs: the entered numerator. Blank for a parked KPI and for a KPI without parts (tools/bsc_kpi_parts.py).
	measure 'BSC Numerator' =
			VAR __Value = ( -- measure body
				VAR Code = SELECTEDVALUE ( 'BSC KPI'[KPI Code] )
				VAR KpiState = SELECTEDVALUE ( 'BSC KPI'[Status] )
				VAR Source = SELECTEDVALUE ( 'BSC KPI'[Value Source] )
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				-- the KPI's numerator (tools/bsc_kpi_parts.py) in the filter context BSC Actual gives the KPI's measure
				RETURN
					SWITCH (
						TRUE (),
						ISBLANK ( Code ) || KpiState = "parked", BLANK (),
						Source = "manual", CALCULATE ( SUM ( 'BSC Manual Values'[Numerator] ), Past, KEEPFILTERS ( Branch[Is Hospital] = "Yes" ) ),
						CALCULATE (
							SWITCH (
								Code,
								"FIN_NET_REVENUE", [BSC GL Net Revenue],
								"FIN_REVENUE_GROWTH", [BSC GL Net Revenue],
								"FIN_EBITDA_MARGIN", [BSC GL EBITDA],
								"FIN_COST_TO_REVENUE", [BSC GL Net Revenue] - [BSC GL EBITDA],
								"FIN_CONSUMABLES_RATIO", [BSC GL Consumables],
								"FIN_DAYS_IN_AR", [BSC GL AR Average] * [BSC Days in Period],
								"FIN_DAYS_INVENTORY", [BSC GL Inventory Average] * [BSC Days in Period],
								"FIN_REVENUE_PER_BED", [BSC GL Net Revenue],
								"FIN_RETURN_ON_ASSETS", [BSC GL Income],
								"FIN_EBITDA_PER_BED", [BSC GL EBITDA],
								"FIN_REVENUE_PER_DOCTOR", [BSC GL Net Revenue],
								"FIN_EBITDA_PER_DOCTOR", [BSC GL EBITDA],
								"CUS_MULTI_SPECIALTY_SHARE",
									CALCULATE ( [Revenue], 'Care Type'[Care Type] = "OP" )
										+ CALCULATE ( [Revenue], 'Care Type'[Care Type] = "IP", 'Charge Lines'[Is LTC] = "No" ),
								"CUS_PAYER_MIX", CALCULATE ( [Revenue by Episode Payer], Payer[Category] = "Insurance" ),
								"CUS_PATIENT_RETENTION", CALCULATE ( DISTINCTCOUNT ( Encounters[Patient Key] ), KEEPFILTERS ( Encounters[Encounter Type] = "OP" ), Encounters[Is Arrived] = "Yes", Encounters[Is Cancelled] = "No", Encounters[Is Returning] = "Yes" ),
								"CUS_NEW_PATIENTS", CALCULATE ( COUNTROWS ( Encounters ), KEEPFILTERS ( Encounters[Encounter Type] = "OP" ), Encounters[Is Arrived] = "Yes", KEEPFILTERS ( Encounters[Visit Type] = "New patient" ) ),
								"CUS_OP_WAIT", CALCULATE ( SUM ( Encounters[Wait Minutes] ), KEEPFILTERS ( Encounters[Encounter Type] = "OP" ), Encounters[Is Arrived] = "Yes", Encounters[Is Cancelled] = "No" ),
								"CUS_NON_MOH_SHARE", CALCULATE ( [Revenue by Episode Payer], Payer[Is MOH] = "No" ),
								"CUS_PAYER_VOLUME", CALCULATE ( [Census], Payer[Category] = "Insurance" ),
								"CUS_ACQUISITION_COST", [BSC GL Marketing],
								"INT_BED_OCCUPANCY", CALCULATE ( SUM ( 'Bed Occupancy'[Is Occupied] ), 'Bed Occupancy'[Is Inpatient Ward] = "Yes", 'Bed Occupancy'[Is Excluded Ward] = "No" ),
								"INT_OP_UTILIZATION", [OP Visits],
								"INT_ALOS", CALCULATE ( SUM ( Admissions[LOS Days] ), Admissions[Is Countable] = "Yes", Admissions[Is LTC] = "No", USERELATIONSHIP ( Admissions[Physical Discharge Date Key], 'Date'[Date Key] ) ),
								"INT_OP_TO_IP", [Admissions],
								"INT_PATIENT_VOLUME", [OP Visits] + [ER Visits] + [Admissions],
								"INT_ER_GROWTH", [ER Visits],
								"INT_DOCTOR_UTILIZATION", [OP Visits],
								"INT_ACTIVATED_BEDS", [BSC Available Beds],
								"INT_HIGH_VALUE_REVENUE", CALCULATE ( [Revenue], Staff[Is High Value Specialty] = "Yes" ),
								"INT_HIGH_VALUE_CENSUS",
									CALCULATE ( [Census], 'Booked Doctor'[Is High Value Specialty] = "Yes" )
										+ CALCULATE ( [Admissions], Staff[Is High Value Specialty] = "Yes" ),
								"INT_OP_REVENUE_PER_EPISODE", CALCULATE ( [Revenue], 'Care Type'[Care Type] = "OP" ),
								"INT_ANCILLARY_UTILIZATION", CALCULATE ( [Revenue], 'Care Type'[Care Type] = "OP", 'Product Category'[Is BSC Ancillary] = "Yes" ),
								"INT_REVENUE_LEAKAGE", CALCULATE ( SUM ( Invoices[Net Amount] ), Payer[Category] IN { "Insurance", "Government" }, 'Claim Status'[Submission Channel] <> "Manual", 'Claim Status'[Is Submitted] = "No" ),
								"INT_CLAIM_INITIAL_REJECTION", [Claims Rejected],
								"INT_ORDER_NOT_DONE", [Unutilised Approvals],
								"INT_APPROVAL_TAT", CALCULATE ( SUM ( 'Pre-auth Lines'[Sent To Response Minutes] ), KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ) ),
								"INT_COST_BUDGET_VARIANCE", [BSC GL Opex] - [BSC Budget Opex],
								"INT_GA_RATIO", [BSC GL G&A],
								"INT_READMISSION_30D", CALCULATE ( [Admissions], Admissions[Is Readmission 30d] = "Yes" ),
								"INT_READMISSION_48H_CRITICAL", [ICU Readmissions 48h],
								"INT_EXTERNAL_REFERRALS", CALCULATE ( [Census], Encounters[Is Referral Policy] = "Yes" ) + CALCULATE ( [Admissions], Admissions[Is Referral Policy] = "Yes" ),
								"LRN_TURNOVER", SUM ( 'Workforce Monthly'[Resignations] ),
								"LRN_REVENUE_PER_FTE", [BSC GL Net Revenue],
								"LRN_STAFF_TO_BED", [BSC Average FTE],
								"LRN_SAUDIZATION",
									SUMX (
										VALUES ( Branch[Branch Key] ),
										VAR LastMonth = [BSC Last Workforce Month]
										RETURN IF ( NOT ISBLANK ( LastMonth ), CALCULATE ( SUM ( 'Workforce Monthly'[Headcount] ), REMOVEFILTERS ( 'Date' ), 'Workforce Monthly'[Month Date Key] = LastMonth, 'Workforce Monthly'[Row Type] = "head", 'Workforce Monthly'[Is Saudi] = 1 ) )
									),
								"LRN_VACANCY_RATE",
									VAR PeriodEnd = CALCULATE ( MAX ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
									VAR LastKey = YEAR ( PeriodEnd ) * 10000 + MONTH ( PeriodEnd ) * 100 + DAY ( PeriodEnd )
									RETURN
										IF (
											NOT ISBLANK ( PeriodEnd ),
											CALCULATE (
												SUM ( Requisitions[Number To Hire] ),
												REMOVEFILTERS ( 'Date' ),
												Requisitions[Approved Date Key] <= LastKey,
												FILTER ( ALL ( Requisitions[Filled Date Key] ), ISBLANK ( Requisitions[Filled Date Key] ) || Requisitions[Filled Date Key] > LastKey )
											)
										),
								"LRN_TIME_TO_FILL", SUM ( Requisitions[Days To Fill] ),
								"LRN_CLINICAL_TO_DOCTOR", [BSC Average Medical],
								BLANK ()
							),
							Past,
							REMOVEFILTERS ( 'BSC KPI' ),
							KEEPFILTERS ( Branch[Is Hospital] = "Yes" )
						)
					)
			) -- end of measure body
			VAR __Wrong = [_Guard 12 facts #8b9401c7]
			RETURN IF ( __Wrong = "", __Value, """BSC Numerator"" can't be analysed by " & __Wrong )
		formatString: #,0.##
		displayFolder: Balanced Scorecard\Scoring

		annotation hnh_guard_allow = BSC KPI
	/// Denominator of the actual of the KPI in context, in BSC Actual's filter context (days up to today, hospitals); blank for a KPI whose actual is a value. Manual KPIs: the entered denominator, or outpatient and ER visits where it is 0 (as BSC Manual Value). Parts per KPI: tools/bsc_kpi_parts.py.
	measure 'BSC Denominator' =
			VAR __Value = ( -- measure body
				VAR Code = SELECTEDVALUE ( 'BSC KPI'[KPI Code] )
				VAR KpiState = SELECTEDVALUE ( 'BSC KPI'[Status] )
				VAR Source = SELECTEDVALUE ( 'BSC KPI'[Value Source] )
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				-- the KPI's denominator (tools/bsc_kpi_parts.py) in the filter context BSC Actual gives the KPI's measure
				RETURN
					SWITCH (
						TRUE (),
						ISBLANK ( Code ) || KpiState = "parked", BLANK (),
						Source = "manual",
							CALCULATE (
								VAR Num = SUM ( 'BSC Manual Values'[Numerator] )
								VAR Den = SUM ( 'BSC Manual Values'[Denominator] )
								-- a denominator of 0 divides by outpatient and ER visits, as in BSC Manual Value
								RETURN IF ( Den = 0 && NOT ISBLANK ( Num ), CALCULATE ( [Census], REMOVEFILTERS ( 'BSC KPI' ) ), Den ),
								Past,
								KEEPFILTERS ( Branch[Is Hospital] = "Yes" )
							),
						CALCULATE (
							SWITCH (
								Code,
								"FIN_EBITDA_MARGIN", [BSC GL Net Revenue],
								"FIN_COST_TO_REVENUE", [BSC GL Net Revenue],
								"FIN_CONSUMABLES_RATIO", [BSC GL Net Revenue],
								"FIN_DAYS_IN_AR", [BSC GL Net Revenue],
								"FIN_DAYS_INVENTORY", [BSC GL COGS],
								"FIN_REVENUE_PER_BED", [BSC Available Beds],
								"FIN_RETURN_ON_ASSETS", [BSC GL Assets Opening],
								"FIN_EBITDA_PER_BED", [BSC Available Beds],
								"FIN_REVENUE_PER_DOCTOR", [BSC Average Doctors],
								"FIN_EBITDA_PER_DOCTOR", [BSC Average Doctors],
								"CUS_MULTI_SPECIALTY_SHARE", [BSC GL Net Revenue],
								"CUS_PAYER_MIX", [BSC GL Net Revenue],
								"CUS_PATIENT_RETENTION", CALCULATE ( DISTINCTCOUNT ( Encounters[Patient Key] ), KEEPFILTERS ( Encounters[Encounter Type] = "OP" ), Encounters[Is Arrived] = "Yes", Encounters[Is Cancelled] = "No" ),
								"CUS_NEW_PATIENTS", [OP Visits],
								"CUS_OP_WAIT", CALCULATE ( COUNT ( Encounters[Wait Minutes] ), KEEPFILTERS ( Encounters[Encounter Type] = "OP" ), Encounters[Is Arrived] = "Yes", Encounters[Is Cancelled] = "No" ),
								"CUS_NON_MOH_SHARE", [BSC GL Net Revenue],
								"CUS_ACQUISITION_COST", CALCULATE ( DISTINCTCOUNT ( Encounters[Patient Key] ), KEEPFILTERS ( Encounters[Encounter Type] = "OP" ), Encounters[Is Arrived] = "Yes", KEEPFILTERS ( Encounters[Visit Type] = "New patient" ) ),
								"INT_BED_OCCUPANCY", CALCULATE ( SUM ( 'Bed Occupancy'[Is Available] ), 'Bed Occupancy'[Is Inpatient Ward] = "Yes", 'Bed Occupancy'[Is Excluded Ward] = "No" ),
								"INT_OP_UTILIZATION", [BSC Clinic Capacity],
								"INT_ALOS", CALCULATE ( COUNT ( Admissions[LOS Days] ), Admissions[Is Countable] = "Yes", Admissions[Is LTC] = "No", USERELATIONSHIP ( Admissions[Physical Discharge Date Key], 'Date'[Date Key] ) ),
								"INT_OP_TO_IP", [OP Visits],
								"INT_ER_GROWTH", CALCULATE ( [ER Visits], SAMEPERIODLASTYEAR ( CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) ) ) ),
								"INT_DOCTOR_UTILIZATION", SUM ( 'Clinic Capacity'[BSC Capacity Slots] ),
								"INT_ACTIVATED_BEDS", [BSC Licensed Beds],
								"INT_HIGH_VALUE_REVENUE", [BSC GL Net Revenue],
								"INT_HIGH_VALUE_CENSUS", [Census],
								"INT_OP_REVENUE_PER_EPISODE", CALCULATE ( [Episodes], 'Care Type'[Care Type] = "OP" ),
								"INT_ANCILLARY_UTILIZATION", CALCULATE ( [Revenue], 'Care Type'[Care Type] = "OP" ),
								"INT_REVENUE_LEAKAGE", CALCULATE ( SUM ( Invoices[Net Amount] ), Payer[Category] IN { "Insurance", "Government" }, 'Claim Status'[Submission Channel] <> "Manual" ),
								"INT_CLAIM_INITIAL_REJECTION", [Claims Submitted],
								"INT_ORDER_NOT_DONE", [Pre-auth Services],
								"INT_APPROVAL_TAT", CALCULATE ( COUNT ( 'Pre-auth Lines'[Sent To Response Minutes] ), KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ) ),
								"INT_COST_BUDGET_VARIANCE", [BSC Budget Opex],
								"INT_GA_RATIO", [BSC GL Net Revenue],
								"INT_READMISSION_30D", [Discharges],
								"INT_READMISSION_48H_CRITICAL", CALCULATE ( [Discharges], Bed[Is Critical] = "Yes" ),
								"LRN_TURNOVER", [BSC Average Headcount],
								"LRN_REVENUE_PER_FTE", [BSC Average FTE],
								"LRN_STAFF_TO_BED", [BSC Available Beds],
								"LRN_SAUDIZATION",
									SUMX (
										VALUES ( Branch[Branch Key] ),
										VAR LastMonth = [BSC Last Workforce Month]
										RETURN IF ( NOT ISBLANK ( LastMonth ), CALCULATE ( SUM ( 'Workforce Monthly'[Headcount] ), REMOVEFILTERS ( 'Date' ), 'Workforce Monthly'[Month Date Key] = LastMonth, 'Workforce Monthly'[Row Type] = "head" ) )
									),
								"LRN_VACANCY_RATE",
									VAR PeriodEnd = CALCULATE ( MAX ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
									RETURN
										IF (
											NOT ISBLANK ( PeriodEnd ),
											CALCULATE ( SUM ( 'BSC Budgeted FTE'[Budgeted FTE] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = YEAR ( PeriodEnd ) )
										),
								"LRN_TIME_TO_FILL", COUNT ( Requisitions[Days To Fill] ),
								"LRN_CLINICAL_TO_DOCTOR", [BSC Average Doctors],
								BLANK ()
							),
							Past,
							REMOVEFILTERS ( 'BSC KPI' ),
							KEEPFILTERS ( Branch[Is Hospital] = "Yes" )
						)
					)
			) -- end of measure body
			VAR __Wrong = [_Guard 16 facts #e3203857]
			RETURN IF ( __Wrong = "", __Value, """BSC Denominator"" can't be analysed by " & __Wrong )
		formatString: #,0.##
		displayFolder: Balanced Scorecard\Scoring

		annotation hnh_guard_allow = BSC KPI
	/// Scorecard target of the KPI in context, for the days up to today: fixed (BI manager's table), budget-based, or the same days last year.
	measure 'BSC Target' =
			VAR __Value = ( -- measure body
				VAR Code = SELECTEDVALUE ( 'BSC KPI'[KPI Code] )
				VAR KpiState = SELECTEDVALUE ( 'BSC KPI'[Status] )
				VAR TargetSource = SELECTEDVALUE ( 'BSC KPI'[Target Source] )
				VAR Skipped = ISBLANK ( Code ) || KpiState = "parked"
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				-- every budget target in one row: one table for all KPI rows, not a SWITCH of measures rebuilt per row
				VAR Budgeted =
					CALCULATETABLE (
						ROW (
							"@FIN_NET_REVENUE", [BSC Target Net Revenue],
							"@FIN_EBITDA_MARGIN", [BSC Target EBITDA Margin],
							"@FIN_COST_TO_REVENUE", [BSC Target Cost to Revenue],
							"@FIN_CONSUMABLES_RATIO", [BSC Target Consumables Ratio],
							"@FIN_DAYS_INVENTORY", [BSC Target Days Inventory (days)],
							"@FIN_REVENUE_PER_BED", [BSC Target Revenue per Bed],
							"@FIN_EBITDA_PER_BED", [BSC Target EBITDA per Bed],
							"@FIN_REVENUE_PER_DOCTOR", [BSC Target Revenue per Doctor],
							"@FIN_EBITDA_PER_DOCTOR", [BSC Target EBITDA per Doctor],
							"@CUS_MULTI_SPECIALTY_SHARE", [BSC Target Multi-Specialty Share],
							"@CUS_PAYER_MIX", [BSC Target Payer Mix],
							"@CUS_NON_MOH_SHARE", [BSC Target Non-MoH Share],
							"@CUS_PAYER_VOLUME", [BSC Target Payer Volume],
							"@INT_OP_UTILIZATION", [BSC Target Clinic Utilization],
							"@INT_OP_TO_IP", [BSC Target OP to IP],
							"@INT_PATIENT_VOLUME", [BSC Target Patient Volume],
							"@INT_ER_GROWTH", [BSC Target ER Growth],
							"@INT_OP_REVENUE_PER_EPISODE", [BSC Target OP Revenue per Episode],
							"@INT_ANCILLARY_UTILIZATION", [BSC Target Ancillary Utilization],
							"@INT_GA_RATIO", [BSC Target G&A Ratio],
							"@LRN_REVENUE_PER_FTE", [BSC Target Revenue per FTE]
						),
						Past,
						REMOVEFILTERS ( 'BSC KPI' ),
						KEEPFILTERS ( Branch[Is Hospital] = "Yes" )
					)
				VAR FixedTarget = CALCULATE ( [BSC Fixed Target], Past, KEEPFILTERS ( Branch[Is Hospital] = "Yes" ) )
				VAR PriorYear = CALCULATE ( [BSC Actual], SAMEPERIODLASTYEAR ( Past ) )
				RETURN
					SWITCH (
						TRUE (),
						Skipped, BLANK (),
						TargetSource = "fixed", FixedTarget,
						TargetSource = "prior_year", PriorYear,
						TargetSource = "budget",
							SWITCH (
								Code,
								"FIN_NET_REVENUE", MAXX ( Budgeted, [@FIN_NET_REVENUE] ),
								"FIN_EBITDA_MARGIN", MAXX ( Budgeted, [@FIN_EBITDA_MARGIN] ),
								"FIN_COST_TO_REVENUE", MAXX ( Budgeted, [@FIN_COST_TO_REVENUE] ),
								"FIN_CONSUMABLES_RATIO", MAXX ( Budgeted, [@FIN_CONSUMABLES_RATIO] ),
								"FIN_DAYS_INVENTORY", MAXX ( Budgeted, [@FIN_DAYS_INVENTORY] ),
								"FIN_REVENUE_PER_BED", MAXX ( Budgeted, [@FIN_REVENUE_PER_BED] ),
								"FIN_EBITDA_PER_BED", MAXX ( Budgeted, [@FIN_EBITDA_PER_BED] ),
								"FIN_REVENUE_PER_DOCTOR", MAXX ( Budgeted, [@FIN_REVENUE_PER_DOCTOR] ),
								"FIN_EBITDA_PER_DOCTOR", MAXX ( Budgeted, [@FIN_EBITDA_PER_DOCTOR] ),
								"CUS_MULTI_SPECIALTY_SHARE", MAXX ( Budgeted, [@CUS_MULTI_SPECIALTY_SHARE] ),
								"CUS_PAYER_MIX", MAXX ( Budgeted, [@CUS_PAYER_MIX] ),
								"CUS_NON_MOH_SHARE", MAXX ( Budgeted, [@CUS_NON_MOH_SHARE] ),
								"CUS_PAYER_VOLUME", MAXX ( Budgeted, [@CUS_PAYER_VOLUME] ),
								"INT_OP_UTILIZATION", MAXX ( Budgeted, [@INT_OP_UTILIZATION] ),
								"INT_OP_TO_IP", MAXX ( Budgeted, [@INT_OP_TO_IP] ),
								"INT_PATIENT_VOLUME", MAXX ( Budgeted, [@INT_PATIENT_VOLUME] ),
								"INT_ER_GROWTH", MAXX ( Budgeted, [@INT_ER_GROWTH] ),
								"INT_OP_REVENUE_PER_EPISODE", MAXX ( Budgeted, [@INT_OP_REVENUE_PER_EPISODE] ),
								"INT_ANCILLARY_UTILIZATION", MAXX ( Budgeted, [@INT_ANCILLARY_UTILIZATION] ),
								"INT_GA_RATIO", MAXX ( Budgeted, [@INT_GA_RATIO] ),
								"LRN_REVENUE_PER_FTE", MAXX ( Budgeted, [@LRN_REVENUE_PER_FTE] ),
								BLANK ()
							),
						BLANK ()
					)
			) -- end of measure body
			VAR __Wrong = [_Guard 19 facts #e451b8cd]
			RETURN IF ( __Wrong = "", __Value, """BSC Target"" can't be analysed by " & __Wrong )
		displayFolder: Balanced Scorecard\Scoring

		formatStringDefinition =
				SWITCH (
					SELECTEDVALUE ( 'BSC KPI'[Value Format] ),
					"sar", "#,0",
					"pct", "0.0%",
					"days", "#,0.0",
					"mins", "#,0.0",
					"#,0.00"
				)

		annotation hnh_guard_allow = BSC KPI
	/// Variance of actual against target in the KPI's direction: (actual - target) / |target| when higher is better, (target - actual) / |target| when lower is better, -|actual - target| / |target| for on target.
	measure 'BSC Variance %' =
			VAR __Value = ( -- measure body
				-- BSC Actual and BSC Target inlined: one table of the KPI measures for every period this measure needs
				VAR Code = SELECTEDVALUE ( 'BSC KPI'[KPI Code] )
				VAR KpiState = SELECTEDVALUE ( 'BSC KPI'[Status] )
				VAR ValueSource = SELECTEDVALUE ( 'BSC KPI'[Value Source] )
				VAR TargetSource = SELECTEDVALUE ( 'BSC KPI'[Target Source] )
				VAR Skipped = ISBLANK ( Code ) || KpiState = "parked"
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				VAR PastPY = CALCULATETABLE ( VALUES ( 'Date'[Date] ), SAMEPERIODLASTYEAR ( Past ) )
				VAR Periods = UNION ( ROW ( "@Period", 0 ), ROW ( "@Period", 1 ) )
				VAR PeriodDates =
					UNION (
						SELECTCOLUMNS ( Past, "@Period", 0, "@Date", 'Date'[Date] ),
						SELECTCOLUMNS ( PastPY, "@Period", 1, "@Date", 'Date'[Date] )
					)
				VAR Measured =
					GENERATE (
						Periods,
						VAR P = [@Period]
						RETURN
							CALCULATETABLE (
								ROW (
									"@FIN_NET_REVENUE", [BSC Net Revenue],
									"@FIN_REVENUE_GROWTH", [BSC Net Revenue],
									"@FIN_EBITDA_MARGIN", [BSC EBITDA Margin],
									"@FIN_COST_TO_REVENUE", [BSC Cost to Revenue],
									"@FIN_CONSUMABLES_RATIO", [BSC Consumables Ratio],
									"@FIN_DAYS_IN_AR", [BSC Days in AR (days)],
									"@FIN_DAYS_INVENTORY", [BSC Days Inventory (days)],
									"@FIN_REVENUE_PER_BED", [BSC Revenue per Bed],
									"@FIN_RETURN_ON_ASSETS", [BSC Return on Assets],
									"@FIN_EBITDA_PER_BED", [BSC EBITDA per Bed],
									"@FIN_REVENUE_PER_DOCTOR", [BSC Revenue per Doctor],
									"@FIN_EBITDA_PER_DOCTOR", [BSC EBITDA per Doctor],
									"@CUS_MULTI_SPECIALTY_SHARE", [BSC Multi-Specialty Revenue Share],
									"@CUS_PAYER_MIX", [BSC Payer Mix],
									"@CUS_PATIENT_SATISFACTION", [BSC Patient Satisfaction],
									"@CUS_PATIENT_RETENTION", [BSC Patient Retention],
									"@CUS_NEW_PATIENTS", [BSC New Patient Acquisition],
									"@CUS_OP_WAIT", [BSC OP Waiting Time (min)],
									"@CUS_NON_MOH_SHARE", [BSC Non-MoH Revenue Share],
									"@CUS_PAYER_VOLUME", [BSC Payer Volume],
									"@CUS_ACQUISITION_COST", [BSC Patient Acquisition Cost],
									"@INT_BED_OCCUPANCY", [BSC Bed Occupancy],
									"@INT_OP_UTILIZATION", [BSC Clinic Utilization],
									"@INT_ALOS", [BSC ALOS (days)],
									"@INT_OP_TO_IP", [BSC OP to IP Conversion],
									"@INT_PATIENT_VOLUME", [BSC Patient Volume],
									"@INT_ER_GROWTH", [BSC ER Growth],
									"@INT_DOCTOR_UTILIZATION", [BSC OP Doctor Utilization],
									"@INT_ACTIVATED_BEDS", [BSC Activated Beds],
									"@INT_HIGH_VALUE_REVENUE", [BSC High-Value Revenue Share],
									"@INT_HIGH_VALUE_CENSUS", [BSC High-Value Census],
									"@INT_OP_REVENUE_PER_EPISODE", [BSC OP Revenue per Episode],
									"@INT_ANCILLARY_UTILIZATION", [BSC Ancillary Utilization],
									"@INT_REVENUE_LEAKAGE", [BSC Revenue Leakage],
									"@INT_CLAIM_INITIAL_REJECTION", [BSC Claim Initial Rejection],
									"@INT_ORDER_NOT_DONE", [BSC Order Not Done],
									"@INT_APPROVAL_TAT", [BSC Approval TAT (min)],
									"@INT_COST_BUDGET_VARIANCE", [BSC Cost Budget Variance],
									"@INT_GA_RATIO", [BSC G&A Ratio],
									"@INT_READMISSION_30D", [BSC Readmission 30d],
									"@INT_READMISSION_48H_CRITICAL", [BSC Readmission 48h Critical],
									"@INT_EXTERNAL_REFERRALS", [BSC External Referrals],
									"@LRN_TURNOVER", [BSC Turnover],
									"@LRN_REVENUE_PER_FTE", [BSC Revenue per FTE],
									"@LRN_STAFF_TO_BED", [BSC Staff to Bed],
									"@LRN_SAUDIZATION", [BSC Saudization],
									"@LRN_VACANCY_RATE", [BSC Vacancy Rate],
									"@LRN_TIME_TO_FILL", [BSC Time to Fill (days)],
									"@LRN_CLINICAL_TO_DOCTOR", [BSC Clinical to Doctor]
								),
								REMOVEFILTERS ( 'Date' ),
								TREATAS ( SELECTCOLUMNS ( FILTER ( PeriodDates, [@Period] = P ), "@Date", [@Date] ), 'Date'[Date] ),
								REMOVEFILTERS ( 'BSC KPI' ),
								KEEPFILTERS ( Branch[Is Hospital] = "Yes" )
							)
					)
				VAR Actuals =
					ADDCOLUMNS (
						Periods,
						"@Actual",
							VAR P = [@Period]
							VAR PeriodMeasures = FILTER ( Measured, [@Period] = P )
							RETURN
								SWITCH (
									TRUE (),
									Skipped, BLANK (),
									ValueSource = "manual", CALCULATE (
										[BSC Manual Value],
										REMOVEFILTERS ( 'Date' ),
										TREATAS ( SELECTCOLUMNS ( FILTER ( PeriodDates, [@Period] = P ), "@Date", [@Date] ), 'Date'[Date] ),
										KEEPFILTERS ( Branch[Is Hospital] = "Yes" )
									),
									SWITCH (
										Code,
										"FIN_NET_REVENUE", MAXX ( PeriodMeasures, [@FIN_NET_REVENUE] ),
										"FIN_REVENUE_GROWTH", MAXX ( PeriodMeasures, [@FIN_REVENUE_GROWTH] ),
										"FIN_EBITDA_MARGIN", MAXX ( PeriodMeasures, [@FIN_EBITDA_MARGIN] ),
										"FIN_COST_TO_REVENUE", MAXX ( PeriodMeasures, [@FIN_COST_TO_REVENUE] ),
										"FIN_CONSUMABLES_RATIO", MAXX ( PeriodMeasures, [@FIN_CONSUMABLES_RATIO] ),
										"FIN_DAYS_IN_AR", MAXX ( PeriodMeasures, [@FIN_DAYS_IN_AR] ),
										"FIN_DAYS_INVENTORY", MAXX ( PeriodMeasures, [@FIN_DAYS_INVENTORY] ),
										"FIN_REVENUE_PER_BED", MAXX ( PeriodMeasures, [@FIN_REVENUE_PER_BED] ),
										"FIN_RETURN_ON_ASSETS", MAXX ( PeriodMeasures, [@FIN_RETURN_ON_ASSETS] ),
										"FIN_EBITDA_PER_BED", MAXX ( PeriodMeasures, [@FIN_EBITDA_PER_BED] ),
										"FIN_REVENUE_PER_DOCTOR", MAXX ( PeriodMeasures, [@FIN_REVENUE_PER_DOCTOR] ),
										"FIN_EBITDA_PER_DOCTOR", MAXX ( PeriodMeasures, [@FIN_EBITDA_PER_DOCTOR] ),
										"CUS_MULTI_SPECIALTY_SHARE", MAXX ( PeriodMeasures, [@CUS_MULTI_SPECIALTY_SHARE] ),
										"CUS_PAYER_MIX", MAXX ( PeriodMeasures, [@CUS_PAYER_MIX] ),
										"CUS_PATIENT_SATISFACTION", MAXX ( PeriodMeasures, [@CUS_PATIENT_SATISFACTION] ),
										"CUS_PATIENT_RETENTION", MAXX ( PeriodMeasures, [@CUS_PATIENT_RETENTION] ),
										"CUS_NEW_PATIENTS", MAXX ( PeriodMeasures, [@CUS_NEW_PATIENTS] ),
										"CUS_OP_WAIT", MAXX ( PeriodMeasures, [@CUS_OP_WAIT] ),
										"CUS_NON_MOH_SHARE", MAXX ( PeriodMeasures, [@CUS_NON_MOH_SHARE] ),
										"CUS_PAYER_VOLUME", MAXX ( PeriodMeasures, [@CUS_PAYER_VOLUME] ),
										"CUS_ACQUISITION_COST", MAXX ( PeriodMeasures, [@CUS_ACQUISITION_COST] ),
										"INT_BED_OCCUPANCY", MAXX ( PeriodMeasures, [@INT_BED_OCCUPANCY] ),
										"INT_OP_UTILIZATION", MAXX ( PeriodMeasures, [@INT_OP_UTILIZATION] ),
										"INT_ALOS", MAXX ( PeriodMeasures, [@INT_ALOS] ),
										"INT_OP_TO_IP", MAXX ( PeriodMeasures, [@INT_OP_TO_IP] ),
										"INT_PATIENT_VOLUME", MAXX ( PeriodMeasures, [@INT_PATIENT_VOLUME] ),
										"INT_ER_GROWTH", MAXX ( PeriodMeasures, [@INT_ER_GROWTH] ),
										"INT_DOCTOR_UTILIZATION", MAXX ( PeriodMeasures, [@INT_DOCTOR_UTILIZATION] ),
										"INT_ACTIVATED_BEDS", MAXX ( PeriodMeasures, [@INT_ACTIVATED_BEDS] ),
										"INT_HIGH_VALUE_REVENUE", MAXX ( PeriodMeasures, [@INT_HIGH_VALUE_REVENUE] ),
										"INT_HIGH_VALUE_CENSUS", MAXX ( PeriodMeasures, [@INT_HIGH_VALUE_CENSUS] ),
										"INT_OP_REVENUE_PER_EPISODE", MAXX ( PeriodMeasures, [@INT_OP_REVENUE_PER_EPISODE] ),
										"INT_ANCILLARY_UTILIZATION", MAXX ( PeriodMeasures, [@INT_ANCILLARY_UTILIZATION] ),
										"INT_REVENUE_LEAKAGE", MAXX ( PeriodMeasures, [@INT_REVENUE_LEAKAGE] ),
										"INT_CLAIM_INITIAL_REJECTION", MAXX ( PeriodMeasures, [@INT_CLAIM_INITIAL_REJECTION] ),
										"INT_ORDER_NOT_DONE", MAXX ( PeriodMeasures, [@INT_ORDER_NOT_DONE] ),
										"INT_APPROVAL_TAT", MAXX ( PeriodMeasures, [@INT_APPROVAL_TAT] ),
										"INT_COST_BUDGET_VARIANCE", MAXX ( PeriodMeasures, [@INT_COST_BUDGET_VARIANCE] ),
										"INT_GA_RATIO", MAXX ( PeriodMeasures, [@INT_GA_RATIO] ),
										"INT_READMISSION_30D", MAXX ( PeriodMeasures, [@INT_READMISSION_30D] ),
										"INT_READMISSION_48H_CRITICAL", MAXX ( PeriodMeasures, [@INT_READMISSION_48H_CRITICAL] ),
										"INT_EXTERNAL_REFERRALS", MAXX ( PeriodMeasures, [@INT_EXTERNAL_REFERRALS] ),
										"LRN_TURNOVER", MAXX ( PeriodMeasures, [@LRN_TURNOVER] ),
										"LRN_REVENUE_PER_FTE", MAXX ( PeriodMeasures, [@LRN_REVENUE_PER_FTE] ),
										"LRN_STAFF_TO_BED", MAXX ( PeriodMeasures, [@LRN_STAFF_TO_BED] ),
										"LRN_SAUDIZATION", MAXX ( PeriodMeasures, [@LRN_SAUDIZATION] ),
										"LRN_VACANCY_RATE", MAXX ( PeriodMeasures, [@LRN_VACANCY_RATE] ),
										"LRN_TIME_TO_FILL", MAXX ( PeriodMeasures, [@LRN_TIME_TO_FILL] ),
										"LRN_CLINICAL_TO_DOCTOR", MAXX ( PeriodMeasures, [@LRN_CLINICAL_TO_DOCTOR] ),
										BLANK ()
									)
								)
					)
				VAR A = MAXX ( FILTER ( Actuals, [@Period] = 0 ), [@Actual] )
				VAR APY = MAXX ( FILTER ( Actuals, [@Period] = 1 ), [@Actual] )
				VAR Budgeted =
					CALCULATETABLE (
						ROW (
							"@FIN_NET_REVENUE", [BSC Target Net Revenue],
							"@FIN_EBITDA_MARGIN", [BSC Target EBITDA Margin],
							"@FIN_COST_TO_REVENUE", [BSC Target Cost to Revenue],
							"@FIN_CONSUMABLES_RATIO", [BSC Target Consumables Ratio],
							"@FIN_DAYS_INVENTORY", [BSC Target Days Inventory (days)],
							"@FIN_REVENUE_PER_BED", [BSC Target Revenue per Bed],
							"@FIN_EBITDA_PER_BED", [BSC Target EBITDA per Bed],
							"@FIN_REVENUE_PER_DOCTOR", [BSC Target Revenue per Doctor],
							"@FIN_EBITDA_PER_DOCTOR", [BSC Target EBITDA per Doctor],
							"@CUS_MULTI_SPECIALTY_SHARE", [BSC Target Multi-Specialty Share],
							"@CUS_PAYER_MIX", [BSC Target Payer Mix],
							"@CUS_NON_MOH_SHARE", [BSC Target Non-MoH Share],
							"@CUS_PAYER_VOLUME", [BSC Target Payer Volume],
							"@INT_OP_UTILIZATION", [BSC Target Clinic Utilization],
							"@INT_OP_TO_IP", [BSC Target OP to IP],
							"@INT_PATIENT_VOLUME", [BSC Target Patient Volume],
							"@INT_ER_GROWTH", [BSC Target ER Growth],
							"@INT_OP_REVENUE_PER_EPISODE", [BSC Target OP Revenue per Episode],
							"@INT_ANCILLARY_UTILIZATION", [BSC Target Ancillary Utilization],
							"@INT_GA_RATIO", [BSC Target G&A Ratio],
							"@LRN_REVENUE_PER_FTE", [BSC Target Revenue per FTE]
						),
						Past,
						REMOVEFILTERS ( 'BSC KPI' ),
						KEEPFILTERS ( Branch[Is Hospital] = "Yes" )
					)
				VAR FixedTarget = CALCULATE ( [BSC Fixed Target], Past, KEEPFILTERS ( Branch[Is Hospital] = "Yes" ) )
				VAR T =
					SWITCH (
						TRUE (),
						Skipped, BLANK (),
						TargetSource = "fixed", FixedTarget,
						TargetSource = "prior_year", APY,
						TargetSource = "budget",
							SWITCH (
								Code,
								"FIN_NET_REVENUE", MAXX ( Budgeted, [@FIN_NET_REVENUE] ),
								"FIN_EBITDA_MARGIN", MAXX ( Budgeted, [@FIN_EBITDA_MARGIN] ),
								"FIN_COST_TO_REVENUE", MAXX ( Budgeted, [@FIN_COST_TO_REVENUE] ),
								"FIN_CONSUMABLES_RATIO", MAXX ( Budgeted, [@FIN_CONSUMABLES_RATIO] ),
								"FIN_DAYS_INVENTORY", MAXX ( Budgeted, [@FIN_DAYS_INVENTORY] ),
								"FIN_REVENUE_PER_BED", MAXX ( Budgeted, [@FIN_REVENUE_PER_BED] ),
								"FIN_EBITDA_PER_BED", MAXX ( Budgeted, [@FIN_EBITDA_PER_BED] ),
								"FIN_REVENUE_PER_DOCTOR", MAXX ( Budgeted, [@FIN_REVENUE_PER_DOCTOR] ),
								"FIN_EBITDA_PER_DOCTOR", MAXX ( Budgeted, [@FIN_EBITDA_PER_DOCTOR] ),
								"CUS_MULTI_SPECIALTY_SHARE", MAXX ( Budgeted, [@CUS_MULTI_SPECIALTY_SHARE] ),
								"CUS_PAYER_MIX", MAXX ( Budgeted, [@CUS_PAYER_MIX] ),
								"CUS_NON_MOH_SHARE", MAXX ( Budgeted, [@CUS_NON_MOH_SHARE] ),
								"CUS_PAYER_VOLUME", MAXX ( Budgeted, [@CUS_PAYER_VOLUME] ),
								"INT_OP_UTILIZATION", MAXX ( Budgeted, [@INT_OP_UTILIZATION] ),
								"INT_OP_TO_IP", MAXX ( Budgeted, [@INT_OP_TO_IP] ),
								"INT_PATIENT_VOLUME", MAXX ( Budgeted, [@INT_PATIENT_VOLUME] ),
								"INT_ER_GROWTH", MAXX ( Budgeted, [@INT_ER_GROWTH] ),
								"INT_OP_REVENUE_PER_EPISODE", MAXX ( Budgeted, [@INT_OP_REVENUE_PER_EPISODE] ),
								"INT_ANCILLARY_UTILIZATION", MAXX ( Budgeted, [@INT_ANCILLARY_UTILIZATION] ),
								"INT_GA_RATIO", MAXX ( Budgeted, [@INT_GA_RATIO] ),
								"LRN_REVENUE_PER_FTE", MAXX ( Budgeted, [@LRN_REVENUE_PER_FTE] ),
								BLANK ()
							),
						BLANK ()
					)
				VAR Dir = SELECTEDVALUE ( 'BSC KPI'[Direction] )
				VAR Diff = SWITCH ( Dir, "higher", A - T, "on_target", - ABS ( A - T ), T - A )
				VAR V = IF ( ISBLANK ( A ) || ISBLANK ( T ) || ISTEXT ( A ) || ISTEXT ( T ), BLANK (), IF ( T = 0, Diff, DIVIDE ( Diff, ABS ( T ) ) ) )
				RETURN V
			) -- end of measure body
			VAR __Wrong = [_Guard 19 facts #e451b8cd]
			RETURN IF ( __Wrong = "", __Value, """BSC Variance %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Balanced Scorecard\Scoring

		annotation hnh_guard_allow = BSC KPI
	/// KPI score 0-100: score base + score slope x variance in points, from the KPI's thresholds.
	measure 'BSC Score' =
			VAR __Value = ( -- measure body
				-- BSC Actual and BSC Target inlined: one table of the KPI measures for every period this measure needs
				VAR Code = SELECTEDVALUE ( 'BSC KPI'[KPI Code] )
				VAR KpiState = SELECTEDVALUE ( 'BSC KPI'[Status] )
				VAR ValueSource = SELECTEDVALUE ( 'BSC KPI'[Value Source] )
				VAR TargetSource = SELECTEDVALUE ( 'BSC KPI'[Target Source] )
				VAR Skipped = ISBLANK ( Code ) || KpiState = "parked"
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				VAR PastPY = CALCULATETABLE ( VALUES ( 'Date'[Date] ), SAMEPERIODLASTYEAR ( Past ) )
				VAR Periods = UNION ( ROW ( "@Period", 0 ), ROW ( "@Period", 1 ) )
				VAR PeriodDates =
					UNION (
						SELECTCOLUMNS ( Past, "@Period", 0, "@Date", 'Date'[Date] ),
						SELECTCOLUMNS ( PastPY, "@Period", 1, "@Date", 'Date'[Date] )
					)
				VAR Measured =
					GENERATE (
						Periods,
						VAR P = [@Period]
						RETURN
							CALCULATETABLE (
								ROW (
									"@FIN_NET_REVENUE", [BSC Net Revenue],
									"@FIN_REVENUE_GROWTH", [BSC Net Revenue],
									"@FIN_EBITDA_MARGIN", [BSC EBITDA Margin],
									"@FIN_COST_TO_REVENUE", [BSC Cost to Revenue],
									"@FIN_CONSUMABLES_RATIO", [BSC Consumables Ratio],
									"@FIN_DAYS_IN_AR", [BSC Days in AR (days)],
									"@FIN_DAYS_INVENTORY", [BSC Days Inventory (days)],
									"@FIN_REVENUE_PER_BED", [BSC Revenue per Bed],
									"@FIN_RETURN_ON_ASSETS", [BSC Return on Assets],
									"@FIN_EBITDA_PER_BED", [BSC EBITDA per Bed],
									"@FIN_REVENUE_PER_DOCTOR", [BSC Revenue per Doctor],
									"@FIN_EBITDA_PER_DOCTOR", [BSC EBITDA per Doctor],
									"@CUS_MULTI_SPECIALTY_SHARE", [BSC Multi-Specialty Revenue Share],
									"@CUS_PAYER_MIX", [BSC Payer Mix],
									"@CUS_PATIENT_SATISFACTION", [BSC Patient Satisfaction],
									"@CUS_PATIENT_RETENTION", [BSC Patient Retention],
									"@CUS_NEW_PATIENTS", [BSC New Patient Acquisition],
									"@CUS_OP_WAIT", [BSC OP Waiting Time (min)],
									"@CUS_NON_MOH_SHARE", [BSC Non-MoH Revenue Share],
									"@CUS_PAYER_VOLUME", [BSC Payer Volume],
									"@CUS_ACQUISITION_COST", [BSC Patient Acquisition Cost],
									"@INT_BED_OCCUPANCY", [BSC Bed Occupancy],
									"@INT_OP_UTILIZATION", [BSC Clinic Utilization],
									"@INT_ALOS", [BSC ALOS (days)],
									"@INT_OP_TO_IP", [BSC OP to IP Conversion],
									"@INT_PATIENT_VOLUME", [BSC Patient Volume],
									"@INT_ER_GROWTH", [BSC ER Growth],
									"@INT_DOCTOR_UTILIZATION", [BSC OP Doctor Utilization],
									"@INT_ACTIVATED_BEDS", [BSC Activated Beds],
									"@INT_HIGH_VALUE_REVENUE", [BSC High-Value Revenue Share],
									"@INT_HIGH_VALUE_CENSUS", [BSC High-Value Census],
									"@INT_OP_REVENUE_PER_EPISODE", [BSC OP Revenue per Episode],
									"@INT_ANCILLARY_UTILIZATION", [BSC Ancillary Utilization],
									"@INT_REVENUE_LEAKAGE", [BSC Revenue Leakage],
									"@INT_CLAIM_INITIAL_REJECTION", [BSC Claim Initial Rejection],
									"@INT_ORDER_NOT_DONE", [BSC Order Not Done],
									"@INT_APPROVAL_TAT", [BSC Approval TAT (min)],
									"@INT_COST_BUDGET_VARIANCE", [BSC Cost Budget Variance],
									"@INT_GA_RATIO", [BSC G&A Ratio],
									"@INT_READMISSION_30D", [BSC Readmission 30d],
									"@INT_READMISSION_48H_CRITICAL", [BSC Readmission 48h Critical],
									"@INT_EXTERNAL_REFERRALS", [BSC External Referrals],
									"@LRN_TURNOVER", [BSC Turnover],
									"@LRN_REVENUE_PER_FTE", [BSC Revenue per FTE],
									"@LRN_STAFF_TO_BED", [BSC Staff to Bed],
									"@LRN_SAUDIZATION", [BSC Saudization],
									"@LRN_VACANCY_RATE", [BSC Vacancy Rate],
									"@LRN_TIME_TO_FILL", [BSC Time to Fill (days)],
									"@LRN_CLINICAL_TO_DOCTOR", [BSC Clinical to Doctor]
								),
								REMOVEFILTERS ( 'Date' ),
								TREATAS ( SELECTCOLUMNS ( FILTER ( PeriodDates, [@Period] = P ), "@Date", [@Date] ), 'Date'[Date] ),
								REMOVEFILTERS ( 'BSC KPI' ),
								KEEPFILTERS ( Branch[Is Hospital] = "Yes" )
							)
					)
				VAR Actuals =
					ADDCOLUMNS (
						Periods,
						"@Actual",
							VAR P = [@Period]
							VAR PeriodMeasures = FILTER ( Measured, [@Period] = P )
							RETURN
								SWITCH (
									TRUE (),
									Skipped, BLANK (),
									ValueSource = "manual", CALCULATE (
										[BSC Manual Value],
										REMOVEFILTERS ( 'Date' ),
										TREATAS ( SELECTCOLUMNS ( FILTER ( PeriodDates, [@Period] = P ), "@Date", [@Date] ), 'Date'[Date] ),
										KEEPFILTERS ( Branch[Is Hospital] = "Yes" )
									),
									SWITCH (
										Code,
										"FIN_NET_REVENUE", MAXX ( PeriodMeasures, [@FIN_NET_REVENUE] ),
										"FIN_REVENUE_GROWTH", MAXX ( PeriodMeasures, [@FIN_REVENUE_GROWTH] ),
										"FIN_EBITDA_MARGIN", MAXX ( PeriodMeasures, [@FIN_EBITDA_MARGIN] ),
										"FIN_COST_TO_REVENUE", MAXX ( PeriodMeasures, [@FIN_COST_TO_REVENUE] ),
										"FIN_CONSUMABLES_RATIO", MAXX ( PeriodMeasures, [@FIN_CONSUMABLES_RATIO] ),
										"FIN_DAYS_IN_AR", MAXX ( PeriodMeasures, [@FIN_DAYS_IN_AR] ),
										"FIN_DAYS_INVENTORY", MAXX ( PeriodMeasures, [@FIN_DAYS_INVENTORY] ),
										"FIN_REVENUE_PER_BED", MAXX ( PeriodMeasures, [@FIN_REVENUE_PER_BED] ),
										"FIN_RETURN_ON_ASSETS", MAXX ( PeriodMeasures, [@FIN_RETURN_ON_ASSETS] ),
										"FIN_EBITDA_PER_BED", MAXX ( PeriodMeasures, [@FIN_EBITDA_PER_BED] ),
										"FIN_REVENUE_PER_DOCTOR", MAXX ( PeriodMeasures, [@FIN_REVENUE_PER_DOCTOR] ),
										"FIN_EBITDA_PER_DOCTOR", MAXX ( PeriodMeasures, [@FIN_EBITDA_PER_DOCTOR] ),
										"CUS_MULTI_SPECIALTY_SHARE", MAXX ( PeriodMeasures, [@CUS_MULTI_SPECIALTY_SHARE] ),
										"CUS_PAYER_MIX", MAXX ( PeriodMeasures, [@CUS_PAYER_MIX] ),
										"CUS_PATIENT_SATISFACTION", MAXX ( PeriodMeasures, [@CUS_PATIENT_SATISFACTION] ),
										"CUS_PATIENT_RETENTION", MAXX ( PeriodMeasures, [@CUS_PATIENT_RETENTION] ),
										"CUS_NEW_PATIENTS", MAXX ( PeriodMeasures, [@CUS_NEW_PATIENTS] ),
										"CUS_OP_WAIT", MAXX ( PeriodMeasures, [@CUS_OP_WAIT] ),
										"CUS_NON_MOH_SHARE", MAXX ( PeriodMeasures, [@CUS_NON_MOH_SHARE] ),
										"CUS_PAYER_VOLUME", MAXX ( PeriodMeasures, [@CUS_PAYER_VOLUME] ),
										"CUS_ACQUISITION_COST", MAXX ( PeriodMeasures, [@CUS_ACQUISITION_COST] ),
										"INT_BED_OCCUPANCY", MAXX ( PeriodMeasures, [@INT_BED_OCCUPANCY] ),
										"INT_OP_UTILIZATION", MAXX ( PeriodMeasures, [@INT_OP_UTILIZATION] ),
										"INT_ALOS", MAXX ( PeriodMeasures, [@INT_ALOS] ),
										"INT_OP_TO_IP", MAXX ( PeriodMeasures, [@INT_OP_TO_IP] ),
										"INT_PATIENT_VOLUME", MAXX ( PeriodMeasures, [@INT_PATIENT_VOLUME] ),
										"INT_ER_GROWTH", MAXX ( PeriodMeasures, [@INT_ER_GROWTH] ),
										"INT_DOCTOR_UTILIZATION", MAXX ( PeriodMeasures, [@INT_DOCTOR_UTILIZATION] ),
										"INT_ACTIVATED_BEDS", MAXX ( PeriodMeasures, [@INT_ACTIVATED_BEDS] ),
										"INT_HIGH_VALUE_REVENUE", MAXX ( PeriodMeasures, [@INT_HIGH_VALUE_REVENUE] ),
										"INT_HIGH_VALUE_CENSUS", MAXX ( PeriodMeasures, [@INT_HIGH_VALUE_CENSUS] ),
										"INT_OP_REVENUE_PER_EPISODE", MAXX ( PeriodMeasures, [@INT_OP_REVENUE_PER_EPISODE] ),
										"INT_ANCILLARY_UTILIZATION", MAXX ( PeriodMeasures, [@INT_ANCILLARY_UTILIZATION] ),
										"INT_REVENUE_LEAKAGE", MAXX ( PeriodMeasures, [@INT_REVENUE_LEAKAGE] ),
										"INT_CLAIM_INITIAL_REJECTION", MAXX ( PeriodMeasures, [@INT_CLAIM_INITIAL_REJECTION] ),
										"INT_ORDER_NOT_DONE", MAXX ( PeriodMeasures, [@INT_ORDER_NOT_DONE] ),
										"INT_APPROVAL_TAT", MAXX ( PeriodMeasures, [@INT_APPROVAL_TAT] ),
										"INT_COST_BUDGET_VARIANCE", MAXX ( PeriodMeasures, [@INT_COST_BUDGET_VARIANCE] ),
										"INT_GA_RATIO", MAXX ( PeriodMeasures, [@INT_GA_RATIO] ),
										"INT_READMISSION_30D", MAXX ( PeriodMeasures, [@INT_READMISSION_30D] ),
										"INT_READMISSION_48H_CRITICAL", MAXX ( PeriodMeasures, [@INT_READMISSION_48H_CRITICAL] ),
										"INT_EXTERNAL_REFERRALS", MAXX ( PeriodMeasures, [@INT_EXTERNAL_REFERRALS] ),
										"LRN_TURNOVER", MAXX ( PeriodMeasures, [@LRN_TURNOVER] ),
										"LRN_REVENUE_PER_FTE", MAXX ( PeriodMeasures, [@LRN_REVENUE_PER_FTE] ),
										"LRN_STAFF_TO_BED", MAXX ( PeriodMeasures, [@LRN_STAFF_TO_BED] ),
										"LRN_SAUDIZATION", MAXX ( PeriodMeasures, [@LRN_SAUDIZATION] ),
										"LRN_VACANCY_RATE", MAXX ( PeriodMeasures, [@LRN_VACANCY_RATE] ),
										"LRN_TIME_TO_FILL", MAXX ( PeriodMeasures, [@LRN_TIME_TO_FILL] ),
										"LRN_CLINICAL_TO_DOCTOR", MAXX ( PeriodMeasures, [@LRN_CLINICAL_TO_DOCTOR] ),
										BLANK ()
									)
								)
					)
				VAR A = MAXX ( FILTER ( Actuals, [@Period] = 0 ), [@Actual] )
				VAR APY = MAXX ( FILTER ( Actuals, [@Period] = 1 ), [@Actual] )
				VAR Budgeted =
					CALCULATETABLE (
						ROW (
							"@FIN_NET_REVENUE", [BSC Target Net Revenue],
							"@FIN_EBITDA_MARGIN", [BSC Target EBITDA Margin],
							"@FIN_COST_TO_REVENUE", [BSC Target Cost to Revenue],
							"@FIN_CONSUMABLES_RATIO", [BSC Target Consumables Ratio],
							"@FIN_DAYS_INVENTORY", [BSC Target Days Inventory (days)],
							"@FIN_REVENUE_PER_BED", [BSC Target Revenue per Bed],
							"@FIN_EBITDA_PER_BED", [BSC Target EBITDA per Bed],
							"@FIN_REVENUE_PER_DOCTOR", [BSC Target Revenue per Doctor],
							"@FIN_EBITDA_PER_DOCTOR", [BSC Target EBITDA per Doctor],
							"@CUS_MULTI_SPECIALTY_SHARE", [BSC Target Multi-Specialty Share],
							"@CUS_PAYER_MIX", [BSC Target Payer Mix],
							"@CUS_NON_MOH_SHARE", [BSC Target Non-MoH Share],
							"@CUS_PAYER_VOLUME", [BSC Target Payer Volume],
							"@INT_OP_UTILIZATION", [BSC Target Clinic Utilization],
							"@INT_OP_TO_IP", [BSC Target OP to IP],
							"@INT_PATIENT_VOLUME", [BSC Target Patient Volume],
							"@INT_ER_GROWTH", [BSC Target ER Growth],
							"@INT_OP_REVENUE_PER_EPISODE", [BSC Target OP Revenue per Episode],
							"@INT_ANCILLARY_UTILIZATION", [BSC Target Ancillary Utilization],
							"@INT_GA_RATIO", [BSC Target G&A Ratio],
							"@LRN_REVENUE_PER_FTE", [BSC Target Revenue per FTE]
						),
						Past,
						REMOVEFILTERS ( 'BSC KPI' ),
						KEEPFILTERS ( Branch[Is Hospital] = "Yes" )
					)
				VAR FixedTarget = CALCULATE ( [BSC Fixed Target], Past, KEEPFILTERS ( Branch[Is Hospital] = "Yes" ) )
				VAR T =
					SWITCH (
						TRUE (),
						Skipped, BLANK (),
						TargetSource = "fixed", FixedTarget,
						TargetSource = "prior_year", APY,
						TargetSource = "budget",
							SWITCH (
								Code,
								"FIN_NET_REVENUE", MAXX ( Budgeted, [@FIN_NET_REVENUE] ),
								"FIN_EBITDA_MARGIN", MAXX ( Budgeted, [@FIN_EBITDA_MARGIN] ),
								"FIN_COST_TO_REVENUE", MAXX ( Budgeted, [@FIN_COST_TO_REVENUE] ),
								"FIN_CONSUMABLES_RATIO", MAXX ( Budgeted, [@FIN_CONSUMABLES_RATIO] ),
								"FIN_DAYS_INVENTORY", MAXX ( Budgeted, [@FIN_DAYS_INVENTORY] ),
								"FIN_REVENUE_PER_BED", MAXX ( Budgeted, [@FIN_REVENUE_PER_BED] ),
								"FIN_EBITDA_PER_BED", MAXX ( Budgeted, [@FIN_EBITDA_PER_BED] ),
								"FIN_REVENUE_PER_DOCTOR", MAXX ( Budgeted, [@FIN_REVENUE_PER_DOCTOR] ),
								"FIN_EBITDA_PER_DOCTOR", MAXX ( Budgeted, [@FIN_EBITDA_PER_DOCTOR] ),
								"CUS_MULTI_SPECIALTY_SHARE", MAXX ( Budgeted, [@CUS_MULTI_SPECIALTY_SHARE] ),
								"CUS_PAYER_MIX", MAXX ( Budgeted, [@CUS_PAYER_MIX] ),
								"CUS_NON_MOH_SHARE", MAXX ( Budgeted, [@CUS_NON_MOH_SHARE] ),
								"CUS_PAYER_VOLUME", MAXX ( Budgeted, [@CUS_PAYER_VOLUME] ),
								"INT_OP_UTILIZATION", MAXX ( Budgeted, [@INT_OP_UTILIZATION] ),
								"INT_OP_TO_IP", MAXX ( Budgeted, [@INT_OP_TO_IP] ),
								"INT_PATIENT_VOLUME", MAXX ( Budgeted, [@INT_PATIENT_VOLUME] ),
								"INT_ER_GROWTH", MAXX ( Budgeted, [@INT_ER_GROWTH] ),
								"INT_OP_REVENUE_PER_EPISODE", MAXX ( Budgeted, [@INT_OP_REVENUE_PER_EPISODE] ),
								"INT_ANCILLARY_UTILIZATION", MAXX ( Budgeted, [@INT_ANCILLARY_UTILIZATION] ),
								"INT_GA_RATIO", MAXX ( Budgeted, [@INT_GA_RATIO] ),
								"LRN_REVENUE_PER_FTE", MAXX ( Budgeted, [@LRN_REVENUE_PER_FTE] ),
								BLANK ()
							),
						BLANK ()
					)
				VAR Dir = SELECTEDVALUE ( 'BSC KPI'[Direction] )
				VAR Diff = SWITCH ( Dir, "higher", A - T, "on_target", - ABS ( A - T ), T - A )
				VAR V = IF ( ISBLANK ( A ) || ISBLANK ( T ) || ISTEXT ( A ) || ISTEXT ( T ), BLANK (), IF ( T = 0, Diff, DIVIDE ( Diff, ABS ( T ) ) ) )
				VAR ScoreBase = SELECTEDVALUE ( 'BSC KPI'[Score Base] )
				VAR ScoreSlope = SELECTEDVALUE ( 'BSC KPI'[Score Slope] )
				VAR S = IF ( NOT ISBLANK ( V ), MIN ( 100, MAX ( 0, ROUND ( ScoreBase + ScoreSlope * 100 * V, 0 ) ) ) )
				RETURN S
			) -- end of measure body
			VAR __Wrong = [_Guard 19 facts #e451b8cd]
			RETURN IF ( __Wrong = "", __Value, """BSC Score"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Balanced Scorecard\Scoring

		annotation hnh_guard_allow = BSC KPI
	/// On track, Watch or At risk from the KPI score and its thresholds.
	measure 'BSC Status' =
			VAR __Value = ( -- measure body
				VAR S = [BSC Score]
				VAR GoodFrom = SELECTEDVALUE ( 'BSC KPI'[Good From] )
				VAR WatchFrom = SELECTEDVALUE ( 'BSC KPI'[Watch From] )
				RETURN IF ( NOT ISBLANK ( S ), IF ( S >= GoodFrom, "On track", IF ( S >= WatchFrom, "Watch", "At risk" ) ) )
			) -- end of measure body
			VAR __Wrong = [_Guard 19 facts #e451b8cd]
			RETURN IF ( __Wrong = "", __Value, """BSC Status"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Balanced Scorecard\Scoring

		annotation hnh_guard_allow = BSC KPI
	/// Parked (parked KPI, or no value for any hospital in any period), No data yet (no value in this selection), No target, or the status.
	measure 'BSC State' =
			VAR __Value = ( -- measure body
				-- BSC Actual and BSC Target inlined: one table of the KPI measures for every period this measure needs
				VAR Code = SELECTEDVALUE ( 'BSC KPI'[KPI Code] )
				VAR KpiState = SELECTEDVALUE ( 'BSC KPI'[Status] )
				VAR ValueSource = SELECTEDVALUE ( 'BSC KPI'[Value Source] )
				VAR TargetSource = SELECTEDVALUE ( 'BSC KPI'[Target Source] )
				VAR Skipped = ISBLANK ( Code ) || KpiState = "parked"
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				VAR PastPY = CALCULATETABLE ( VALUES ( 'Date'[Date] ), SAMEPERIODLASTYEAR ( Past ) )
				VAR PastAll = CALCULATETABLE ( VALUES ( 'Date'[Date] ), REMOVEFILTERS ( 'Date' ), 'Date'[Date] <= TODAY () )
				VAR Periods = UNION ( ROW ( "@Period", 0 ), ROW ( "@Period", 1 ), ROW ( "@Period", 2 ) )
				VAR PeriodDates =
					UNION (
						SELECTCOLUMNS ( Past, "@Period", 0, "@Date", 'Date'[Date] ),
						SELECTCOLUMNS ( PastPY, "@Period", 1, "@Date", 'Date'[Date] ),
						SELECTCOLUMNS ( PastAll, "@Period", 2, "@Date", 'Date'[Date] )
					)
				VAR PeriodBranches =
					UNION (
						CROSSJOIN ( FILTER ( Periods, [@Period] <> 2 ), SELECTCOLUMNS ( VALUES ( Branch[Branch Key] ), "@Branch", Branch[Branch Key] ) ),
						CROSSJOIN ( ROW ( "@Period", 2 ), SELECTCOLUMNS ( ALL ( Branch[Branch Key] ), "@Branch", Branch[Branch Key] ) )
					)
				VAR Measured =
					GENERATE (
						Periods,
						VAR P = [@Period]
						RETURN
							CALCULATETABLE (
								ROW (
									"@FIN_NET_REVENUE", [BSC Net Revenue],
									"@FIN_REVENUE_GROWTH", [BSC Net Revenue],
									"@FIN_EBITDA_MARGIN", [BSC EBITDA Margin],
									"@FIN_COST_TO_REVENUE", [BSC Cost to Revenue],
									"@FIN_CONSUMABLES_RATIO", [BSC Consumables Ratio],
									"@FIN_DAYS_IN_AR", [BSC Days in AR (days)],
									"@FIN_DAYS_INVENTORY", [BSC Days Inventory (days)],
									"@FIN_REVENUE_PER_BED", [BSC Revenue per Bed],
									"@FIN_RETURN_ON_ASSETS", [BSC Return on Assets],
									"@FIN_EBITDA_PER_BED", [BSC EBITDA per Bed],
									"@FIN_REVENUE_PER_DOCTOR", [BSC Revenue per Doctor],
									"@FIN_EBITDA_PER_DOCTOR", [BSC EBITDA per Doctor],
									"@CUS_MULTI_SPECIALTY_SHARE", [BSC Multi-Specialty Revenue Share],
									"@CUS_PAYER_MIX", [BSC Payer Mix],
									"@CUS_PATIENT_SATISFACTION", [BSC Patient Satisfaction],
									"@CUS_PATIENT_RETENTION", [BSC Patient Retention],
									"@CUS_NEW_PATIENTS", [BSC New Patient Acquisition],
									"@CUS_OP_WAIT", [BSC OP Waiting Time (min)],
									"@CUS_NON_MOH_SHARE", [BSC Non-MoH Revenue Share],
									"@CUS_PAYER_VOLUME", [BSC Payer Volume],
									"@CUS_ACQUISITION_COST", [BSC Patient Acquisition Cost],
									"@INT_BED_OCCUPANCY", [BSC Bed Occupancy],
									"@INT_OP_UTILIZATION", [BSC Clinic Utilization],
									"@INT_ALOS", [BSC ALOS (days)],
									"@INT_OP_TO_IP", [BSC OP to IP Conversion],
									"@INT_PATIENT_VOLUME", [BSC Patient Volume],
									"@INT_ER_GROWTH", [BSC ER Growth],
									"@INT_DOCTOR_UTILIZATION", [BSC OP Doctor Utilization],
									"@INT_ACTIVATED_BEDS", [BSC Activated Beds],
									"@INT_HIGH_VALUE_REVENUE", [BSC High-Value Revenue Share],
									"@INT_HIGH_VALUE_CENSUS", [BSC High-Value Census],
									"@INT_OP_REVENUE_PER_EPISODE", [BSC OP Revenue per Episode],
									"@INT_ANCILLARY_UTILIZATION", [BSC Ancillary Utilization],
									"@INT_REVENUE_LEAKAGE", [BSC Revenue Leakage],
									"@INT_CLAIM_INITIAL_REJECTION", [BSC Claim Initial Rejection],
									"@INT_ORDER_NOT_DONE", [BSC Order Not Done],
									"@INT_APPROVAL_TAT", [BSC Approval TAT (min)],
									"@INT_COST_BUDGET_VARIANCE", [BSC Cost Budget Variance],
									"@INT_GA_RATIO", [BSC G&A Ratio],
									"@INT_READMISSION_30D", [BSC Readmission 30d],
									"@INT_READMISSION_48H_CRITICAL", [BSC Readmission 48h Critical],
									"@INT_EXTERNAL_REFERRALS", [BSC External Referrals],
									"@LRN_TURNOVER", [BSC Turnover],
									"@LRN_REVENUE_PER_FTE", [BSC Revenue per FTE],
									"@LRN_STAFF_TO_BED", [BSC Staff to Bed],
									"@LRN_SAUDIZATION", [BSC Saudization],
									"@LRN_VACANCY_RATE", [BSC Vacancy Rate],
									"@LRN_TIME_TO_FILL", [BSC Time to Fill (days)],
									"@LRN_CLINICAL_TO_DOCTOR", [BSC Clinical to Doctor]
								),
								REMOVEFILTERS ( 'Date' ),
								TREATAS ( SELECTCOLUMNS ( FILTER ( PeriodDates, [@Period] = P ), "@Date", [@Date] ), 'Date'[Date] ),
								REMOVEFILTERS ( Branch ),
								TREATAS ( SELECTCOLUMNS ( FILTER ( PeriodBranches, [@Period] = P ), "@Branch", [@Branch] ), Branch[Branch Key] ),
								REMOVEFILTERS ( 'BSC KPI' ),
								KEEPFILTERS ( Branch[Is Hospital] = "Yes" )
							)
					)
				VAR Actuals =
					ADDCOLUMNS (
						Periods,
						"@Actual",
							VAR P = [@Period]
							VAR PeriodMeasures = FILTER ( Measured, [@Period] = P )
							RETURN
								SWITCH (
									TRUE (),
									Skipped, BLANK (),
									ValueSource = "manual", CALCULATE (
										[BSC Manual Value],
										REMOVEFILTERS ( 'Date' ),
										TREATAS ( SELECTCOLUMNS ( FILTER ( PeriodDates, [@Period] = P ), "@Date", [@Date] ), 'Date'[Date] ),
										REMOVEFILTERS ( Branch ),
										TREATAS ( SELECTCOLUMNS ( FILTER ( PeriodBranches, [@Period] = P ), "@Branch", [@Branch] ), Branch[Branch Key] ),
										KEEPFILTERS ( Branch[Is Hospital] = "Yes" )
									),
									SWITCH (
										Code,
										"FIN_NET_REVENUE", MAXX ( PeriodMeasures, [@FIN_NET_REVENUE] ),
										"FIN_REVENUE_GROWTH", MAXX ( PeriodMeasures, [@FIN_REVENUE_GROWTH] ),
										"FIN_EBITDA_MARGIN", MAXX ( PeriodMeasures, [@FIN_EBITDA_MARGIN] ),
										"FIN_COST_TO_REVENUE", MAXX ( PeriodMeasures, [@FIN_COST_TO_REVENUE] ),
										"FIN_CONSUMABLES_RATIO", MAXX ( PeriodMeasures, [@FIN_CONSUMABLES_RATIO] ),
										"FIN_DAYS_IN_AR", MAXX ( PeriodMeasures, [@FIN_DAYS_IN_AR] ),
										"FIN_DAYS_INVENTORY", MAXX ( PeriodMeasures, [@FIN_DAYS_INVENTORY] ),
										"FIN_REVENUE_PER_BED", MAXX ( PeriodMeasures, [@FIN_REVENUE_PER_BED] ),
										"FIN_RETURN_ON_ASSETS", MAXX ( PeriodMeasures, [@FIN_RETURN_ON_ASSETS] ),
										"FIN_EBITDA_PER_BED", MAXX ( PeriodMeasures, [@FIN_EBITDA_PER_BED] ),
										"FIN_REVENUE_PER_DOCTOR", MAXX ( PeriodMeasures, [@FIN_REVENUE_PER_DOCTOR] ),
										"FIN_EBITDA_PER_DOCTOR", MAXX ( PeriodMeasures, [@FIN_EBITDA_PER_DOCTOR] ),
										"CUS_MULTI_SPECIALTY_SHARE", MAXX ( PeriodMeasures, [@CUS_MULTI_SPECIALTY_SHARE] ),
										"CUS_PAYER_MIX", MAXX ( PeriodMeasures, [@CUS_PAYER_MIX] ),
										"CUS_PATIENT_SATISFACTION", MAXX ( PeriodMeasures, [@CUS_PATIENT_SATISFACTION] ),
										"CUS_PATIENT_RETENTION", MAXX ( PeriodMeasures, [@CUS_PATIENT_RETENTION] ),
										"CUS_NEW_PATIENTS", MAXX ( PeriodMeasures, [@CUS_NEW_PATIENTS] ),
										"CUS_OP_WAIT", MAXX ( PeriodMeasures, [@CUS_OP_WAIT] ),
										"CUS_NON_MOH_SHARE", MAXX ( PeriodMeasures, [@CUS_NON_MOH_SHARE] ),
										"CUS_PAYER_VOLUME", MAXX ( PeriodMeasures, [@CUS_PAYER_VOLUME] ),
										"CUS_ACQUISITION_COST", MAXX ( PeriodMeasures, [@CUS_ACQUISITION_COST] ),
										"INT_BED_OCCUPANCY", MAXX ( PeriodMeasures, [@INT_BED_OCCUPANCY] ),
										"INT_OP_UTILIZATION", MAXX ( PeriodMeasures, [@INT_OP_UTILIZATION] ),
										"INT_ALOS", MAXX ( PeriodMeasures, [@INT_ALOS] ),
										"INT_OP_TO_IP", MAXX ( PeriodMeasures, [@INT_OP_TO_IP] ),
										"INT_PATIENT_VOLUME", MAXX ( PeriodMeasures, [@INT_PATIENT_VOLUME] ),
										"INT_ER_GROWTH", MAXX ( PeriodMeasures, [@INT_ER_GROWTH] ),
										"INT_DOCTOR_UTILIZATION", MAXX ( PeriodMeasures, [@INT_DOCTOR_UTILIZATION] ),
										"INT_ACTIVATED_BEDS", MAXX ( PeriodMeasures, [@INT_ACTIVATED_BEDS] ),
										"INT_HIGH_VALUE_REVENUE", MAXX ( PeriodMeasures, [@INT_HIGH_VALUE_REVENUE] ),
										"INT_HIGH_VALUE_CENSUS", MAXX ( PeriodMeasures, [@INT_HIGH_VALUE_CENSUS] ),
										"INT_OP_REVENUE_PER_EPISODE", MAXX ( PeriodMeasures, [@INT_OP_REVENUE_PER_EPISODE] ),
										"INT_ANCILLARY_UTILIZATION", MAXX ( PeriodMeasures, [@INT_ANCILLARY_UTILIZATION] ),
										"INT_REVENUE_LEAKAGE", MAXX ( PeriodMeasures, [@INT_REVENUE_LEAKAGE] ),
										"INT_CLAIM_INITIAL_REJECTION", MAXX ( PeriodMeasures, [@INT_CLAIM_INITIAL_REJECTION] ),
										"INT_ORDER_NOT_DONE", MAXX ( PeriodMeasures, [@INT_ORDER_NOT_DONE] ),
										"INT_APPROVAL_TAT", MAXX ( PeriodMeasures, [@INT_APPROVAL_TAT] ),
										"INT_COST_BUDGET_VARIANCE", MAXX ( PeriodMeasures, [@INT_COST_BUDGET_VARIANCE] ),
										"INT_GA_RATIO", MAXX ( PeriodMeasures, [@INT_GA_RATIO] ),
										"INT_READMISSION_30D", MAXX ( PeriodMeasures, [@INT_READMISSION_30D] ),
										"INT_READMISSION_48H_CRITICAL", MAXX ( PeriodMeasures, [@INT_READMISSION_48H_CRITICAL] ),
										"INT_EXTERNAL_REFERRALS", MAXX ( PeriodMeasures, [@INT_EXTERNAL_REFERRALS] ),
										"LRN_TURNOVER", MAXX ( PeriodMeasures, [@LRN_TURNOVER] ),
										"LRN_REVENUE_PER_FTE", MAXX ( PeriodMeasures, [@LRN_REVENUE_PER_FTE] ),
										"LRN_STAFF_TO_BED", MAXX ( PeriodMeasures, [@LRN_STAFF_TO_BED] ),
										"LRN_SAUDIZATION", MAXX ( PeriodMeasures, [@LRN_SAUDIZATION] ),
										"LRN_VACANCY_RATE", MAXX ( PeriodMeasures, [@LRN_VACANCY_RATE] ),
										"LRN_TIME_TO_FILL", MAXX ( PeriodMeasures, [@LRN_TIME_TO_FILL] ),
										"LRN_CLINICAL_TO_DOCTOR", MAXX ( PeriodMeasures, [@LRN_CLINICAL_TO_DOCTOR] ),
										BLANK ()
									)
								)
					)
				VAR A = MAXX ( FILTER ( Actuals, [@Period] = 0 ), [@Actual] )
				VAR APY = MAXX ( FILTER ( Actuals, [@Period] = 1 ), [@Actual] )
				VAR AllTime = MAXX ( FILTER ( Actuals, [@Period] = 2 ), [@Actual] )
				VAR Budgeted =
					CALCULATETABLE (
						ROW (
							"@FIN_NET_REVENUE", [BSC Target Net Revenue],
							"@FIN_EBITDA_MARGIN", [BSC Target EBITDA Margin],
							"@FIN_COST_TO_REVENUE", [BSC Target Cost to Revenue],
							"@FIN_CONSUMABLES_RATIO", [BSC Target Consumables Ratio],
							"@FIN_DAYS_INVENTORY", [BSC Target Days Inventory (days)],
							"@FIN_REVENUE_PER_BED", [BSC Target Revenue per Bed],
							"@FIN_EBITDA_PER_BED", [BSC Target EBITDA per Bed],
							"@FIN_REVENUE_PER_DOCTOR", [BSC Target Revenue per Doctor],
							"@FIN_EBITDA_PER_DOCTOR", [BSC Target EBITDA per Doctor],
							"@CUS_MULTI_SPECIALTY_SHARE", [BSC Target Multi-Specialty Share],
							"@CUS_PAYER_MIX", [BSC Target Payer Mix],
							"@CUS_NON_MOH_SHARE", [BSC Target Non-MoH Share],
							"@CUS_PAYER_VOLUME", [BSC Target Payer Volume],
							"@INT_OP_UTILIZATION", [BSC Target Clinic Utilization],
							"@INT_OP_TO_IP", [BSC Target OP to IP],
							"@INT_PATIENT_VOLUME", [BSC Target Patient Volume],
							"@INT_ER_GROWTH", [BSC Target ER Growth],
							"@INT_OP_REVENUE_PER_EPISODE", [BSC Target OP Revenue per Episode],
							"@INT_ANCILLARY_UTILIZATION", [BSC Target Ancillary Utilization],
							"@INT_GA_RATIO", [BSC Target G&A Ratio],
							"@LRN_REVENUE_PER_FTE", [BSC Target Revenue per FTE]
						),
						Past,
						REMOVEFILTERS ( 'BSC KPI' ),
						KEEPFILTERS ( Branch[Is Hospital] = "Yes" )
					)
				VAR FixedTarget = CALCULATE ( [BSC Fixed Target], Past, KEEPFILTERS ( Branch[Is Hospital] = "Yes" ) )
				VAR T =
					SWITCH (
						TRUE (),
						Skipped, BLANK (),
						TargetSource = "fixed", FixedTarget,
						TargetSource = "prior_year", APY,
						TargetSource = "budget",
							SWITCH (
								Code,
								"FIN_NET_REVENUE", MAXX ( Budgeted, [@FIN_NET_REVENUE] ),
								"FIN_EBITDA_MARGIN", MAXX ( Budgeted, [@FIN_EBITDA_MARGIN] ),
								"FIN_COST_TO_REVENUE", MAXX ( Budgeted, [@FIN_COST_TO_REVENUE] ),
								"FIN_CONSUMABLES_RATIO", MAXX ( Budgeted, [@FIN_CONSUMABLES_RATIO] ),
								"FIN_DAYS_INVENTORY", MAXX ( Budgeted, [@FIN_DAYS_INVENTORY] ),
								"FIN_REVENUE_PER_BED", MAXX ( Budgeted, [@FIN_REVENUE_PER_BED] ),
								"FIN_EBITDA_PER_BED", MAXX ( Budgeted, [@FIN_EBITDA_PER_BED] ),
								"FIN_REVENUE_PER_DOCTOR", MAXX ( Budgeted, [@FIN_REVENUE_PER_DOCTOR] ),
								"FIN_EBITDA_PER_DOCTOR", MAXX ( Budgeted, [@FIN_EBITDA_PER_DOCTOR] ),
								"CUS_MULTI_SPECIALTY_SHARE", MAXX ( Budgeted, [@CUS_MULTI_SPECIALTY_SHARE] ),
								"CUS_PAYER_MIX", MAXX ( Budgeted, [@CUS_PAYER_MIX] ),
								"CUS_NON_MOH_SHARE", MAXX ( Budgeted, [@CUS_NON_MOH_SHARE] ),
								"CUS_PAYER_VOLUME", MAXX ( Budgeted, [@CUS_PAYER_VOLUME] ),
								"INT_OP_UTILIZATION", MAXX ( Budgeted, [@INT_OP_UTILIZATION] ),
								"INT_OP_TO_IP", MAXX ( Budgeted, [@INT_OP_TO_IP] ),
								"INT_PATIENT_VOLUME", MAXX ( Budgeted, [@INT_PATIENT_VOLUME] ),
								"INT_ER_GROWTH", MAXX ( Budgeted, [@INT_ER_GROWTH] ),
								"INT_OP_REVENUE_PER_EPISODE", MAXX ( Budgeted, [@INT_OP_REVENUE_PER_EPISODE] ),
								"INT_ANCILLARY_UTILIZATION", MAXX ( Budgeted, [@INT_ANCILLARY_UTILIZATION] ),
								"INT_GA_RATIO", MAXX ( Budgeted, [@INT_GA_RATIO] ),
								"LRN_REVENUE_PER_FTE", MAXX ( Budgeted, [@LRN_REVENUE_PER_FTE] ),
								BLANK ()
							),
						BLANK ()
					)
				VAR Dir = SELECTEDVALUE ( 'BSC KPI'[Direction] )
				VAR Diff = SWITCH ( Dir, "higher", A - T, "on_target", - ABS ( A - T ), T - A )
				VAR V = IF ( ISBLANK ( A ) || ISBLANK ( T ) || ISTEXT ( A ) || ISTEXT ( T ), BLANK (), IF ( T = 0, Diff, DIVIDE ( Diff, ABS ( T ) ) ) )
				VAR ScoreBase = SELECTEDVALUE ( 'BSC KPI'[Score Base] )
				VAR ScoreSlope = SELECTEDVALUE ( 'BSC KPI'[Score Slope] )
				VAR S = IF ( NOT ISBLANK ( V ), MIN ( 100, MAX ( 0, ROUND ( ScoreBase + ScoreSlope * 100 * V, 0 ) ) ) )
				VAR GoodFrom = SELECTEDVALUE ( 'BSC KPI'[Good From] )
				VAR WatchFrom = SELECTEDVALUE ( 'BSC KPI'[Watch From] )
				VAR Rating = IF ( NOT ISBLANK ( S ), IF ( S >= GoodFrom, "On track", IF ( S >= WatchFrom, "Watch", "At risk" ) ) )
				RETURN
					SWITCH (
						TRUE (),
						KpiState = "parked", "Parked",
						ISBLANK ( A ) && ISBLANK ( AllTime ), "Parked",
						ISBLANK ( A ), "No data yet",
						ISBLANK ( Rating ), "No target",
						Rating
					)
			) -- end of measure body
			VAR __Wrong = [_Guard 19 facts #e451b8cd]
			RETURN IF ( __Wrong = "", __Value, """BSC State"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Balanced Scorecard\Scoring

		annotation hnh_guard_allow = BSC KPI
	/// Weight of the KPI inside its pillar: the hospital's profile for one hospital, the corporate weight for several.
	measure 'BSC KPI Weight' =
			VAR __Value = ( -- measure body
				IF ( HASONEVALUE ( Branch[Branch Key] ), SUM ( 'BSC Weights'[Weight] ), SUM ( 'BSC KPI'[Corporate Weight] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard BSC Weights | BSC KPI]
			RETURN IF ( __Wrong = "", __Value, """BSC KPI Weight"" can't be analysed by " & __Wrong )
		formatString: 0.000
		displayFolder: Balanced Scorecard\Scoring

		annotation hnh_guard_allow = BSC KPI
	/// Weighted mean of the KPI scores of the pillar in context (KPIs with a score and a weight).
	measure 'BSC Pillar Score' =
			VAR __Value = ( -- measure body
				VAR Kpis = ADDCOLUMNS ( VALUES ( 'BSC KPI'[KPI Code] ), "@score", [BSC Score], "@weight", [BSC KPI Weight] )
				VAR Scored = FILTER ( Kpis, NOT ISBLANK ( [@score] ) && [@weight] > 0 )
				RETURN DIVIDE ( SUMX ( Scored, [@score] * [@weight] ), SUMX ( Scored, [@weight] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard 20 facts #b6b7dad9]
			RETURN IF ( __Wrong = "", __Value, """BSC Pillar Score"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Balanced Scorecard\Scoring

		annotation hnh_guard_allow = BSC KPI
	/// Pillar scores weighted by the pillar weights (pillars with a score).
	measure 'BSC Overall Score' =
			VAR __Value = ( -- measure body
				VAR Pillars = ADDCOLUMNS ( VALUES ( 'BSC KPI'[Pillar] ), "@score", [BSC Pillar Score], "@weight", CALCULATE ( MAX ( 'BSC KPI'[Pillar Weight] ) ) )
				VAR Scored = FILTER ( Pillars, NOT ISBLANK ( [@score] ) )
				RETURN DIVIDE ( SUMX ( Scored, [@score] * [@weight] ), SUMX ( Scored, [@weight] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard 20 facts #b6b7dad9]
			RETURN IF ( __Wrong = "", __Value, """BSC Overall Score"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Balanced Scorecard\Scoring

		annotation hnh_guard_allow = BSC KPI
	/// The KPI actual of the 12 months ending at the last month in context, oldest first, separated by semicolons (sparkline data).
	measure 'BSC Trend' =
			VAR __Value = ( -- measure body
				VAR EndMonth = CALCULATE ( MAX ( 'Date'[Year Month] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				VAR Months = TOPN ( 12, FILTER ( ALL ( 'Date'[Year Month] ), 'Date'[Year Month] <= EndMonth ), 'Date'[Year Month], DESC )
				RETURN
					CONCATENATEX (
						Months,
						VAR MonthKey = 'Date'[Year Month]
						VAR MonthValue = CALCULATE ( [BSC Actual], REMOVEFILTERS ( 'Date' ), 'Date'[Year Month] = MonthKey )
						RETURN IF ( ISNUMBER ( MonthValue ), FORMAT ( MonthValue, "0.########" ), "" ),
						";",
						'Date'[Year Month], ASC
					)
			) -- end of measure body
			VAR __Wrong = [_Guard 17 facts #3ba24bc3]
			RETURN IF ( __Wrong = "", __Value, """BSC Trend"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Balanced Scorecard\Scoring

		annotation hnh_guard_allow = BSC KPI
	/// Everything the scorecard visual shows for the KPI in context, from one evaluation: actual | target | variance | score | state | KPI weight | actual trend | target trend | score trend. Numbers in en-US without grouping, blank as an empty field; each trend is the 12 months ending at the last month in context, oldest first, separated by semicolons. Same values as BSC Actual, BSC Target, BSC Variance %, BSC Score, BSC State, BSC KPI Weight and BSC Trend; the guard text when a guard trips.
	measure 'BSC Visual Payload' =
			VAR __Value = ( -- measure body
				VAR Code = SELECTEDVALUE ( 'BSC KPI'[KPI Code] )
				VAR KpiState = SELECTEDVALUE ( 'BSC KPI'[Status] )
				VAR ValueSource = SELECTEDVALUE ( 'BSC KPI'[Value Source] )
				VAR TargetSource = SELECTEDVALUE ( 'BSC KPI'[Target Source] )
				VAR Skipped = ISBLANK ( Code ) || KpiState = "parked"
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				VAR Dir = SELECTEDVALUE ( 'BSC KPI'[Direction] )
				VAR ScoreBase = SELECTEDVALUE ( 'BSC KPI'[Score Base] )
				VAR ScoreSlope = SELECTEDVALUE ( 'BSC KPI'[Score Slope] )
				VAR GoodFrom = SELECTEDVALUE ( 'BSC KPI'[Good From] )
				VAR WatchFrom = SELECTEDVALUE ( 'BSC KPI'[Watch From] )
				VAR PastPY = CALCULATETABLE ( VALUES ( 'Date'[Date] ), SAMEPERIODLASTYEAR ( Past ) )
				VAR PastAll = CALCULATETABLE ( VALUES ( 'Date'[Date] ), REMOVEFILTERS ( 'Date' ), 'Date'[Date] <= TODAY () )
				VAR EndMonth = CALCULATE ( MAX ( 'Date'[Year Month] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				VAR Months = TOPN ( 12, FILTER ( ALL ( 'Date'[Year Month] ), 'Date'[Year Month] <= EndMonth ), 'Date'[Year Month], DESC )
				-- periods: 0 the selection, 1 its prior year, 2 all time and all hospitals, a Year Month key that month, the key - 100 its prior year
				VAR Periods =
					UNION (
						ROW ( "@Period", 0 ),
						ROW ( "@Period", 1 ),
						ROW ( "@Period", 2 ),
						SELECTCOLUMNS ( Months, "@Period", 'Date'[Year Month] ),
						SELECTCOLUMNS ( Months, "@Period", 'Date'[Year Month] - 100 )
					)
				VAR MonthDates =
					GENERATE (
						SELECTCOLUMNS ( Months, "@Month", 'Date'[Year Month] ),
						VAR M = [@Month]
						VAR MonthPast = CALCULATETABLE ( VALUES ( 'Date'[Date] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year Month] = M, 'Date'[Date] <= TODAY () )
						RETURN
							UNION (
								SELECTCOLUMNS ( MonthPast, "@Period", M, "@Date", 'Date'[Date] ),
								SELECTCOLUMNS ( CALCULATETABLE ( VALUES ( 'Date'[Date] ), SAMEPERIODLASTYEAR ( MonthPast ) ), "@Period", M - 100, "@Date", 'Date'[Date] )
							)
					)
				VAR PeriodDates =
					UNION (
						SELECTCOLUMNS ( Past, "@Period", 0, "@Date", 'Date'[Date] ),
						SELECTCOLUMNS ( PastPY, "@Period", 1, "@Date", 'Date'[Date] ),
						SELECTCOLUMNS ( PastAll, "@Period", 2, "@Date", 'Date'[Date] ),
						SELECTCOLUMNS ( MonthDates, "@Period", [@Period], "@Date", [@Date] )
					)
				VAR PeriodBranches =
					UNION (
						CROSSJOIN ( FILTER ( Periods, [@Period] <> 2 ), SELECTCOLUMNS ( VALUES ( Branch[Branch Key] ), "@Branch", Branch[Branch Key] ) ),
						CROSSJOIN ( ROW ( "@Period", 2 ), SELECTCOLUMNS ( ALL ( Branch[Branch Key] ), "@Branch", Branch[Branch Key] ) )
					)
				-- the KPI measures' bodies (their guards are covered by this measure's): the selection (0), its prior year (1) and all time (2), one evaluation per period
				VAR MeasuredPeriods =
					GENERATE (
						FILTER ( Periods, [@Period] IN { 0, 1, 2 } ),
						VAR P = [@Period]
						RETURN
							CALCULATETABLE (
								ROW (
									"@FIN_NET_REVENUE", [_Unguarded BSC Net Revenue],
									"@FIN_REVENUE_GROWTH", [_Unguarded BSC Net Revenue],
									"@FIN_EBITDA_MARGIN", [_Unguarded BSC EBITDA Margin],
									"@FIN_COST_TO_REVENUE", [_Unguarded BSC Cost to Revenue],
									"@FIN_CONSUMABLES_RATIO", [_Unguarded BSC Consumables Ratio],
									"@FIN_DAYS_IN_AR", [_Unguarded BSC Days in AR (days)],
									"@FIN_DAYS_INVENTORY", [_Unguarded BSC Days Inventory (days)],
									"@FIN_REVENUE_PER_BED", [_Unguarded BSC Revenue per Bed],
									"@FIN_RETURN_ON_ASSETS", [_Unguarded BSC Return on Assets],
									"@FIN_EBITDA_PER_BED", [_Unguarded BSC EBITDA per Bed],
									"@FIN_REVENUE_PER_DOCTOR", [_Unguarded BSC Revenue per Doctor],
									"@FIN_EBITDA_PER_DOCTOR", [_Unguarded BSC EBITDA per Doctor],
									"@CUS_MULTI_SPECIALTY_SHARE", [_Unguarded BSC Multi-Specialty Revenue Share],
									"@CUS_PAYER_MIX", [_Unguarded BSC Payer Mix],
									"@CUS_PATIENT_SATISFACTION", [_Unguarded BSC Patient Satisfaction],
									"@CUS_PATIENT_RETENTION", [_Unguarded BSC Patient Retention],
									"@CUS_NEW_PATIENTS", [_Unguarded BSC New Patient Acquisition],
									"@CUS_OP_WAIT", [_Unguarded BSC OP Waiting Time (min)],
									"@CUS_NON_MOH_SHARE", [_Unguarded BSC Non-MoH Revenue Share],
									"@CUS_PAYER_VOLUME", [_Unguarded BSC Payer Volume],
									"@CUS_ACQUISITION_COST", [_Unguarded BSC Patient Acquisition Cost],
									"@INT_BED_OCCUPANCY", [_Unguarded BSC Bed Occupancy],
									"@INT_OP_UTILIZATION", [_Unguarded BSC Clinic Utilization],
									"@INT_ALOS", [_Unguarded BSC ALOS (days)],
									"@INT_OP_TO_IP", [_Unguarded BSC OP to IP Conversion],
									"@INT_PATIENT_VOLUME", [_Unguarded BSC Patient Volume],
									"@INT_ER_GROWTH", [_Unguarded BSC ER Growth],
									"@INT_DOCTOR_UTILIZATION", [_Unguarded BSC OP Doctor Utilization],
									"@INT_ACTIVATED_BEDS", [_Unguarded BSC Activated Beds],
									"@INT_HIGH_VALUE_REVENUE", [_Unguarded BSC High-Value Revenue Share],
									"@INT_HIGH_VALUE_CENSUS", [_Unguarded BSC High-Value Census],
									"@INT_OP_REVENUE_PER_EPISODE", [_Unguarded BSC OP Revenue per Episode],
									"@INT_ANCILLARY_UTILIZATION", [_Unguarded BSC Ancillary Utilization],
									"@INT_REVENUE_LEAKAGE", [_Unguarded BSC Revenue Leakage],
									"@INT_CLAIM_INITIAL_REJECTION", [_Unguarded BSC Claim Initial Rejection],
									"@INT_ORDER_NOT_DONE", [_Unguarded BSC Order Not Done],
									"@INT_APPROVAL_TAT", [_Unguarded BSC Approval TAT (min)],
									"@INT_COST_BUDGET_VARIANCE", [_Unguarded BSC Cost Budget Variance],
									"@INT_GA_RATIO", [_Unguarded BSC G&A Ratio],
									"@INT_READMISSION_30D", [_Unguarded BSC Readmission 30d],
									"@INT_READMISSION_48H_CRITICAL", [_Unguarded BSC Readmission 48h Critical],
									"@INT_EXTERNAL_REFERRALS", [_Unguarded BSC External Referrals],
									"@LRN_TURNOVER", [_Unguarded BSC Turnover],
									"@LRN_REVENUE_PER_FTE", [_Unguarded BSC Revenue per FTE],
									"@LRN_STAFF_TO_BED", [_Unguarded BSC Staff to Bed],
									"@LRN_SAUDIZATION", [_Unguarded BSC Saudization],
									"@LRN_VACANCY_RATE", [_Unguarded BSC Vacancy Rate],
									"@LRN_TIME_TO_FILL", [_Unguarded BSC Time to Fill (days)],
									"@LRN_CLINICAL_TO_DOCTOR", [_Unguarded BSC Clinical to Doctor]
								),
								REMOVEFILTERS ( 'Date' ),
								TREATAS ( SELECTCOLUMNS ( FILTER ( PeriodDates, [@Period] = P ), "@Date", [@Date] ), 'Date'[Date] ),
								REMOVEFILTERS ( Branch ),
								TREATAS ( SELECTCOLUMNS ( FILTER ( PeriodBranches, [@Period] = P ), "@Branch", [@Branch] ), Branch[Branch Key] ),
								REMOVEFILTERS ( 'BSC KPI' ),
								KEEPFILTERS ( Branch[Is Hospital] = "Yes" )
							)
					)
				-- the 12 trend months and their prior-year months: 24 different months, each period's dates inside its own month, so one
				-- evaluation grouped by Year Month gives every month its own value (one storage engine query per measure, not 24)
				VAR MeasuredMonths =
					CALCULATETABLE (
						ADDCOLUMNS (
							VALUES ( 'Date'[Year Month] ),
							"@FIN_NET_REVENUE", [_Unguarded BSC Net Revenue],
							"@FIN_REVENUE_GROWTH", [_Unguarded BSC Net Revenue],
							"@FIN_EBITDA_MARGIN", [_Unguarded BSC EBITDA Margin],
							"@FIN_COST_TO_REVENUE", [_Unguarded BSC Cost to Revenue],
							"@FIN_CONSUMABLES_RATIO", [_Unguarded BSC Consumables Ratio],
							"@FIN_DAYS_IN_AR", [_Unguarded BSC Days in AR (days)],
							"@FIN_DAYS_INVENTORY", [_Unguarded BSC Days Inventory (days)],
							"@FIN_REVENUE_PER_BED", [_Unguarded BSC Revenue per Bed],
							"@FIN_RETURN_ON_ASSETS", [_Unguarded BSC Return on Assets],
							"@FIN_EBITDA_PER_BED", [_Unguarded BSC EBITDA per Bed],
							"@FIN_REVENUE_PER_DOCTOR", [_Unguarded BSC Revenue per Doctor],
							"@FIN_EBITDA_PER_DOCTOR", [_Unguarded BSC EBITDA per Doctor],
							"@CUS_MULTI_SPECIALTY_SHARE", [_Unguarded BSC Multi-Specialty Revenue Share],
							"@CUS_PAYER_MIX", [_Unguarded BSC Payer Mix],
							"@CUS_PATIENT_SATISFACTION", [_Unguarded BSC Patient Satisfaction],
							"@CUS_PATIENT_RETENTION", [_Unguarded BSC Patient Retention],
							"@CUS_NEW_PATIENTS", [_Unguarded BSC New Patient Acquisition],
							"@CUS_OP_WAIT", [_Unguarded BSC OP Waiting Time (min)],
							"@CUS_NON_MOH_SHARE", [_Unguarded BSC Non-MoH Revenue Share],
							"@CUS_PAYER_VOLUME", [_Unguarded BSC Payer Volume],
							"@CUS_ACQUISITION_COST", [_Unguarded BSC Patient Acquisition Cost],
							"@INT_BED_OCCUPANCY", [_Unguarded BSC Bed Occupancy],
							"@INT_OP_UTILIZATION", [_Unguarded BSC Clinic Utilization],
							"@INT_ALOS", [_Unguarded BSC ALOS (days)],
							"@INT_OP_TO_IP", [_Unguarded BSC OP to IP Conversion],
							"@INT_PATIENT_VOLUME", [_Unguarded BSC Patient Volume],
							"@INT_ER_GROWTH", [_Unguarded BSC ER Growth],
							"@INT_DOCTOR_UTILIZATION", [_Unguarded BSC OP Doctor Utilization],
							"@INT_ACTIVATED_BEDS", [_Unguarded BSC Activated Beds],
							"@INT_HIGH_VALUE_REVENUE", [_Unguarded BSC High-Value Revenue Share],
							"@INT_HIGH_VALUE_CENSUS", [_Unguarded BSC High-Value Census],
							"@INT_OP_REVENUE_PER_EPISODE", [_Unguarded BSC OP Revenue per Episode],
							"@INT_ANCILLARY_UTILIZATION", [_Unguarded BSC Ancillary Utilization],
							"@INT_REVENUE_LEAKAGE", [_Unguarded BSC Revenue Leakage],
							"@INT_CLAIM_INITIAL_REJECTION", [_Unguarded BSC Claim Initial Rejection],
							"@INT_ORDER_NOT_DONE", [_Unguarded BSC Order Not Done],
							"@INT_APPROVAL_TAT", [_Unguarded BSC Approval TAT (min)],
							"@INT_COST_BUDGET_VARIANCE", [_Unguarded BSC Cost Budget Variance],
							"@INT_GA_RATIO", [_Unguarded BSC G&A Ratio],
							"@INT_READMISSION_30D", [_Unguarded BSC Readmission 30d],
							"@INT_READMISSION_48H_CRITICAL", [_Unguarded BSC Readmission 48h Critical],
							"@INT_EXTERNAL_REFERRALS", [_Unguarded BSC External Referrals],
							"@LRN_TURNOVER", [_Unguarded BSC Turnover],
							"@LRN_REVENUE_PER_FTE", [_Unguarded BSC Revenue per FTE],
							"@LRN_STAFF_TO_BED", [_Unguarded BSC Staff to Bed],
							"@LRN_SAUDIZATION", [_Unguarded BSC Saudization],
							"@LRN_VACANCY_RATE", [_Unguarded BSC Vacancy Rate],
							"@LRN_TIME_TO_FILL", [_Unguarded BSC Time to Fill (days)],
							"@LRN_CLINICAL_TO_DOCTOR", [_Unguarded BSC Clinical to Doctor]
						),
						REMOVEFILTERS ( 'Date' ),
						TREATAS ( SELECTCOLUMNS ( FILTER ( PeriodDates, NOT ( [@Period] IN { 0, 1, 2 } ) ), "@Date", [@Date] ), 'Date'[Date] ),
						REMOVEFILTERS ( Branch ),
						TREATAS ( SELECTCOLUMNS ( FILTER ( PeriodBranches, NOT ( [@Period] IN { 0, 1, 2 } ) ), "@Branch", [@Branch] ), Branch[Branch Key] ),
						REMOVEFILTERS ( 'BSC KPI' ),
						KEEPFILTERS ( Branch[Is Hospital] = "Yes" )
					)
				VAR Measured = UNION ( MeasuredPeriods, MeasuredMonths )
				VAR Actuals =
					ADDCOLUMNS (
						Periods,
						"@Actual",
							VAR P = [@Period]
							VAR PeriodMeasures = FILTER ( Measured, [@Period] = P )
							RETURN
								SWITCH (
									TRUE (),
									Skipped, BLANK (),
									ValueSource = "manual", CALCULATE (
										[_Unguarded BSC Manual Value],
										REMOVEFILTERS ( 'Date' ),
										TREATAS ( SELECTCOLUMNS ( FILTER ( PeriodDates, [@Period] = P ), "@Date", [@Date] ), 'Date'[Date] ),
										REMOVEFILTERS ( Branch ),
										TREATAS ( SELECTCOLUMNS ( FILTER ( PeriodBranches, [@Period] = P ), "@Branch", [@Branch] ), Branch[Branch Key] ),
										KEEPFILTERS ( Branch[Is Hospital] = "Yes" )
									),
									SWITCH (
										Code,
										"FIN_NET_REVENUE", MAXX ( PeriodMeasures, [@FIN_NET_REVENUE] ),
										"FIN_REVENUE_GROWTH", MAXX ( PeriodMeasures, [@FIN_REVENUE_GROWTH] ),
										"FIN_EBITDA_MARGIN", MAXX ( PeriodMeasures, [@FIN_EBITDA_MARGIN] ),
										"FIN_COST_TO_REVENUE", MAXX ( PeriodMeasures, [@FIN_COST_TO_REVENUE] ),
										"FIN_CONSUMABLES_RATIO", MAXX ( PeriodMeasures, [@FIN_CONSUMABLES_RATIO] ),
										"FIN_DAYS_IN_AR", MAXX ( PeriodMeasures, [@FIN_DAYS_IN_AR] ),
										"FIN_DAYS_INVENTORY", MAXX ( PeriodMeasures, [@FIN_DAYS_INVENTORY] ),
										"FIN_REVENUE_PER_BED", MAXX ( PeriodMeasures, [@FIN_REVENUE_PER_BED] ),
										"FIN_RETURN_ON_ASSETS", MAXX ( PeriodMeasures, [@FIN_RETURN_ON_ASSETS] ),
										"FIN_EBITDA_PER_BED", MAXX ( PeriodMeasures, [@FIN_EBITDA_PER_BED] ),
										"FIN_REVENUE_PER_DOCTOR", MAXX ( PeriodMeasures, [@FIN_REVENUE_PER_DOCTOR] ),
										"FIN_EBITDA_PER_DOCTOR", MAXX ( PeriodMeasures, [@FIN_EBITDA_PER_DOCTOR] ),
										"CUS_MULTI_SPECIALTY_SHARE", MAXX ( PeriodMeasures, [@CUS_MULTI_SPECIALTY_SHARE] ),
										"CUS_PAYER_MIX", MAXX ( PeriodMeasures, [@CUS_PAYER_MIX] ),
										"CUS_PATIENT_SATISFACTION", MAXX ( PeriodMeasures, [@CUS_PATIENT_SATISFACTION] ),
										"CUS_PATIENT_RETENTION", MAXX ( PeriodMeasures, [@CUS_PATIENT_RETENTION] ),
										"CUS_NEW_PATIENTS", MAXX ( PeriodMeasures, [@CUS_NEW_PATIENTS] ),
										"CUS_OP_WAIT", MAXX ( PeriodMeasures, [@CUS_OP_WAIT] ),
										"CUS_NON_MOH_SHARE", MAXX ( PeriodMeasures, [@CUS_NON_MOH_SHARE] ),
										"CUS_PAYER_VOLUME", MAXX ( PeriodMeasures, [@CUS_PAYER_VOLUME] ),
										"CUS_ACQUISITION_COST", MAXX ( PeriodMeasures, [@CUS_ACQUISITION_COST] ),
										"INT_BED_OCCUPANCY", MAXX ( PeriodMeasures, [@INT_BED_OCCUPANCY] ),
										"INT_OP_UTILIZATION", MAXX ( PeriodMeasures, [@INT_OP_UTILIZATION] ),
										"INT_ALOS", MAXX ( PeriodMeasures, [@INT_ALOS] ),
										"INT_OP_TO_IP", MAXX ( PeriodMeasures, [@INT_OP_TO_IP] ),
										"INT_PATIENT_VOLUME", MAXX ( PeriodMeasures, [@INT_PATIENT_VOLUME] ),
										"INT_ER_GROWTH", MAXX ( PeriodMeasures, [@INT_ER_GROWTH] ),
										"INT_DOCTOR_UTILIZATION", MAXX ( PeriodMeasures, [@INT_DOCTOR_UTILIZATION] ),
										"INT_ACTIVATED_BEDS", MAXX ( PeriodMeasures, [@INT_ACTIVATED_BEDS] ),
										"INT_HIGH_VALUE_REVENUE", MAXX ( PeriodMeasures, [@INT_HIGH_VALUE_REVENUE] ),
										"INT_HIGH_VALUE_CENSUS", MAXX ( PeriodMeasures, [@INT_HIGH_VALUE_CENSUS] ),
										"INT_OP_REVENUE_PER_EPISODE", MAXX ( PeriodMeasures, [@INT_OP_REVENUE_PER_EPISODE] ),
										"INT_ANCILLARY_UTILIZATION", MAXX ( PeriodMeasures, [@INT_ANCILLARY_UTILIZATION] ),
										"INT_REVENUE_LEAKAGE", MAXX ( PeriodMeasures, [@INT_REVENUE_LEAKAGE] ),
										"INT_CLAIM_INITIAL_REJECTION", MAXX ( PeriodMeasures, [@INT_CLAIM_INITIAL_REJECTION] ),
										"INT_ORDER_NOT_DONE", MAXX ( PeriodMeasures, [@INT_ORDER_NOT_DONE] ),
										"INT_APPROVAL_TAT", MAXX ( PeriodMeasures, [@INT_APPROVAL_TAT] ),
										"INT_COST_BUDGET_VARIANCE", MAXX ( PeriodMeasures, [@INT_COST_BUDGET_VARIANCE] ),
										"INT_GA_RATIO", MAXX ( PeriodMeasures, [@INT_GA_RATIO] ),
										"INT_READMISSION_30D", MAXX ( PeriodMeasures, [@INT_READMISSION_30D] ),
										"INT_READMISSION_48H_CRITICAL", MAXX ( PeriodMeasures, [@INT_READMISSION_48H_CRITICAL] ),
										"INT_EXTERNAL_REFERRALS", MAXX ( PeriodMeasures, [@INT_EXTERNAL_REFERRALS] ),
										"LRN_TURNOVER", MAXX ( PeriodMeasures, [@LRN_TURNOVER] ),
										"LRN_REVENUE_PER_FTE", MAXX ( PeriodMeasures, [@LRN_REVENUE_PER_FTE] ),
										"LRN_STAFF_TO_BED", MAXX ( PeriodMeasures, [@LRN_STAFF_TO_BED] ),
										"LRN_SAUDIZATION", MAXX ( PeriodMeasures, [@LRN_SAUDIZATION] ),
										"LRN_VACANCY_RATE", MAXX ( PeriodMeasures, [@LRN_VACANCY_RATE] ),
										"LRN_TIME_TO_FILL", MAXX ( PeriodMeasures, [@LRN_TIME_TO_FILL] ),
										"LRN_CLINICAL_TO_DOCTOR", MAXX ( PeriodMeasures, [@LRN_CLINICAL_TO_DOCTOR] ),
										BLANK ()
									)
								)
					)
				VAR TargetPeriods = UNION ( ROW ( "@Period", 0 ), SELECTCOLUMNS ( Months, "@Period", 'Date'[Year Month] ) )
				VAR Budgeted =
					GENERATE (
						TargetPeriods,
						VAR P = [@Period]
						RETURN
							CALCULATETABLE (
								ROW (
									"@FIN_NET_REVENUE", [_Unguarded BSC Target Net Revenue],
									"@FIN_EBITDA_MARGIN", [_Unguarded BSC Target EBITDA Margin],
									"@FIN_COST_TO_REVENUE", [_Unguarded BSC Target Cost to Revenue],
									"@FIN_CONSUMABLES_RATIO", [_Unguarded BSC Target Consumables Ratio],
									"@FIN_DAYS_INVENTORY", [_Unguarded BSC Target Days Inventory (days)],
									"@FIN_REVENUE_PER_BED", [_Unguarded BSC Target Revenue per Bed],
									"@FIN_EBITDA_PER_BED", [_Unguarded BSC Target EBITDA per Bed],
									"@FIN_REVENUE_PER_DOCTOR", [_Unguarded BSC Target Revenue per Doctor],
									"@FIN_EBITDA_PER_DOCTOR", [_Unguarded BSC Target EBITDA per Doctor],
									"@CUS_MULTI_SPECIALTY_SHARE", [_Unguarded BSC Target Multi-Specialty Share],
									"@CUS_PAYER_MIX", [_Unguarded BSC Target Payer Mix],
									"@CUS_NON_MOH_SHARE", [_Unguarded BSC Target Non-MoH Share],
									"@CUS_PAYER_VOLUME", [_Unguarded BSC Target Payer Volume],
									"@INT_OP_UTILIZATION", [_Unguarded BSC Target Clinic Utilization],
									"@INT_OP_TO_IP", [_Unguarded BSC Target OP to IP],
									"@INT_PATIENT_VOLUME", [_Unguarded BSC Target Patient Volume],
									"@INT_ER_GROWTH", [_Unguarded BSC Target ER Growth],
									"@INT_OP_REVENUE_PER_EPISODE", [_Unguarded BSC Target OP Revenue per Episode],
									"@INT_ANCILLARY_UTILIZATION", [_Unguarded BSC Target Ancillary Utilization],
									"@INT_GA_RATIO", [_Unguarded BSC Target G&A Ratio],
									"@LRN_REVENUE_PER_FTE", [_Unguarded BSC Target Revenue per FTE]
								),
								REMOVEFILTERS ( 'Date' ),
								TREATAS ( SELECTCOLUMNS ( FILTER ( PeriodDates, [@Period] = P ), "@Date", [@Date] ), 'Date'[Date] ),
								REMOVEFILTERS ( 'BSC KPI' ),
								KEEPFILTERS ( Branch[Is Hospital] = "Yes" )
							)
					)
				VAR Targets =
					ADDCOLUMNS (
						TargetPeriods,
						"@Target",
							VAR P = [@Period]
							VAR PeriodBudgets = FILTER ( Budgeted, [@Period] = P )
							RETURN
								SWITCH (
									TRUE (),
									Skipped, BLANK (),
									TargetSource = "fixed", CALCULATE ( [_Unguarded BSC Fixed Target], REMOVEFILTERS ( 'Date' ), TREATAS ( SELECTCOLUMNS ( FILTER ( PeriodDates, [@Period] = P ), "@Date", [@Date] ), 'Date'[Date] ), KEEPFILTERS ( Branch[Is Hospital] = "Yes" ) ),
									TargetSource = "prior_year", MAXX ( FILTER ( Actuals, [@Period] = IF ( P = 0, 1, P - 100 ) ), [@Actual] ),
									TargetSource = "budget",
										SWITCH (
											Code,
											"FIN_NET_REVENUE", MAXX ( PeriodBudgets, [@FIN_NET_REVENUE] ),
											"FIN_EBITDA_MARGIN", MAXX ( PeriodBudgets, [@FIN_EBITDA_MARGIN] ),
											"FIN_COST_TO_REVENUE", MAXX ( PeriodBudgets, [@FIN_COST_TO_REVENUE] ),
											"FIN_CONSUMABLES_RATIO", MAXX ( PeriodBudgets, [@FIN_CONSUMABLES_RATIO] ),
											"FIN_DAYS_INVENTORY", MAXX ( PeriodBudgets, [@FIN_DAYS_INVENTORY] ),
											"FIN_REVENUE_PER_BED", MAXX ( PeriodBudgets, [@FIN_REVENUE_PER_BED] ),
											"FIN_EBITDA_PER_BED", MAXX ( PeriodBudgets, [@FIN_EBITDA_PER_BED] ),
											"FIN_REVENUE_PER_DOCTOR", MAXX ( PeriodBudgets, [@FIN_REVENUE_PER_DOCTOR] ),
											"FIN_EBITDA_PER_DOCTOR", MAXX ( PeriodBudgets, [@FIN_EBITDA_PER_DOCTOR] ),
											"CUS_MULTI_SPECIALTY_SHARE", MAXX ( PeriodBudgets, [@CUS_MULTI_SPECIALTY_SHARE] ),
											"CUS_PAYER_MIX", MAXX ( PeriodBudgets, [@CUS_PAYER_MIX] ),
											"CUS_NON_MOH_SHARE", MAXX ( PeriodBudgets, [@CUS_NON_MOH_SHARE] ),
											"CUS_PAYER_VOLUME", MAXX ( PeriodBudgets, [@CUS_PAYER_VOLUME] ),
											"INT_OP_UTILIZATION", MAXX ( PeriodBudgets, [@INT_OP_UTILIZATION] ),
											"INT_OP_TO_IP", MAXX ( PeriodBudgets, [@INT_OP_TO_IP] ),
											"INT_PATIENT_VOLUME", MAXX ( PeriodBudgets, [@INT_PATIENT_VOLUME] ),
											"INT_ER_GROWTH", MAXX ( PeriodBudgets, [@INT_ER_GROWTH] ),
											"INT_OP_REVENUE_PER_EPISODE", MAXX ( PeriodBudgets, [@INT_OP_REVENUE_PER_EPISODE] ),
											"INT_ANCILLARY_UTILIZATION", MAXX ( PeriodBudgets, [@INT_ANCILLARY_UTILIZATION] ),
											"INT_GA_RATIO", MAXX ( PeriodBudgets, [@INT_GA_RATIO] ),
											"LRN_REVENUE_PER_FTE", MAXX ( PeriodBudgets, [@LRN_REVENUE_PER_FTE] ),
											BLANK ()
										),
									BLANK ()
								)
					)
				VAR Scored =
					ADDCOLUMNS (
						ADDCOLUMNS (
							Targets,
							"@Actual", VAR P = [@Period] RETURN MAXX ( FILTER ( Actuals, [@Period] = P ), [@Actual] )
						),
						"@Variance",
							VAR A = [@Actual]
							VAR T = [@Target]
							VAR Diff = SWITCH ( Dir, "higher", A - T, "on_target", - ABS ( A - T ), T - A )
							RETURN IF ( ISBLANK ( A ) || ISBLANK ( T ) || ISTEXT ( A ) || ISTEXT ( T ), BLANK (), IF ( T = 0, Diff, DIVIDE ( Diff, ABS ( T ) ) ) )
					)
				VAR Scores =
					ADDCOLUMNS (
						Scored,
						"@Score", VAR V = [@Variance] RETURN IF ( NOT ISBLANK ( V ), MIN ( 100, MAX ( 0, ROUND ( ScoreBase + ScoreSlope * 100 * V, 0 ) ) ) )
					)
				VAR A = MAXX ( FILTER ( Scores, [@Period] = 0 ), [@Actual] )
				VAR T = MAXX ( FILTER ( Scores, [@Period] = 0 ), [@Target] )
				VAR V = MAXX ( FILTER ( Scores, [@Period] = 0 ), [@Variance] )
				VAR S = MAXX ( FILTER ( Scores, [@Period] = 0 ), [@Score] )
				VAR AllTime = MAXX ( FILTER ( Actuals, [@Period] = 2 ), [@Actual] )
				VAR Rating = IF ( NOT ISBLANK ( S ), IF ( S >= GoodFrom, "On track", IF ( S >= WatchFrom, "Watch", "At risk" ) ) )
				VAR StateWord =
					SWITCH (
						TRUE (),
						KpiState = "parked", "Parked",
						ISBLANK ( A ) && ISBLANK ( AllTime ), "Parked",
						ISBLANK ( A ), "No data yet",
						ISBLANK ( Rating ), "No target",
						Rating
					)
				VAR WeightValue = [_Unguarded BSC KPI Weight]
				VAR MonthScores = FILTER ( Scores, [@Period] <> 0 )
				RETURN
					IF ( ISNUMBER ( A ), FORMAT ( A, "0.############", "en-US" ) ) & "|" & IF ( ISNUMBER ( T ), FORMAT ( T, "0.############", "en-US" ) ) & "|" & IF ( ISNUMBER ( V ), FORMAT ( V, "0.############", "en-US" ) ) & "|" & IF ( ISNUMBER ( S ), FORMAT ( S, "0.############", "en-US" ) )
						& "|" & StateWord & "|" & IF ( ISNUMBER ( WeightValue ), FORMAT ( WeightValue, "0.############", "en-US" ) )
						& "|" & CONCATENATEX ( MonthScores, IF ( ISNUMBER ( [@Actual] ), FORMAT ( [@Actual], "0.############", "en-US" ) ), ";", [@Period], ASC )
						& "|" & CONCATENATEX ( MonthScores, IF ( ISNUMBER ( [@Target] ), FORMAT ( [@Target], "0.############", "en-US" ) ), ";", [@Period], ASC )
						& "|" & CONCATENATEX ( MonthScores, IF ( ISNUMBER ( [@Score] ), FORMAT ( [@Score], "0.############", "en-US" ) ), ";", [@Period], ASC )
			) -- end of measure body
			VAR __Wrong = [_Guard 20 facts #b6b7dad9]
			RETURN IF ( __Wrong = "", __Value, """BSC Visual Payload"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Balanced Scorecard\Visual

		annotation hnh_guard_allow = BSC KPI
	/// The first six fields of BSC Visual Payload (actual | target | variance | score | state | KPI weight) with empty trend fields, for the hospital comparison: no monthly periods, so KPI x hospital stays fast. Same values as BSC Actual, BSC Target, BSC Variance %, BSC Score, BSC State and BSC KPI Weight; the guard text when a guard trips.
	measure 'BSC Visual Payload Scores' =
			VAR __Value = ( -- measure body
				-- BSC State's evaluation (current period, prior year, all time; no monthly trend), returned in the BSC Visual Payload format
				VAR Code = SELECTEDVALUE ( 'BSC KPI'[KPI Code] )
				VAR KpiState = SELECTEDVALUE ( 'BSC KPI'[Status] )
				VAR ValueSource = SELECTEDVALUE ( 'BSC KPI'[Value Source] )
				VAR TargetSource = SELECTEDVALUE ( 'BSC KPI'[Target Source] )
				VAR Skipped = ISBLANK ( Code ) || KpiState = "parked"
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				VAR PastPY = CALCULATETABLE ( VALUES ( 'Date'[Date] ), SAMEPERIODLASTYEAR ( Past ) )
				VAR PastAll = CALCULATETABLE ( VALUES ( 'Date'[Date] ), REMOVEFILTERS ( 'Date' ), 'Date'[Date] <= TODAY () )
				VAR Periods = UNION ( ROW ( "@Period", 0 ), ROW ( "@Period", 1 ), ROW ( "@Period", 2 ) )
				VAR PeriodDates =
					UNION (
						SELECTCOLUMNS ( Past, "@Period", 0, "@Date", 'Date'[Date] ),
						SELECTCOLUMNS ( PastPY, "@Period", 1, "@Date", 'Date'[Date] ),
						SELECTCOLUMNS ( PastAll, "@Period", 2, "@Date", 'Date'[Date] )
					)
				VAR PeriodBranches =
					UNION (
						CROSSJOIN ( FILTER ( Periods, [@Period] <> 2 ), SELECTCOLUMNS ( VALUES ( Branch[Branch Key] ), "@Branch", Branch[Branch Key] ) ),
						CROSSJOIN ( ROW ( "@Period", 2 ), SELECTCOLUMNS ( ALL ( Branch[Branch Key] ), "@Branch", Branch[Branch Key] ) )
					)
				VAR Measured =
					GENERATE (
						Periods,
						VAR P = [@Period]
						RETURN
							CALCULATETABLE (
								ROW (
									"@FIN_NET_REVENUE", [BSC Net Revenue],
									"@FIN_REVENUE_GROWTH", [BSC Net Revenue],
									"@FIN_EBITDA_MARGIN", [BSC EBITDA Margin],
									"@FIN_COST_TO_REVENUE", [BSC Cost to Revenue],
									"@FIN_CONSUMABLES_RATIO", [BSC Consumables Ratio],
									"@FIN_DAYS_IN_AR", [BSC Days in AR (days)],
									"@FIN_DAYS_INVENTORY", [BSC Days Inventory (days)],
									"@FIN_REVENUE_PER_BED", [BSC Revenue per Bed],
									"@FIN_RETURN_ON_ASSETS", [BSC Return on Assets],
									"@FIN_EBITDA_PER_BED", [BSC EBITDA per Bed],
									"@FIN_REVENUE_PER_DOCTOR", [BSC Revenue per Doctor],
									"@FIN_EBITDA_PER_DOCTOR", [BSC EBITDA per Doctor],
									"@CUS_MULTI_SPECIALTY_SHARE", [BSC Multi-Specialty Revenue Share],
									"@CUS_PAYER_MIX", [BSC Payer Mix],
									"@CUS_PATIENT_SATISFACTION", [BSC Patient Satisfaction],
									"@CUS_PATIENT_RETENTION", [BSC Patient Retention],
									"@CUS_NEW_PATIENTS", [BSC New Patient Acquisition],
									"@CUS_OP_WAIT", [BSC OP Waiting Time (min)],
									"@CUS_NON_MOH_SHARE", [BSC Non-MoH Revenue Share],
									"@CUS_PAYER_VOLUME", [BSC Payer Volume],
									"@CUS_ACQUISITION_COST", [BSC Patient Acquisition Cost],
									"@INT_BED_OCCUPANCY", [BSC Bed Occupancy],
									"@INT_OP_UTILIZATION", [BSC Clinic Utilization],
									"@INT_ALOS", [BSC ALOS (days)],
									"@INT_OP_TO_IP", [BSC OP to IP Conversion],
									"@INT_PATIENT_VOLUME", [BSC Patient Volume],
									"@INT_ER_GROWTH", [BSC ER Growth],
									"@INT_DOCTOR_UTILIZATION", [BSC OP Doctor Utilization],
									"@INT_ACTIVATED_BEDS", [BSC Activated Beds],
									"@INT_HIGH_VALUE_REVENUE", [BSC High-Value Revenue Share],
									"@INT_HIGH_VALUE_CENSUS", [BSC High-Value Census],
									"@INT_OP_REVENUE_PER_EPISODE", [BSC OP Revenue per Episode],
									"@INT_ANCILLARY_UTILIZATION", [BSC Ancillary Utilization],
									"@INT_REVENUE_LEAKAGE", [BSC Revenue Leakage],
									"@INT_CLAIM_INITIAL_REJECTION", [BSC Claim Initial Rejection],
									"@INT_ORDER_NOT_DONE", [BSC Order Not Done],
									"@INT_APPROVAL_TAT", [BSC Approval TAT (min)],
									"@INT_COST_BUDGET_VARIANCE", [BSC Cost Budget Variance],
									"@INT_GA_RATIO", [BSC G&A Ratio],
									"@INT_READMISSION_30D", [BSC Readmission 30d],
									"@INT_READMISSION_48H_CRITICAL", [BSC Readmission 48h Critical],
									"@INT_EXTERNAL_REFERRALS", [BSC External Referrals],
									"@LRN_TURNOVER", [BSC Turnover],
									"@LRN_REVENUE_PER_FTE", [BSC Revenue per FTE],
									"@LRN_STAFF_TO_BED", [BSC Staff to Bed],
									"@LRN_SAUDIZATION", [BSC Saudization],
									"@LRN_VACANCY_RATE", [BSC Vacancy Rate],
									"@LRN_TIME_TO_FILL", [BSC Time to Fill (days)],
									"@LRN_CLINICAL_TO_DOCTOR", [BSC Clinical to Doctor]
								),
								REMOVEFILTERS ( 'Date' ),
								TREATAS ( SELECTCOLUMNS ( FILTER ( PeriodDates, [@Period] = P ), "@Date", [@Date] ), 'Date'[Date] ),
								REMOVEFILTERS ( Branch ),
								TREATAS ( SELECTCOLUMNS ( FILTER ( PeriodBranches, [@Period] = P ), "@Branch", [@Branch] ), Branch[Branch Key] ),
								REMOVEFILTERS ( 'BSC KPI' ),
								KEEPFILTERS ( Branch[Is Hospital] = "Yes" )
							)
					)
				VAR Actuals =
					ADDCOLUMNS (
						Periods,
						"@Actual",
							VAR P = [@Period]
							VAR PeriodMeasures = FILTER ( Measured, [@Period] = P )
							RETURN
								SWITCH (
									TRUE (),
									Skipped, BLANK (),
									ValueSource = "manual", CALCULATE (
										[BSC Manual Value],
										REMOVEFILTERS ( 'Date' ),
										TREATAS ( SELECTCOLUMNS ( FILTER ( PeriodDates, [@Period] = P ), "@Date", [@Date] ), 'Date'[Date] ),
										REMOVEFILTERS ( Branch ),
										TREATAS ( SELECTCOLUMNS ( FILTER ( PeriodBranches, [@Period] = P ), "@Branch", [@Branch] ), Branch[Branch Key] ),
										KEEPFILTERS ( Branch[Is Hospital] = "Yes" )
									),
									SWITCH (
										Code,
										"FIN_NET_REVENUE", MAXX ( PeriodMeasures, [@FIN_NET_REVENUE] ),
										"FIN_REVENUE_GROWTH", MAXX ( PeriodMeasures, [@FIN_REVENUE_GROWTH] ),
										"FIN_EBITDA_MARGIN", MAXX ( PeriodMeasures, [@FIN_EBITDA_MARGIN] ),
										"FIN_COST_TO_REVENUE", MAXX ( PeriodMeasures, [@FIN_COST_TO_REVENUE] ),
										"FIN_CONSUMABLES_RATIO", MAXX ( PeriodMeasures, [@FIN_CONSUMABLES_RATIO] ),
										"FIN_DAYS_IN_AR", MAXX ( PeriodMeasures, [@FIN_DAYS_IN_AR] ),
										"FIN_DAYS_INVENTORY", MAXX ( PeriodMeasures, [@FIN_DAYS_INVENTORY] ),
										"FIN_REVENUE_PER_BED", MAXX ( PeriodMeasures, [@FIN_REVENUE_PER_BED] ),
										"FIN_RETURN_ON_ASSETS", MAXX ( PeriodMeasures, [@FIN_RETURN_ON_ASSETS] ),
										"FIN_EBITDA_PER_BED", MAXX ( PeriodMeasures, [@FIN_EBITDA_PER_BED] ),
										"FIN_REVENUE_PER_DOCTOR", MAXX ( PeriodMeasures, [@FIN_REVENUE_PER_DOCTOR] ),
										"FIN_EBITDA_PER_DOCTOR", MAXX ( PeriodMeasures, [@FIN_EBITDA_PER_DOCTOR] ),
										"CUS_MULTI_SPECIALTY_SHARE", MAXX ( PeriodMeasures, [@CUS_MULTI_SPECIALTY_SHARE] ),
										"CUS_PAYER_MIX", MAXX ( PeriodMeasures, [@CUS_PAYER_MIX] ),
										"CUS_PATIENT_SATISFACTION", MAXX ( PeriodMeasures, [@CUS_PATIENT_SATISFACTION] ),
										"CUS_PATIENT_RETENTION", MAXX ( PeriodMeasures, [@CUS_PATIENT_RETENTION] ),
										"CUS_NEW_PATIENTS", MAXX ( PeriodMeasures, [@CUS_NEW_PATIENTS] ),
										"CUS_OP_WAIT", MAXX ( PeriodMeasures, [@CUS_OP_WAIT] ),
										"CUS_NON_MOH_SHARE", MAXX ( PeriodMeasures, [@CUS_NON_MOH_SHARE] ),
										"CUS_PAYER_VOLUME", MAXX ( PeriodMeasures, [@CUS_PAYER_VOLUME] ),
										"CUS_ACQUISITION_COST", MAXX ( PeriodMeasures, [@CUS_ACQUISITION_COST] ),
										"INT_BED_OCCUPANCY", MAXX ( PeriodMeasures, [@INT_BED_OCCUPANCY] ),
										"INT_OP_UTILIZATION", MAXX ( PeriodMeasures, [@INT_OP_UTILIZATION] ),
										"INT_ALOS", MAXX ( PeriodMeasures, [@INT_ALOS] ),
										"INT_OP_TO_IP", MAXX ( PeriodMeasures, [@INT_OP_TO_IP] ),
										"INT_PATIENT_VOLUME", MAXX ( PeriodMeasures, [@INT_PATIENT_VOLUME] ),
										"INT_ER_GROWTH", MAXX ( PeriodMeasures, [@INT_ER_GROWTH] ),
										"INT_DOCTOR_UTILIZATION", MAXX ( PeriodMeasures, [@INT_DOCTOR_UTILIZATION] ),
										"INT_ACTIVATED_BEDS", MAXX ( PeriodMeasures, [@INT_ACTIVATED_BEDS] ),
										"INT_HIGH_VALUE_REVENUE", MAXX ( PeriodMeasures, [@INT_HIGH_VALUE_REVENUE] ),
										"INT_HIGH_VALUE_CENSUS", MAXX ( PeriodMeasures, [@INT_HIGH_VALUE_CENSUS] ),
										"INT_OP_REVENUE_PER_EPISODE", MAXX ( PeriodMeasures, [@INT_OP_REVENUE_PER_EPISODE] ),
										"INT_ANCILLARY_UTILIZATION", MAXX ( PeriodMeasures, [@INT_ANCILLARY_UTILIZATION] ),
										"INT_REVENUE_LEAKAGE", MAXX ( PeriodMeasures, [@INT_REVENUE_LEAKAGE] ),
										"INT_CLAIM_INITIAL_REJECTION", MAXX ( PeriodMeasures, [@INT_CLAIM_INITIAL_REJECTION] ),
										"INT_ORDER_NOT_DONE", MAXX ( PeriodMeasures, [@INT_ORDER_NOT_DONE] ),
										"INT_APPROVAL_TAT", MAXX ( PeriodMeasures, [@INT_APPROVAL_TAT] ),
										"INT_COST_BUDGET_VARIANCE", MAXX ( PeriodMeasures, [@INT_COST_BUDGET_VARIANCE] ),
										"INT_GA_RATIO", MAXX ( PeriodMeasures, [@INT_GA_RATIO] ),
										"INT_READMISSION_30D", MAXX ( PeriodMeasures, [@INT_READMISSION_30D] ),
										"INT_READMISSION_48H_CRITICAL", MAXX ( PeriodMeasures, [@INT_READMISSION_48H_CRITICAL] ),
										"INT_EXTERNAL_REFERRALS", MAXX ( PeriodMeasures, [@INT_EXTERNAL_REFERRALS] ),
										"LRN_TURNOVER", MAXX ( PeriodMeasures, [@LRN_TURNOVER] ),
										"LRN_REVENUE_PER_FTE", MAXX ( PeriodMeasures, [@LRN_REVENUE_PER_FTE] ),
										"LRN_STAFF_TO_BED", MAXX ( PeriodMeasures, [@LRN_STAFF_TO_BED] ),
										"LRN_SAUDIZATION", MAXX ( PeriodMeasures, [@LRN_SAUDIZATION] ),
										"LRN_VACANCY_RATE", MAXX ( PeriodMeasures, [@LRN_VACANCY_RATE] ),
										"LRN_TIME_TO_FILL", MAXX ( PeriodMeasures, [@LRN_TIME_TO_FILL] ),
										"LRN_CLINICAL_TO_DOCTOR", MAXX ( PeriodMeasures, [@LRN_CLINICAL_TO_DOCTOR] ),
										BLANK ()
									)
								)
					)
				VAR A = MAXX ( FILTER ( Actuals, [@Period] = 0 ), [@Actual] )
				VAR APY = MAXX ( FILTER ( Actuals, [@Period] = 1 ), [@Actual] )
				VAR AllTime = MAXX ( FILTER ( Actuals, [@Period] = 2 ), [@Actual] )
				VAR Budgeted =
					CALCULATETABLE (
						ROW (
							"@FIN_NET_REVENUE", [BSC Target Net Revenue],
							"@FIN_EBITDA_MARGIN", [BSC Target EBITDA Margin],
							"@FIN_COST_TO_REVENUE", [BSC Target Cost to Revenue],
							"@FIN_CONSUMABLES_RATIO", [BSC Target Consumables Ratio],
							"@FIN_DAYS_INVENTORY", [BSC Target Days Inventory (days)],
							"@FIN_REVENUE_PER_BED", [BSC Target Revenue per Bed],
							"@FIN_EBITDA_PER_BED", [BSC Target EBITDA per Bed],
							"@FIN_REVENUE_PER_DOCTOR", [BSC Target Revenue per Doctor],
							"@FIN_EBITDA_PER_DOCTOR", [BSC Target EBITDA per Doctor],
							"@CUS_MULTI_SPECIALTY_SHARE", [BSC Target Multi-Specialty Share],
							"@CUS_PAYER_MIX", [BSC Target Payer Mix],
							"@CUS_NON_MOH_SHARE", [BSC Target Non-MoH Share],
							"@CUS_PAYER_VOLUME", [BSC Target Payer Volume],
							"@INT_OP_UTILIZATION", [BSC Target Clinic Utilization],
							"@INT_OP_TO_IP", [BSC Target OP to IP],
							"@INT_PATIENT_VOLUME", [BSC Target Patient Volume],
							"@INT_ER_GROWTH", [BSC Target ER Growth],
							"@INT_OP_REVENUE_PER_EPISODE", [BSC Target OP Revenue per Episode],
							"@INT_ANCILLARY_UTILIZATION", [BSC Target Ancillary Utilization],
							"@INT_GA_RATIO", [BSC Target G&A Ratio],
							"@LRN_REVENUE_PER_FTE", [BSC Target Revenue per FTE]
						),
						Past,
						REMOVEFILTERS ( 'BSC KPI' ),
						KEEPFILTERS ( Branch[Is Hospital] = "Yes" )
					)
				VAR FixedTarget = CALCULATE ( [BSC Fixed Target], Past, KEEPFILTERS ( Branch[Is Hospital] = "Yes" ) )
				VAR T =
					SWITCH (
						TRUE (),
						Skipped, BLANK (),
						TargetSource = "fixed", FixedTarget,
						TargetSource = "prior_year", APY,
						TargetSource = "budget",
							SWITCH (
								Code,
								"FIN_NET_REVENUE", MAXX ( Budgeted, [@FIN_NET_REVENUE] ),
								"FIN_EBITDA_MARGIN", MAXX ( Budgeted, [@FIN_EBITDA_MARGIN] ),
								"FIN_COST_TO_REVENUE", MAXX ( Budgeted, [@FIN_COST_TO_REVENUE] ),
								"FIN_CONSUMABLES_RATIO", MAXX ( Budgeted, [@FIN_CONSUMABLES_RATIO] ),
								"FIN_DAYS_INVENTORY", MAXX ( Budgeted, [@FIN_DAYS_INVENTORY] ),
								"FIN_REVENUE_PER_BED", MAXX ( Budgeted, [@FIN_REVENUE_PER_BED] ),
								"FIN_EBITDA_PER_BED", MAXX ( Budgeted, [@FIN_EBITDA_PER_BED] ),
								"FIN_REVENUE_PER_DOCTOR", MAXX ( Budgeted, [@FIN_REVENUE_PER_DOCTOR] ),
								"FIN_EBITDA_PER_DOCTOR", MAXX ( Budgeted, [@FIN_EBITDA_PER_DOCTOR] ),
								"CUS_MULTI_SPECIALTY_SHARE", MAXX ( Budgeted, [@CUS_MULTI_SPECIALTY_SHARE] ),
								"CUS_PAYER_MIX", MAXX ( Budgeted, [@CUS_PAYER_MIX] ),
								"CUS_NON_MOH_SHARE", MAXX ( Budgeted, [@CUS_NON_MOH_SHARE] ),
								"CUS_PAYER_VOLUME", MAXX ( Budgeted, [@CUS_PAYER_VOLUME] ),
								"INT_OP_UTILIZATION", MAXX ( Budgeted, [@INT_OP_UTILIZATION] ),
								"INT_OP_TO_IP", MAXX ( Budgeted, [@INT_OP_TO_IP] ),
								"INT_PATIENT_VOLUME", MAXX ( Budgeted, [@INT_PATIENT_VOLUME] ),
								"INT_ER_GROWTH", MAXX ( Budgeted, [@INT_ER_GROWTH] ),
								"INT_OP_REVENUE_PER_EPISODE", MAXX ( Budgeted, [@INT_OP_REVENUE_PER_EPISODE] ),
								"INT_ANCILLARY_UTILIZATION", MAXX ( Budgeted, [@INT_ANCILLARY_UTILIZATION] ),
								"INT_GA_RATIO", MAXX ( Budgeted, [@INT_GA_RATIO] ),
								"LRN_REVENUE_PER_FTE", MAXX ( Budgeted, [@LRN_REVENUE_PER_FTE] ),
								BLANK ()
							),
						BLANK ()
					)
				VAR Dir = SELECTEDVALUE ( 'BSC KPI'[Direction] )
				VAR Diff = SWITCH ( Dir, "higher", A - T, "on_target", - ABS ( A - T ), T - A )
				VAR V = IF ( ISBLANK ( A ) || ISBLANK ( T ) || ISTEXT ( A ) || ISTEXT ( T ), BLANK (), IF ( T = 0, Diff, DIVIDE ( Diff, ABS ( T ) ) ) )
				VAR ScoreBase = SELECTEDVALUE ( 'BSC KPI'[Score Base] )
				VAR ScoreSlope = SELECTEDVALUE ( 'BSC KPI'[Score Slope] )
				VAR S = IF ( NOT ISBLANK ( V ), MIN ( 100, MAX ( 0, ROUND ( ScoreBase + ScoreSlope * 100 * V, 0 ) ) ) )
				VAR GoodFrom = SELECTEDVALUE ( 'BSC KPI'[Good From] )
				VAR WatchFrom = SELECTEDVALUE ( 'BSC KPI'[Watch From] )
				VAR Rating = IF ( NOT ISBLANK ( S ), IF ( S >= GoodFrom, "On track", IF ( S >= WatchFrom, "Watch", "At risk" ) ) )
				VAR StateWord =
					SWITCH (
						TRUE (),
						KpiState = "parked", "Parked",
						ISBLANK ( A ) && ISBLANK ( AllTime ), "Parked",
						ISBLANK ( A ), "No data yet",
						ISBLANK ( Rating ), "No target",
						Rating
					)
				VAR WeightValue = [BSC KPI Weight]
				-- fields 7 to 9 (the trends) stay empty
				RETURN
					IF ( ISNUMBER ( A ), FORMAT ( A, "0.############", "en-US" ) ) & "|" & IF ( ISNUMBER ( T ), FORMAT ( T, "0.############", "en-US" ) ) & "|" & IF ( ISNUMBER ( V ), FORMAT ( V, "0.############", "en-US" ) ) & "|" & IF ( ISNUMBER ( S ), FORMAT ( S, "0.############", "en-US" ) )
						& "|" & StateWord & "|" & IF ( ISNUMBER ( WeightValue ), FORMAT ( WeightValue, "0.############", "en-US" ) ) & "|||"
			) -- end of measure body
			VAR __Wrong = [_Guard 20 facts #b6b7dad9]
			RETURN IF ( __Wrong = "", __Value, """BSC Visual Payload Scores"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Balanced Scorecard\Visual

		annotation hnh_guard_allow = BSC KPI
	/// Hospitals and period of the selection: the hospital, Corporate or n hospitals, then the first and last month in context up to today.
	measure 'BSC Selection Label' =
			VAR Hospitals = CALCULATE ( COUNTROWS ( Branch ), KEEPFILTERS ( Branch[Is Hospital] = "Yes" ) )
			VAR AllHospitals = CALCULATE ( COUNTROWS ( Branch ), ALL ( Branch ), Branch[Is Hospital] = "Yes" )
			VAR HospitalText =
				SWITCH (
					TRUE (),
					Hospitals = 0, "No hospital",
					Hospitals = 1, CALCULATE ( SELECTEDVALUE ( Branch[Branch Name] ), KEEPFILTERS ( Branch[Is Hospital] = "Yes" ) ),
					Hospitals = AllHospitals, "Corporate",
					Hospitals & " hospitals"
				)
			VAR PeriodStart = CALCULATE ( MIN ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
			VAR PeriodEnd = CALCULATE ( MAX ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
			VAR FirstText = FORMAT ( PeriodStart, "MMM yyyy", "en-US" )
			VAR LastText = FORMAT ( PeriodEnd, "MMM yyyy", "en-US" )
			VAR PeriodText = IF ( ISBLANK ( PeriodStart ), "", IF ( FirstText = LastText, FirstText, FirstText & " – " & LastText ) )
			RETURN HospitalText & IF ( PeriodText = "", "", " · " & PeriodText )
		formatString: General
		displayFolder: Balanced Scorecard\Visual

		annotation hnh_guard_allow = BSC KPI

	/// Display name of the family detail page of the KPI in context, for the KPI detail page's family button: revenue, finance, volume, beds, revenue_cycle, workforce, experience map to the report's seven family pages. Blank when no single KPI is in context.
	measure 'BSC Detail Page' =
			SWITCH (
				SELECTEDVALUE ( 'BSC KPI'[Detail Page] ),
				"revenue", "Revenue detail",
				"finance", "Finance detail",
				"volume", "Patient volume detail",
				"beds", "Beds & clinical detail",
				"revenue_cycle", "Revenue cycle detail",
				"workforce", "Workforce detail",
				"experience", "Patient experience detail",
				BLANK ()
			)
		formatString: General
		displayFolder: Balanced Scorecard\Detail

	/// How the target of the KPI in context is set, in words: Fixed target (the target table), Budget, Same period last year; blank for a KPI without a target and when no single KPI is in context.
	measure 'BSC Target Basis' =
			SWITCH (
				SELECTEDVALUE ( 'BSC KPI'[Target Source] ),
				"fixed", "Fixed target",
				"budget", "Budget",
				"prior_year", "Same period last year",
				BLANK ()
			)
		formatString: General
		displayFolder: Balanced Scorecard\Detail

	/// The distinct notes entered with the manual values of the KPI in context, for the selected hospitals and the months up to today, sorted and joined with " · ". Blank for a measure KPI and when there is no note.
	measure 'BSC Manual Note' =
			VAR __Value = ( -- measure body
				VAR Source = SELECTEDVALUE ( 'BSC KPI'[Value Source] )
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				VAR Notes =
					CALCULATETABLE (
						VALUES ( 'BSC Manual Values'[Note] ),
						Past,
						KEEPFILTERS ( Branch[Is Hospital] = "Yes" ),
						'BSC Manual Values'[Note] <> ""
					)
				RETURN IF ( Source = "manual", CONCATENATEX ( Notes, 'BSC Manual Values'[Note], " · ", 'BSC Manual Values'[Note], ASC ) )
			) -- end of measure body
			VAR __Wrong = [_Guard BSC Manual Values | BSC KPI]
			RETURN IF ( __Wrong = "", __Value, """BSC Manual Note"" can't be analysed by " & __Wrong )
		formatString: General
		displayFolder: Balanced Scorecard\Detail

		annotation hnh_guard_allow = BSC KPI

