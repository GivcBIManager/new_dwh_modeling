			RETURN IF ( __Wrong = "", __Value, """FR Chart TB Last Year"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Report

		annotation hnh_snapshot = 1
		annotation hnh_guard_allow = Finance Column, GL FS Monthly, P&L Report
	/// Chart series: trial balance month-end closing (debit positive) against budget, as a ratio. The matrix row in context drives it; with no row selected it shows the default line (trade receivables, net).
	measure 'FR Chart TB vs Budget %' =
			VAR __Value = ( -- measure body
				CALCULATE (
					IF (
						ISFILTERED ( 'GL FS Monthly'[FS Type Name] ) || ISFILTERED ( 'GL FS Monthly'[FS Element Name] ) || ISFILTERED ( 'GL FS Monthly'[FS Category Name] ) || ISFILTERED ( 'GL FS Monthly'[FS Caption Name] ) || ISFILTERED ( 'GL FS Monthly'[Account Name] ),
						DIVIDE ( [FR TB Balance (Budgeted)] - [FR TB Budget], ABS ( [FR TB Budget] ) ),
						CALCULATE ( DIVIDE ( [FR TB Balance (Budgeted)] - [FR TB Budget], ABS ( [FR TB Budget] ) ), 'GL FS Monthly'[FS Caption] = "trade receivables, net" )
					),
					REMOVEFILTERS ( 'Finance Column' )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + GL FS Monthly + P&L Report | Finance Column, GL FS Monthly, P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Chart TB vs Budget %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Finance\Report

		annotation hnh_snapshot = 1
		annotation hnh_guard_allow = Finance Column, GL FS Monthly, P&L Report
	/// Chart series: trial balance month-end closing of the budgeted hospitals as a share of budget (FR TB Balance (Budgeted) / FR TB Budget, the matrix's Ach % kind). The matrix row in context drives it; with no row selected it shows the default line (trade receivables, net).
	measure 'FR Chart TB Achievement %' =
			VAR __Value = ( -- measure body
				CALCULATE (
					IF (
						ISFILTERED ( 'GL FS Monthly'[FS Type Name] ) || ISFILTERED ( 'GL FS Monthly'[FS Element Name] ) || ISFILTERED ( 'GL FS Monthly'[FS Category Name] ) || ISFILTERED ( 'GL FS Monthly'[FS Caption Name] ) || ISFILTERED ( 'GL FS Monthly'[Account Name] ),
						DIVIDE ( [FR TB Balance (Budgeted)], [FR TB Budget] ),
						CALCULATE ( DIVIDE ( [FR TB Balance (Budgeted)], [FR TB Budget] ), 'GL FS Monthly'[FS Caption] = "trade receivables, net" )
					),
					REMOVEFILTERS ( 'Finance Column' )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Finance Budget + GL FS Monthly + P&L Report | Finance Column, GL FS Monthly, P&L Report]
			RETURN IF ( __Wrong = "", __Value, """FR Chart TB Achievement %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Finance\Report

		annotation hnh_snapshot = 1
		annotation hnh_guard_allow = Finance Column, GL FS Monthly, P&L Report
	/// Chart series: trial balance month-end closing (debit positive) against last year, as a ratio. The matrix row in context drives it; with no row selected it shows the default line (trade receivables, net).
	measure 'FR Chart TB vs LY %' =
			VAR __Value = ( -- measure body
				CALCULATE (
					IF (
						ISFILTERED ( 'GL FS Monthly'[FS Type Name] ) || ISFILTERED ( 'GL FS Monthly'[FS Element Name] ) || ISFILTERED ( 'GL FS Monthly'[FS Category Name] ) || ISFILTERED ( 'GL FS Monthly'[FS Caption Name] ) || ISFILTERED ( 'GL FS Monthly'[Account Name] ),
						DIVIDE ( [FR GL Closing] - [FR GL Closing Last Year], ABS ( [FR GL Closing Last Year] ) ),
						CALCULATE ( DIVIDE ( [FR GL Closing] - [FR GL Closing Last Year], ABS ( [FR GL Closing Last Year] ) ), 'GL FS Monthly'[FS Caption] = "trade receivables, net" )
					),
					REMOVEFILTERS ( 'Finance Column' )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL FS Monthly | Finance Column, GL FS Monthly, P&L Report]
