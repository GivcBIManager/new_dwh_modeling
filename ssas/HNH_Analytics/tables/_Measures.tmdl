		annotation hnh_guard_allow = Finance Column, P&L Report
	/// Background of an income statement matrix row by its P&L line: net band #DFE8F1 on Net profit and Total comprehensive income, total band #EFF4F9 on the other subtotal lines (Line Kind 'subtotal'), white on detail lines and with several lines in context.
	measure 'FR Row Band' =
			VAR Code = SELECTEDVALUE ( 'P&L Line'[PL Line Code] )
			VAR Kind = SELECTEDVALUE ( 'P&L Line'[Line Kind] )
			RETURN
				SWITCH ( TRUE (), Code IN { "NET_PROFIT", "TOTAL_COMPREHENSIVE_INCOME" }, "#DFE8F1", Kind = "subtotal", "#EFF4F9", "#FFFFFF" )
		formatString: General
		displayFolder: Finance\Report
	/// Chart series: balance sheet month-end balance (display sign) actual. The matrix row in context drives it; with no row selected it shows the default line (trade receivables, net).
