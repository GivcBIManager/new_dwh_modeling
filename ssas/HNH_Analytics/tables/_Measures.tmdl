					IF (
						ISFILTERED ( 'GL FS Monthly'[BS Side] ) || ISFILTERED ( 'GL FS Monthly'[BS Element] ) || ISFILTERED ( 'GL FS Monthly'[BS Category] ) || ISFILTERED ( 'GL FS Monthly'[BS Caption] ) || ISFILTERED ( 'GL FS Monthly'[Account Name] ),
