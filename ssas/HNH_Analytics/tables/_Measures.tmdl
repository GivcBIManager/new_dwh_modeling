	/// Employee cost in SAR, positive: direct-cost plus G&A employee lines (DC_EMPLOYEE + GA_EMPLOYEE, sign reversed), months up to the current one.
	measure 'Fin Employee Cost' =
			VAR __Value = ( -- measure body
				VAR Total =
					CALCULATE (
						SUM ( 'P&L Report'[Amount] ),
						'P&L Line'[PL Line Code] IN { "DC_EMPLOYEE", "GA_EMPLOYEE" },
						KEEPFILTERS ( 'Date'[Date] <= TODAY () )
					)
				RETURN
					IF ( NOT ISBLANK ( Total ), -Total )
			) -- end of measure body
			VAR __Wrong = [_Guard P&L Report]
