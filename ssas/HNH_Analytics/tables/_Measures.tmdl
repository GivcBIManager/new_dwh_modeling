				& IF ( ISFILTERED ( 'P&L Report' ), ", ""P&L Report""" )
				& IF ( ISFILTERED ( 'Patient' ), ", ""Patient""" )
				& IF ( ISFILTERED ( 'Patient Consumption' ), ", ""Patient Consumption""" )
				& IF ( ISFILTERED ( 'Patient Details' ), ", ""Patient Details""" )
				& IF ( ISFILTERED ( 'Pay Category' ), ", ""Pay Category""" )
				& IF ( ISFILTERED ( 'Payer' ), ", ""Payer""" )
				& IF ( ISFILTERED ( 'Payroll' ), ", ""Payroll""" )
				& IF ( ISFILTERED ( 'Policy' ), ", ""Policy""" )
				& IF ( ISFILTERED ( 'Pre-auth Lines' ), ", ""Pre-auth Lines""" )
				& IF ( ISFILTERED ( 'Pre-auth Outcome' ), ", ""Pre-auth Outcome""" )
				& IF ( ISFILTERED ( 'Procedure Type' ), ", ""Procedure Type""" )
				& IF ( ISFILTERED ( 'Product Category' ), ", ""Product Category""" )
				& IF ( ISFILTERED ( 'Purchase Lines' ), ", ""Purchase Lines""" )
				& IF ( ISFILTERED ( 'Requisitions' ), ", ""Requisitions""" )
				& IF ( ISFILTERED ( 'Revenue Adjustments' ), ", ""Revenue Adjustments""" )
				& IF ( ISFILTERED ( 'Service' ), ", ""Service""" )
				& IF ( ISFILTERED ( 'Service Department' ), ", ""Service Department""" )
				& IF ( ISFILTERED ( 'Staff Productivity' ), ", ""Staff Productivity""" )
				& IF ( ISFILTERED ( 'Stock Monthly' ), ", ""Stock Monthly""" )
				& IF ( ISFILTERED ( 'Stock Movements' ), ", ""Stock Movements""" )
				& IF ( ISFILTERED ( 'Store' ), ", ""Store""" )
				& IF ( ISFILTERED ( 'Supplier' ), ", ""Supplier""" )
				& IF ( ISFILTERED ( 'Surgeries' ), ", ""Surgeries""" )
