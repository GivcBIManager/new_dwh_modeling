/// Every measure of the model, in display folders by domain (<domain>\<topic>). Each perspective shows the measures of its domain (decision P26).
table _Measures

	/// Admissions by admit date, old warehouse rule (vw_inpatients, 2026-10-13): a last bed in a ward that is not excluded, an outcome that is not wrong admission, and more than one hour (to now for open stays).
	measure Admissions =
			VAR __Value = ( -- measure body
				CALCULATE ( COUNTROWS ( Admissions ), Admissions[Is Countable] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions]
			RETURN IF ( __Wrong = "", __Value, """Admissions"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Admissions
	/// Occupied ÷ available bed-days on inpatient wards that are not excluded (gold spec section 8; receiving notes).
	measure 'Bed Occupancy %' =
			VAR __Value = ( -- measure body
				CALCULATE (
					DIVIDE ( SUM ( 'Bed Occupancy'[Is Occupied] ), SUM ( 'Bed Occupancy'[Is Available] ) ),
					'Bed Occupancy'[Is Inpatient Ward] = "Yes",
					'Bed Occupancy'[Is Excluded Ward] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Bed Occupancy]
			RETURN IF ( __Wrong = "", __Value, """Bed Occupancy %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Flow\Occupancy
	/// Outpatient visits: arrived, not cancelled OP encounters (gold spec section 8).
	measure 'OP Visits' =
			VAR __Value = ( -- measure body
				CALCULATE (
					COUNTROWS ( Encounters ),
					KEEPFILTERS ( Encounters[Encounter Type] = "OP" ),
					Encounters[Is Arrived] = "Yes",
					Encounters[Is Cancelled] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """OP Visits"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Visits
	/// Billed amount in SAR: Σ net_amount of invoices (Phase 2 spec section 8).
	measure 'Billed Amount' =
			VAR __Value = ( -- measure body
				SUM ( Invoices[Net Amount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Invoices]
			RETURN IF ( __Wrong = "", __Value, """Billed Amount"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Billing
	/// Patient collections in SAR: Σ receipt_amount over receipts and cancellations; refunds are excluded (receiving note: refunds = Σ over Refund).
	measure 'Patient Collections' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Cash Receipts'[Receipt Amount] ), 'Cash Receipts'[Receipt Kind] IN { "Receipt", "Cancellation" } )
			) -- end of measure body
			VAR __Wrong = [_Guard Cash Receipts]
			RETURN IF ( __Wrong = "", __Value, """Patient Collections"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Collections
	/// Recognised revenue in SAR: Σ revenue_amount (Phase 2 spec section 8, "Revenue").
	measure Revenue =
			VAR __Value = ( -- measure body
				SUM ( 'Charge Lines'[Revenue Amount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Claimed amount in SAR of the latest, not cancelled submission (Phase 2B spec section 7; receiving notes).
	measure 'Claimed Amount' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Claim Lines'[Line Claimed Amount] ),
					'Claim Lines'[Is Latest Submission] = "Yes",
					'Claim Lines'[Is Cancelled Claim] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Lines]
			RETURN IF ( __Wrong = "", __Value, """Claimed Amount"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Claims
	/// Posted closing balance in SAR at the last period of the selection (an adjustment period wins over its month), signed for display (Phase 3 spec section 8). Snapshot. The last period is taken per branch, so a multi-branch total keeps every branch.
	measure 'GL Closing Balance' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastPeriod = CALCULATE ( MAX ( 'GL Balances'[Period Key] ), REMOVEFILTERS ( 'GL Balances' ), VALUES ( 'Date'[Date] ), VALUES ( 'GL Period'[Period Key] ), VALUES ( Branch[Branch Key] ) )
					RETURN
						CALCULATE (
							SUMX ( 'GL Balances', 'GL Balances'[Closing Balance] * RELATED ( 'FS Line'[Display Sign] ) ),
							'GL Balances'[Period Key] = LastPeriod,
							'GL Balances'[Balance View] = "posted"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """GL Closing Balance"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Balances

		annotation hnh_snapshot = 1
	/// Month-end headcount of the last closed month (is_closed_month) in the selection; the projected current month is excluded. Contingent workers excluded (Phase 4 spec section 7). Snapshot: never summed over months. The last period is taken per branch, so a multi-branch total keeps every branch.
	measure Headcount =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastMonth = CALCULATE ( MAX ( Headcount[Month Date Key] ), REMOVEFILTERS ( Headcount ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ), Headcount[Is Closed Month] = "Yes" )
					RETURN
						CALCULATE (
							SUM ( Headcount[Headcount Units] ),
							Headcount[Month Date Key] = LastMonth,
							Headcount[Is Closed Month] = "Yes",
							Headcount[Is Contingent] = "No"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Headcount]
			RETURN IF ( __Wrong = "", __Value, """Headcount"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Headcount

		annotation hnh_snapshot = 1
	/// Payroll cost in SAR: Σ cost_amount; parallel-run rows are already excluded (Phase 4 spec section 7).
	measure 'Payroll Cost' =
			VAR __Value = ( -- measure body
				SUM ( Payroll[Cost Amount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Payroll]
			RETURN IF ( __Wrong = "", __Value, """Payroll Cost"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Payroll
	/// Consumption cost in SAR: Σ consumption_cost of consumption movements (Phase 5 spec section 7).
	measure 'Consumption Cost' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Stock Movements'[Consumption Cost Amount] ), 'Stock Movements'[Is Consumption] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Movements]
			RETURN IF ( __Wrong = "", __Value, """Consumption Cost"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Consumption
	/// Stock value in SAR at the last month-end of the selection, expiry stores excluded (Phase 5 spec section 7). Snapshot. The last period is taken per branch, so a multi-branch total keeps every branch.
	measure 'Stock Value' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastMonth = CALCULATE ( MAX ( 'Stock Monthly'[Month Date Key] ), REMOVEFILTERS ( 'Stock Monthly' ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ) )
					RETURN
						CALCULATE (
							SUM ( 'Stock Monthly'[Stock Value Amount] ),
							'Stock Monthly'[Month Date Key] = LastMonth,
							'Stock Monthly'[Is Expiry Store] = "No"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Monthly]
			RETURN IF ( __Wrong = "", __Value, """Stock Value"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Stock

		annotation hnh_snapshot = 1
	/// Hospital NPS on the 5-point "recommend" question: (promoters − detractors) ÷ answers × 100; under 30 answers shows "insufficient sample" (Phase 6 spec section 7).
	measure 'Hospital NPS (5-point)' =
			VAR __Value = ( -- measure body
				VAR Answers = CALCULATE ( COUNTROWS ( 'Survey Answers' ), 'Survey Answers'[NPS Role] = "Hospital NPS" )
				VAR Net =
					CALCULATE (
						SUM ( 'Survey Answers'[Is Promoter] ) - SUM ( 'Survey Answers'[Is Detractor] ),
						'Survey Answers'[NPS Role] = "Hospital NPS"
					)
				RETURN IF ( Answers > 0, DIVIDE ( Net, Answers ) * 100 )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Hospital NPS (5-point)"" can't be analysed by " & __Wrong )
		displayFolder: Patient Experience\NPS
	
		formatStringDefinition =
				VAR Answers = CALCULATE ( COUNTROWS ( 'Survey Answers' ), 'Survey Answers'[NPS Role] = "Hospital NPS" )
				RETURN IF ( Answers < 30, """insufficient sample""", "0.0" )
	/// Primary survey invitations (Phase 6 spec section 7.1).
	measure Invitations =
			VAR __Value = ( -- measure body
				CALCULATE ( COUNTROWS ( 'Survey Responses' ), 'Survey Responses'[Is Primary For Encounter] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Invitations"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Survey Quality
	/// Responded ÷ primary invitations (Phase 6 spec 7.1 as amended in the receiving notes: not ÷ SMS sent, because a third of submitted surveys have no SMS date).
	measure 'Response Rate %' =
			VAR __Value = ( -- measure body
				VAR Invited = CALCULATE ( COUNTROWS ( 'Survey Responses' ), 'Survey Responses'[Is Primary For Encounter] = "Yes" )
				VAR Responded =
					CALCULATE (
						COUNTROWS ( 'Survey Responses' ),
						'Survey Responses'[Is Primary For Encounter] = "Yes",
						'Survey Responses'[Is Responded] = "Yes"
					)
				RETURN DIVIDE ( Responded, Invited )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Response Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Survey Quality
	/// The login SSAS sees for this connection; use it to check row-level security from a report.
	measure 'Current User' = USERPRINCIPALNAME ()
		formatString: General
		displayFolder: Diagnostics

	/// Emergency visits: ER encounters that are not cancelled (gold spec section 8).
	measure 'ER Visits' =
			VAR __Value = ( -- measure body
				CALCULATE (
					COUNTROWS ( Encounters ),
					KEEPFILTERS ( Encounters[Encounter Type] = "ER" ),
					Encounters[Is Cancelled] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """ER Visits"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Visits
	/// Census: OP visits plus ER visits (gold spec section 8).
	measure Census =
			VAR __Value = ( -- measure body
				[OP Visits] + [ER Visits]
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """Census"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Visits
	/// Distinct patients with an arrived, not cancelled OP or ER encounter (gold spec section 8; IP rows are admissions).
	measure 'Unique Patients' =
			VAR __Value = ( -- measure body
				CALCULATE (
					DISTINCTCOUNT ( Encounters[Patient Key] ),
					KEEPFILTERS ( Encounters[Encounter Type] IN { "OP", "ER" } ),
					Encounters[Is Arrived] = "Yes",
					Encounters[Is Cancelled] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """Unique Patients"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Patients
	/// Arrived OP and ER encounters with visit type New patient (gold spec section 8).
	measure 'New Patients' =
			VAR __Value = ( -- measure body
				CALCULATE (
					COUNTROWS ( Encounters ),
					KEEPFILTERS ( Encounters[Encounter Type] IN { "OP", "ER" } ),
					KEEPFILTERS ( Encounters[Visit Type] = "New patient" ),
					Encounters[Is Arrived] = "Yes"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """New Patients"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Patients
	/// Distinct returning patients (is_returning) among arrived, not cancelled OP and ER encounters (gold spec section 8).
	measure 'Returning Patients' =
			VAR __Value = ( -- measure body
				CALCULATE (
					DISTINCTCOUNT ( Encounters[Patient Key] ),
					KEEPFILTERS ( Encounters[Encounter Type] IN { "OP", "ER" } ),
					Encounters[Is Arrived] = "Yes",
					Encounters[Is Cancelled] = "No",
					Encounters[Is Returning] = "Yes"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """Returning Patients"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Patients
	/// Average waiting minutes of arrived, not cancelled OP and ER encounters; ER wait is arrival to treatment start (gold spec section 8; receiving notes).
	measure 'Average Wait (min)' =
			VAR __Value = ( -- measure body
				CALCULATE (
					AVERAGE ( Encounters[Wait Minutes] ),
					KEEPFILTERS ( Encounters[Encounter Type] IN { "OP", "ER" } ),
					Encounters[Is Arrived] = "Yes",
					Encounters[Is Cancelled] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """Average Wait (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Patient Flow\Waiting
	/// Median waiting minutes of arrived, not cancelled OP and ER encounters (gold spec section 8).
	measure 'Median Wait (min)' =
			VAR __Value = ( -- measure body
				CALCULATE (
					MEDIAN ( Encounters[Wait Minutes] ),
					KEEPFILTERS ( Encounters[Encounter Type] IN { "OP", "ER" } ),
					Encounters[Is Arrived] = "Yes",
					Encounters[Is Cancelled] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """Median Wait (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Patient Flow\Waiting
	/// Sum of waiting minutes, the figure the old reports published; use the average or median for comparisons (gold spec section 8 corrections).
	measure 'Total Wait (min)' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( Encounters[Wait Minutes] ),
					KEEPFILTERS ( Encounters[Encounter Type] IN { "OP", "ER" } ),
					Encounters[Is Arrived] = "Yes",
					Encounters[Is Cancelled] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """Total Wait (min)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Waiting
	/// Average ER length of stay in minutes, arrival to completion, of arrived, not cancelled ER encounters (receiving notes).
	measure 'Average ER LOS (min)' =
			VAR __Value = ( -- measure body
				CALCULATE (
					AVERAGE ( Encounters[ER LOS Minutes] ),
					KEEPFILTERS ( Encounters[Encounter Type] = "ER" ),
					Encounters[Is Arrived] = "Yes",
					Encounters[Is Cancelled] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """Average ER LOS (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Patient Flow\Waiting
	/// No-shows ÷ booked appointments that are not walk-ins and not cancelled (gold spec section 8).
	measure 'No-show Rate %' =
			VAR __Value = ( -- measure body
				VAR Booked =
					CALCULATE (
						COUNTROWS ( Encounters ),
						KEEPFILTERS ( Encounters[Encounter Type] IN { "OP", "ER" } ),
						Encounters[Is Walk In] = "No",
						Encounters[Is Cancelled] = "No"
					)
				VAR NoShows =
					CALCULATE (
						COUNTROWS ( Encounters ),
						KEEPFILTERS ( Encounters[Encounter Type] IN { "OP", "ER" } ),
						Encounters[Is Walk In] = "No",
						Encounters[Is Cancelled] = "No",
						Encounters[Is No Show] = "Yes"
					)
				RETURN DIVIDE ( NoShows, Booked )
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """No-show Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Flow\Appointments
	/// Cancelled ÷ booked appointments (not walk-ins), cancelled ones included in the denominator (gold spec section 8).
	measure 'Cancellation Rate %' =
			VAR __Value = ( -- measure body
				VAR Booked =
					CALCULATE (
						COUNTROWS ( Encounters ),
						KEEPFILTERS ( Encounters[Encounter Type] IN { "OP", "ER" } ),
						Encounters[Is Walk In] = "No"
					)
				VAR Cancelled =
					CALCULATE (
						COUNTROWS ( Encounters ),
						KEEPFILTERS ( Encounters[Encounter Type] IN { "OP", "ER" } ),
						Encounters[Is Walk In] = "No",
						Encounters[Is Cancelled] = "Yes"
					)
				RETURN DIVIDE ( Cancelled, Booked )
			) -- end of measure body
			VAR __Wrong = [_Guard Encounters]
			RETURN IF ( __Wrong = "", __Value, """Cancellation Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Flow\Appointments
	/// Episodes with an arrived encounter that is not a follow-up, by episode start date (gold spec section 8).
	measure Episodes =
			VAR __Value = ( -- measure body
				CALCULATE ( COUNTROWS ( Episodes ), Episodes[Has Arrived Non Follow Up Encounter] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Episodes]
			RETURN IF ( __Wrong = "", __Value, """Episodes"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Episodes
	/// Admissions counted by the old warehouse rule (see Admissions), by physical discharge date.
	measure Discharges =
			VAR __Value = ( -- measure body
				CALCULATE (
					COUNTROWS ( Admissions ),
					Admissions[Is Countable] = "Yes",
					USERELATIONSHIP ( Admissions[Physical Discharge Date Key], 'Date'[Date Key] )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions]
			RETURN IF ( __Wrong = "", __Value, """Discharges"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Admissions
	/// Average length of stay in days of the period's discharges (old warehouse rule, see Admissions); slice by Is LTC for the LTC split (old rule: more than 30 days to discharge or to now, or referred as LTC).
	measure 'ALOS (days)' =
			VAR __Value = ( -- measure body
				CALCULATE (
					AVERAGE ( Admissions[LOS Days] ),
					Admissions[Is Countable] = "Yes",
					USERELATIONSHIP ( Admissions[Physical Discharge Date Key], 'Date'[Date Key] )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions]
			RETURN IF ( __Wrong = "", __Value, """ALOS (days)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Patient Flow\Admissions
	/// 30-day readmissions ÷ admissions, by admit date, old warehouse rule: 30 days or less from the patient's previous admission (admit to admit).
	measure 'Readmission Rate 30d %' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Admissions], Admissions[Is Readmission 30d] = "Yes" ), [Admissions] )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions]
			RETURN IF ( __Wrong = "", __Value, """Readmission Rate 30d %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Flow\Admissions
	/// Admissions within 2 calendar days of the patient's previous admission whose last ward is named ICU or CCU (old warehouse rule).
	measure 'ICU Readmissions 48h' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Admissions], Admissions[Is ICU Readmission 48h] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions]
			RETURN IF ( __Wrong = "", __Value, """ICU Readmissions 48h"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Admissions
	/// Countable admissions from OP or ER ÷ OP and ER episodes whose consultant's specialty admits (gold spec section 8; episodes as in the Episodes measure).
	measure 'Conversion Rate %' =
			VAR __Value = ( -- measure body
				VAR Converted =
					CALCULATE (
						[Admissions],
						REMOVEFILTERS ( 'Care Type' ),
						KEEPFILTERS ( 'Admission Source'[Admission Source] IN { "OP", "ER" } ),
						KEEPFILTERS ( TREATAS ( VALUES ( 'Care Type'[Care Type] ), 'Admission Source'[Admission Source] ) )
					)
				VAR Eligible =
					CALCULATE (
						[Episodes],
						KEEPFILTERS ( 'Care Type'[Care Type] IN { "OP", "ER" } ),
						KEEPFILTERS ( TREATAS ( VALUES ( 'Admission Source'[Admission Source] ), 'Care Type'[Care Type] ) ),
						REMOVEFILTERS ( 'Admission Source' ),
						Staff[Is Non Admitting Specialty] = "No"
					)
				RETURN DIVIDE ( Converted, Eligible )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Episodes | Admission Source]
			RETURN IF ( __Wrong = "", __Value, """Conversion Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Flow\Admissions

		annotation hnh_guard_allow = Admission Source
	/// Discharges ÷ average available beds of inpatient, not excluded wards over the days in the period (gold spec section 8).
	measure 'Bed Turnover' =
			VAR __Value = ( -- measure body
				VAR BedDays =
					CALCULATE (
						SUM ( 'Bed Occupancy'[Is Available] ),
						'Bed Occupancy'[Is Inpatient Ward] = "Yes",
						'Bed Occupancy'[Is Excluded Ward] = "No"
					)
				VAR Days =
					CALCULATE (
						DISTINCTCOUNT ( 'Bed Occupancy'[Date Key] ),
						'Bed Occupancy'[Is Inpatient Ward] = "Yes",
						'Bed Occupancy'[Is Excluded Ward] = "No"
					)
				RETURN DIVIDE ( [Discharges], DIVIDE ( BedDays, Days ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Admissions + Bed Occupancy]
			RETURN IF ( __Wrong = "", __Value, """Bed Turnover"" can't be analysed by " & __Wrong )
		formatString: #,0.00
		displayFolder: Patient Flow\Occupancy
	/// Attended ÷ scheduled clinic slots (gold spec section 8).
	measure 'Clinic Utilisation %' =
			VAR __Value = ( -- measure body
				DIVIDE ( SUM ( 'Clinic Capacity'[Slots Attended] ), SUM ( 'Clinic Capacity'[Slots Total] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Clinic Capacity]
			RETURN IF ( __Wrong = "", __Value, """Clinic Utilisation %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Flow\Clinics
	/// Operations that are not cancelled, by operation date (gold spec section 8).
	measure 'Theatre Volume' =
			VAR __Value = ( -- measure body
				CALCULATE ( COUNTROWS ( Surgeries ), Surgeries[Is Cancelled] = "No" )
			) -- end of measure body
			VAR __Wrong = [_Guard Surgeries]
			RETURN IF ( __Wrong = "", __Value, """Theatre Volume"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Theatre
	/// Target census of the most likely scenario unless a scenario is selected (gold spec 7.7).
	measure 'Target Census' =
			VAR __Value = ( -- measure body
				VAR Scenario =
					FILTER (
						ALL ( Targets[Scenario] ),
						IF ( ISFILTERED ( Targets[Scenario] ), Targets[Scenario] IN VALUES ( Targets[Scenario] ), Targets[Scenario] = "most_likely" )
					)
				RETURN CALCULATE ( SUM ( Targets[Target Census] ), Scenario )
			) -- end of measure body
			VAR __Wrong = [_Guard Targets]
			RETURN IF ( __Wrong = "", __Value, """Target Census"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Targets
	/// Target episodes of the most likely scenario unless a scenario is selected (gold spec 7.7).
	measure 'Target Episodes' =
			VAR __Value = ( -- measure body
				VAR Scenario =
					FILTER (
						ALL ( Targets[Scenario] ),
						IF ( ISFILTERED ( Targets[Scenario] ), Targets[Scenario] IN VALUES ( Targets[Scenario] ), Targets[Scenario] = "most_likely" )
					)
				RETURN CALCULATE ( SUM ( Targets[Target Episodes] ), Scenario )
			) -- end of measure body
			VAR __Wrong = [_Guard Targets]
			RETURN IF ( __Wrong = "", __Value, """Target Episodes"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Targets
	/// Target revenue in SAR of the most likely scenario unless a scenario is selected (gold spec 7.7).
	measure 'Target Revenue' =
			VAR __Value = ( -- measure body
				VAR Scenario =
					FILTER (
						ALL ( Targets[Scenario] ),
						IF ( ISFILTERED ( Targets[Scenario] ), Targets[Scenario] IN VALUES ( Targets[Scenario] ), Targets[Scenario] = "most_likely" )
					)
				RETURN CALCULATE ( SUM ( Targets[Target Revenue] ), Scenario )
			) -- end of measure body
			VAR __Wrong = [_Guard Targets]
			RETURN IF ( __Wrong = "", __Value, """Target Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Targets
	/// Target cost per episode in SAR = Σ target_cost_total ÷ Σ target_episodes, never a sum of the per-row value (receiving notes).
	measure 'Target Cost per Episode' =
			VAR __Value = ( -- measure body
				VAR Scenario =
					FILTER (
						ALL ( Targets[Scenario] ),
						IF ( ISFILTERED ( Targets[Scenario] ), Targets[Scenario] IN VALUES ( Targets[Scenario] ), Targets[Scenario] = "most_likely" )
					)
				RETURN CALCULATE ( DIVIDE ( SUM ( Targets[Target Cost Total] ), SUM ( Targets[Target Episodes] ) ), Scenario )
			) -- end of measure body
			VAR __Wrong = [_Guard Targets]
			RETURN IF ( __Wrong = "", __Value, """Target Cost per Episode"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Flow\Targets
	/// Target ALOS in days of inpatient stay types = Σ target patient days ÷ Σ target episodes (the episode-weighted target_alos; receiving notes).
	measure 'Target ALOS (days)' =
			VAR __Value = ( -- measure body
				VAR Scenario =
					FILTER (
						ALL ( Targets[Scenario] ),
						IF ( ISFILTERED ( Targets[Scenario] ), Targets[Scenario] IN VALUES ( Targets[Scenario] ), Targets[Scenario] = "most_likely" )
					)
				RETURN
					CALCULATE (
						DIVIDE ( SUM ( Targets[Target Patient Days] ), SUM ( Targets[Target Episodes] ) ),
						Scenario,
						KEEPFILTERS ( Targets[Stay Type] IN { "Non-LTC", "LTC" } )
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Targets]
			RETURN IF ( __Wrong = "", __Value, """Target ALOS (days)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Patient Flow\Targets
	/// Gross charges in SAR of recognised revenue lines (Phase 2 spec section 9).
	measure 'Gross Charges' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Charge Lines'[Gross Amount] ), 'Charge Lines'[Is Recognised Revenue] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """Gross Charges"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Line discount in SAR of recognised revenue lines (Phase 2 spec section 9).
	measure 'Line Discount' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Charge Lines'[Line Discount Amount] ), 'Charge Lines'[Is Recognised Revenue] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """Line Discount"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// VAT in SAR of recognised revenue lines (Phase 2 spec section 9).
	measure VAT =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Charge Lines'[VAT Amount] ), 'Charge Lines'[Is Recognised Revenue] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """VAT"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Claimable revenue in SAR: Σ claimable_amount (Phase 2 spec section 9).
	measure 'Claimable Revenue' =
			VAR __Value = ( -- measure body
				SUM ( 'Charge Lines'[Claimable Amount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """Claimable Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Revenue in SAR of patient-share (deductible and co-pay) lines (Phase 2 spec section 9).
	measure 'Patient Share Revenue' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Revenue], KEEPFILTERS ( 'Charge Lines'[Is Patient Share] = "Yes" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """Patient Share Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Revenue in SAR of cash-billed lines (Phase 2 spec section 9).
	measure 'Cash Revenue' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Revenue], KEEPFILTERS ( 'Charge Lines'[Is Cash Billed] = "Yes" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """Cash Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Revenue in SAR of medication lines (Phase 2 spec section 9).
	measure 'Medication Revenue' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Revenue], KEEPFILTERS ( 'Charge Lines'[Is Medication] = "Yes" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """Medication Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Revenue in SAR by the episode's payer, so a payer's patients include their co-pay; Revenue slices by the billed payer (Phase 2 spec section 9).
	measure 'Revenue by Episode Payer' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Revenue], USERELATIONSHIP ( 'Charge Lines'[Episode Payer Key], Payer[Payer Key] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """Revenue by Episode Payer"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Package content value in SAR: Σ package_content_amount (Phase 2 spec section 9).
	measure 'Package Content Value' =
			VAR __Value = ( -- measure body
				SUM ( 'Charge Lines'[Package Content Amount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """Package Content Value"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Net amount in SAR of cancelled charge lines (Phase 2 spec section 9).
	measure 'Cancelled Charges' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Charge Lines'[Net Amount] ), KEEPFILTERS ( 'Charge Lines'[Charge Status] = "Cancelled" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines]
			RETURN IF ( __Wrong = "", __Value, """Cancelled Charges"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Post-invoice discount in SAR: Σ adjustment_amount of the credit documents (Phase 2 spec section 9).
	measure 'Post-invoice Discount' =
			VAR __Value = ( -- measure body
				SUM ( 'Revenue Adjustments'[Adjustment Amount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Revenue Adjustments]
			RETURN IF ( __Wrong = "", __Value, """Post-invoice Discount"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Revenue plus post-invoice discount in SAR (Phase 2 spec section 9).
	measure 'Net Revenue After Adjustments' =
			VAR __Value = ( -- measure body
				[Revenue] + [Post-invoice Discount]
			) -- end of measure body
			VAR __Wrong = [_Guard Charge Lines + Revenue Adjustments]
			RETURN IF ( __Wrong = "", __Value, """Net Revenue After Adjustments"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Revenue
	/// Billed amount in SAR of verified invoices (Phase 2 spec section 9).
	measure 'Verified Billed Amount' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Billed Amount], KEEPFILTERS ( Invoices[Is Verified] = "Yes" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Invoices]
			RETURN IF ( __Wrong = "", __Value, """Verified Billed Amount"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Billing
	/// Unbilled amount in SAR of episodes, by the episode's last delivery date (Phase 2 spec section 9).
	measure 'Unbilled Amount' =
			VAR __Value = ( -- measure body
				SUM ( 'Episode Billing'[Unbilled Amount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Episode Billing]
			RETURN IF ( __Wrong = "", __Value, """Unbilled Amount"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Billing
	/// Refunds paid back to patients in SAR: Σ receipt_amount of Refund rows (receiving notes).
	measure 'Patient Refunds' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Cash Receipts'[Receipt Amount] ), 'Cash Receipts'[Receipt Kind] = "Refund" )
			) -- end of measure body
			VAR __Wrong = [_Guard Cash Receipts]
			RETURN IF ( __Wrong = "", __Value, """Patient Refunds"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Collections
	/// Outpatient order lines in leak scope; inpatient lines only when Is Inpatient is selected (order fulfilment spec section 8; receiving notes).
	measure 'Order Lines' =
			VAR __Value = ( -- measure body
				VAR Inpatient =
					FILTER (
						ALL ( 'Order Lines'[Is Inpatient] ),
						IF ( ISFILTERED ( 'Order Lines'[Is Inpatient] ) || ISFILTERED ( 'Care Type' ), 'Order Lines'[Is Inpatient] IN VALUES ( 'Order Lines'[Is Inpatient] ), 'Order Lines'[Is Inpatient] = "No" )
					)
				RETURN CALCULATE ( COUNTROWS ( 'Order Lines' ), Inpatient, 'Order Lines'[Is In Leak Scope] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Order Lines]
			RETURN IF ( __Wrong = "", __Value, """Order Lines"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Order Fulfilment
	/// Lost order lines in leak scope, outpatient by default (order fulfilment spec section 8).
	measure 'Lost Lines' =
			VAR __Value = ( -- measure body
				VAR Inpatient =
					FILTER (
						ALL ( 'Order Lines'[Is Inpatient] ),
						IF ( ISFILTERED ( 'Order Lines'[Is Inpatient] ) || ISFILTERED ( 'Care Type' ), 'Order Lines'[Is Inpatient] IN VALUES ( 'Order Lines'[Is Inpatient] ), 'Order Lines'[Is Inpatient] = "No" )
					)
				RETURN
					CALCULATE (
						COUNTROWS ( 'Order Lines' ),
						Inpatient,
						'Order Lines'[Is In Leak Scope] = "Yes",
						'Order Lines'[Is Lost] = "Yes"
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Order Lines]
			RETURN IF ( __Wrong = "", __Value, """Lost Lines"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Order Fulfilment
	/// Lost lines ÷ order lines (order fulfilment spec section 8).
	measure 'Leak Rate %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Lost Lines], [Order Lines] )
			) -- end of measure body
			VAR __Wrong = [_Guard Order Lines]
			RETURN IF ( __Wrong = "", __Value, """Leak Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Revenue Cycle\Order Fulfilment
	/// Ordered value in SAR of lost lines, unit outliers excluded (order fulfilment spec section 8).
	measure 'Lost Value' =
			VAR __Value = ( -- measure body
				VAR Inpatient =
					FILTER (
						ALL ( 'Order Lines'[Is Inpatient] ),
						IF ( ISFILTERED ( 'Order Lines'[Is Inpatient] ) || ISFILTERED ( 'Care Type' ), 'Order Lines'[Is Inpatient] IN VALUES ( 'Order Lines'[Is Inpatient] ), 'Order Lines'[Is Inpatient] = "No" )
					)
				RETURN
					CALCULATE (
						SUM ( 'Order Lines'[Ordered Value] ),
						Inpatient,
						'Order Lines'[Is In Leak Scope] = "Yes",
						'Order Lines'[Is Lost] = "Yes",
						'Order Lines'[Is Unit Outlier] = "No"
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Order Lines]
			RETURN IF ( __Wrong = "", __Value, """Lost Value"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Order Fulfilment
	/// Average of the per-line unit fulfilment ratio (capped at 1) over lines in leak scope; outliers kept (order fulfilment spec section 8).
	measure 'Unit Fulfilment Rate %' =
			VAR __Value = ( -- measure body
				VAR Inpatient =
					FILTER (
						ALL ( 'Order Lines'[Is Inpatient] ),
						IF ( ISFILTERED ( 'Order Lines'[Is Inpatient] ) || ISFILTERED ( 'Care Type' ), 'Order Lines'[Is Inpatient] IN VALUES ( 'Order Lines'[Is Inpatient] ), 'Order Lines'[Is Inpatient] = "No" )
					)
				RETURN CALCULATE ( AVERAGE ( 'Order Lines'[Unit Fulfilment Ratio] ), Inpatient, 'Order Lines'[Is In Leak Scope] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Order Lines]
			RETURN IF ( __Wrong = "", __Value, """Unit Fulfilment Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Revenue Cycle\Order Fulfilment
	/// Partially delivered lines in leak scope, unit outliers excluded (order fulfilment spec section 8; receiving notes).
	measure 'Partially Delivered Lines' =
			VAR __Value = ( -- measure body
				VAR Inpatient =
					FILTER (
						ALL ( 'Order Lines'[Is Inpatient] ),
						IF ( ISFILTERED ( 'Order Lines'[Is Inpatient] ) || ISFILTERED ( 'Care Type' ), 'Order Lines'[Is Inpatient] IN VALUES ( 'Order Lines'[Is Inpatient] ), 'Order Lines'[Is Inpatient] = "No" )
					)
				RETURN
					CALCULATE (
						COUNTROWS ( 'Order Lines' ),
						Inpatient,
						'Order Lines'[Is In Leak Scope] = "Yes",
						'Order Lines'[Is Partially Delivered] = "Yes",
						'Order Lines'[Is Unit Outlier] = "No"
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Order Lines]
			RETURN IF ( __Wrong = "", __Value, """Partially Delivered Lines"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Revenue Cycle\Order Fulfilment
	/// Lost lines in context ÷ lost lines with every filter except the ordering doctor's specialty (order fulfilment spec section 8).
	measure 'Share of Total Lost %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Lost Lines], CALCULATE ( [Lost Lines], REMOVEFILTERS ( Staff[Unified Specialty], Staff[Specialty] ) ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Order Lines]
			RETURN IF ( __Wrong = "", __Value, """Share of Total Lost %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Revenue Cycle\Order Fulfilment
	/// Median minutes from order to first delivery of delivered lines; Consultation and Package are left out (charged at order time) (order fulfilment spec section 8).
	measure 'Order to Delivery Median (min)' =
			VAR __Value = ( -- measure body
				VAR Inpatient =
					FILTER (
						ALL ( 'Order Lines'[Is Inpatient] ),
						IF ( ISFILTERED ( 'Order Lines'[Is Inpatient] ) || ISFILTERED ( 'Care Type' ), 'Order Lines'[Is Inpatient] IN VALUES ( 'Order Lines'[Is Inpatient] ), 'Order Lines'[Is Inpatient] = "No" )
					)
				RETURN
					CALCULATE (
						MEDIAN ( 'Order Lines'[Order To Delivery Minutes] ),
						Inpatient,
						'Order Lines'[Line Status] = "Delivered",
						KEEPFILTERS ( NOT ( 'Order Lines'[Order Category] IN { "Consultation", "Package" } ) )
					)
			) -- end of measure body
			VAR __Wrong = [_Guard Order Lines]
			RETURN IF ( __Wrong = "", __Value, """Order to Delivery Median (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Revenue Cycle\Order Fulfilment
	/// Cancelled lines ÷ all lines (cancelled lines are out of leak scope, so no scope filter), outpatient by default (order fulfilment spec section 8).
	measure 'Order Cancellation Rate %' =
			VAR __Value = ( -- measure body
				VAR Inpatient =
					FILTER (
						ALL ( 'Order Lines'[Is Inpatient] ),
						IF ( ISFILTERED ( 'Order Lines'[Is Inpatient] ) || ISFILTERED ( 'Care Type' ), 'Order Lines'[Is Inpatient] IN VALUES ( 'Order Lines'[Is Inpatient] ), 'Order Lines'[Is Inpatient] = "No" )
					)
				VAR AllLines = CALCULATE ( COUNTROWS ( 'Order Lines' ), Inpatient )
				VAR Cancelled = CALCULATE ( COUNTROWS ( 'Order Lines' ), Inpatient, 'Order Lines'[Line Status] = "Cancelled" )
				RETURN DIVIDE ( Cancelled, AllLines )
			) -- end of measure body
			VAR __Wrong = [_Guard Order Lines]
			RETURN IF ( __Wrong = "", __Value, """Order Cancellation Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Revenue Cycle\Order Fulfilment
	/// Claimed amount in SAR of sent lines of the latest, not cancelled submission (Phase 2B spec section 8).
	measure 'Claims Submitted' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Claim Lines'[Line Claimed Amount] ),
					'Claim Lines'[Is Sent] = "Yes",
					'Claim Lines'[Is Latest Submission] = "Yes",
					'Claim Lines'[Is Cancelled Claim] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Lines]
			RETURN IF ( __Wrong = "", __Value, """Claims Submitted"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Claims
	/// Approved amount in SAR of the latest, not cancelled submission (Phase 2B spec section 8).
	measure 'Claims Approved' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Claim Lines'[Approved Amount] ),
					'Claim Lines'[Is Latest Submission] = "Yes",
					'Claim Lines'[Is Cancelled Claim] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Lines]
			RETURN IF ( __Wrong = "", __Value, """Claims Approved"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Claims
	/// Outcome-aware rejected amount in SAR of the latest, not cancelled submission; slice by NPHIES Reason for rejections by reason (Phase 2B spec section 8).
	measure 'Claims Rejected' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Claim Lines'[Rejected Amount] ),
					'Claim Lines'[Is Latest Submission] = "Yes",
					'Claim Lines'[Is Cancelled Claim] = "No"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Lines]
			RETURN IF ( __Wrong = "", __Value, """Claims Rejected"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Claims
	/// Rejected ÷ submitted amount of adjudicated lines of the latest, not cancelled submission (Phase 2B spec section 8; receiving notes).
	measure 'Claim Rejection Rate %' =
			VAR __Value = ( -- measure body
				VAR Rejected = CALCULATE ( [Claims Rejected], 'Claim Lines'[Adjudication Status] = "Adjudicated" )
				VAR Submitted =
					CALCULATE (
						SUM ( 'Claim Lines'[Submitted Amount] ),
						'Claim Lines'[Is Latest Submission] = "Yes",
						'Claim Lines'[Is Cancelled Claim] = "No",
						'Claim Lines'[Adjudication Status] = "Adjudicated"
					)
				RETURN DIVIDE ( Rejected, Submitted )
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Lines]
			RETURN IF ( __Wrong = "", __Value, """Claim Rejection Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Claims & Pre-auth\Claims
	/// Rejection rate of first submissions (submission 1 as sent, cancelled claims included: the one exception to the cancelled rule) (Phase 2B spec section 8; receiving notes).
	measure 'First-pass Rejection Rate %' =
			VAR __Value = ( -- measure body
				VAR Rejected =
					CALCULATE (
						SUM ( 'Claim Lines'[Rejected Amount] ),
						'Claim Lines'[Submission Number] = 1,
						'Claim Lines'[Adjudication Status] = "Adjudicated"
					)
				VAR Submitted =
					CALCULATE (
						SUM ( 'Claim Lines'[Submitted Amount] ),
						'Claim Lines'[Submission Number] = 1,
						'Claim Lines'[Adjudication Status] = "Adjudicated"
					)
				RETURN DIVIDE ( Rejected, Submitted )
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Lines]
			RETURN IF ( __Wrong = "", __Value, """First-pass Rejection Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Claims & Pre-auth\Claims
	/// Approved amount in SAR of latest, not cancelled resubmissions (submission number above 1) (Phase 2B spec section 8).
	measure 'Resubmission Recovery' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Claim Lines'[Approved Amount] ),
					'Claim Lines'[Is Latest Submission] = "Yes",
					'Claim Lines'[Is Cancelled Claim] = "No",
					'Claim Lines'[Submission Number] > 1
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Lines]
			RETURN IF ( __Wrong = "", __Value, """Resubmission Recovery"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Claims
	/// Claimed amount in SAR of sent, latest, not cancelled lines with no response or pended (Phase 2B spec section 8).
	measure 'Pending Adjudication' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Claim Lines'[Line Claimed Amount] ),
					'Claim Lines'[Is Sent] = "Yes",
					'Claim Lines'[Is Latest Submission] = "Yes",
					'Claim Lines'[Is Cancelled Claim] = "No",
					KEEPFILTERS ( 'Claim Lines'[Adjudication Status] IN { "No response", "Pended" } )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Lines]
			RETURN IF ( __Wrong = "", __Value, """Pending Adjudication"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Claims
	/// Claim remittance in SAR from NPHIES payment lines; advances are in Payer Advances; not insurer AR (Phase 2B spec section 8; receiving notes).
	measure Remitted =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Claim Payments'[Payment Amount] ), 'Claim Payments'[Detail Type] = "payment" )
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Payments]
			RETURN IF ( __Wrong = "", __Value, """Remitted"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Payments
	/// Money paid by payers as advances in SAR (detail type advance); not claim remittance (receiving notes).
	measure 'Payer Advances' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Claim Payments'[Payment Amount] ), 'Claim Payments'[Detail Type] = "advance" )
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Payments]
			RETURN IF ( __Wrong = "", __Value, """Payer Advances"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Payments
	/// Early fee in SAR as signed by the payer; reported beside the NPHIES fee, never netted (Phase 2B spec section 8).
	measure 'Early Fee' =
			VAR __Value = ( -- measure body
				SUM ( 'Claim Payments'[Early Fee] )
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Payments]
			RETURN IF ( __Wrong = "", __Value, """Early Fee"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Payments
	/// NPHIES fee in SAR as signed by the payer (Phase 2B spec section 8).
	measure 'NPHIES Fee' =
			VAR __Value = ( -- measure body
				SUM ( 'Claim Payments'[NPHIES Fee] )
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Payments]
			RETURN IF ( __Wrong = "", __Value, """NPHIES Fee"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Payments
	/// Median days from statement to payment of payment lines, for one payment month only (blank over longer periods: bulk back-settlements skew them) (Phase 2B spec section 8; receiving notes).
	measure 'Median Days to Payment' =
			VAR __Value = ( -- measure body
				IF (
					HASONEVALUE ( 'Date'[Year Month] ),
					CALCULATE ( MEDIAN ( 'Claim Payments'[Days To Payment] ), 'Claim Payments'[Detail Type] = "payment" )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Claim Payments]
			RETURN IF ( __Wrong = "", __Value, """Median Days to Payment"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Claims & Pre-auth\Payments
	/// Pre-auth service lines, payer advance authorisations excluded (Phase 2 spec section 9; receiving notes).
	measure 'Pre-auth Services' =
			VAR __Value = ( -- measure body
				CALCULATE ( COUNTROWS ( 'Pre-auth Lines' ), KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Pre-auth Services"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Distinct pre-auth requests per branch, added over branches; payer advances excluded (Phase 2 spec section 9).
	measure 'Pre-auth Requests' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					CALCULATE (
						DISTINCTCOUNTNOBLANK ( 'Pre-auth Lines'[Request No] ),
						KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" )
					)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Pre-auth Requests"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Approved lines with a final response ÷ lines with a final response (Phase 2 spec section 9; receiving notes).
	measure 'Pre-auth Approval Rate %' =
			VAR __Value = ( -- measure body
				VAR Final = CALCULATE ( [Pre-auth Services], 'Pre-auth Lines'[Has Final Response] = "Yes" )
				VAR Approved =
					CALCULATE ( [Pre-auth Services], 'Pre-auth Lines'[Has Final Response] = "Yes", 'Pre-auth Lines'[Is Approved] = "Yes" )
				RETURN DIVIDE ( Approved, Final )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Pre-auth Approval Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Rejected lines with a final response ÷ lines with a final response (Phase 2 spec section 9; receiving notes).
	measure 'Pre-auth Rejection Rate %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Pre-auth Rejected Lines], CALCULATE ( [Pre-auth Services], 'Pre-auth Lines'[Has Final Response] = "Yes" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Pre-auth Rejection Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Lines approved at the first response ÷ approved lines with a final response (Phase 2 spec section 9).
	measure 'Approved First Time %' =
			VAR __Value = ( -- measure body
				VAR Approved =
					CALCULATE ( [Pre-auth Services], 'Pre-auth Lines'[Has Final Response] = "Yes", 'Pre-auth Lines'[Is Approved] = "Yes" )
				VAR FirstTime =
					CALCULATE (
						[Pre-auth Services],
						'Pre-auth Lines'[Has Final Response] = "Yes",
						'Pre-auth Lines'[Is Approved] = "Yes",
						'Pre-auth Lines'[Is First Response Approved] = "Yes"
					)
				RETURN DIVIDE ( FirstTime, Approved )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Approved First Time %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Requests with a resubmitted line ÷ requests (Phase 2 spec section 9).
	measure 'Pre-auth Resubmission Rate %' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Pre-auth Requests], 'Pre-auth Lines'[Is Resubmitted] = "Yes" ), [Pre-auth Requests] )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Pre-auth Resubmission Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Transfer lines ÷ lines (Phase 2 spec section 9).
	measure 'Pre-auth Transfer Rate %' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Pre-auth Services], 'Pre-auth Lines'[Is Transfer] = "Yes" ), [Pre-auth Services] )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Pre-auth Transfer Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Average minutes from request to first send (Phase 2 spec section 9).
	measure 'Request to Sent Avg (min)' =
			VAR __Value = ( -- measure body
				CALCULATE ( AVERAGE ( 'Pre-auth Lines'[Request To Sent Minutes] ), KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Request to Sent Avg (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Claims & Pre-auth\Pre-auth Turnaround
	/// Median minutes from request to first send (Phase 2 spec section 9).
	measure 'Request to Sent Median (min)' =
			VAR __Value = ( -- measure body
				CALCULATE ( MEDIAN ( 'Pre-auth Lines'[Request To Sent Minutes] ), KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Request to Sent Median (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Claims & Pre-auth\Pre-auth Turnaround
	/// Average minutes from send to the final response (Phase 2 spec section 9).
	measure 'Sent to Response Avg (min)' =
			VAR __Value = ( -- measure body
				CALCULATE ( AVERAGE ( 'Pre-auth Lines'[Sent To Response Minutes] ), KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Sent to Response Avg (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Claims & Pre-auth\Pre-auth Turnaround
	/// Median minutes from send to the final response (Phase 2 spec section 9).
	measure 'Sent to Response Median (min)' =
			VAR __Value = ( -- measure body
				CALCULATE ( MEDIAN ( 'Pre-auth Lines'[Sent To Response Minutes] ), KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Sent to Response Median (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Claims & Pre-auth\Pre-auth Turnaround
	/// Average minutes from request to the final response (Phase 2 spec section 9).
	measure 'Total Turnaround Avg (min)' =
			VAR __Value = ( -- measure body
				CALCULATE ( AVERAGE ( 'Pre-auth Lines'[Total Turnaround Minutes] ), KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Total Turnaround Avg (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Claims & Pre-auth\Pre-auth Turnaround
	/// Median minutes from request to the final response (Phase 2 spec section 9).
	measure 'Total Turnaround Median (min)' =
			VAR __Value = ( -- measure body
				CALCULATE ( MEDIAN ( 'Pre-auth Lines'[Total Turnaround Minutes] ), KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Total Turnaround Median (min)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Claims & Pre-auth\Pre-auth Turnaround
	/// Approved lines that were never delivered (Phase 2 spec section 9).
	measure 'Unutilised Approvals' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Pre-auth Services], 'Pre-auth Lines'[Is Approved Not Delivered] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Unutilised Approvals"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Unutilised approvals ÷ lines (Phase 2 spec section 9).
	measure 'Unutilised Approval Rate %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Unutilised Approvals], [Pre-auth Services] )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Unutilised Approval Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Approved estimated amount in SAR of approved, undelivered lines on the latest request for the service (Phase 2 spec section 9).
	measure 'Pre-auth Lost Revenue' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Pre-auth Lines'[Approved Estimated Amount] ),
					KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ),
					'Pre-auth Lines'[Is Approved Not Delivered] = "Yes",
					'Pre-auth Lines'[Is Latest Request For Service] = "Yes"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Pre-auth Lost Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Estimated amount in SAR of rejected lines on the latest request for the service (Phase 2 spec section 9).
	measure 'Pre-auth Rejected Revenue' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Pre-auth Lines'[Estimated Amount] ),
					KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ),
					'Pre-auth Lines'[Preauth Outcome] = "Rejected",
					'Pre-auth Lines'[Is Latest Request For Service] = "Yes"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Pre-auth Rejected Revenue"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Lines delivered without an approval (Phase 2 spec section 9).
	measure 'Delivered Without Approval' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Pre-auth Services], 'Pre-auth Lines'[Is Delivered Not Approved] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Delivered Without Approval"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Estimated amount in SAR of lines delivered without an approval (Phase 2 spec section 9).
	measure 'Delivered Without Approval Amount' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Pre-auth Lines'[Estimated Amount] ),
					KEEPFILTERS ( 'Pre-auth Lines'[Line Source] <> "Payer advance" ),
					'Pre-auth Lines'[Is Delivered Not Approved] = "Yes"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Delivered Without Approval Amount"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Rejected pre-auth lines with a final response; slice by NPHIES Reason for rejections by reason (Phase 2B spec section 8).
	measure 'Pre-auth Rejected Lines' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Pre-auth Services], 'Pre-auth Lines'[Preauth Outcome] = "Rejected", 'Pre-auth Lines'[Has Final Response] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Pre-auth Rejected Lines"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Pre-auth
	/// Payer-initiated advance authorisations, by the payer's creation date (receiving notes).
	measure 'Advance Authorisations' =
			VAR __Value = ( -- measure body
				CALCULATE ( COUNTROWS ( 'Pre-auth Lines' ), KEEPFILTERS ( 'Pre-auth Lines'[Line Source] = "Payer advance" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Advance Authorisations"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Advance Authorisations
	/// Payer approved amount in SAR of advance authorisations, placeholders of 0 and 1 SAR included as sent (receiving notes).
	measure 'Advance Approved Amount' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Pre-auth Lines'[Payer Approved Amount] ), KEEPFILTERS ( 'Pre-auth Lines'[Line Source] = "Payer advance" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Pre-auth Lines]
			RETURN IF ( __Wrong = "", __Value, """Advance Approved Amount"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Claims & Pre-auth\Advance Authorisations
	/// Closing balance in SAR including unposted journals, at the last period of the selection per branch, signed for display (Phase 3 spec section 8; receiving notes). Snapshot.
	measure 'GL Closing Balance (incl. Unposted)' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastPeriod = CALCULATE ( MAX ( 'GL Balances'[Period Key] ), REMOVEFILTERS ( 'GL Balances' ), VALUES ( 'Date'[Date] ), VALUES ( 'GL Period'[Period Key] ), VALUES ( Branch[Branch Key] ) )
					RETURN
						CALCULATE (
							SUMX ( 'GL Balances', 'GL Balances'[Closing Balance] * RELATED ( 'FS Line'[Display Sign] ) ),
							'GL Balances'[Period Key] = LastPeriod,
							'GL Balances'[Balance View] = "including_unposted"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """GL Closing Balance (incl. Unposted)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Balances

		annotation hnh_snapshot = 1
	/// Posted period movement in SAR, signed for display; use it for balances and year to date (Phase 3 spec section 8).
	measure 'GL Movement' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUMX ( 'GL Balances', 'GL Balances'[Period Movement] * RELATED ( 'FS Line'[Display Sign] ) ),
					'GL Balances'[Balance View] = "posted"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """GL Movement"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Balances
	/// Period movement in SAR including unposted journals, signed for display (Phase 3 spec section 8).
	measure 'GL Movement (incl. Unposted)' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUMX ( 'GL Balances', 'GL Balances'[Period Movement] * RELATED ( 'FS Line'[Display Sign] ) ),
					'GL Balances'[Balance View] = "including_unposted"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """GL Movement (incl. Unposted)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Balances
	/// Posted movement in SAR without the go-live opening-balance journals, for monthly trends (Phase 3 spec section 8; receiving notes).
	measure 'GL Movement Trend' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUMX ( 'GL Balances', 'GL Balances'[Period Movement Excl Opening] * RELATED ( 'FS Line'[Display Sign] ) ),
					'GL Balances'[Balance View] = "posted"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """GL Movement Trend"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Balances
	/// Movement in SAR including unposted journals, without opening-balance journals, for monthly trends (Phase 3 spec section 8).
	measure 'GL Movement Trend (incl. Unposted)' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUMX ( 'GL Balances', 'GL Balances'[Period Movement Excl Opening] * RELATED ( 'FS Line'[Display Sign] ) ),
					'GL Balances'[Balance View] = "including_unposted"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """GL Movement Trend (incl. Unposted)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Balances
	/// Equity line Profit for the year in SAR = −Σ posted closing balance of income-statement accounts at the last period per branch, so assets = liabilities + equity (receiving notes). Snapshot.
	measure 'Profit for the Year' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastPeriod = CALCULATE ( MAX ( 'GL Balances'[Period Key] ), REMOVEFILTERS ( 'GL Balances' ), VALUES ( 'Date'[Date] ), VALUES ( 'GL Period'[Period Key] ), VALUES ( Branch[Branch Key] ) )
					RETURN
						- CALCULATE (
							SUM ( 'GL Balances'[Closing Balance] ),
							'GL Balances'[Period Key] = LastPeriod,
							'GL Balances'[Balance View] = "posted",
							'GL Account'[Balance Side] = "IS"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """Profit for the Year"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Balances

		annotation hnh_snapshot = 1
	/// Profit for the year in SAR including unposted journals (receiving notes). Snapshot.
	measure 'Profit for the Year (incl. Unposted)' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastPeriod = CALCULATE ( MAX ( 'GL Balances'[Period Key] ), REMOVEFILTERS ( 'GL Balances' ), VALUES ( 'Date'[Date] ), VALUES ( 'GL Period'[Period Key] ), VALUES ( Branch[Branch Key] ) )
					RETURN
						- CALCULATE (
							SUM ( 'GL Balances'[Closing Balance] ),
							'GL Balances'[Period Key] = LastPeriod,
							'GL Balances'[Balance View] = "including_unposted",
							'GL Account'[Balance Side] = "IS"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """Profit for the Year (incl. Unposted)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Balances

		annotation hnh_snapshot = 1
	/// Posted actual in SAR of one budget code, on the code's natural side; blank across several codes, whose sum is meaningless (Phase 3 spec section 8; receiving notes).
	measure 'IS Actual' =
			VAR __Value = ( -- measure body
				IF ( HASONEVALUE ( 'Budget Line'[Budget Line Code] ), SUM ( 'Income Statement'[Actual Posted] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """IS Actual"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Statement
	/// Actual in SAR including unposted journals, of one budget code (Phase 3 spec section 8).
	measure 'IS Actual (incl. Unposted)' =
			VAR __Value = ( -- measure body
				IF ( HASONEVALUE ( 'Budget Line'[Budget Line Code] ), SUM ( 'Income Statement'[Actual Including Unposted] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """IS Actual (incl. Unposted)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Statement
	/// Actual in SAR without opening-balance journals, of one budget code, for monthly trends (Phase 3 spec 6.3).
	measure 'IS Actual (excl. Opening)' =
			VAR __Value = ( -- measure body
				IF ( HASONEVALUE ( 'Budget Line'[Budget Line Code] ), SUM ( 'Income Statement'[Actual Excl Opening] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """IS Actual (excl. Opening)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Statement
	/// Most likely budget in SAR of one budget code (Phase 3 spec section 8; budget covers branches 1-6).
	measure 'IS Budget' =
			VAR __Value = ( -- measure body
				IF ( HASONEVALUE ( 'Budget Line'[Budget Line Code] ), SUM ( 'Income Statement'[Budget Most Likely] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """IS Budget"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Budget
	/// Budget to compare with the actual: IS Budget, except DC_MEDICINES, which compares with the DC_MEDICINES + DC_CONSUMABLES budget (receiving notes, O-P3-8).
	measure 'IS Budget (Comparable)' =
			VAR __Value = ( -- measure body
				IF (
					HASONEVALUE ( 'Budget Line'[Budget Line Code] ),
					IF (
						SELECTEDVALUE ( 'Budget Line'[Budget Line Code] ) = "DC_MEDICINES",
						CALCULATE (
							SUM ( 'Income Statement'[Budget Most Likely] ),
							REMOVEFILTERS ( 'Budget Line' ),
							'Budget Line'[Budget Line Code] IN { "DC_MEDICINES", "DC_CONSUMABLES" }
						),
						[IS Budget]
					)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """IS Budget (Comparable)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Budget
	/// Actual − comparable budget in SAR of one budget code (Phase 3 spec section 8).
	measure 'Budget Variance' =
			VAR __Value = ( -- measure body
				[IS Actual] - [IS Budget (Comparable)]
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """Budget Variance"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Budget
	/// Budget variance ÷ the absolute comparable budget (Phase 3 spec section 8).
	measure 'Budget Variance %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Budget Variance], ABS ( [IS Budget (Comparable)] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """Budget Variance %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Finance\Budget
	/// EBITDA in SAR: the EBITDA subtotal of the income statement, posted (Phase 3 spec section 8; never re-derived in DAX).
	measure EBITDA =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Income Statement'[Actual Posted] ), 'Budget Line'[Budget Line Code] = "EBITDA" )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """EBITDA"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Statement
	/// Gross profit in SAR: the GROSS_PROFIT subtotal, posted (Phase 3 spec section 8).
	measure 'Gross Profit' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Income Statement'[Actual Posted] ), 'Budget Line'[Budget Line Code] = "GROSS_PROFIT" )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """Gross Profit"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Statement
	/// Net profit in SAR: the NET_PROFIT subtotal, posted (Phase 3 spec section 8).
	measure 'Net Profit' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Income Statement'[Actual Posted] ), 'Budget Line'[Budget Line Code] = "NET_PROFIT" )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """Net Profit"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Statement
	/// EBITDA ÷ net revenue (REV_NET) (Phase 3 spec section 8).
	measure 'EBITDA Margin %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [EBITDA], CALCULATE ( SUM ( 'Income Statement'[Actual Posted] ), 'Budget Line'[Budget Line Code] = "REV_NET" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Income Statement]
			RETURN IF ( __Wrong = "", __Value, """EBITDA Margin %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Finance\Statement
	/// Supplier spend in SAR: Σ spend_amount of AP invoice lines by accounting date (Phase 3 spec section 8).
	measure 'Supplier Spend' =
			VAR __Value = ( -- measure body
				SUM ( 'AP Invoice Lines'[Spend Amount] )
			) -- end of measure body
			VAR __Wrong = [_Guard AP Invoice Lines]
			RETURN IF ( __Wrong = "", __Value, """Supplier Spend"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Payables
	/// Open payables in SAR at the last refresh, by invoice date; credit memos reduce it; filter Invoice Type for invoices only (Phase 3 spec section 8; receiving notes). Snapshot.
	measure 'Open Payables' =
			VAR __Value = ( -- measure body
				SUM ( 'AP Open Items'[Amount Remaining] )
			) -- end of measure body
			VAR __Wrong = [_Guard AP Open Items]
			RETURN IF ( __Wrong = "", __Value, """Open Payables"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Payables

		annotation hnh_snapshot = 1
	/// Open payables in SAR past their due date (days overdue above 0) at the last refresh (Phase 3 spec section 8). Snapshot.
	measure 'Overdue Payables' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'AP Open Items'[Amount Remaining] ), 'AP Open Items'[Days Overdue] > 0 )
			) -- end of measure body
			VAR __Wrong = [_Guard AP Open Items]
			RETURN IF ( __Wrong = "", __Value, """Overdue Payables"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Payables

		annotation hnh_snapshot = 1
	/// Median days from invoice to payment of payments that are not voided (Phase 3 spec section 8).
	measure 'Median Days to Pay' =
			VAR __Value = ( -- measure body
				CALCULATE ( MEDIAN ( 'AP Payments'[Days Invoice To Payment] ), 'AP Payments'[Is Voided] = "No" )
			) -- end of measure body
			VAR __Wrong = [_Guard AP Payments]
			RETURN IF ( __Wrong = "", __Value, """Median Days to Pay"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Finance\Payables
	/// Payments made on or before the due date ÷ payments, voided payments excluded (Phase 3 spec section 8).
	measure 'On-time Payment Rate %' =
			VAR __Value = ( -- measure body
				VAR Payments = CALCULATE ( COUNTROWS ( 'AP Payments' ), 'AP Payments'[Is Voided] = "No" )
				VAR OnTime =
					CALCULATE (
						COUNTROWS ( 'AP Payments' ),
						'AP Payments'[Is Voided] = "No",
						'AP Payments'[Days After Due] <= 0 && NOT ISBLANK ( 'AP Payments'[Days After Due] )
					)
				RETURN DIVIDE ( OnTime, Payments )
			) -- end of measure body
			VAR __Wrong = [_Guard AP Payments]
			RETURN IF ( __Wrong = "", __Value, """On-time Payment Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Finance\Payables
	/// Month-end FTE of the last closed month in the selection per branch, contingent workers excluded (Phase 4 spec section 7). Snapshot.
	measure FTE =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastMonth = CALCULATE ( MAX ( Headcount[Month Date Key] ), REMOVEFILTERS ( Headcount ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ), Headcount[Is Closed Month] = "Yes" )
					RETURN
						CALCULATE (
							SUM ( Headcount[FTE] ),
							Headcount[Month Date Key] = LastMonth,
							Headcount[Is Closed Month] = "Yes",
							Headcount[Is Contingent] = "No"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Headcount]
			RETURN IF ( __Wrong = "", __Value, """FTE"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Workforce\Headcount

		annotation hnh_snapshot = 1
	/// Saudi headcount ÷ headcount at the last closed month (Phase 4 spec section 7). Snapshot.
	measure 'Saudisation Rate %' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Headcount], KEEPFILTERS ( Headcount[Is Saudi] = "Yes" ) ), [Headcount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Headcount]
			RETURN IF ( __Wrong = "", __Value, """Saudisation Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Workforce\Headcount

		annotation hnh_snapshot = 1
	/// Average month-end headcount over the closed months of the selection, from 2026 (Phase 4 spec section 7; receiving notes).
	measure 'Average Headcount' =
			VAR __Value = ( -- measure body
				AVERAGEX ( VALUES ( 'Date'[Year Month] ), [Headcount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Headcount]
			RETURN IF ( __Wrong = "", __Value, """Average Headcount"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Workforce\Headcount
	/// Hire movements in the period (Phase 4 spec section 7).
	measure Hires =
			VAR __Value = ( -- measure body
				CALCULATE ( COUNTROWS ( 'Worker Movements' ), 'Worker Movements'[Is Hire] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Worker Movements]
			RETURN IF ( __Wrong = "", __Value, """Hires"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Movements
	/// Leaver movements in the period (Phase 4 spec section 7).
	measure Leavers =
			VAR __Value = ( -- measure body
				CALCULATE ( COUNTROWS ( 'Worker Movements' ), 'Worker Movements'[Is Leaver] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Worker Movements]
			RETURN IF ( __Wrong = "", __Value, """Leavers"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Movements
	/// Voluntary leaver movements in the period (Phase 4 spec section 7).
	measure 'Voluntary Leavers' =
			VAR __Value = ( -- measure body
				CALCULATE ( COUNTROWS ( 'Worker Movements' ), 'Worker Movements'[Is Voluntary Leaver] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Worker Movements]
			RETURN IF ( __Wrong = "", __Value, """Voluntary Leavers"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Movements
	/// Leavers ÷ average month-end headcount of the period, from 2026 (Phase 4 spec section 7; receiving notes).
	measure 'Turnover Rate %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Leavers], [Average Headcount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Headcount + Worker Movements]
			RETURN IF ( __Wrong = "", __Value, """Turnover Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Workforce\Movements
	/// Voluntary leavers ÷ average month-end headcount of the period, from 2026 (Phase 4 spec section 7).
	measure 'Voluntary Turnover Rate %' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Voluntary Leavers], [Average Headcount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Headcount + Worker Movements]
			RETURN IF ( __Wrong = "", __Value, """Voluntary Turnover Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Workforce\Movements
	/// Gross pay in SAR: Σ gross_pay, parallel-run rows already excluded; open Oasis payroll included (Phase 4 spec section 7; receiving notes).
	measure 'Gross Pay' =
			VAR __Value = ( -- measure body
				SUM ( Payroll[Gross Pay] )
			) -- end of measure body
			VAR __Wrong = [_Guard Payroll]
			RETURN IF ( __Wrong = "", __Value, """Gross Pay"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Payroll
	/// Gross pay in SAR of payroll the branch has not closed yet; it changes until the month is closed (receiving notes).
	measure 'Gross Pay (Open Payroll)' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Gross Pay], KEEPFILTERS ( Payroll[Is Closed Payroll] = "No" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Payroll]
			RETURN IF ( __Wrong = "", __Value, """Gross Pay (Open Payroll)"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Payroll
	/// Overtime gross pay ÷ gross pay (Phase 4 spec section 7).
	measure 'Overtime Share %' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Gross Pay], KEEPFILTERS ( 'Pay Category'[Pay Category] = "Overtime" ) ), [Gross Pay] )
			) -- end of measure body
			VAR __Wrong = [_Guard Payroll]
			RETURN IF ( __Wrong = "", __Value, """Overtime Share %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Workforce\Payroll
	/// Average month-end FTE over the closed months of the selection (Phase 4 spec section 7).
	measure 'Average FTE' =
			VAR __Value = ( -- measure body
				AVERAGEX ( VALUES ( 'Date'[Year Month] ), [FTE] )
			) -- end of measure body
			VAR __Wrong = [_Guard Headcount]
			RETURN IF ( __Wrong = "", __Value, """Average FTE"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Workforce\Headcount
	/// Payroll cost in SAR ÷ average FTE of the period (Phase 4 spec section 7).
	measure 'Payroll Cost per FTE' =
			VAR __Value = ( -- measure body
				DIVIDE ( [Payroll Cost], [Average FTE] )
			) -- end of measure body
			VAR __Wrong = [_Guard Headcount + Payroll]
			RETURN IF ( __Wrong = "", __Value, """Payroll Cost per FTE"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Payroll
	/// Counted sick-leave days up to today (receiving notes: planned absence runs into 2027).
	measure 'Sick Days' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Absence Days'[Absence Days] ),
					KEEPFILTERS ( 'Absence Type'[Absence Category] = "Sick" ),
					'Date'[Is Past] = "Yes"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Absence Days]
			RETURN IF ( __Wrong = "", __Value, """Sick Days"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Absence
	/// Sick days ÷ (month-end FTE × past calendar days), over months with a closed headcount (Phase 4 spec section 7).
	measure 'Sick Leave Rate %' =
			VAR __Value = ( -- measure body
				VAR Months =
					FILTER (
						ADDCOLUMNS (
							VALUES ( 'Date'[Year Month] ),
							"@Fte", [FTE],
							"@Days", CALCULATE ( COUNTROWS ( 'Date' ), 'Date'[Is Past] = "Yes" ),
							"@Sick", [Sick Days]
						),
						NOT ISBLANK ( [@Fte] )
					)
				RETURN DIVIDE ( SUMX ( Months, [@Sick] ), SUMX ( Months, [@Fte] * [@Days] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Absence Days + Headcount]
			RETURN IF ( __Wrong = "", __Value, """Sick Leave Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Workforce\Absence
	/// Leave balance in days at the last closed accrual month of the selection per branch: the latest period of each employee and plan in that month (receiving notes). Snapshot.
	measure 'Leave Balance (days)' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastDay =
						CALCULATE (
							MAX ( 'Leave Balances'[Accrual Period Date Key] ),
							REMOVEFILTERS ( 'Leave Balances' ),
							VALUES ( 'Date'[Date] ),
							VALUES ( Branch[Branch Key] ),
							'Leave Balances'[Is Latest In Month] = "Yes",
							'Leave Balances'[Is Closed Period] = "Yes",
							'Date'[Is Past] = "Yes"
						)
					RETURN
						CALCULATE (
							SUM ( 'Leave Balances'[End Balance] ),
							'Leave Balances'[Is Latest In Month] = "Yes",
							'Leave Balances'[Is Closed Period] = "Yes",
							'Date'[Year Month] = INT ( LastDay / 100 )
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Leave Balances]
			RETURN IF ( __Wrong = "", __Value, """Leave Balance (days)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Workforce\Leave

		annotation hnh_snapshot = 1
	/// Leave liability in SAR at the last closed accrual month of the selection per branch (receiving notes). Snapshot.
	measure 'Leave Liability' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastDay =
						CALCULATE (
							MAX ( 'Leave Balances'[Accrual Period Date Key] ),
							REMOVEFILTERS ( 'Leave Balances' ),
							VALUES ( 'Date'[Date] ),
							VALUES ( Branch[Branch Key] ),
							'Leave Balances'[Is Latest In Month] = "Yes",
							'Leave Balances'[Is Closed Period] = "Yes",
							'Date'[Is Past] = "Yes"
						)
					RETURN
						CALCULATE (
							SUM ( 'Leave Balances'[Leave Liability Amount] ),
							'Leave Balances'[Is Latest In Month] = "Yes",
							'Leave Balances'[Is Closed Period] = "Yes",
							'Date'[Year Month] = INT ( LastDay / 100 )
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Leave Balances]
			RETURN IF ( __Wrong = "", __Value, """Leave Liability"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Leave

		annotation hnh_snapshot = 1
	/// Leave balance in days at the latest closed accrual period, whatever dates are selected (receiving notes: latest-position KPI).
	measure 'Current Leave Balance (days)' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Leave Balances'[End Balance] ), 'Leave Balances'[Is Current Balance] = "Yes", REMOVEFILTERS ( 'Date' ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Leave Balances]
			RETURN IF ( __Wrong = "", __Value, """Current Leave Balance (days)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Workforce\Leave
	/// Leave liability in SAR at the latest closed accrual period, whatever dates are selected (receiving notes).
	measure 'Current Leave Liability' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Leave Balances'[Leave Liability Amount] ), 'Leave Balances'[Is Current Balance] = "Yes", REMOVEFILTERS ( 'Date' ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Leave Balances]
			RETURN IF ( __Wrong = "", __Value, """Current Leave Liability"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Leave
	/// Revenue ÷ payroll cost of linked doctors and nurses, a ratio of sums (Phase 4 spec section 7; receiving notes).
	measure 'Revenue per Payroll SAR' =
			VAR __Value = ( -- measure body
				DIVIDE ( SUM ( 'Staff Productivity'[Revenue Amount] ), SUM ( 'Staff Productivity'[Payroll Cost] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Staff Productivity]
			RETURN IF ( __Wrong = "", __Value, """Revenue per Payroll SAR"" can't be analysed by " & __Wrong )
		formatString: #,0.00
		displayFolder: Workforce\Productivity
	/// Encounters seen ÷ FTE-months of linked doctors and nurses (Phase 4 spec section 7).
	measure 'Visits per FTE' =
			VAR __Value = ( -- measure body
				DIVIDE ( SUM ( 'Staff Productivity'[Encounters Seen] ), SUM ( 'Staff Productivity'[FTE] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Staff Productivity]
			RETURN IF ( __Wrong = "", __Value, """Visits per FTE"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Workforce\Productivity
	/// Payroll cost in SAR ÷ encounters seen of linked doctors and nurses (Phase 4 spec section 7).
	measure 'Payroll Cost per Visit' =
			VAR __Value = ( -- measure body
				DIVIDE ( SUM ( 'Staff Productivity'[Payroll Cost] ), SUM ( 'Staff Productivity'[Encounters Seen] ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Staff Productivity]
			RETURN IF ( __Wrong = "", __Value, """Payroll Cost per Visit"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Workforce\Productivity
	/// Consumption quantity in primary units of consumption movements (patient sales − returns + department issues) (Phase 5 spec section 7).
	measure 'Consumption Quantity' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Stock Movements'[Consumption Quantity] ), 'Stock Movements'[Is Consumption] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Movements]
			RETURN IF ( __Wrong = "", __Value, """Consumption Quantity"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Consumption
	/// Consumption cost in SAR at pharmacy stores, plus medication issued from wards (Phase 5 spec section 7).
	measure 'Pharmacy Consumption Cost' =
			VAR __Value = ( -- measure body
				CALCULATE ( [Consumption Cost], KEEPFILTERS ( Store[Store Type] = "Pharmacy" ) )
					+ CALCULATE ( [Consumption Cost], KEEPFILTERS ( Store[Store Type] = "Ward" ), KEEPFILTERS ( 'Item'[Item Group] = "Medication" ) )
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Movements]
			RETURN IF ( __Wrong = "", __Value, """Pharmacy Consumption Cost"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Consumption
	/// Recorded cost in SAR of patient consumption lines (Phase 5 spec section 7).
	measure 'Patient Consumption Cost' =
			VAR __Value = ( -- measure body
				SUM ( 'Patient Consumption'[Cost Amount] )
			) -- end of measure body
			VAR __Wrong = [_Guard Patient Consumption]
			RETURN IF ( __Wrong = "", __Value, """Patient Consumption Cost"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Consumption
	/// Revenue − consumption cost in SAR of patient consumption lines whose revenue basis is a charge (receiving notes; package components are separate).
	measure 'Drug and Supply Margin' =
			VAR __Value = ( -- measure body
				CALCULATE (
					SUM ( 'Patient Consumption'[Revenue Amount] ) - SUM ( 'Patient Consumption'[Consumption Cost] ),
					'Patient Consumption'[Revenue Basis] = "charge"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Patient Consumption]
			RETURN IF ( __Wrong = "", __Value, """Drug and Supply Margin"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Margin
	/// Margin ÷ revenue of charge-based patient consumption, a ratio of sums (Phase 5 spec section 7).
	measure 'Drug and Supply Margin %' =
			VAR __Value = ( -- measure body
				DIVIDE (
					[Drug and Supply Margin],
					CALCULATE ( SUM ( 'Patient Consumption'[Revenue Amount] ), 'Patient Consumption'[Revenue Basis] = "charge" )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Patient Consumption]
			RETURN IF ( __Wrong = "", __Value, """Drug and Supply Margin %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Supply Chain\Margin
	/// Consumption cost in SAR of package-component dispenses, whose revenue is on the package header (receiving notes).
	measure 'Package Component Cost' =
			VAR __Value = ( -- measure body
				CALCULATE ( SUM ( 'Patient Consumption'[Consumption Cost] ), 'Patient Consumption'[Revenue Basis] = "package_component" )
			) -- end of measure body
			VAR __Wrong = [_Guard Patient Consumption]
			RETURN IF ( __Wrong = "", __Value, """Package Component Cost"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Margin
	/// Stock value at the last closed month-end ÷ (that month's consumption cost ÷ days in the month), per branch, then summed (Phase 5 spec section 7). Snapshot.
	measure 'Days of Stock' =
			VAR __Value = ( -- measure body
				VAR DailyUse =
					SUMX (
						VALUES ( Branch[Branch Key] ),
						VAR LastMonth = CALCULATE ( MAX ( 'Stock Monthly'[Month Date Key] ), REMOVEFILTERS ( 'Stock Monthly' ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ), 'Stock Monthly'[Is Closed Month] = "Yes" )
						RETURN DIVIDE ( CALCULATE ( [Consumption Cost], 'Date'[Year Month] = INT ( LastMonth / 100 ) ), MOD ( LastMonth, 100 ) )
					)
				VAR StockValue =
					SUMX (
						VALUES ( Branch[Branch Key] ),
						VAR LastMonth = CALCULATE ( MAX ( 'Stock Monthly'[Month Date Key] ), REMOVEFILTERS ( 'Stock Monthly' ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ), 'Stock Monthly'[Is Closed Month] = "Yes" )
						RETURN CALCULATE ( SUM ( 'Stock Monthly'[Stock Value Amount] ), 'Stock Monthly'[Month Date Key] = LastMonth, 'Stock Monthly'[Is Expiry Store] = "No" )
					)
				RETURN DIVIDE ( StockValue, DailyUse )
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Monthly + Stock Movements]
			RETURN IF ( __Wrong = "", __Value, """Days of Stock"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Supply Chain\Stock

		annotation hnh_snapshot = 1
	/// Consumption cost of the 12 months to the last closed month-end ÷ average month-end stock value of those months, per branch, then summed (Phase 5 spec section 7). Snapshot.
	measure 'Inventory Turnover' =
			VAR __Value = ( -- measure body
				VAR Consumption12 =
					SUMX (
						VALUES ( Branch[Branch Key] ),
						VAR LastMonth = CALCULATE ( MAX ( 'Stock Monthly'[Month Date Key] ), REMOVEFILTERS ( 'Stock Monthly' ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ), 'Stock Monthly'[Is Closed Month] = "Yes" )
						VAR LastDay = DATE ( INT ( LastMonth / 10000 ), MOD ( INT ( LastMonth / 100 ), 100 ), MOD ( LastMonth, 100 ) )
						RETURN IF ( NOT ISBLANK ( LastMonth ), CALCULATE ( [Consumption Cost], DATESINPERIOD ( 'Date'[Date], LastDay, -12, MONTH ) ) )
					)
				VAR AverageStock =
					SUMX (
						VALUES ( Branch[Branch Key] ),
						VAR LastMonth = CALCULATE ( MAX ( 'Stock Monthly'[Month Date Key] ), REMOVEFILTERS ( 'Stock Monthly' ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ), 'Stock Monthly'[Is Closed Month] = "Yes" )
						VAR LastDay = DATE ( INT ( LastMonth / 10000 ), MOD ( INT ( LastMonth / 100 ), 100 ), MOD ( LastMonth, 100 ) )
						RETURN
							IF (
								NOT ISBLANK ( LastMonth ),
								CALCULATE ( AVERAGEX ( VALUES ( 'Date'[Year Month] ), [Stock Value] ), DATESINPERIOD ( 'Date'[Date], LastDay, -12, MONTH ) )
							)
					)
				RETURN DIVIDE ( Consumption12, AverageStock )
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Monthly + Stock Movements]
			RETURN IF ( __Wrong = "", __Value, """Inventory Turnover"" can't be analysed by " & __Wrong )
		formatString: #,0.00
		displayFolder: Supply Chain\Stock

		annotation hnh_snapshot = 1
	/// Items with stock at the last closed month-end and no consumption in the 90 days to it, per branch (Phase 5 spec section 7). Snapshot.
	measure 'Slow-Moving Items' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastMonth = CALCULATE ( MAX ( 'Stock Monthly'[Month Date Key] ), REMOVEFILTERS ( 'Stock Monthly' ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ), 'Stock Monthly'[Is Closed Month] = "Yes" )
					VAR LastDay = DATE ( INT ( LastMonth / 10000 ), MOD ( INT ( LastMonth / 100 ), 100 ), MOD ( LastMonth, 100 ) )
					VAR InStock =
						CALCULATETABLE (
							VALUES ( 'Stock Monthly'[Item Key] ),
							'Stock Monthly'[Month Date Key] = LastMonth,
							'Stock Monthly'[Is Expiry Store] = "No",
							'Stock Monthly'[Quantity] > 0
						)
					VAR Consumed =
						CALCULATETABLE (
							VALUES ( 'Stock Movements'[Item Key] ),
							'Stock Movements'[Is Consumption] = "Yes",
							DATESINPERIOD ( 'Date'[Date], LastDay, -90, DAY )
						)
					RETURN IF ( NOT ISBLANK ( LastMonth ), COUNTROWS ( EXCEPT ( InStock, Consumed ) ) )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Monthly + Stock Movements]
			RETURN IF ( __Wrong = "", __Value, """Slow-Moving Items"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Stock

		annotation hnh_snapshot = 1
	/// Stock value in SAR at the last closed month-end of items with no consumption in the 90 days to it (Phase 5 spec section 7). Snapshot.
	measure 'Slow-Moving Stock Value' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastMonth = CALCULATE ( MAX ( 'Stock Monthly'[Month Date Key] ), REMOVEFILTERS ( 'Stock Monthly' ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ), 'Stock Monthly'[Is Closed Month] = "Yes" )
					VAR LastDay = DATE ( INT ( LastMonth / 10000 ), MOD ( INT ( LastMonth / 100 ), 100 ), MOD ( LastMonth, 100 ) )
					VAR InStock =
						CALCULATETABLE (
							VALUES ( 'Stock Monthly'[Item Key] ),
							'Stock Monthly'[Month Date Key] = LastMonth,
							'Stock Monthly'[Is Expiry Store] = "No",
							'Stock Monthly'[Quantity] > 0
						)
					VAR Consumed =
						CALCULATETABLE (
							VALUES ( 'Stock Movements'[Item Key] ),
							'Stock Movements'[Is Consumption] = "Yes",
							DATESINPERIOD ( 'Date'[Date], LastDay, -90, DAY )
						)
					RETURN
						IF (
							NOT ISBLANK ( LastMonth ),
							CALCULATE (
								SUM ( 'Stock Monthly'[Stock Value Amount] ),
								'Stock Monthly'[Month Date Key] = LastMonth,
								'Stock Monthly'[Is Expiry Store] = "No",
								'Stock Monthly'[Quantity] > 0,
								EXCEPT ( InStock, Consumed )
							)
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Monthly + Stock Movements]
			RETURN IF ( __Wrong = "", __Value, """Slow-Moving Stock Value"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Stock

		annotation hnh_snapshot = 1
	/// Items with stock at the last closed month-end and no consumption in the 180 days to it, per branch (Phase 5 spec section 7). Snapshot.
	measure 'Dead Stock Items' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastMonth = CALCULATE ( MAX ( 'Stock Monthly'[Month Date Key] ), REMOVEFILTERS ( 'Stock Monthly' ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ), 'Stock Monthly'[Is Closed Month] = "Yes" )
					VAR LastDay = DATE ( INT ( LastMonth / 10000 ), MOD ( INT ( LastMonth / 100 ), 100 ), MOD ( LastMonth, 100 ) )
					VAR InStock =
						CALCULATETABLE (
							VALUES ( 'Stock Monthly'[Item Key] ),
							'Stock Monthly'[Month Date Key] = LastMonth,
							'Stock Monthly'[Is Expiry Store] = "No",
							'Stock Monthly'[Quantity] > 0
						)
					VAR Consumed =
						CALCULATETABLE (
							VALUES ( 'Stock Movements'[Item Key] ),
							'Stock Movements'[Is Consumption] = "Yes",
							DATESINPERIOD ( 'Date'[Date], LastDay, -180, DAY )
						)
					RETURN IF ( NOT ISBLANK ( LastMonth ), COUNTROWS ( EXCEPT ( InStock, Consumed ) ) )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Monthly + Stock Movements]
			RETURN IF ( __Wrong = "", __Value, """Dead Stock Items"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Stock

		annotation hnh_snapshot = 1
	/// Stock value in SAR at the last closed month-end of items with no consumption in the 180 days to it (Phase 5 spec section 7). Snapshot.
	measure 'Dead Stock Value' =
			VAR __Value = ( -- measure body
				SUMX (
					VALUES ( Branch[Branch Key] ),
					VAR LastMonth = CALCULATE ( MAX ( 'Stock Monthly'[Month Date Key] ), REMOVEFILTERS ( 'Stock Monthly' ), VALUES ( 'Date'[Date] ), VALUES ( Branch[Branch Key] ), 'Stock Monthly'[Is Closed Month] = "Yes" )
					VAR LastDay = DATE ( INT ( LastMonth / 10000 ), MOD ( INT ( LastMonth / 100 ), 100 ), MOD ( LastMonth, 100 ) )
					VAR InStock =
						CALCULATETABLE (
							VALUES ( 'Stock Monthly'[Item Key] ),
							'Stock Monthly'[Month Date Key] = LastMonth,
							'Stock Monthly'[Is Expiry Store] = "No",
							'Stock Monthly'[Quantity] > 0
						)
					VAR Consumed =
						CALCULATETABLE (
							VALUES ( 'Stock Movements'[Item Key] ),
							'Stock Movements'[Is Consumption] = "Yes",
							DATESINPERIOD ( 'Date'[Date], LastDay, -180, DAY )
						)
					RETURN
						IF (
							NOT ISBLANK ( LastMonth ),
							CALCULATE (
								SUM ( 'Stock Monthly'[Stock Value Amount] ),
								'Stock Monthly'[Month Date Key] = LastMonth,
								'Stock Monthly'[Is Expiry Store] = "No",
								'Stock Monthly'[Quantity] > 0,
								EXCEPT ( InStock, Consumed )
							)
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Monthly + Stock Movements]
			RETURN IF ( __Wrong = "", __Value, """Dead Stock Value"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Supply Chain\Stock

		annotation hnh_snapshot = 1
	/// Median days from PO to first receipt of approved POs; prefer it to the average (Oasis outliers above 365 days) (Phase 5 spec section 7; receiving notes).
	measure 'PO Lead Time Median (days)' =
			VAR __Value = ( -- measure body
				CALCULATE ( MEDIAN ( 'Purchase Lines'[Lead Time Days] ), 'Purchase Lines'[Is Approved PO] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Purchase Lines]
			RETURN IF ( __Wrong = "", __Value, """PO Lead Time Median (days)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Supply Chain\Purchasing
	/// Average days from PO to first receipt of approved POs (Phase 5 spec section 7).
	measure 'PO Lead Time Average (days)' =
			VAR __Value = ( -- measure body
				CALCULATE ( AVERAGE ( 'Purchase Lines'[Lead Time Days] ), 'Purchase Lines'[Is Approved PO] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Purchase Lines]
			RETURN IF ( __Wrong = "", __Value, """PO Lead Time Average (days)"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Supply Chain\Purchasing
	/// Quantity received ÷ (quantity ordered − quantity cancelled) of approved POs, in the ordering unit (Phase 5 spec section 7).
	measure 'PO Fill Rate %' =
			VAR __Value = ( -- measure body
				CALCULATE (
					DIVIDE (
						SUM ( 'Purchase Lines'[Quantity Received] ),
						SUM ( 'Purchase Lines'[Quantity Ordered] ) - SUM ( 'Purchase Lines'[Quantity Cancelled] )
					),
					'Purchase Lines'[Is Approved PO] = "Yes"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Purchase Lines]
			RETURN IF ( __Wrong = "", __Value, """PO Fill Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Supply Chain\Purchasing
	/// Unit price of the latest approved PO line for one item and one supplier (the highest price if several lines share that date); blank otherwise (Phase 5 spec section 7).
	measure 'Last PO Unit Price' =
			VAR __Value = ( -- measure body
				IF (
					HASONEVALUE ( 'Item'[Item Key] ) && HASONEVALUE ( Supplier[Supplier Key] ),
					VAR LastPo = CALCULATE ( MAX ( 'Purchase Lines'[PO Date Key] ), 'Purchase Lines'[Is Approved PO] = "Yes" )
					RETURN
						CALCULATE (
							MAX ( 'Purchase Lines'[Unit Price] ),
							'Purchase Lines'[PO Date Key] = LastPo,
							'Purchase Lines'[Is Approved PO] = "Yes"
						)
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Purchase Lines]
			RETURN IF ( __Wrong = "", __Value, """Last PO Unit Price"" can't be analysed by " & __Wrong )
		formatString: #,0.00
		displayFolder: Supply Chain\Purchasing
	/// Latest ÷ previous approved PO unit price − 1, for one item and one supplier (Phase 5 spec section 7).
	measure 'PO Price Change %' =
			VAR __Value = ( -- measure body
				IF (
					HASONEVALUE ( 'Item'[Item Key] ) && HASONEVALUE ( Supplier[Supplier Key] ),
					VAR LastPo = CALCULATE ( MAX ( 'Purchase Lines'[PO Date Key] ), 'Purchase Lines'[Is Approved PO] = "Yes" )
					VAR PreviousPo =
						CALCULATE (
							MAX ( 'Purchase Lines'[PO Date Key] ),
							'Purchase Lines'[Is Approved PO] = "Yes",
							'Purchase Lines'[PO Date Key] < LastPo
						)
					VAR PreviousPrice =
						CALCULATE (
							MAX ( 'Purchase Lines'[Unit Price] ),
							'Purchase Lines'[PO Date Key] = PreviousPo,
							'Purchase Lines'[Is Approved PO] = "Yes"
						)
					VAR Ratio = DIVIDE ( [Last PO Unit Price], PreviousPrice )
					RETURN IF ( NOT ISBLANK ( PreviousPo ) && NOT ISBLANK ( Ratio ), Ratio - 1 )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Purchase Lines]
			RETURN IF ( __Wrong = "", __Value, """PO Price Change %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Supply Chain\Purchasing
	/// AP spend matched to POs ÷ total AP spend (Phase 5 spec section 7, with Phase 3's AP invoice lines).
	measure 'PO-Matched Spend Share %' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Supplier Spend], KEEPFILTERS ( 'AP Invoice Lines'[Is PO Matched] = "Yes" ) ), [Supplier Spend] )
			) -- end of measure body
			VAR __Wrong = [_Guard AP Invoice Lines]
			RETURN IF ( __Wrong = "", __Value, """PO-Matched Spend Share %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Supply Chain\Purchasing
	/// Oasis lines Fusion has not received ÷ Oasis lines from go-live (in Fusion or a gap), as rec_stock_interface_daily (Phase 5 spec section 7).
	measure 'Fusion Interface Gap %' =
			VAR __Value = ( -- measure body
				VAR Gap =
					CALCULATE ( COUNTROWS ( 'Stock Movements' ), 'Stock Movements'[Is Fusion Gap] = "Yes", 'Stock Movements'[Is In Oasis] = "Yes" )
				VAR InFusion =
					CALCULATE ( COUNTROWS ( 'Stock Movements' ), 'Stock Movements'[Source System] = "fusion", 'Stock Movements'[Is In Oasis] = "Yes" )
				RETURN DIVIDE ( Gap, Gap + InFusion )
			) -- end of measure body
			VAR __Wrong = [_Guard Stock Movements]
			RETURN IF ( __Wrong = "", __Value, """Fusion Interface Gap %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Supply Chain\Interface
	/// Every survey invitation, primary or repeat (Phase 6 spec 7.1, secondary measure).
	measure 'All Invitations' =
			VAR __Value = ( -- measure body
				COUNTROWS ( 'Survey Responses' )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """All Invitations"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\Survey Quality
	/// Primary invitations with an SMS sent ÷ primary invitations (Phase 6 spec 7.1).
	measure 'SMS Reach %' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Invitations], 'Survey Responses'[Is SMS Sent] = "Yes" ), [Invitations] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """SMS Reach %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Survey Quality
	/// Submitted ÷ responded primary invitations (Phase 6 spec 7.1).
	measure 'Completion Rate %' =
			VAR __Value = ( -- measure body
				DIVIDE (
					CALCULATE ( [Invitations], 'Survey Responses'[Is Submitted] = "Yes" ),
					CALCULATE ( [Invitations], 'Survey Responses'[Is Responded] = "Yes" )
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Completion Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Survey Quality
	/// Scored questions answered ÷ offered, over responded primary invitations (Phase 6 spec 7.1).
	measure 'Answer Completeness %' =
			VAR __Value = ( -- measure body
				CALCULATE (
					DIVIDE ( SUM ( 'Survey Responses'[Scored Questions Answered] ), SUM ( 'Survey Responses'[Scored Questions Offered] ) ),
					'Survey Responses'[Is Primary For Encounter] = "Yes",
					'Survey Responses'[Is Responded] = "Yes"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Answer Completeness %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Survey Quality
	/// Median days from visit to answer of responded primary invitations; only submitted surveys have it (Phase 6 spec 7.1; receiving notes).
	measure 'Median Days Visit to Answer' =
			VAR __Value = ( -- measure body
				CALCULATE (
					MEDIAN ( 'Survey Responses'[Days Visit To Answer] ),
					'Survey Responses'[Is Primary For Encounter] = "Yes",
					'Survey Responses'[Is Responded] = "Yes"
				)
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Median Days Visit to Answer"" can't be analysed by " & __Wrong )
		formatString: #,0.0
		displayFolder: Patient Experience\Survey Quality
	/// Primary invitations linked to an encounter ÷ primary invitations (Phase 6 spec 7.1).
	measure 'Encounter Link %' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [Invitations], KEEPFILTERS ( 'Survey Responses'[Link Status] = "Linked" ) ), [Invitations] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Encounter Link %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Survey Quality
	/// Responded primary invitations with a known doctor ÷ responded primary invitations (Phase 6 spec 7.1; receiving notes: staff_key <> -1).
	measure 'Doctor Attribution %' =
			VAR __Value = ( -- measure body
				VAR Responded = CALCULATE ( [Invitations], 'Survey Responses'[Is Responded] = "Yes" )
				VAR Attributed =
					CALCULATE ( [Invitations], 'Survey Responses'[Is Responded] = "Yes", 'Survey Responses'[Staff Key] <> -1 )
				RETURN DIVIDE ( Attributed, Responded )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Doctor Attribution %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Survey Quality
	/// Repeat (non-primary) invitations ÷ all invitations (Phase 6 spec 7.1).
	measure 'Repeat Invitation Rate %' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( [All Invitations], 'Survey Responses'[Is Primary For Encounter] = "No" ), [All Invitations] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Responses]
			RETURN IF ( __Wrong = "", __Value, """Repeat Invitation Rate %"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\Survey Quality
	/// Physician NPS on the 5-point question: (promoters − detractors) ÷ answers × 100; under 30 answers shows "insufficient sample" (Phase 6 spec 7.2).
	measure 'Physician NPS (5-point)' =
			VAR __Value = ( -- measure body
				VAR Answers = CALCULATE ( COUNTROWS ( 'Survey Answers' ), 'Survey Answers'[NPS Role] = "Physician NPS" )
				VAR Net =
					CALCULATE (
						SUM ( 'Survey Answers'[Is Promoter] ) - SUM ( 'Survey Answers'[Is Detractor] ),
						'Survey Answers'[NPS Role] = "Physician NPS"
					)
				RETURN IF ( Answers > 0, DIVIDE ( Net, Answers ) * 100 )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """Physician NPS (5-point)"" can't be analysed by " & __Wrong )
		displayFolder: Patient Experience\NPS
	
		formatStringDefinition =
				VAR Answers = CALCULATE ( COUNTROWS ( 'Survey Answers' ), 'Survey Answers'[NPS Role] = "Physician NPS" )
				RETURN IF ( Answers < 30, """insufficient sample""", "0.0" )
	/// NPS of any selection (domain, question, doctor, specialty) over scored answers; under 30 answers shows "insufficient sample" (Phase 6 spec 7.2).
	measure 'NPS (5-point)' =
			VAR __Value = ( -- measure body
				VAR Answers = [NPS Answers]
				VAR Net =
					CALCULATE (
						SUM ( 'Survey Answers'[Is Promoter] ) - SUM ( 'Survey Answers'[Is Detractor] ),
						'Survey Answers'[Is Scored] = "Yes"
					)
				RETURN IF ( Answers > 0, DIVIDE ( Net, Answers ) * 100 )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """NPS (5-point)"" can't be analysed by " & __Wrong )
		displayFolder: Patient Experience\NPS
	
		formatStringDefinition =
				IF ( [NPS Answers] < 30, """insufficient sample""", "0.0" )
	/// Scored answers (n), shown next to every NPS (Phase 6 spec 7.2).
	measure 'NPS Answers' =
			VAR __Value = ( -- measure body
				CALCULATE ( COUNTROWS ( 'Survey Answers' ), 'Survey Answers'[Is Scored] = "Yes" )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """NPS Answers"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Patient Experience\NPS
	/// Promoter answers ÷ scored answers (Phase 6 spec 7.2).
	measure '% Promoters' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( SUM ( 'Survey Answers'[Is Promoter] ), 'Survey Answers'[Is Scored] = "Yes" ), [NPS Answers] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """% Promoters"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\NPS
	/// Passive answers ÷ scored answers (Phase 6 spec 7.2).
	measure '% Passives' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( SUM ( 'Survey Answers'[Is Passive] ), 'Survey Answers'[Is Scored] = "Yes" ), [NPS Answers] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """% Passives"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\NPS
	/// Detractor answers ÷ scored answers (Phase 6 spec 7.2).
	measure '% Detractors' =
			VAR __Value = ( -- measure body
				DIVIDE ( CALCULATE ( SUM ( 'Survey Answers'[Is Detractor] ), 'Survey Answers'[Is Scored] = "Yes" ), [NPS Answers] )
			) -- end of measure body
			VAR __Wrong = [_Guard Survey Answers]
			RETURN IF ( __Wrong = "", __Value, """% Detractors"" can't be analysed by " & __Wrong )
		formatString: 0.0%
		displayFolder: Patient Experience\NPS
	/// Trial balance opening balance in SAR (natural sign: debit +, credit −) at the first period of the selection per branch; under YTD the opening of the year. Posted unless a Balance View is selected (Phase 3 spec section 1, F4).
	measure 'TB Opening Balance' =
			VAR __Value = ( -- measure body
				VAR View =
					FILTER (
						ALL ( 'GL Balances'[Balance View] ),
						IF ( ISFILTERED ( 'GL Balances'[Balance View] ), 'GL Balances'[Balance View] IN VALUES ( 'GL Balances'[Balance View] ), 'GL Balances'[Balance View] = "posted" )
					)
				RETURN
					SUMX (
						VALUES ( Branch[Branch Key] ),
						VAR FirstPeriod = CALCULATE ( MIN ( 'GL Balances'[Period Key] ), REMOVEFILTERS ( 'GL Balances' ), VALUES ( 'Date'[Date] ), VALUES ( 'GL Period'[Period Key] ), VALUES ( Branch[Branch Key] ) )
						RETURN CALCULATE ( SUM ( 'GL Balances'[Opening Balance] ), 'GL Balances'[Period Key] = FirstPeriod, View )
					)
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """TB Opening Balance"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Trial Balance
	/// Trial balance debits in SAR of the periods in the selection; posted unless a Balance View is selected (Phase 3 spec F4).
	measure 'TB Debit' =
			VAR __Value = ( -- measure body
				VAR View =
					FILTER (
						ALL ( 'GL Balances'[Balance View] ),
						IF ( ISFILTERED ( 'GL Balances'[Balance View] ), 'GL Balances'[Balance View] IN VALUES ( 'GL Balances'[Balance View] ), 'GL Balances'[Balance View] = "posted" )
					)
				RETURN CALCULATE ( SUM ( 'GL Balances'[Period Debit] ), View )
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """TB Debit"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Trial Balance
	/// Trial balance credits in SAR of the periods in the selection; posted unless a Balance View is selected (Phase 3 spec F4).
	measure 'TB Credit' =
			VAR __Value = ( -- measure body
				VAR View =
					FILTER (
						ALL ( 'GL Balances'[Balance View] ),
						IF ( ISFILTERED ( 'GL Balances'[Balance View] ), 'GL Balances'[Balance View] IN VALUES ( 'GL Balances'[Balance View] ), 'GL Balances'[Balance View] = "posted" )
					)
				RETURN CALCULATE ( SUM ( 'GL Balances'[Period Credit] ), View )
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """TB Credit"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Trial Balance
	/// Trial balance net movement in SAR (debit − credit, natural sign) of the periods in the selection; posted unless a Balance View is selected (Phase 3 spec F4).
	measure 'TB Net Movement' =
			VAR __Value = ( -- measure body
				VAR View =
					FILTER (
						ALL ( 'GL Balances'[Balance View] ),
						IF ( ISFILTERED ( 'GL Balances'[Balance View] ), 'GL Balances'[Balance View] IN VALUES ( 'GL Balances'[Balance View] ), 'GL Balances'[Balance View] = "posted" )
					)
				RETURN CALCULATE ( SUM ( 'GL Balances'[Period Movement] ), View )
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """TB Net Movement"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Trial Balance
	/// Trial balance closing balance in SAR (natural sign) at the last period of the selection per branch (an adjustment period wins over its month); all accounts net to 0. Posted unless a Balance View is selected (Phase 3 spec section 8, F4). Snapshot.
	measure 'TB Closing Balance' =
			VAR __Value = ( -- measure body
				VAR View =
					FILTER (
						ALL ( 'GL Balances'[Balance View] ),
						IF ( ISFILTERED ( 'GL Balances'[Balance View] ), 'GL Balances'[Balance View] IN VALUES ( 'GL Balances'[Balance View] ), 'GL Balances'[Balance View] = "posted" )
					)
				RETURN
					SUMX (
						VALUES ( Branch[Branch Key] ),
						VAR LastPeriod = CALCULATE ( MAX ( 'GL Balances'[Period Key] ), REMOVEFILTERS ( 'GL Balances' ), VALUES ( 'Date'[Date] ), VALUES ( 'GL Period'[Period Key] ), VALUES ( Branch[Branch Key] ) )
						RETURN CALCULATE ( SUM ( 'GL Balances'[Closing Balance] ), 'GL Balances'[Period Key] = LastPeriod, View )
					)
			) -- end of measure body
			VAR __Wrong = [_Guard GL Balances]
			RETURN IF ( __Wrong = "", __Value, """TB Closing Balance"" can't be analysed by " & __Wrong )
		formatString: #,0
		displayFolder: Finance\Trial Balance

		annotation hnh_snapshot = 1

	/// Filtered tables that cannot filter AP Invoice Lines, as a quoted list; generated by ssas/tools/measure_guards.py (SSAS spec P41).
	measure '_Guard AP Invoice Lines' =
			VAR __Names =
				IF ( ISFILTERED ( 'AP Open Items' ), ", ""AP Open Items""" )
				& IF ( ISFILTERED ( 'AP Payments' ), ", ""AP Payments""" )
				& IF ( ISFILTERED ( 'Absence Days' ), ", ""Absence Days""" )
