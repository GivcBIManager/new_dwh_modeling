/// Post-invoice revenue adjustments.
table 'Revenue Adjustments'

	column 'Branch Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Adjustment Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: value
		summarizeBy: none
		sourceColumn: adjustment_date_key

	column 'Patient Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: patient_key

	column 'Billed Payer Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: billed_payer_key

	column 'Care Type Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: care_type_key

	column 'Doc No'
		dataType: string
		summarizeBy: none
		sourceColumn: doc_no

	column 'Base Doc No'
		dataType: string
		summarizeBy: none
		sourceColumn: base_doc_no

	column 'Adjustment Amount'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: adjustment_amount

	column 'Base Invoice Net Amount'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: base_invoice_net_amount

	partition 'Revenue Adjustments' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_fact_revenue_adjustment")
				in
				    Source

	annotation hnh_kind = fact
	annotation hnh_view = ssas_fact_revenue_adjustment
