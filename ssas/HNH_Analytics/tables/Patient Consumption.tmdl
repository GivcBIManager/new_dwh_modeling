/// Items consumed by patients with cost and revenue.
table 'Patient Consumption'

	column 'Branch Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: value
		summarizeBy: none
		sourceColumn: date_key

	column 'Store Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: store_key

	column 'Item Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: item_key

	column 'Movement Type Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: movement_type_key

	column 'Patient Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: patient_key

	column 'Treating Staff Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: treating_staff_key

	column 'Billed Payer Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: billed_payer_key

	column 'Care Type Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: care_type_key

	column 'Service Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: service_key

	column 'Department Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: department_key

	column 'Is Linked To Charge'
		dataType: string
		summarizeBy: none
		sourceColumn: is_linked_to_charge

	column 'Revenue Basis'
		dataType: string
		summarizeBy: none
		sourceColumn: revenue_basis

	column 'Primary Quantity'
		dataType: double
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: primary_quantity

	column 'Cost Amount'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: cost_amount

	column 'Consumption Quantity'
		dataType: double
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: consumption_quantity

	column 'Consumption Cost'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: consumption_cost

	column 'Revenue Amount'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: revenue_amount

	column 'Oasis Cost Amount'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: oasis_cost_amount

	column 'Is Cost Mismatch'
		dataType: string
		summarizeBy: none
		sourceColumn: is_cost_mismatch

	column 'Source System'
		dataType: string
		summarizeBy: none
		sourceColumn: source_system

	column 'Is In Oasis'
		dataType: string
		summarizeBy: none
		sourceColumn: is_in_oasis

	column 'Is In Fusion'
		dataType: string
		summarizeBy: none
		sourceColumn: is_in_fusion

	column 'Is Fusion Gap'
		dataType: string
		summarizeBy: none
		sourceColumn: is_fusion_gap

	partition 'Patient Consumption template' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_fact_patient_consumption where 1 = 0")
				in
				    Source

	annotation hnh_kind = fact
	annotation hnh_view = ssas_fact_patient_consumption
	annotation hnh_partition_column = date_key
