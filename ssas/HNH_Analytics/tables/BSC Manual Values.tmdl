/// Monthly KPI values entered by the BI manager.
table 'BSC Manual Values'

	column 'BSC KPI Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: bsc_kpi_key

	column 'Branch Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Month Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: value
		summarizeBy: none
		sourceColumn: month_date_key

	column Numerator
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: numerator

	column Denominator
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: denominator

	column Note
		dataType: string
		summarizeBy: none
		sourceColumn: note

	partition 'BSC Manual Values' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_fact_bsc_manual_value")
				in
				    Source

	annotation hnh_kind = fact
	annotation hnh_view = ssas_fact_bsc_manual_value
