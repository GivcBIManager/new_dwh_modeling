	partition 'Encounters template' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_fact_encounter where 1 = 0")
				in
				    Source

	annotation hnh_kind = fact
	annotation hnh_view = ssas_fact_encounter
	annotation hnh_partition_column = encounter_date_key
