/// One Press Ganey survey invitation and its response.
table 'Survey Responses'

	/// Primary survey invitations (Phase 6 spec section 7.1).
	measure Invitations = CALCULATE ( COUNTROWS ( 'Survey Responses' ), 'Survey Responses'[Is Primary For Encounter] = "Yes" )
		formatString: #,0
		displayFolder: Survey Quality

	/// Responded ÷ primary invitations (Phase 6 spec 7.1 as amended in the receiving notes: not ÷ SMS sent, because a third of submitted surveys have no SMS date).
	measure 'Response Rate %' =
			VAR Invited = CALCULATE ( COUNTROWS ( 'Survey Responses' ), 'Survey Responses'[Is Primary For Encounter] = "Yes" )
			VAR Responded =
				CALCULATE (
					COUNTROWS ( 'Survey Responses' ),
					'Survey Responses'[Is Primary For Encounter] = "Yes",
					'Survey Responses'[Is Responded] = "Yes"
				)
			RETURN DIVIDE ( Responded, Invited )
		formatString: 0.0%
		displayFolder: Survey Quality

	column 'Survey Response Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: survey_response_key

	column 'Branch Key'
