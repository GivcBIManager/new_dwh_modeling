/// Clinic slots per doctor and day.
table 'Clinic Capacity'

	column 'Branch Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: value
		summarizeBy: none
		sourceColumn: date_key

	column 'Department Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: department_key

	column 'Staff Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: staff_key

	column 'Slots Total'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: slots_total

	column 'Slots Booked'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: slots_booked

	column 'Slots Attended'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: slots_attended

	column 'Slots No Show'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: slots_no_show

	column 'Slots Cancelled'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: slots_cancelled

	column 'Slots Rescheduled'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: slots_rescheduled

	column 'Slots Walk In'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: slots_walk_in

	column 'Break Slots'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: break_slots

	column 'Scheduled Minutes'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: scheduled_minutes

	partition 'Clinic Capacity template' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_agg_clinic_capacity_daily where 1 = 0")
				in
				    Source

	annotation hnh_kind = fact
	annotation hnh_view = ssas_agg_clinic_capacity_daily
	annotation hnh_partition_column = date_key
