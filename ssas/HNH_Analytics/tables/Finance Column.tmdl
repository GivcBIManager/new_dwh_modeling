/// Columns of the finance report's tables by page and view, with group and month number.
table 'Finance Column'

	column 'Column Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: column_key

	column Page
		dataType: string
		summarizeBy: none
		sourceColumn: page

	column View
		dataType: string
		summarizeBy: none
		sourceColumn: view

	column 'Group Name'
		dataType: string
		summarizeBy: none
		sortByColumn: 'Group Order'
		sourceColumn: group_name

	column 'Group Order'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: group_order

	column 'Column Name'
		dataType: string
		summarizeBy: none
		sortByColumn: 'Column Order'
		sourceColumn: column_name

	column 'Column Order'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: column_order

	column Kind
		dataType: string
		summarizeBy: none
		sourceColumn: kind

	column 'Month Num'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: month_num

	partition 'Finance Column' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_dim_finance_column")
				in
				    Source

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_finance_column
