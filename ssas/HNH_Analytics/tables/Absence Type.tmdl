/// Absence types and plans.
table 'Absence Type'

	column 'Absence Type Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: absence_type_key

	column 'Absence Type ID'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: absence_type_id

	column 'Absence Type Name'
		dataType: string
		summarizeBy: none
		sourceColumn: absence_type_name

	column 'Absence Plan Name'
		dataType: string
		summarizeBy: none
		sourceColumn: absence_plan_name

	column 'Plan Type'
		dataType: string
		summarizeBy: none
		sourceColumn: plan_type

	column 'Absence Category'
		dataType: string
		summarizeBy: none
		sourceColumn: absence_category

	column 'Is Current'
		dataType: string
		summarizeBy: none
		sourceColumn: is_current

	partition 'Absence Type' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_dim_absence_type")
				in
				    Source

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_absence_type
