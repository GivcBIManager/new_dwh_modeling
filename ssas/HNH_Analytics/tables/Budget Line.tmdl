/// Income statement budget lines and subtotals.
table 'Budget Line'

	column 'Budget Line Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: budget_line_key

	column 'Budget Line Code'
		dataType: string
		summarizeBy: none
		sourceColumn: budget_line_code

	column 'Budget Line Name'
		dataType: string
		summarizeBy: none
		sortByColumn: 'Sort Order'
		sourceColumn: budget_line_name

	column 'Sort Order'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: sort_order

	column 'Is Subtotal'
		dataType: string
		summarizeBy: none
		sourceColumn: is_subtotal

	column 'Natural Side'
		dataType: string
		summarizeBy: none
		sourceColumn: natural_side

	partition 'Budget Line' = query
		source
			query = select * from gold.ssas_dim_budget_line
			dataSource: HNH_Gold

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_budget_line
