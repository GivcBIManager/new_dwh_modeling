/// Visit eligibility types and free follow-up days.
table 'Eligibility Type'

	column 'Eligibility Type Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: eligibility_type_key

	column 'Branch Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Eligibility Type'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: eligibility_type

	column Description
		dataType: string
		summarizeBy: none
		sourceColumn: description

	column 'Care Type'
		dataType: string
		summarizeBy: none
		sourceColumn: care_type

	column 'Free Follow Up Days'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: free_follow_up_days

	partition 'Eligibility Type' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_dim_eligibility_type")
				in
				    Source

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_eligibility_type
