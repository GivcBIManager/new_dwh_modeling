/// NPHIES adjudication and rejection reasons.
table 'NPHIES Reason'

	column 'NPHIES Reason Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: nphies_reason_key

	column 'Reason Code'
		dataType: string
		summarizeBy: none
		sourceColumn: reason_code

	column Reason
		dataType: string
		summarizeBy: none
		sourceColumn: reason

	column 'Reason Category'
		dataType: string
		summarizeBy: none
		sourceColumn: reason_category

	partition 'NPHIES Reason' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_dim_nphies_reason")
				in
				    Source

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_nphies_reason
