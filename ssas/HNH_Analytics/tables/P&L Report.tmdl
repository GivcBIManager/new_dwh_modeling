/// Monthly amount per P&L report line, branch and slicer, in the Fusion report's sign.
table 'P&L Report'

	column 'Branch Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Source System'
		dataType: string
		summarizeBy: none
		sourceColumn: source_system

	column 'PL Line Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: pl_line_key

	column 'PL Line Code'
		dataType: string
		summarizeBy: none
		sourceColumn: pl_line_code

	column 'Account Code'
		dataType: string
		summarizeBy: none
		sourceColumn: account_code

	column 'FS Category'
		dataType: string
		summarizeBy: none
		sourceColumn: fs_category

	column 'FS Caption'
		dataType: string
		summarizeBy: none
		sourceColumn: fs_caption

	column 'FS Line'
		dataType: string
		summarizeBy: none
		sourceColumn: fs_line

	column 'Specialty Name'
		dataType: string
		summarizeBy: none
		sourceColumn: specialty_name

	column 'Service Location Name'
		dataType: string
		summarizeBy: none
		sourceColumn: service_location_name

	column 'Service Group Name'
		dataType: string
		summarizeBy: none
		sourceColumn: service_group_name

	column Amount
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: amount

	column 'Month Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: value
		summarizeBy: none
		sourceColumn: month_date_key

	partition 'P&L Report' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_fact_pl_report_monthly")
				in
				    Source

	annotation hnh_kind = fact
	annotation hnh_view = ssas_fact_pl_report_monthly
