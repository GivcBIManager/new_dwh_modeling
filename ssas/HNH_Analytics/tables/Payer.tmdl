/// Purchasers (insurers, companies, cash) with category and MOH flag.
table Payer

	column 'Payer Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: payer_key

	column 'Branch Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Purchaser Code'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: purchaser_code

	column 'Purchaser Name'
		dataType: string
		summarizeBy: none
		sourceColumn: purchaser_name

	column 'Account Code'
		dataType: string
		summarizeBy: none
		sourceColumn: account_code

	column Company
		dataType: string
		summarizeBy: none
		sourceColumn: company

	column Creditor
		dataType: string
		summarizeBy: none
		sourceColumn: creditor

	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	column 'Billing Type'
		dataType: string
		summarizeBy: none
		sourceColumn: billing_type

	column 'Manual Submission'
		dataType: string
		summarizeBy: none
		sourceColumn: manual_submission

	column 'Purchaser Type'
		dataType: string
		summarizeBy: none
		sourceColumn: purchaser_type

	column 'Is TPA'
		dataType: string
		summarizeBy: none
		sourceColumn: is_tpa

	column 'Is MOH'
		dataType: string
		summarizeBy: none
		sourceColumn: is_moh

	column 'Is Active'
		dataType: string
		summarizeBy: none
		sourceColumn: is_active

	column 'CCHI No'
		dataType: string
		summarizeBy: none
		sourceColumn: cchi_no

	column 'NPHIES License'
		dataType: string
		summarizeBy: none
		sourceColumn: nphies_license

	partition Payer = query
		source
			query = select * from gold.ssas_dim_payer
			dataSource: HNH_Gold

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_payer
