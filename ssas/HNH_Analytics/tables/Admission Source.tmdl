/// How the patient was admitted.
table 'Admission Source'

	column 'Admission Source Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: admission_source_key

	column 'Admission Source'
		dataType: string
		summarizeBy: none
		sourceColumn: admission_source

	partition 'Admission Source' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_dim_admission_source")
				in
				    Source

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_admission_source
