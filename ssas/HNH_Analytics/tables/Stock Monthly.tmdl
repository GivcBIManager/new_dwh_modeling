/// Month-end stock per store and item.
table 'Stock Monthly'

	/// Stock value in SAR at the last month-end of the selection, expiry stores excluded (Phase 5 spec section 7). Snapshot. The last period is taken per branch, so a multi-branch total keeps every branch.
	measure 'Stock Value' =
			SUMX (
				VALUES ( Branch[Branch Key] ),
				VAR LastMonth = CALCULATE ( MAX ( 'Stock Monthly'[Month Date Key] ) )
				RETURN
					CALCULATE (
						SUM ( 'Stock Monthly'[Stock Value Amount] ),
						'Stock Monthly'[Month Date Key] = LastMonth,
						'Stock Monthly'[Is Expiry Store] = "No"
					)
			)
		formatString: #,0
		displayFolder: Stock

	column 'Branch Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Month Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: value
		summarizeBy: none
		sourceColumn: month_date_key

	column 'Store Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: store_key

	column 'Item Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: item_key

	column Quantity
		dataType: double
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: quantity

	column 'Stock Value Amount'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: stock_value

	column 'Stock Source'
		dataType: string
		summarizeBy: none
		sourceColumn: stock_source

	column 'Source System'
		dataType: string
		summarizeBy: none
		sourceColumn: source_system

	column 'Is Expiry Store'
		dataType: string
		summarizeBy: none
		sourceColumn: is_expiry_store

	column 'Is Closed Month'
		dataType: string
		summarizeBy: none
		sourceColumn: is_closed_month

	column 'Has Expired Lot'
		dataType: string
		summarizeBy: none
		sourceColumn: has_expired_lot

	column 'Consumption Quantity'
		dataType: double
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: consumption_quantity

	column 'Consumption Cost'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: consumption_cost

	partition 'Stock Monthly' = query
		source
			query = select * from gold.ssas_fact_stock_monthly
			dataSource: HNH_Gold

	annotation hnh_kind = fact
	annotation hnh_view = ssas_fact_stock_monthly
