/// One counted absence day per employee.
table 'Absence Days'

	column 'Branch Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Employee Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: employee_key

	column 'Staff Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: staff_key

	column 'Absence Type Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: absence_type_key

	column 'Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: value
		summarizeBy: none
		sourceColumn: date_key

	column 'Absence Days'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: absence_days

	partition 'Absence Days' = query
		source
			query = select * from gold.ssas_fact_absence_daily
			dataSource: HNH_Gold

	annotation hnh_kind = fact
	annotation hnh_view = ssas_fact_absence_daily
