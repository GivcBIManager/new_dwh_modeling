/// Patients per branch without personal identifiers; filtered to the user's branches.
table Patient

	column 'Patient Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: patient_key

	column 'Branch Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Patient ID'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: patient_id

	column MRN
		dataType: string
		summarizeBy: none
		sourceColumn: mrn

	column Gender
		dataType: string
		summarizeBy: none
		sourceColumn: gender

	column 'Birth Date'
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: birth_date

	column Nationality
		dataType: string
		summarizeBy: none
		sourceColumn: nationality

	column 'Is Saudi'
		dataType: string
		summarizeBy: none
		sourceColumn: is_saudi

	column 'Marital Status'
		dataType: string
		summarizeBy: none
		sourceColumn: marital_status

	column Occupation
		dataType: string
		summarizeBy: none
		sourceColumn: occupation

	column 'Registered Date'
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: registered_date

	column 'Registered Dept'
		dataType: string
		summarizeBy: none
		sourceColumn: registered_dept

	column Status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	column 'Is Chronic'
		dataType: string
		summarizeBy: none
		sourceColumn: is_chronic

	column 'Is At Risk'
		dataType: string
		summarizeBy: none
		sourceColumn: is_at_risk

	column 'Is Merged'
		dataType: string
		summarizeBy: none
		sourceColumn: is_merged

	column 'Person Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: person_key

	column 'Person Key Source'
		dataType: string
		summarizeBy: none
		sourceColumn: person_key_source

	partition Patient = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_dim_patient")
				in
				    Source

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_patient
