/// Time intelligence for any measure: pick one item (SSAS spec 8.3). Items other than Current run up to today, so a whole year or no date filter means "to date" (P40). Snapshot measures keep their month-end value under MTD, QTD, YTD and Rolling 12M.
table 'Time Calculation'

	calculationGroup
		precedence: 1

		calculationItem Current = SELECTEDMEASURE ()
			ordinal: 0

		calculationItem MTD =
				-- Dates up to today only: a whole year, or no date filter, means "to date" (the calendar runs to 2028).
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				RETURN
					-- Snapshot measures: keep this list identical in MTD, QTD, YTD, PY YTD and Rolling 12M
					IF (
						ISSELECTEDMEASURE ( [Headcount], [Stock Value], [GL Closing Balance], [GL Closing Balance (incl. Unposted)], [Profit for the Year], [Profit for the Year (incl. Unposted)], [Open Payables], [Overdue Payables], [FTE], [Saudisation Rate %], [Leave Balance (days)], [Leave Liability], [Days of Stock], [Inventory Turnover], [Slow-Moving Items], [Slow-Moving Stock Value], [Dead Stock Items], [Dead Stock Value], [TB Closing Balance] ),
						SELECTEDMEASURE (),
						CALCULATE ( SELECTEDMEASURE (), DATESMTD ( Past ) )
					)

			ordinal: 1

		calculationItem QTD =
				-- Dates up to today only: a whole year, or no date filter, means "to date" (the calendar runs to 2028).
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				RETURN
					-- Snapshot measures: keep this list identical in MTD, QTD, YTD, PY YTD and Rolling 12M
					IF (
						ISSELECTEDMEASURE ( [Headcount], [Stock Value], [GL Closing Balance], [GL Closing Balance (incl. Unposted)], [Profit for the Year], [Profit for the Year (incl. Unposted)], [Open Payables], [Overdue Payables], [FTE], [Saudisation Rate %], [Leave Balance (days)], [Leave Liability], [Days of Stock], [Inventory Turnover], [Slow-Moving Items], [Slow-Moving Stock Value], [Dead Stock Items], [Dead Stock Value], [TB Closing Balance] ),
						SELECTEDMEASURE (),
						CALCULATE ( SELECTEDMEASURE (), DATESQTD ( Past ) )
					)

			ordinal: 2

		calculationItem YTD =
				-- Dates up to today only: a whole year, or no date filter, means "to date" (the calendar runs to 2028).
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				RETURN
					-- Snapshot measures: keep this list identical in MTD, QTD, YTD, PY YTD and Rolling 12M
					IF (
						ISSELECTEDMEASURE ( [Headcount], [Stock Value], [GL Closing Balance], [GL Closing Balance (incl. Unposted)], [Profit for the Year], [Profit for the Year (incl. Unposted)], [Open Payables], [Overdue Payables], [FTE], [Saudisation Rate %], [Leave Balance (days)], [Leave Liability], [Days of Stock], [Inventory Turnover], [Slow-Moving Items], [Slow-Moving Stock Value], [Dead Stock Items], [Dead Stock Value], [TB Closing Balance] ),
						SELECTEDMEASURE (),
						CALCULATE ( SELECTEDMEASURE (), DATESYTD ( Past ) )
					)

			ordinal: 3

		calculationItem PY =
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				RETURN CALCULATE ( SELECTEDMEASURE (), SAMEPERIODLASTYEAR ( Past ) )

			ordinal: 4

		calculationItem 'PY YTD' =
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				RETURN
					-- Snapshot measures: keep this list identical in MTD, QTD, YTD, PY YTD and Rolling 12M
					IF (
						ISSELECTEDMEASURE ( [Headcount], [Stock Value], [GL Closing Balance], [GL Closing Balance (incl. Unposted)], [Profit for the Year], [Profit for the Year (incl. Unposted)], [Open Payables], [Overdue Payables], [FTE], [Saudisation Rate %], [Leave Balance (days)], [Leave Liability], [Days of Stock], [Inventory Turnover], [Slow-Moving Items], [Slow-Moving Stock Value], [Dead Stock Items], [Dead Stock Value], [TB Closing Balance] ),
						CALCULATE ( SELECTEDMEASURE (), SAMEPERIODLASTYEAR ( Past ) ),
						CALCULATE ( SELECTEDMEASURE (), DATESYTD ( SAMEPERIODLASTYEAR ( Past ) ) )
					)

			ordinal: 5

		calculationItem 'YoY Δ' =
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				VAR Cur = CALCULATE ( SELECTEDMEASURE (), Past )
				VAR Prev = CALCULATE ( SELECTEDMEASURE (), SAMEPERIODLASTYEAR ( Past ) )
				RETURN
					-- A text measure (Current User, a "can't be analysed" message) passes through unchanged.
					IF (
						ISTEXT ( Cur ) || ISTEXT ( Prev ),
						Cur,
						IF ( NOT ISBLANK ( Cur ) && NOT ISBLANK ( Prev ), Cur - Prev )
					)

			ordinal: 6

		calculationItem 'YoY %' =
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				VAR Cur = CALCULATE ( SELECTEDMEASURE (), Past )
				VAR Prev = CALCULATE ( SELECTEDMEASURE (), SAMEPERIODLASTYEAR ( Past ) )
				RETURN
					-- A text measure (Current User, a "can't be analysed" message) passes through unchanged.
					IF (
						ISTEXT ( Cur ) || ISTEXT ( Prev ),
						Cur,
						IF ( NOT ISBLANK ( Cur ) && NOT ISBLANK ( Prev ), DIVIDE ( Cur - Prev, ABS ( Prev ) ) )
					)

			ordinal: 7
			formatStringDefinition = IF ( ISTEXT ( SELECTEDMEASURE () ), "", "0.0%" )

		calculationItem 'MoM Δ' =
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				VAR Cur = CALCULATE ( SELECTEDMEASURE (), Past )
				VAR Prev = CALCULATE ( SELECTEDMEASURE (), DATEADD ( Past, -1, MONTH ) )
				RETURN
					-- A text measure (Current User, a "can't be analysed" message) passes through unchanged.
					IF (
						ISTEXT ( Cur ) || ISTEXT ( Prev ),
						Cur,
						IF ( NOT ISBLANK ( Cur ) && NOT ISBLANK ( Prev ), Cur - Prev )
					)

			ordinal: 8

		calculationItem 'MoM %' =
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				VAR Cur = CALCULATE ( SELECTEDMEASURE (), Past )
				VAR Prev = CALCULATE ( SELECTEDMEASURE (), DATEADD ( Past, -1, MONTH ) )
				RETURN
					-- A text measure (Current User, a "can't be analysed" message) passes through unchanged.
					IF (
						ISTEXT ( Cur ) || ISTEXT ( Prev ),
						Cur,
						IF ( NOT ISBLANK ( Cur ) && NOT ISBLANK ( Prev ), DIVIDE ( Cur - Prev, ABS ( Prev ) ) )
					)

			ordinal: 9
			formatStringDefinition = IF ( ISTEXT ( SELECTEDMEASURE () ), "", "0.0%" )

		calculationItem 'Rolling 12M' =
				VAR Past = CALCULATETABLE ( VALUES ( 'Date'[Date] ), KEEPFILTERS ( 'Date'[Date] <= TODAY () ) )
				VAR LastDay = MAXX ( Past, 'Date'[Date] )
				RETURN
					-- Snapshot measures: keep this list identical in MTD, QTD, YTD, PY YTD and Rolling 12M
					IF (
						ISSELECTEDMEASURE ( [Headcount], [Stock Value], [GL Closing Balance], [GL Closing Balance (incl. Unposted)], [Profit for the Year], [Profit for the Year (incl. Unposted)], [Open Payables], [Overdue Payables], [FTE], [Saudisation Rate %], [Leave Balance (days)], [Leave Liability], [Days of Stock], [Inventory Turnover], [Slow-Moving Items], [Slow-Moving Stock Value], [Dead Stock Items], [Dead Stock Value], [TB Closing Balance] ),
						SELECTEDMEASURE (),
						IF ( NOT ISBLANK ( LastDay ), CALCULATE ( SELECTEDMEASURE (), DATESINPERIOD ( 'Date'[Date], LastDay, -12, MONTH ) ) )
					)

			ordinal: 10

	column 'Time Calculation'
		dataType: string
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

	column Ordinal
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Ordinal

	partition 'Time Calculation' = calculationGroup

	annotation hnh_kind = calculation_group
