/// Appointment and visit outcomes.
table 'Appointment Outcome'

	column 'Outcome Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: outcome_key

	column 'Branch Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Outcome Code'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: outcome_code

	column Outcome
		dataType: string
		summarizeBy: none
		sourceColumn: outcome

	column 'Outcome Group'
		dataType: string
		summarizeBy: none
		sourceColumn: outcome_group

	column 'Is Cancelled'
		dataType: string
		summarizeBy: none
		sourceColumn: is_cancelled

	partition 'Appointment Outcome' = query
		source
			query = select * from gold.ssas_dim_appointment_outcome
			dataSource: HNH_Gold

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_appointment_outcome
