/// Surgery procedure types.
table 'Procedure Type'

	column 'Procedure Type Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: procedure_type_key

	column 'Procedure Type'
		dataType: string
		summarizeBy: none
		sourceColumn: procedure_type

	partition 'Procedure Type' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_dim_procedure_type")
				in
				    Source

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_procedure_type
