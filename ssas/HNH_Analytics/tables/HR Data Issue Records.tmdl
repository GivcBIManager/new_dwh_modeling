/// One HR record that has a data quality issue.
table 'HR Data Issue Records'

	column 'HR Dq Issue Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: hr_dq_issue_key

	column 'Issue Code'
		dataType: string
		summarizeBy: none
		sourceColumn: issue_code

	column 'Branch Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Employee Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: employee_key

	column 'Staff Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: staff_key

	column 'Worker Number'
		dataType: string
		summarizeBy: none
		sourceColumn: worker_number

	column 'Staff ID'
		dataType: string
		summarizeBy: none
		sourceColumn: staff_id

	column 'Field Name'
		dataType: string
		summarizeBy: none
		sourceColumn: field_name

	column 'Value Found'
		dataType: string
		summarizeBy: none
		sourceColumn: value_found

	column 'Record Date'
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: record_date

	partition 'HR Data Issue Records' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_fact_hr_dq_record")
				in
				    Source

	annotation hnh_kind = fact
	annotation hnh_view = ssas_fact_hr_dq_record
