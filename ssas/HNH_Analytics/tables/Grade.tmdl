/// Fusion grades.
table Grade

	column 'Grade Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: grade_key

	column 'Grade ID'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: grade_id

	column 'Grade Code'
		dataType: string
		summarizeBy: none
		sourceColumn: grade_code

	column 'Grade Name'
		dataType: string
		summarizeBy: none
		sourceColumn: grade_name

	column 'Is Current'
		dataType: string
		summarizeBy: none
		sourceColumn: is_current

	partition Grade = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_dim_grade")
				in
				    Source

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_grade
