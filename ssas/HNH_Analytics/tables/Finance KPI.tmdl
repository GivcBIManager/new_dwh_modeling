/// Finance report KPIs with group, unit, direction and card.
table 'Finance KPI'

	column 'KPI Code'
		dataType: string
		summarizeBy: none
		sourceColumn: kpi_code

	column 'KPI Group'
		dataType: string
		summarizeBy: none
		sortByColumn: 'Group Order'
		sourceColumn: kpi_group

	column 'Group Order'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: group_order

	column 'KPI Name'
		dataType: string
		summarizeBy: none
		sortByColumn: 'Display Order'
		sourceColumn: kpi_name

	column Unit
		dataType: string
		summarizeBy: none
		sourceColumn: unit

	column Direction
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: direction

	column 'Display Order'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: display_order

	column 'Card Code'
		dataType: string
		summarizeBy: none
		sourceColumn: card_code

	partition 'Finance KPI' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_dim_finance_kpi")
				in
				    Source

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_finance_kpi
