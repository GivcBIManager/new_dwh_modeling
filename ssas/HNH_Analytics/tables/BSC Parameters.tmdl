/// Scorecard parameters (clinic hours per day, patients per hour, ancillary target share).
table 'BSC Parameters'

	column 'BSC Parameter Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: bsc_parameter_key

	column 'Clinic Hours Per Day'
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: clinic_hours_per_day

	column 'Clinic Patients Per Hour'
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: clinic_patients_per_hour

	column 'Ancillary Target Share'
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: ancillary_target_share

	partition 'BSC Parameters' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_dim_bsc_parameter")
				in
				    Source

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_bsc_parameter
