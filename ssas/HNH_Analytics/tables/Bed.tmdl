/// Beds with class, classification and critical flag.
table Bed

	column 'Bed Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: bed_key

	column 'Branch Key'
		dataType: int64
		isHidden
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Bed Location'
		dataType: string
		summarizeBy: none
		sourceColumn: bed_location

	column 'Current Ward'
		dataType: string
		summarizeBy: none
		sourceColumn: current_ward

	column 'Bed Class'
		dataType: string
		summarizeBy: none
		sourceColumn: bed_class

	column 'Bed Gender'
		dataType: string
		summarizeBy: none
		sourceColumn: bed_gender

	column Classification
		dataType: string
		summarizeBy: none
		sourceColumn: classification

	column 'Is Critical'
		dataType: string
		summarizeBy: none
		sourceColumn: is_critical

	column 'Current Slot Status'
		dataType: string
		summarizeBy: none
		sourceColumn: current_slot_status

	column 'Is Currently Available'
		dataType: string
		summarizeBy: none
		sourceColumn: is_currently_available

	partition Bed = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_dim_bed")
				in
				    Source

	annotation hnh_kind = dim
	annotation hnh_view = ssas_dim_bed
