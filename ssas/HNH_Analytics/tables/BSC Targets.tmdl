/// Fixed KPI targets per hospital and month.
table 'BSC Targets'

	column 'BSC KPI Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: bsc_kpi_key

	column 'Branch Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: hash
		summarizeBy: none
		sourceColumn: branch_key

	column 'Month Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		encodingHint: value
		summarizeBy: none
		sourceColumn: month_date_key

	column 'Target Value'
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: target_value

	column 'Scale With Months'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: scale_with_months

	column 'Source Basis'
		dataType: string
		summarizeBy: none
		sourceColumn: source_basis

	partition 'BSC Targets' = m
		source =
				let
				    Source = Odbc.Query("dsn=HNH_Gold", "select * from gold.ssas_fact_bsc_target_monthly")
				in
				    Source

	annotation hnh_kind = fact
	annotation hnh_view = ssas_fact_bsc_target_monthly
