    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Read the status",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "fontWeight": "bold",
                      "color": "#1478BE"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• ● On track (green): the actual meets the target.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• ◆ Watch (amber): short of the target but still within the watch threshold. For on-target KPIs, the distance from the target is compared with the distance from the watch value to the target.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• ■ At risk (red): it is worse than the watch value.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• ○ No target yet (grey): no target is set, so the KPI is not scored.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• – No data (grey): there is no figure for the month.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Parked: the KPI is listed but not scored for now.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• 🔒 Requires pay access: pay figures (payroll, overtime, leave, productivity) show only to users with pay access; others see this note instead of a number.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Every target marked (placeholder) is a starting value, the current level, until HR sets the real one. HR decides the targets; the BI manager enters them (docs/hr_config.md). The mark goes when a real target is in.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
