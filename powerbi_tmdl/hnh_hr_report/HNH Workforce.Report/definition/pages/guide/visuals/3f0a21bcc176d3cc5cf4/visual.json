  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Find your way",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "16pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Home: the headline figures. Story: one sentence and one chart per area. Scorecard: every KPI and its status. Details: six pages of breakdowns. Data quality and Guide.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• On the Scorecard, select a KPI row, then Drill through to KPI detail.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Right-click a branch or department bar, then Drill through > Employee list, to see the people. Back returns to the page you came from.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Charts with arrows drill down a level: branch, then location; department, then job, position and grade; absence category, then type.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Click a bar or a cell to filter the rest of the page; click it again to clear.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Pick the dates",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "16pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Last closed month is on when the report opens: the cards and breakdowns show the month just ended.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Click it off to use Dates. Hires, pay and absence days add up over the dates; headcount and leave balance are those at the end of the last closed month in them.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Trend charts show the closed months of the Dates, the last 12 at most, with Last closed month on or off.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Period, on Scorecard and KPI detail: the month (Current), quarter to date (QTD) or year to date (YTD). Annual targets of rates such as turnover are pro-rated to the months.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Branch lists the eight hospitals and Head Office. Every page, KPI and target includes Head Office; it shows only to users whose access includes it.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "6pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              }
            ]
          }
        }
