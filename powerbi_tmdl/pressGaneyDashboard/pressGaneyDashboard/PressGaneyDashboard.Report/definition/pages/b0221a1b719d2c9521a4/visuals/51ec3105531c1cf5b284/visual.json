              },
              {
                "textRuns": [
                  {
                    "value": "Care type: ",
                    "textStyle": {
                      "fontFamily": "Zain, Segoe UI",
                      "fontSize": "13px",
                      "fontWeight": "bold",
                      "color": "#0A1E32"
                    }
                  },
                  {
                    "value": "each survey linked to a visit carries that visit's care type: Emergency → ER visits, Outpatient → OP visits, Inpatient → admissions. Day case and unknown are left out.",
