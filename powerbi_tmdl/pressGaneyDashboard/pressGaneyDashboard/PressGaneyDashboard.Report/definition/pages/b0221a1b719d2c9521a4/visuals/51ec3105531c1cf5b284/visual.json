                      "fontFamily": "Zain, Segoe UI",
                      "fontSize": "13px",
                      "color": "#3C4D60"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Only months with 1,000+ invitations and surveys linked to a visit count. Needed ±5%: 385 responses, less for small groups. Gap: responses still needed.",
