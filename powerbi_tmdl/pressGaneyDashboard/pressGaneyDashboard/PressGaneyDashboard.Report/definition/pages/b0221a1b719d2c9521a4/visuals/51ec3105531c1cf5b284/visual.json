                      "fontFamily": "Zain, Segoe UI",
                      "fontSize": "13px",
                      "color": "#3C4D60"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Non-response: ",
                    "textStyle": {
                      "fontFamily": "Zain, Segoe UI",
                      "fontSize": "13px",
                      "fontWeight": "bold",
                      "color": "#0A1E32"
                    }
                  },
                  {
                    "value": "each care setting uses one channel, so channels can't show whether non-responders feel differently; the lower the response rate, the higher that risk.",
