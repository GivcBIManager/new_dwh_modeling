          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "KPI score (0 to 100)",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "fontWeight": "bold",
                      "color": "#1478BE"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Variance: how far the actual is from the target, as a % of the target. Where lower is better, the sign is flipped, so beating the target is always positive. For on-target KPIs, any distance from the target counts against.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Score = score base + score slope × variance, rounded and kept between 0 and 100.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Every KPI today uses base 85 and slope 0.6: a KPI exactly on target scores 85, and each point of variance moves the score by 0.6.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Status: On track from 85, Watch from 70, At risk below 70.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
