    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Pillar and overall scores",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "fontWeight": "bold",
                      "color": "#1478BE"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Objective and pillar score: the average of their KPI scores, weighted by KPI weight.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• With one hospital selected, that hospital's KPI weights apply; otherwise the corporate weights.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Overall score: the average of the pillar scores, weighted by pillar weight.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• KPIs without a score (no data, no target, parked) are left out; the others' weights count in full.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Hospital comparison ranks hospitals by these scores; equal rounded scores share a rank.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
