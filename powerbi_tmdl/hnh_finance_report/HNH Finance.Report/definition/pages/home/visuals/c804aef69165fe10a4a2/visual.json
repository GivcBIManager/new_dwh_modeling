          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "• The eight hospitals; Head Office is not included.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#0A1E32",
                      "fontWeight": "normal"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• General ledger from 2022: Oasis up to each hospital's move to Fusion, Fusion after it. Refreshed every night.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#0A1E32",
                      "fontWeight": "normal"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Actuals stop at today, so the current month is partial; a month not yet closed can look low.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#0A1E32",
                      "fontWeight": "normal"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Budgets and targets are entered by the BI manager; where none is entered yet the report says so (No budget yet, No target yet).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
