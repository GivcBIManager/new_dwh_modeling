            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Find your way",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "13pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• The report opens on Home: the period's headline figures and a card for each statement.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• The tabs at the top lead to Home, Trial Balance, Income Statement, Balance Sheet, KPIs & Ratios, How to use and Definitions. Pages are reached only through the tabs and buttons.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Each statement has two views. Monthly: months across, for the hospitals picked. Hospitals: the eight hospitals side by side, with All hospitals after them under each figure.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Switch views with the Monthly and Hospitals buttons at the top left.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Pick the period",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "13pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Hospital: one or more hospitals (Monthly pages and Home). The Hospitals view always shows all eight.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Year: the current year when the report opens; pick an earlier year to look back.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Month: nothing picked means every month of the year up to today; pick one or more months to narrow it.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• The period in use shows at the top right. Your picks follow you to every page.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5pt",
                      "color": "#0A1E32"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Actuals stop at today: the current month is partial, and a month the ledger has not closed yet can look low.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
