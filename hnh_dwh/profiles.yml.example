hnh_dwh:
  target: dev
  outputs:
    dev:
      type: clickhouse
      driver: http
      host: "{{ env_var('HNH_CH_HOST') }}"
      port: "{{ env_var('HNH_CH_PORT', '8123') | int }}"
      user: "{{ env_var('HNH_CH_USER', 'default') }}"
      password: "{{ env_var('HNH_CH_PASSWORD') }}"
      schema: gold
      secure: false
      verify: false
      threads: 4
      connect_timeout: 30
      send_receive_timeout: 1800
      use_lw_deletes: true
